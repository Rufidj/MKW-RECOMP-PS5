diff --git a/runtime/gfx/nvn/host/gfx_window_ps5.c b/runtime/gfx/nvn/host/gfx_window_ps5.c
new file mode 100644
index 0000000..569b346
--- /dev/null
+++ b/runtime/gfx/nvn/host/gfx_window_ps5.c
@@ -0,0 +1,133 @@
+// PS5 native display surface for the runtime's existing Vulkan present path.
+// SPDX-License-Identifier: MIT
+// Uses VK_KHR_display, as the locally validated PS5 Vulkan foundation does.
+// No SDL window or separate Vulkan device: the runtime owns both device and swapchain.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 display backend selected for another target"
+#endif
+#include <stdlib.h>
+#include "gfx.h"
+#include "gfx_wsys.h"
+#include "ui/menu/menu.h"
+#include "platform/platform.h"
+
+typedef struct {
+    VkDisplaySurfaceCreateInfoKHR surface;
+    uint32_t refresh;
+    uint64_t score;
+    int found;
+} DisplayChoice;
+static uint32_t display_width, display_height;
+
+// Driver lists are stable during startup. Reject incomplete results and retry
+// on the next device/start attempt rather than using partially filled arrays.
+static int choose_display(VkPhysicalDevice pd, DisplayChoice *choice) {
+    uint32_t nd = 0, np = 0;
+    if (vkGetPhysicalDeviceDisplayPropertiesKHR(pd, &nd, NULL) != VK_SUCCESS || !nd || nd > 4096 ||
+        vkGetPhysicalDeviceDisplayPlanePropertiesKHR(pd, &np, NULL) != VK_SUCCESS || !np || np > 4096) return 0;
+    VkDisplayPropertiesKHR *displays = calloc(nd, sizeof *displays);
+    VkDisplayPlanePropertiesKHR *planes = calloc(np, sizeof *planes);
+    if (!displays || !planes) { free(displays); free(planes); return 0; }
+    int ok = vkGetPhysicalDeviceDisplayPropertiesKHR(pd, &nd, displays) == VK_SUCCESS &&
+             vkGetPhysicalDeviceDisplayPlanePropertiesKHR(pd, &np, planes) == VK_SUCCESS;
+    int want_w, want_h; gfx_cfg_window_size(&want_w, &want_h);
+    for (uint32_t d = 0; ok && d < nd; d++) {
+        if (!(displays[d].supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR)) continue;
+        uint32_t nm = 0;
+        if (vkGetDisplayModePropertiesKHR(pd, displays[d].display, &nm, NULL) != VK_SUCCESS || !nm || nm > 4096) continue;
+        VkDisplayModePropertiesKHR *modes = calloc(nm, sizeof *modes);
+        if (!modes) { ok = 0; break; }
+        if (vkGetDisplayModePropertiesKHR(pd, displays[d].display, &nm, modes) != VK_SUCCESS) { free(modes); continue; }
+        for (uint32_t p = 0; p < np; p++) {
+            if (planes[p].currentDisplay && planes[p].currentDisplay != displays[d].display) continue;
+            uint32_t ns = 0;
+            if (vkGetDisplayPlaneSupportedDisplaysKHR(pd, p, &ns, NULL) != VK_SUCCESS || !ns || ns > 4096) continue;
+            VkDisplayKHR *supported = calloc(ns, sizeof *supported);
+            if (!supported) { ok = 0; break; }
+            int match = 0;
+            if (vkGetDisplayPlaneSupportedDisplaysKHR(pd, p, &ns, supported) == VK_SUCCESS)
+                for (uint32_t s = 0; s < ns; s++) match |= supported[s] == displays[d].display;
+            free(supported);
+            if (!match) continue;
+            for (uint32_t m = 0; m < nm; m++) {
+                VkDisplayPlaneCapabilitiesKHR cap;
+                if (vkGetDisplayPlaneCapabilitiesKHR(pd, modes[m].displayMode, p, &cap) != VK_SUCCESS) continue;
+                VkExtent2D size = modes[m].parameters.visibleRegion;
+                if (!size.width || !size.height || size.width > INT32_MAX || size.height > INT32_MAX ||
+                    cap.minSrcPosition.x > 0 || cap.minSrcPosition.y > 0 || cap.maxSrcPosition.x < 0 || cap.maxSrcPosition.y < 0 ||
+                    cap.minDstPosition.x > 0 || cap.minDstPosition.y > 0 || cap.maxDstPosition.x < 0 || cap.maxDstPosition.y < 0 ||
+                    size.width < cap.minSrcExtent.width || size.width > cap.maxSrcExtent.width ||
+                    size.height < cap.minSrcExtent.height || size.height > cap.maxSrcExtent.height ||
+                    size.width < cap.minDstExtent.width || size.width > cap.maxDstExtent.width ||
+                    size.height < cap.minDstExtent.height || size.height > cap.maxDstExtent.height) continue;
+                // Size first, then proximity to 60 Hz. Select only supported modes;
+                // never invent the refresh value reported to the game.
+                uint64_t dx = size.width > (uint32_t)want_w ? size.width - want_w : want_w - size.width;
+                uint64_t dy = size.height > (uint32_t)want_h ? size.height - want_h : want_h - size.height;
+                uint32_t hz = modes[m].parameters.refreshRate;
+                uint64_t score = ((dx + dy) << 32) + (hz > 60000 ? hz - 60000 : 60000 - hz);
+                VkDisplayPlaneAlphaFlagBitsKHR alpha = 0;
+                const VkDisplayPlaneAlphaFlagBitsKHR options[] = {VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+                    VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR, VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_PREMULTIPLIED_BIT_KHR,
+                    VK_DISPLAY_PLANE_ALPHA_PER_PIXEL_BIT_KHR};
+                for (unsigned a = 0; a < sizeof options / sizeof *options; a++)
+                    if (cap.supportedAlpha & options[a]) { alpha = options[a]; break; }
+                if (!alpha || (choice->found && score >= choice->score)) continue;
+                *choice = (DisplayChoice){.found = 1, .score = score, .refresh = hz,
+                    .surface = {.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR,
+                        .displayMode = modes[m].displayMode, .planeIndex = p,
+                        .planeStackIndex = planes[p].currentStackIndex,
+                        .transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+                        .globalAlpha = 1, .alphaMode = alpha, .imageExtent = size}};
+            }
+        }
+        free(modes);
+    }
+    free(planes); free(displays); return ok && choice->found;
+}
+int gfx_window_vk_extensions(const char **out, int max) {
+    if (max < 2) return 0;
+    out[0] = VK_KHR_SURFACE_EXTENSION_NAME; out[1] = VK_KHR_DISPLAY_EXTENSION_NAME; return 2;
+}
+int gfx_window_vk_presentable(VkInstance instance, VkPhysicalDevice pd, uint32_t family) {
+    DisplayChoice choice = {0}; VkSurfaceKHR surface = VK_NULL_HANDLE;
+    if (!choose_display(pd, &choice) || vkCreateDisplayPlaneSurfaceKHR(instance, &choice.surface, NULL, &surface) != VK_SUCCESS) return 0;
+    VkBool32 supported = VK_FALSE;
+    VkResult result = vkGetPhysicalDeviceSurfaceSupportKHR(pd, family, surface, &supported);
+    vkDestroySurfaceKHR(instance, surface, NULL);
+    return result == VK_SUCCESS && supported;
+}
+VkSurfaceKHR wsys_surface(VkInstance instance) {
+    VkCtx *ctx = vk_ctx(); DisplayChoice choice = {0}; VkSurfaceKHR surface = VK_NULL_HANDLE;
+    if (!ctx || ctx->instance != instance || !choose_display(ctx->phys, &choice)) return VK_NULL_HANDLE;
+    VkResult result = vkCreateDisplayPlaneSurfaceKHR(instance, &choice.surface, NULL, &surface);
+    if (result != VK_SUCCESS) { rt_log("gfx: PS5 display surface failed (%d)", result); return VK_NULL_HANDLE; }
+    __atomic_store_n(&display_width, choice.surface.imageExtent.width, __ATOMIC_RELEASE);
+    __atomic_store_n(&display_height, choice.surface.imageExtent.height, __ATOMIC_RELEASE);
+    gfx_window_set_refresh(choice.refresh / 1000.0);
+    rt_log("gfx: PS5 native display %ux%u at %.3f Hz", choice.surface.imageExtent.width,
+           choice.surface.imageExtent.height, choice.refresh / 1000.0);
+    return surface;
+}
+int wsys_open(void) { return 1; } // VK_KHR_display has no separate OS window.
+int gfx_window_monitor_size(int *w, int *h) {
+    uint32_t width = __atomic_load_n(&display_width, __ATOMIC_ACQUIRE);
+    uint32_t height = __atomic_load_n(&display_height, __ATOMIC_ACQUIRE);
+    if (!width || !height) return 0;
+    *w = (int)width; *h = (int)height; return 1;
+}
+void wsys_client_size(int *w, int *h) { if (!gfx_window_monitor_size(w, h)) *w = *h = 0; }
