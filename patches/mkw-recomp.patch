diff --git a/runtime/ui/menu/menu_boot.cpp b/runtime/ui/menu/menu_boot.cpp
new file mode 100644
index 0000000..8296852
--- /dev/null
+++ b/runtime/ui/menu/menu_boot.cpp
@@ -0,0 +1,323 @@
+// Startup screen drawn by the existing ImGui/Vulkan present path. SPDX-License-Identifier: MIT
+//
+// With /app0/boot-splash.png (the game's own title picture, put on the console by the player: it is not part of the build
+// or of the repository) the screen is that picture with a real loading bar in its slot. Without the file: the black text
+// console below. The bar is made of measured work, not of time: bytes read and decoded, guest memory backed, and the
+// textures the game has created, each against the totals of a complete load (the values below were measured on the
+// console, and the file profile/boot-totals.txt written after every complete load replaces them). The picture stays over
+// the game, which starts rendering behind it, until its textures are in.
+#include "menu_boot.h"
+#include "imgui.h"
+#include <float.h>
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+extern "C" {
+#include "cfg.h"
+#include "host.h"
+#include "platform/platform.h"
+}
+#ifdef __PROSPERO__
+#define STB_IMAGE_IMPLEMENTATION
+#define STBI_NO_STDIO
+#define STBI_NO_GIF
+#define STBI_NO_BMP
+#define STBI_NO_PSD
+#define STBI_NO_TGA
+#define STBI_NO_PIC
+#include "stb_image.h"
+#endif
+
+static void bar(char *out, size_t cap, uint64_t done, uint64_t total) {
+    int pct = total ? (int)(done >= total ? 100 : done * 100 / total) : 0;
+    int fill = pct * 30 / 100;
+    char b[32];
+    for (int i = 0; i < 30; i++) b[i] = i < fill ? '#' : '.';
+    b[30] = 0;
+    snprintf(out, cap, "[%s] %3d%%", b, pct);
+}
+
+static void draw_text_console(float w, float h, float s, const BootProgress *p, uint64_t now) {
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(w, h), IM_COL32(0, 0, 0, 255));
+    ImFont *font = ImGui::GetFont();
+    const float size = 19 * s, step = 24 * s, x = 28 * s;
+    const ImU32 green = IM_COL32(110, 230, 120, 255), grey = IM_COL32(190, 190, 190, 255), amber = IM_COL32(237, 194, 117, 255);
+    float y = 20 * s;
+    auto text = [&](ImU32 c, const char *str) { dl->AddText(font, size, ImVec2(x, y), c, str); y += step; };
+    char line[420];
+    uint64_t elapsed = now > p->started_ns ? (now - p->started_ns) / 1000000000ull : 0;
+    uint64_t idle = now > p->last_activity_ns ? (now - p->last_activity_ns) / 1000000000ull : 0;
+    text(green, "MKW-PS5 recompilado - arranque");
+    snprintf(line, sizeof line, "t+%llu:%02llu   leido %.1f MB   descomprimido %.1f MB   decodificadores activos %u",
+             (unsigned long long)(elapsed / 60), (unsigned long long)(elapsed % 60), p->read_bytes / 1000000.0,
+             p->decoded_bytes / 1000000.0, p->active_decoders);
+    text(grey, line);
+    y += step * 0.5f;
+    BootConsole con;
+    if (boot_progress_console(&con)) {
+        // The two live lines sit at the bottom; the finished steps fill the space above, newest last.
+        float live_y = h - 4 * step - 20 * s;
+        int fit = (int)((live_y - y) / step);
+        int first = con.nlines > fit ? con.nlines - fit : 0;
+        for (int i = first; i < con.nlines; i++) text(strncmp(con.lines[i], "[   OK   ]", 10) ? grey : green, con.lines[i]);
+        y = live_y;
+        char b[48];
+        if (con.unpack_total) {
+            bar(b, sizeof b, con.unpack_done, con.unpack_total);
+            snprintf(line, sizeof line, "descomprimiendo %s", con.unpack_file);
+            text(IM_COL32(242, 246, 250, 255), line);
+            snprintf(line, sizeof line, "  %s   %.1f / %.1f MiB", b, con.unpack_done / 1048576.0, con.unpack_total / 1048576.0);
+            text(green, line);
+        } else {
+            y += 2 * step;
+        }
+        if (con.file[0]) {
+            bar(b, sizeof b, con.file_done, con.file_total);
+            snprintf(line, sizeof line, "leyendo %s", con.file);
+            text(IM_COL32(242, 246, 250, 255), line);
+            snprintf(line, sizeof line, "  %s   %.2f / %.2f MiB", b, con.file_done / 1048576.0, con.file_total / 1048576.0);
+            text(green, line);
+        }
+    }
+    if (idle >= 15) {
+        snprintf(line, sizeof line, "sin actividad de recursos desde hace %llu s (el juego espera otra cosa)", (unsigned long long)idle);
+        dl->AddText(font, size, ImVec2(x, h - step - 6 * s), amber, line);
+    }
+}
+
+#ifdef __PROSPERO__
+// ---- the picture: decoded once, copied into a custom rectangle of the font atlas (no Vulkan code of our own)
+static unsigned char *g_pix;
+static int g_pw, g_ph, g_rect = -1;
+static float g_u0, g_v0, g_u1, g_v1;
+static int g_tried;
+static float g_sx0 = 304.0f / 1024, g_sx1 = 743.0f / 1024, g_sy0 = 512.0f / 576, g_sy1 = 547.0f / 576;   // the slot, as fractions
+
+// Area-average reduction: a picture wider than the display would otherwise cost a 4096-wide atlas (32 MiB of GPU memory).
+static void shrink_to_width(int max_w) {
+    if (g_pw <= max_w) return;
+    int nw = max_w, nh = (int)((int64_t)g_ph * nw / g_pw);
+    unsigned char *out = (unsigned char *)malloc((size_t)nw * (size_t)nh * 4);
+    if (!out) return;
+    for (int y = 0; y < nh; y++) {
+        int sy0 = (int)((int64_t)y * g_ph / nh), sy1 = (int)((int64_t)(y + 1) * g_ph / nh);
+        if (sy1 <= sy0) sy1 = sy0 + 1;
+        for (int x = 0; x < nw; x++) {
+            int sx0 = (int)((int64_t)x * g_pw / nw), sx1 = (int)((int64_t)(x + 1) * g_pw / nw);
+            if (sx1 <= sx0) sx1 = sx0 + 1;
+            unsigned long sum[4] = {0, 0, 0, 0};
+            for (int yy = sy0; yy < sy1; yy++)
+                for (int xx = sx0; xx < sx1; xx++) {
+                    const unsigned char *q = g_pix + ((size_t)yy * (size_t)g_pw + (size_t)xx) * 4;
+                    sum[0] += q[0], sum[1] += q[1], sum[2] += q[2], sum[3] += q[3];
+                }
+            unsigned long n = (unsigned long)(sy1 - sy0) * (unsigned long)(sx1 - sx0);
+            unsigned char *d = out + ((size_t)y * (size_t)nw + (size_t)x) * 4;
+            for (int c = 0; c < 4; c++) d[c] = (unsigned char)(sum[c] / n);
+        }
+    }
+    stbi_image_free(g_pix);
+    g_pix = out;
+    g_pw = nw, g_ph = nh;
+}
+
+// The loading bar's slot is the dark brown capsule near the bottom of the picture: found by colour, so any picture of the
+// game's title screen works at any size. Falls back to the measured fractions of the 1024x576 original.
+static void find_slot(void) {
+    auto brown = [&](int x, int y) {
+        const unsigned char *q = g_pix + ((size_t)y * (size_t)g_pw + (size_t)x) * 4;
+        return q[0] > 70 && q[0] < 135 && q[1] > 55 && q[1] < 110 && q[2] > 40 && q[2] < 90 && q[0] > q[1] && q[1] > q[2];
+    };
+    int rows = 0, top = -1, bottom = -1, x0 = g_pw, x1 = -1;
+    for (int y = (int)(g_ph * 0.85f); y < g_ph; y++) {
+        int count = 0, lo = g_pw, hi = -1;
+        for (int x = (int)(g_pw * 0.2f); x < (int)(g_pw * 0.8f); x++)
+            if (brown(x, y)) count++, lo = lo < x ? lo : x, hi = hi > x ? hi : x;
+        if (count > g_pw * 0.3f) {
+            if (top < 0) top = y;
+            bottom = y, rows++;
+            if (lo < x0) x0 = lo;
+            if (hi > x1) x1 = hi;
+        }
+    }
+    if (rows < g_ph / 40 || x1 - x0 < g_pw / 4) {
+        rt_log("boot: slot of the loading bar not found in the picture: default position");
+        return;
+    }
+    // the capsule's dark fill runs a little inside its rim: pull each side in by 1 % of the slot
+    float inset = (float)(x1 - x0) * 0.008f;
+    g_sx0 = ((float)x0 + inset) / g_pw, g_sx1 = ((float)x1 - inset) / g_pw;
+    g_sy0 = (float)top / g_ph, g_sy1 = (float)(bottom + 1) / g_ph;
+    rt_log("boot: loading bar slot at x %.3f..%.3f, y %.3f..%.3f of the picture", g_sx0, g_sx1, g_sy0, g_sy1);
+}
+
+static void splash_load(void) {
+    if (g_tried) return;
+    g_tried = 1;
+    uint64_t n = 0;
+    uint8_t *file = plat_file_read("/app0/boot-splash.png", &n);
+    if (!file) file = plat_file_read("/app0/boot-splash.jpg", &n);
+    if (!file) { rt_log("boot: no /app0/boot-splash.png: text startup screen"); return; }
+    int comp;
+    g_pix = stbi_load_from_memory(file, (int)n, &g_pw, &g_ph, &comp, 4);
+    free(file);
+    if (!g_pix || g_pw < 16 || g_ph < 16 || g_pw > 4096 || g_ph > 4096) {
+        rt_log("boot: boot-splash.png could not be decoded: text startup screen");
+        if (g_pix) stbi_image_free(g_pix);
+        g_pix = NULL;
+        return;
+    }
+    shrink_to_width(1920);
+    find_slot();
+    rt_log("boot: startup picture %dx%d", g_pw, g_ph);
+}
+
+void menu_boot_atlas(ImFontAtlas *fa) {
+    splash_load();
+    g_rect = -1;
+    if (!g_pix) return;
+    fa->TexDesiredWidth = g_pw + 8 <= 1024 ? 1024 : g_pw + 8 <= 2048 ? 2048 : 4096;   // wide enough for the picture plus its padding
+    g_rect = fa->AddCustomRectRegular(g_pw, g_ph);
+    unsigned char *px = NULL;
+    int tw = 0, th = 0;
+    fa->GetTexDataAsRGBA32(&px, &tw, &th);   // builds the atlas: the rectangle gets its place
+    const ImFontAtlasCustomRect *r = fa->GetCustomRectByIndex(g_rect);
+    if (!px || !r || !r->IsPacked()) { g_rect = -1; return; }
+    for (int y = 0; y < g_ph; y++) memcpy(px + ((size_t)(r->Y + y) * (size_t)tw + (size_t)r->X) * 4, g_pix + (size_t)y * (size_t)g_pw * 4, (size_t)g_pw * 4);
+    g_u0 = (float)r->X / tw, g_v0 = (float)r->Y / th, g_u1 = (float)(r->X + g_pw) / tw, g_v1 = (float)(r->Y + g_ph) / th;
+}
+
+// ---- the bar: measured work against the totals of a complete load, in two parts by time
+// Before the game's first image: bytes read and decoded, and guest memory backed, each against what that start-up took
+// (measured on the console). After it: the textures the game creates, through the curve of time against textures measured
+// in a complete load (they are not made at an even pace: ~13000 in the first 3 minutes, 175000 in the next 5). The share
+// of each part is its measured duration. After every complete load the file profile/boot-totals.txt keeps what that load
+// measured, and the next start uses it.
+struct Totals { double read, decoded, backed_mib, images, pre_s, tex_s; };
+static Totals g_tot = {165.8e6, 637.3e6, 2160.0, 190000.0, 70.0, 533.0};
+static const double kCurve[][2] = {   // textures created / 188160, fraction of the texture phase's time (MKWBOOT-035)
+    {0, 0}, {256, 15}, {1536, 50}, {2048, 71}, {4864, 91}, {8448, 120}, {11008, 150}, {13056, 181}, {48128, 212},
+    {65536, 242}, {84736, 272}, {89344, 303}, {94208, 334}, {103168, 364}, {116224, 395}, {136704, 420}, {147968, 451},
+    {157184, 482}, {172544, 513}, {188160, 533}};
+static int g_tot_loaded, g_snap;
+static double g_shown;          // never goes back
+static uint64_t g_fade_ns;
+static double g_read1, g_dec1, g_backed1;   // what the start-up had read, decoded and backed at the first image
+static char g_totals_path[1200];
+
+static void totals_load(void) {
+    if (g_tot_loaded) return;
+    g_tot_loaded = 1;
+    snprintf(g_totals_path, sizeof g_totals_path, "%s/boot-totals.txt", rt_config()->profile);
+    uint64_t n = 0;
+    uint8_t *f = plat_file_read(g_totals_path, &n);
+    if (!f) return;
+    Totals t;
+    if (sscanf((const char *)f, "%lf %lf %lf %lf %lf %lf", &t.read, &t.decoded, &t.backed_mib, &t.images, &t.pre_s, &t.tex_s) == 6 &&
+        t.read > 1e6 && t.read < 1e9 && t.decoded > 1e6 && t.decoded < 4e9 && t.backed_mib > 100 && t.images >= 0 && t.pre_s > 5 &&
+        t.pre_s < 900 && t.tex_s > 5 && t.tex_s < 3600)
+        g_tot = t;
+    free(f);
+}
+
+static void totals_save(const BootProgress *p, uint64_t now) {
+    char text[200];
+    double pre = p->first_image_ns > p->started_ns ? (p->first_image_ns - p->started_ns) / 1e9 : g_tot.pre_s;
+    double tex = p->first_image_ns && now > p->first_image_ns ? (now - p->first_image_ns) / 1e9 : g_tot.tex_s;
+    int len = snprintf(text, sizeof text, "%.0f %.0f %.0f %.0f %.0f %.0f\n", g_read1, g_dec1, g_backed1, (double)p->images, pre, tex);
+    if (len > 0 && g_read1 > 1e6 && plat_file_write_atomic(g_totals_path, text, (size_t)len))
+        rt_log("boot: load complete; totals saved for the next start: %s", text);
+}
+
+// Fraction of the texture phase's time at which the game has created this many textures.
+static double curve(double created) {
+    const size_t n = sizeof kCurve / sizeof *kCurve;
+    double x = created * (188160.0 / g_tot.images);
+    if (x >= kCurve[n - 1][0]) return 1.0;
+    for (size_t i = 1; i < n; i++)
+        if (x <= kCurve[i][0]) {
+            double t = (x - kCurve[i - 1][0]) / (kCurve[i][0] - kCurve[i - 1][0]);
+            return (kCurve[i - 1][1] + t * (kCurve[i][1] - kCurve[i - 1][1])) / kCurve[n - 1][1];
+        }
+    return 1.0;
+}
+
+static double fraction(const BootProgress *p, double *backed_mib) {
+    float used = 0, total = 0, guest = 0;
+    plat_mem_info(&used, &total, &guest);
+    *backed_mib = guest;
+    if (!p->first_image) {
+        double io = fmin(1.0, 0.5 * (p->read_bytes / g_tot.read + p->decoded_bytes / g_tot.decoded));
+        double mem = fmin(1.0, guest / g_tot.backed_mib);
+        return (0.4 * io + 0.6 * mem) * 0.99;   // the whole bar is the start-up now (reads, decoding, memory)
+    }
+    return 1.0;   // MKWBOOT-046: the first image of the game is the end of the load: the textures that come after it showed nothing more
+}
+
+// The picture over the whole screen (fitted, black bars), its slot filled to the measured fraction.
+static int draw_splash(float w, float h, const BootProgress *p, uint64_t now) {
+    if (g_rect < 0) return 0;
+    totals_load();
+    double backed = 0;
+    if (p->first_image && !g_snap) {   // what the start-up itself came to: the totals of the next start
+        g_snap = 1;
+        g_read1 = (double)p->read_bytes, g_dec1 = (double)p->decoded_bytes;
+        float u, t, g;
+        plat_mem_info(&u, &t, &g);
+        g_backed1 = g;
+    }
+    double f = fraction(p, &backed);
+    if (f > g_shown) g_shown = f;
+    // The load is over when the textures of a complete load exist, or the count stopped for a long while after the
+    // game's first image (a load that never completes must not hide the game forever).
+    // The picture goes when the game's first image is up (MKWBOOT-046). MKWBOOT-037 held it until every texture existed (6-9
+    // minutes) and the game looked the same afterwards as it did right after its first image: the wait gave nothing.
+    bool done = p->first_image && now - p->first_image_ns > 1500000000ull;
+    if (done && !g_fade_ns) {
+        g_fade_ns = now;
+        totals_save(p, now);
+        g_shown = 1.0;
+    }
+    float alpha = 1.0f;
+    if (g_fade_ns) {
+        alpha = 1.0f - (float)((now - g_fade_ns) / 1e9 / 0.6);
+        if (alpha <= 0.0f) { boot_progress_finish(); return 1; }
+    }
+    ImDrawList *dl = ImGui::GetForegroundDrawList();
+    const ImU32 white = IM_COL32(255, 255, 255, (int)(255 * alpha));
+    dl->AddRectFilled(ImVec2(0, 0), ImVec2(w, h), IM_COL32(0, 0, 0, (int)(255 * alpha)));
+    float k = fminf(w / (float)g_pw, h / (float)g_ph), iw = g_pw * k, ih = g_ph * k, x0 = (w - iw) * 0.5f, y0 = (h - ih) * 0.5f;
+    dl->AddImage(ImGui::GetIO().Fonts->TexID, ImVec2(x0, y0), ImVec2(x0 + iw, y0 + ih), ImVec2(g_u0, g_v0), ImVec2(g_u1, g_v1), white);
+    // the slot of the picture (measured on the 1024x576 original): inner capsule x 304..743, y 512..547
+    float sx0 = x0 + iw * g_sx0, sx1 = x0 + iw * g_sx1;
+    float sy0 = y0 + ih * g_sy0, sy1 = y0 + ih * g_sy1, r = (sy1 - sy0) * 0.5f;
+    float fx = sx0 + (sx1 - sx0) * (float)g_shown;
+    if (fx - sx0 > 2 * r) {
+        dl->AddRectFilled(ImVec2(sx0, sy0), ImVec2(fx, sy1), IM_COL32(246, 190, 40, (int)(255 * alpha)), r);
+        dl->AddRectFilled(ImVec2(sx0 + r * 0.5f, sy0 + r * 0.25f), ImVec2(fx - r * 0.5f, sy0 + r * 0.75f),
+                          IM_COL32(255, 232, 130, (int)(150 * alpha)), r * 0.25f);
+    } else if (fx > sx0 + 1) {
+        dl->AddRectFilled(ImVec2(sx0, sy0), ImVec2(sx0 + 2 * r, sy1), IM_COL32(246, 190, 40, (int)(255 * alpha)), r);
+    }
+    char pct[16];
+    snprintf(pct, sizeof pct, "%d %%", (int)(g_shown * 100.0 + 0.5));
+    ImFont *font = ImGui::GetFont();
+    float size = (sy1 - sy0) * 0.62f;
+    ImVec2 ts = font->CalcTextSizeA(size, FLT_MAX, 0.0f, pct), at((sx0 + sx1 - ts.x) * 0.5f, (sy0 + sy1 - ts.y) * 0.5f);
+    const ImU32 dark = IM_COL32(40, 25, 10, (int)(230 * alpha));
+    for (int dx = -1; dx <= 1; dx++)
+        for (int dy = -1; dy <= 1; dy++)
+            if (dx || dy) dl->AddText(font, size, ImVec2(at.x + dx * 1.5f, at.y + dy * 1.5f), dark, pct);
+    dl->AddText(font, size, at, white, pct);
+    return 1;
+}
+#else
+void menu_boot_atlas(ImFontAtlas *) {}
+static int draw_splash(float, float, const BootProgress *, uint64_t) { return 0; }
+#endif
+
+void menu_boot_draw(float w, float h, float s, const BootProgress *p, uint64_t now) {
+    if (!draw_splash(w, h, p, now)) draw_text_console(w, h, s, p, now);
+}
