+                demand_include(), str(c), str(ROOT / 'runtime/platform/ps5_sys.c'),
+                '-Wl,--gc-sections', '-Wl,-z,now', '-Wl,--defsym=__mkw_image_end=_end',
+                '-o', str(exe)], check=True)
+            subprocess.run([str(exe)], check=True)
