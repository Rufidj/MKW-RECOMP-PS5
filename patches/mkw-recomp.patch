+"""Startup snapshots are bounded, nonblocking and resume owners before logging."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+ROOT = Path(__file__).resolve().parents[1]
+class StartupDiagTest(unittest.TestCase):
+    def test_lock_and_sampling_protocol(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'snapshot.c'
+            c.write_text(r'''
+#include "kernel_int.h"
+#include "kernel_startup.h"
+#include <assert.h>
+#include <stdarg.h>
+unsigned rt_trace;
+uint64_t kern_now_ns(void) { return 0; }
+PlatMutex G;
+RtThread *g_all;
+static int busy, owned, paused, stops, resumes;
+static char output[65536]; static size_t used;
+int plat_mutex_trylock(PlatMutex *m) { assert(m == &G); if (busy) return 0; assert(!owned); owned = 1; return 1; }
+void plat_mutex_unlock(PlatMutex *m) { assert(m == &G && owned && !paused); owned = 0; }
+int plat_intr_stop(PlatIntr *p, uint64_t *rip, uint64_t *rsp) {
+    assert(owned && !paused); stops++;
+    if (p == (PlatIntr *)2) return 0;
+    assert(p == (PlatIntr *)1); paused = 1; *rip = 0x1234; *rsp = 0x5678; return 1;
+}
+int plat_intr_resume(PlatIntr *p, uint64_t to) { assert(owned && paused && p == (PlatIntr *)1 && !to); paused = 0; resumes++; return 1; }
+void rt_log(const char *fmt, ...) {
+    assert(!owned && !paused);
+    va_list ap; va_start(ap, fmt); int n = vsnprintf(output + used, sizeof output - used, fmt, ap); va_end(ap);
+    assert(n >= 0 && used + n + 1 < sizeof output); used += n; output[used++] = '\n'; output[used] = 0;
+}
+const char *hostfn_name(uint64_t a) { (void)a; return "host-test"; }
+const char *ldr_describe(uint64_t a, char *out, int n) { snprintf(out, n, "guest-%llx", (unsigned long long)a); return out; }
+int plat_mem_readable(uint64_t addr, uint64_t n) { (void)addr; (void)n; return 0; }   // no guest stack in the fixture
+int plat_module_of(uintptr_t p, char *out, size_t n, uintptr_t *base) { assert(!owned && !paused); (void)p; *base = 0x1000; snprintf(out, n, "native-test"); return 1; }
+int main(void) {
+    busy = 1; kern_startup_snapshot(); assert(strstr(output, "lock busy") && !stops);
+    busy = 0; output[0] = 0; used = 0;
+    Cpu cpu = {0}; cpu.pc = 0x123456; cpu.x[30] = 0x654321;
+    RtThread rows[140] = {0};
+    for (unsigned i = 0; i < 140; i++) {
+        rows[i].handle = 0x1001 + i; rows[i].started = 1; rows[i].cur_core = -1;
+        rows[i].wkind = W_SYNC; rows[i].cur = &cpu; rows[i].all = i + 1 < 140 ? &rows[i + 1] : 0;
+        rows[i].hthr = (PlatIntr *)3; // Waiting threads must never be suspended.
+    }
+    rows[0].cur_core = 0; rows[0].hthr = (PlatIntr *)1;
+    rows[1].cur_core = 1; rows[1].hthr = (PlatIntr *)2;
+    g_all = rows; kern_startup_snapshot();
+    assert(stops == 2 && resumes == 1 && !paused && !owned);
+    assert(strstr(output, "140 guest threads (128 shown)") && strstr(output, "native-test+0x234"));
+    assert(strstr(output, "host-test") && cpu.pc == 0x123456 && cpu.x[30] == 0x654321);
+    g_all = 0; used = 0; output[0] = 0; kern_startup_snapshot();
+    assert(strstr(output, "0 guest threads (0 shown)"));
+}
+''')
+            includes = {ROOT / 'runtime'} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')}
+            exe = d / 'snapshot'
+            subprocess.run(['clang', '-O2', '-march=x86-64-v3', '-ffunction-sections', '-fdata-sections',
+                            '-Wno-bitwise-instead-of-logical', *['-I' + str(p) for p in sorted(includes)],
+                            str(c), str(ROOT / 'runtime/core/kernel/kernel_diag.c'), '-Wl,--gc-sections', '-o', str(exe)], check=True)
+            subprocess.run([str(exe)], check=True)
+if __name__ == '__main__': unittest.main()
