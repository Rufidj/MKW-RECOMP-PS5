+"""Compare SHA with hashlib in normal and PS5 declaration modes at padding boundaries.
+
+Usage: python3 tests/test_ps5_sha256.py. Defining __PROSPERO__ on the host tests
+the new CPUID dispatch and SHA declarations; cross-compilation checks its ABI.
+"""
+import ctypes
+import hashlib
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class Ps5ShaChecks(unittest.TestCase):
+    def test_sha_against_hashlib(self):
+        cc = shutil.which("clang")
+        if not cc:
+            self.skipTest("clang is needed")
+        with tempfile.TemporaryDirectory() as tmp:
+            for native_dispatch in (False, True):
+                library = Path(tmp) / f"sha-{native_dispatch}.so"
+                flags = ["-D__PROSPERO__"] if native_dispatch else []
+                subprocess.run([cc, "-shared", "-fPIC", "-O2", "-Wall", "-Wextra", "-Werror", *flags,
+                                str(ROOT / "runtime/core/base/sha256.c"), "-o", str(library)], check=True, timeout=30)
+                lib = ctypes.CDLL(str(library))
+                lib.sha256.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_void_p]
+                lib.sha256.restype = None
+                for size in (0, 1, 7, 55, 56, 63, 64, 65, 119, 120, 121, 1024, 123456):
+                    data = bytes((i * 19 + 7) % 256 for i in range(size))
+                    source = ctypes.create_string_buffer(data)
+                    result = (ctypes.c_ubyte * 32)()
+                    lib.sha256(source, size, result)
+                    self.assertEqual(bytes(result), hashlib.sha256(data).digest(), (native_dispatch, size))
+
+
+if __name__ == "__main__":
+    unittest.main()
