+    if (!c->x[0]) return;
+    char out[16] = {0};
+    for (unsigned i = 0; i < 15 && version[i]; i++) out[i] = version[i];
+#ifdef MKW_CHECKED_MEMORY
+    rt_checked_copy_out(c->x[0], out, sizeof out);
+#else
+    memcpy((void *)(uintptr_t)c->x[0], out, sizeof out);
+#endif
+}
