+"""Module lookup must not read an execute-only ELF header."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_include
+ROOT = Path(__file__).resolve().parents[1]
+class Ps5ModuleTest(unittest.TestCase):
+    def test_unreadable_header(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'module.c'
+            c.write_text(r'''
+#include "platform.h"
+#include <assert.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+extern char __ehdr_start[], __mkw_image_end[];
+int main(void) {
+    uintptr_t start = (uintptr_t)__ehdr_start, end = (uintptr_t)__mkw_image_end;
+    long page = sysconf(_SC_PAGESIZE); assert(page > 0);
+    // Stronger than execute-only: even the ELF header itself is inaccessible.
+    assert(!mprotect((void *)start, (size_t)page, PROT_NONE));
+    char name[16] = {0}; uintptr_t base = 0;
+    assert(plat_module_of((uintptr_t)plat_module_of, name, sizeof name, &base));
+    assert(base == start && !strcmp(name, "mkw"));
+    assert(plat_module_of(start, name, 0, 0));
+    assert(!plat_module_of(start - 1, name, sizeof name, &base));
+    assert(!plat_module_of(end, name, sizeof name, &base));
+    assert(!plat_module_of(UINTPTR_MAX, name, sizeof name, &base));
+    assert(!mprotect((void *)start, (size_t)page, PROT_READ));
+}
+''')
+            exe = d / 'module'
+            subprocess.run(['clang', '-O2', '-DMKW_PS5_HOST_CHECK', '-D_GNU_SOURCE',
