+// Opt-in scalar access experiment using original synthetic AOT routines. SPDX-License-Identifier: MIT
+// Thread-scoped fault recovery exercises individual regions and the shared
+// mapped-region registry. This is not the complete game's memory backend.
+#ifndef MKW_CHECKED_MEMORY
+#define MKW_CHECKED_MEMORY
+#endif
+#include "cpu/cpu.h"
+#include "ps5_cpu_probe.h"
+#include "ps5_guest_memory.h"
+#include "sdk/ov/display_version.h"
+#include <ps5platform/checked_region.h>
+#include <setjmp.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <pthread.h>
+#include "ps5_aot_fixture.h"
+
+typedef struct {
+    struct ps5_checked_region *region;
+    uint64_t base, bytes;
+    Ps5GuestSpace *space;
+    jmp_buf recovery;
+    int armed;
+} ScalarProbe;
+static _Thread_local ScalarProbe *current;
+static _Noreturn void access_fault(void) {
+    if (current && current->armed) longjmp(current->recovery, 1);
+    __builtin_trap(); // A diagnostic hook used outside its scoped invocation is a programming error.
+}
+static ScalarProbe *access_region(uint64_t address, unsigned bytes) {
+    ScalarProbe *p = current;
+    if (!p || !p->armed || (bytes != 1 && bytes != 2 && bytes != 4 && bytes != 8 && bytes != 16) ||
+        (!p->space && (address < p->base || address - p->base > p->bytes || bytes > p->bytes - (address - p->base))))
+        access_fault();
+    return p;
+}
+uint64_t rt_checked_scalar_load(uint64_t address, unsigned bytes) {
+    ScalarProbe *p = access_region(address, bytes);
+    uint64_t value = 0;
+    if (!(p->space ? ps5_guest_read(p->space, address, &value, bytes) : ps5_checked_read(p->region, (size_t)(address - p->base), &value, bytes))) access_fault();
+    return value;
+}
+void rt_checked_scalar_store(uint64_t address, uint64_t value, unsigned bytes) {
+    ScalarProbe *p = access_region(address, bytes);
+    if (!(p->space ? ps5_guest_write(p->space, address, &value, bytes) : ps5_checked_write(p->region, (size_t)(address - p->base), &value, bytes))) access_fault();
+}
+u128 rt_checked_vector_load(uint64_t address) {
+    ScalarProbe *p = access_region(address, 16); u128 value;
+    if (!(p->space ? ps5_guest_read(p->space, address, &value, 16) : ps5_checked_read(p->region, (size_t)(address - p->base), &value, 16))) access_fault();
+    return value;
+}
+void rt_checked_vector_store(uint64_t address, u128 value) {
+    ScalarProbe *p = access_region(address, 16);
+    if (!(p->space ? ps5_guest_write(p->space, address, &value, 16) : ps5_checked_write(p->region, (size_t)(address - p->base), &value, 16))) access_fault();
+}
+// MKWBOOT-064: the per-size entries of the generated code (cpu.h), here plain forwards to the scoped probe above.
+#define PROBE_ENTRY(N, T)                                                                              \
+    T rt_ld##N(uint64_t a) { return (T)rt_checked_scalar_load(a, N / 8); }                             \
+    void rt_st##N(uint64_t a, T v) { rt_checked_scalar_store(a, v, N / 8); }
+PROBE_ENTRY(8, uint8_t)
+PROBE_ENTRY(16, uint16_t)
+PROBE_ENTRY(32, uint32_t)
+PROBE_ENTRY(64, uint64_t)
+u128 rt_ld128(uint64_t a) { return rt_checked_vector_load(a); }
+void rt_st128(uint64_t a, u128 v) { rt_checked_vector_store(a, v); }
+u128 rt_checked_atomic_load(uint64_t address, unsigned bytes) {
+    ScalarProbe *p = access_region(address, bytes); u128 value = 0;
+    if (!(p->space ? ps5_guest_atomic_load(p->space, address, &value, bytes) : ps5_checked_atomic_load(p->region, (size_t)(address - p->base), &value, bytes))) access_fault();
+    return value;
+}
+void rt_checked_atomic_store(uint64_t address, u128 value, unsigned bytes) {
+    ScalarProbe *p = access_region(address, bytes);
+    if (!(p->space ? ps5_guest_atomic_store(p->space, address, &value, bytes) : ps5_checked_atomic_store(p->region, (size_t)(address - p->base), &value, bytes))) access_fault();
+}
+int rt_checked_atomic_cas(uint64_t address, void *expected, u128 value, unsigned bytes) {
+    ScalarProbe *p = access_region(address, bytes); int exchanged;
+    if (!(p->space ? ps5_guest_atomic_cas(p->space, address, expected, &value, bytes, &exchanged) : ps5_checked_atomic_cas(p->region, (size_t)(address - p->base), expected, &value, bytes, &exchanged))) access_fault();
+    return exchanged;
+}
+u128 rt_checked_atomic_rmw(uint64_t address, u128 value, unsigned bytes, unsigned op) {
+    (void)access_region(address, bytes);
+    if (op > 4) access_fault();
+    u128 mask = bytes == 16 ? ~(u128)0 : (((u128)1 << (8 * bytes)) - 1);
+    u128 old = rt_checked_atomic_load(address, bytes);
+    for (;;) {
+        u128 next = op == 0 ? value : op == 1 ? old + value : op == 2 ? old & value : op == 3 ? old ^ value : old | value;
+        u128 expected = old;
+        if (rt_checked_atomic_cas(address, &expected, next & mask, bytes)) return old;
+        old = expected;
+    }
+}
+static int invoke(ScalarProbe *p, GuestFn fn, Cpu *c) {
+    p->armed = 1;
+    if (setjmp(p->recovery)) { p->armed = 0; return 0; }
+    fn(c); p->armed = 0; return 1;
+}
+int ps5_cpu_run_checked(Ps5GuestSpace *space, GuestFn fn, Cpu *c) {
+    if (current || !space || !fn || !c) return 0;
+    ScalarProbe context = {.space = space};
+    current = &context;
+    unsigned fp = __builtin_ia32_stmxcsr();
+    rt_fpcr_sync(c);
+    int ok = invoke(&context, fn, c);
+    __builtin_ia32_ldmxcsr(fp);
+    current = NULL; return ok;
+}
+void rt_checked_copy_out(uint64_t address, const void *host, size_t bytes) {
+    ScalarProbe *p = current;
+    if (!p || !p->armed || !p->space || !ps5_guest_write(p->space, address, host, bytes)) access_fault();
+}
+static void display_version_service(Cpu *c) { rt_display_version(c, "1.0.0"); }
+#define REQUIRE(condition, message) do { if (!(condition)) { snprintf(detail, cap, "%s", message); goto done; } } while (0)
+int ps5_cpu_scalar_probe(char *detail, size_t cap) {
+    ScalarProbe probe = {.base = 0x7100000000ull, .bytes = 0x8000};
+    int ok = 0; unsigned cases = 0, faults = 0;
+    REQUIRE(!current, "Diagnostico AOT ya activo en este hilo");
+    REQUIRE(ps5_checked_create(probe.base, (size_t)probe.bytes, &probe.region), "No se reserva la region AOT");
+    current = &probe;
+    REQUIRE(ps5_checked_protect(probe.region, 0x1000, 0x1000, PS5_CHECKED_READ) &&
+            ps5_checked_protect(probe.region, 0x4000, 0x1000, PS5_CHECKED_NONE), "No se protegen las paginas AOT");
+    GuestFn functions[] = {ps5_aot_1, ps5_aot_2, ps5_aot_4, ps5_aot_8};
+    for (unsigned k = 0; k < 4; k++) {
+        unsigned width = 1u << k;
+        uint64_t mask = width == 8 ? UINT64_MAX : (1ull << (8 * width)) - 1;
+        for (unsigned i = 0; i < 64; i++) {
+            uint64_t a = (0xfedcba9876543210ull * (i + 1)) & mask;
+            uint64_t b = (0x123456789abcdef1ull * (i + 3)) & mask;
+            unsigned char input[16] = {0};
+            memcpy(input, &a, width); memcpy(input + width, &b, width);
+            REQUIRE(ps5_checked_write(probe.region, 0x2000, input, 2 * width), "No se prepara la entrada AOT");
+            Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[1] = probe.base + 0x3001; // unaligned output
+            REQUIRE(invoke(&probe, functions[k], &c), "Acceso AOT valido rechazado");
+            uint64_t actual = 0;
+            REQUIRE(ps5_checked_read(probe.region, 0x3001, &actual, width), "No se lee el resultado AOT");
+            REQUIRE(c.x[0] == a + b && actual == ((a + b) & mask), "Registros o memoria AOT no coinciden");
+            cases++;
+        }
+        uint64_t destinations[] = {probe.base + 0x1000, probe.base + 0x4000,
+                                   probe.base + 0x8000 - width + 1, UINT64_MAX};
+        for (unsigned j = 0; j < 4; j++) {
+            Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[1] = destinations[j];
+            REQUIRE(!invoke(&probe, functions[k], &c), "Escritura AOT sin permiso aceptada"); faults++;
+        }
+        if (width > 1) {
+            unsigned char before[16], after[16];
+            REQUIRE(ps5_checked_read(probe.region, 0xff8, before, 16), "No se lee la frontera AOT");
+            Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[1] = probe.base + 0x1000 - width + 1;
+            REQUIRE(!invoke(&probe, functions[k], &c), "Cruce AOT RW/RO aceptado"); faults++;
+            REQUIRE(ps5_checked_read(probe.region, 0xff8, after, 16) && !memcmp(before, after, 16),
+                    "Una escritura AOT rechazada altero datos");
+        }
+        Cpu c = {0}; c.x[0] = probe.base + 0x4000; c.x[1] = probe.base + 0x3001;
+        REQUIRE(!invoke(&probe, functions[k], &c), "Lectura AOT sin permiso aceptada"); faults++;
+    }
+    snprintf(detail, cap, "AOT sintetico: %u casos de 8/16/32/64 bits; %u rechazos; frontera RW/RO intacta", cases, faults);
+    ok = 1;
+done:
+    if (current == &probe) current = NULL;
+    if (probe.region) ps5_checked_destroy(probe.region);
+    return ok;
+}
+
+typedef struct { struct ps5_checked_region *region; uint64_t base; int ok; } AtomicWorker;
+static void *atomic_worker(void *arg) {
+    AtomicWorker *w = arg;
+    ScalarProbe p = {.region = w->region, .base = w->base, .bytes = 0x8000};
+    current = &p; w->ok = 1;
+    for (unsigned i = 0; i < 1000; i++) {
+        Cpu c = {0}; c.x[0] = w->base + 0x2000; c.x[2] = 1;
+        if (!invoke(&p, ps5_aot_add_8, &c)) { w->ok = 0; break; }
+    }
+    current = NULL; return NULL;
+}
+int ps5_cpu_atomic_simd_probe(char *detail, size_t cap) {
+    ScalarProbe probe = {.base = 0x7100000000ull, .bytes = 0x8000};
+    int ok = 0; unsigned vectors = 0, atomics = 0, faults = 0;
+    REQUIRE(!current, "Diagnostico AOT ya activo en este hilo");
+    REQUIRE(ps5_checked_create(probe.base, (size_t)probe.bytes, &probe.region), "No se reserva la region SIMD/atomicos");
+    current = &probe;
+    REQUIRE(ps5_checked_protect(probe.region, 0x1000, 0x1000, PS5_CHECKED_READ), "No se protege la region SIMD/atomicos");
+    for (unsigned i = 0; i < 64; i++) {
+        unsigned char input[16], output[16];
+        for (unsigned j = 0; j < 16; j++) input[j] = (unsigned char)(i * 13 + j * 19);
+        REQUIRE(ps5_checked_write(probe.region, 0x2003, input, 16), "No se prepara SIMD");
+        Cpu c = {0}; c.x[0] = probe.base + 0x2003; c.x[1] = probe.base + 0x3001;
+        REQUIRE(invoke(&probe, ps5_aot_vector, &c), "Acceso SIMD valido rechazado");
+        REQUIRE(ps5_checked_read(probe.region, 0x3001, output, 16), "No se lee SIMD");
+        for (unsigned j = 0; j < 16; j++) REQUIRE(output[j] == (unsigned char)(input[j] * 2), "Resultado SIMD incorrecto");
+        vectors++;
+    }
+    GuestFn cas[] = {ps5_aot_cas_1, ps5_aot_cas_2, ps5_aot_cas_4, ps5_aot_cas_8};
+    GuestFn lda[] = {ps5_aot_lda_1, ps5_aot_lda_2, ps5_aot_lda_4, ps5_aot_lda_8};
+    GuestFn stl[] = {ps5_aot_stl_1, ps5_aot_stl_2, ps5_aot_stl_4, ps5_aot_stl_8};
+#define OPS(name) {ps5_aot_##name##_1, ps5_aot_##name##_2, ps5_aot_##name##_4, ps5_aot_##name##_8}
+    GuestFn rmw[][4] = {OPS(add), OPS(and), OPS(xor), OPS(or), OPS(smax), OPS(smin), OPS(umax), OPS(umin), OPS(swap)};
+#undef OPS
+    for (unsigned k = 0; k < 4; k++) {
+        unsigned width = 1u << k;
+        uint64_t mask = width == 8 ? UINT64_MAX : (1ull << (8 * width)) - 1;
+        uint64_t sign = 1ull << (8 * width - 1);
+        for (unsigned i = 0; i < 16; i++) {
+            uint64_t a = (0xfedcba9876543210ull * (i + 1)) & mask;
+            uint64_t b = (0x123456789abcdef1ull * (i + 3)) & mask;
+            for (unsigned op = 0; op < 9; op++) {
+                REQUIRE(ps5_checked_write(probe.region, 0x2000, &a, width), "No se prepara RMW");
+                Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[2] = b;
+                REQUIRE(invoke(&probe, rmw[op][k], &c), "RMW valido rechazado");
+                uint64_t actual = 0, expected;
+                switch (op) {
+                case 0: expected = a + b; break;
+                case 1: expected = a & ~b; break; // LDCLR, not LDAND.
+                case 2: expected = a ^ b; break;
+                case 3: expected = a | b; break;
+                case 4: expected = (a ^ sign) > (b ^ sign) ? a : b; break;
+                case 5: expected = (a ^ sign) < (b ^ sign) ? a : b; break;
+                case 6: expected = a > b ? a : b; break;
+                case 7: expected = a < b ? a : b; break;
+                default: expected = b;
+                }
+                REQUIRE(ps5_checked_read(probe.region, 0x2000, &actual, width) && actual == (expected & mask) && c.x[3] == a,
+                        "Valor RMW o registro anterior incorrecto"); atomics++;
+            }
+            for (unsigned match = 0; match < 2; match++) {
+                REQUIRE(ps5_checked_write(probe.region, 0x2000, &a, width), "No se prepara CAS");
+                Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[2] = match ? a : (a ^ 1); c.x[3] = b;
+                REQUIRE(invoke(&probe, cas[k], &c), "CAS valido rechazado");
+                uint64_t actual = 0;
+                REQUIRE(ps5_checked_read(probe.region, 0x2000, &actual, width) && actual == (match ? b : a) && c.x[2] == a,
+                        "CAS no conserva el valor anterior o la comparacion"); atomics++;
+            }
+            Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[4] = b;
+            REQUIRE(invoke(&probe, stl[k], &c) && invoke(&probe, lda[k], &c) && c.x[2] == b,
+                    "Release/acquire incorrecto"); atomics += 2;
+        }
+        for (unsigned bad = 0; bad < 2; bad++) {
+            Cpu c = {0}; c.x[0] = bad ? UINT64_MAX : probe.base + 0x1000;
+            REQUIRE(!invoke(&probe, cas[k], &c), "CAS sin permiso aceptado"); faults++;
+        }
+    }
+    for (unsigned match = 0; match < 2; match++) {
+        uint64_t pair[2] = {0x123456789abcdef0ull, 0xfedcba9876543210ull}, after[2];
+        REQUIRE(ps5_checked_write(probe.region, 0x2000, pair, 16), "No se prepara CASP");
+        Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[2] = pair[0] ^ !match; c.x[3] = pair[1]; c.x[4] = 7; c.x[5] = 9;
+        REQUIRE(invoke(&probe, ps5_aot_casp, &c) && c.x[2] == pair[0] && c.x[3] == pair[1] &&
+                ps5_checked_read(probe.region, 0x2000, after, 16) && after[0] == (match ? 7 : pair[0]) && after[1] == (match ? 9 : pair[1]),
+                "CASP de 128 bits incorrecto"); atomics++;
+    }
+    for (unsigned pair = 0; pair < 2; pair++) for (unsigned interfere = 0; interfere < 2; interfere++) {
+        uint64_t initial[2] = {31, 47}, changed[2] = {59, 61}, after[2];
+        REQUIRE(ps5_checked_write(probe.region, 0x2000, initial, 16), "No se prepara exclusivo");
+        Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[4] = 71; c.x[5] = 73;
+        REQUIRE(invoke(&probe, pair ? ps5_aot_ldxp : ps5_aot_ldx, &c), "Carga exclusiva rechazada");
+        REQUIRE(c.x[2] == initial[0] && (!pair || c.x[3] == initial[1]), "Carga exclusiva incorrecta");
+        if (interfere) REQUIRE(ps5_checked_write(probe.region, 0x2000, changed, 16), "No se modifica exclusivo");
+        REQUIRE(invoke(&probe, pair ? ps5_aot_stxp : ps5_aot_stx, &c) && (pair ? c.x[6] : c.x[3]) == interfere,
+                "Estado de exclusivo incorrecto");
+        REQUIRE(ps5_checked_read(probe.region, 0x2000, after, 16) && after[0] == (interfere ? 59 : 71) &&
+                (!pair || after[1] == (interfere ? 61 : 73)), "Contenido de exclusivo incorrecto"); atomics += 2;
+    }
+    unsigned char before[32], after[32];
+    REQUIRE(ps5_checked_read(probe.region, 0xff0, before, 32), "No se lee frontera SIMD");
+    Cpu c = {0}; c.x[0] = probe.base + 0x2000; c.x[1] = probe.base + 0xff8;
+    REQUIRE(!invoke(&probe, ps5_aot_vector, &c), "Cruce SIMD RW/RO aceptado"); faults++;
+    REQUIRE(ps5_checked_read(probe.region, 0xff0, after, 32) && !memcmp(before, after, 32), "Cruce SIMD rechazado altero datos");
+    c = (Cpu){0}; c.x[0] = probe.base + 0x2001;
+    REQUIRE(!invoke(&probe, ps5_aot_casp, &c), "CASP desalineado aceptado"); faults++;
+    uint64_t zero = 0;
+    REQUIRE(ps5_checked_write(probe.region, 0x2000, &zero, 8), "No se prepara contador atomico");
+    pthread_t threads[4]; AtomicWorker workers[4]; unsigned started = 0;
+    for (; started < 4; started++) {
+        workers[started] = (AtomicWorker){probe.region, probe.base, 0};
+        if (pthread_create(&threads[started], NULL, atomic_worker, &workers[started])) break;
+    }
+    for (unsigned i = 0; i < started; i++) if (pthread_join(threads[i], NULL)) __builtin_trap();
+    REQUIRE(started == 4, "No se completan los hilos atomicos");
+    for (unsigned i = 0; i < 4; i++) REQUIRE(workers[i].ok, "Fallo en un hilo atomico");
+    uint64_t total = 0;
+    REQUIRE(ps5_checked_read(probe.region, 0x2000, &total, 8) && total == 4000, "Contencion atomica pierde incrementos");
+    snprintf(detail, cap, "SIMD: %u casos; atomicos: %u; %u rechazos; 4 hilos: 4000 incrementos OK", vectors, atomics, faults);
+    ok = 1;
+done:
+    if (current == &probe) current = NULL;
+    if (probe.region) ps5_checked_destroy(probe.region);
+    return ok;
+}
+int ps5_cpu_hle_probe(char *detail, size_t cap) {
+    ScalarProbe probe = {.base = 0x7100000000ull, .bytes = 0x20000};
+    int ok = 0;
+    REQUIRE(!current, "Diagnostico AOT ya activo en este hilo");
+    probe.space = ps5_guest_space_create();
+    REQUIRE(probe.space, "No se crea el registro de memoria");
+    current = &probe;
+    uint64_t base = probe.base;
+    REQUIRE(ps5_guest_map(probe.space, base, 0x10000) && ps5_guest_map(probe.space, base + 0x10000, 0x10000),
+            "No se crean las dos regiones");
+    REQUIRE(!ps5_guest_map(probe.space, base, 0x10000), "Se acepta un mapa solapado");
+    uint64_t input[2] = {123, 456}, result = 0;
+    REQUIRE(ps5_guest_write(probe.space, base + 0x8000, input, 16), "No se prepara la entrada entre regiones");
+    // Exercise the real DC ZVA lowering through the same registry hooks.
+    REQUIRE(ps5_guest_fill(probe.space, base + 0x9000, 7, 128), "No se prepara DC ZVA");
+    Cpu z = {0}; z.x[0] = base + 0x9050;
+    REQUIRE(invoke(&probe, ps5_aot_zero, &z), "DC ZVA comprobado rechazado");
+    unsigned char zeroed[128];
+    REQUIRE(ps5_guest_read(probe.space, base + 0x9000, zeroed, 128), "No se lee DC ZVA");
+    for (unsigned i = 0; i < 128; i++) REQUIRE(zeroed[i] == (i < 64 ? 7 : 0), "DC ZVA modifica fuera de su bloque");
+    Cpu c = {0}; c.x[0] = base + 0x8000; c.x[1] = base + 0x11000;
+    REQUIRE(invoke(&probe, ps5_aot_8, &c) && c.x[0] == 579 &&
+            ps5_guest_read(probe.space, base + 0x11000, &result, 8) && result == 579,
+            "AOT no comparte las regiones de memoria");
+    c = (Cpu){0}; c.x[0] = base + 0x12000;
+    REQUIRE(invoke(&probe, display_version_service, &c), "Salida HLE valida rechazada");
+    char version[16], expected[16] = "1.0.0";
+    REQUIRE(ps5_guest_read(probe.space, base + 0x12000, version, 16) && !memcmp(version, expected, 16),
+            "GetDisplayVersion no publica el resultado esperado");
+    unsigned char pattern[64], before[64], after[64];
+    for (unsigned i = 0; i < 64; i++) pattern[i] = (unsigned char)(i * 7 + 3);
+    REQUIRE(ps5_guest_write(probe.space, base + 0xffe0, pattern, 64) &&
+            ps5_guest_read(probe.space, base + 0xffe0, before, 64) && !memcmp(before, pattern, 64),
+            "Copia entre mapas adyacentes incorrecta");
+    REQUIRE(ps5_guest_copy(probe.space, base + 0xffe8, base + 0xffe0, 48), "Memmove invitado rechazado");
+    memmove(pattern + 8, pattern, 48);
+    REQUIRE(ps5_guest_read(probe.space, base + 0xffe0, before, 64) && !memcmp(before, pattern, 64),
+            "Memmove entre regiones no conserva el solapamiento");
+    c = (Cpu){0}; c.x[0] = base + 0xfff8; c.x[1] = base + 0x13001;
+    REQUIRE(invoke(&probe, ps5_aot_vector, &c) && ps5_guest_read(probe.space, base + 0x13001, after, 16),
+            "SIMD no cruza mapas adyacentes validos");
+    for (unsigned i = 0; i < 16; i++) REQUIRE(after[i] == (unsigned char)(before[24 + i] * 2), "SIMD entre regiones incorrecto");
+    c = (Cpu){0}; c.x[0] = base + 0x11000; c.x[2] = 579; c.x[4] = 17; c.x[5] = 19;
+    REQUIRE(invoke(&probe, ps5_aot_casp, &c) && ps5_guest_read(probe.space, base + 0x11000, after, 16),
+            "CASP no comparte el registro");
+    uint64_t pair[2]; memcpy(pair, after, 16);
+    REQUIRE(pair[0] == 17 && pair[1] == 19, "CASP en segunda region incorrecto");
+    c = (Cpu){0}; c.x[0] = base + 0x11000; c.x[4] = 101;
+    REQUIRE(invoke(&probe, ps5_aot_stl_8, &c) && invoke(&probe, ps5_aot_lda_8, &c) && c.x[2] == 101,
+            "Acquire/release no comparte el registro");
+    REQUIRE(ps5_guest_protect(probe.space, base + 0x10000, 0x1000, PS5_CHECKED_READ), "No se protege la segunda region");
+    REQUIRE(!ps5_guest_write(probe.space, base + 0xffe0, pattern, 64) &&
+            !ps5_guest_fill(probe.space, base + 0xffe0, 0, 64) &&
+            !ps5_guest_copy(probe.space, base + 0xffe0, base + 0x8000, 64), "Salida parcial entre regiones aceptada");
+    c = (Cpu){0}; c.x[0] = base + 0xfff8;
+    REQUIRE(!invoke(&probe, display_version_service, &c), "GetDisplayVersion cruza RW/RO sin rechazo");
+    REQUIRE(ps5_guest_read(probe.space, base + 0xffe0, after, 64) && !memcmp(before, after, 64),
+            "HLE o copia rechazada deja una escritura parcial");
+    REQUIRE(ps5_guest_access(probe.space, base + 0x10000) == PS5_CHECKED_READ &&
+            ps5_guest_access(probe.space, base + 0x20000) == -1, "Consulta de memoria incorrecta");
+    REQUIRE(!ps5_guest_read(probe.space, base + 0x8000, (void *)(uintptr_t)(base + 0x12000), 16),
+            "Alias de memoria invitada aceptado como buffer host");
+    c = (Cpu){0}; c.x[0] = base + 0x8000; c.x[2] = 1;
+    REQUIRE(invoke(&probe, ps5_aot_add_8, &c) && c.x[3] == 123, "Atomicos no comparten el registro");
+    REQUIRE(ps5_guest_unmap(probe.space, base + 0x10000) &&
+            ps5_guest_access(probe.space, base + 0x12000) == -1, "No se elimina una region");
+    c = (Cpu){0}; c.x[0] = base + 0x12000;
+    REQUIRE(!invoke(&probe, display_version_service, &c), "Salida HLE a region liberada aceptada");
+    REQUIRE(ps5_guest_map(probe.space, base + 0x10000, 0x10000) &&
+            ps5_guest_read(probe.space, base + 0x12000, version, 16), "No se reutiliza la direccion liberada");
+    for (unsigned i = 0; i < 16; i++) REQUIRE(!version[i], "La region reutilizada conserva datos antiguos");
+    snprintf(detail, cap, "2 regiones: AOT, atomicos y GetDisplayVersion; copias/HLE sin escritura parcial; liberar/reusar OK");
+    ok = 1;
+done:
+    if (current == &probe) current = NULL;
+    ps5_guest_space_destroy(probe.space); return ok;
+}
