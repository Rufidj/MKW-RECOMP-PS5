+"""Host lifetime and fiber-switch regression, without the game or a GPU.
+
+Usage: python3 tests/test_ps5_threads.py (also discovered by pytest).
+Native PS5 stack backing and signal delivery still need console validation.
+"""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_include, demand_sources
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class Ps5ThreadChecks(unittest.TestCase):
+    def test_threads_and_fibers(self):
+        cc = shutil.which("clang")
+        if not cc:
+            self.skipTest("clang is needed for the standalone C harness")
+        with tempfile.TemporaryDirectory() as folder:
+            exe = Path(folder) / "ps5-threads"
+            sources = [ROOT / "runtime/platform" / f"{name}.c"
+                       for name in ("ps5_sync", "common", "ps5_stack", "ps5_threads", "ps5_fibers")]
+            subprocess.run([
+                cc, "-O2", "-g", "-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing",
+                "-fno-omit-frame-pointer", "-DMKW_PS5_HOST_CHECK", "-ffunction-sections", "-fdata-sections",
+                f"-I{ROOT / 'runtime/platform'}", demand_include(), str(ROOT / "tests/c/t_ps5_threads.c"),
+                *demand_sources(),
+                *map(str, sources), "-pthread", "-lm", "-Wl,--gc-sections,--wrap=pthread_create", "-o", str(exe),
+            ], check=True, timeout=30)
+            subprocess.run([str(exe)], check=True, timeout=30, cwd=folder)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_ps5_zstd.py b/tests/test_ps5_zstd.py
new file mode 100644
index 0000000..a7e5a95
--- /dev/null
+++ b/tests/test_ps5_zstd.py
@@ -0,0 +1,114 @@
+"""Real native Zstd replacement publishes into sparse checked guest memory."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_sources, demand_include
+ROOT = Path(__file__).resolve().parents[1]
+class Ps5ZstdTest(unittest.TestCase):
+    def test_sparse_output(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp); source = folder / 'zstd.c'
+            source.write_text(r'''
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ps5_mem.h"
+#include "ps5_hle_copy.h"
+#define memcpy ps5_hle_memcpy
+#include "ov_zstd.c"
+#undef memcpy
+int kern_host_track;
+uint64_t kern_now_ns(void) { return 0; }
+static uint64_t thaw_bytes;
+static size_t largest_thaw;
+int kern_core_away(void) { return 0; }
+void kern_core_back(int *away) { (void)away; }
+void kern_host_left(void *thread) { (void)thread; abort(); }
+void rt_log(const char *fmt, ...) { (void)fmt; }
+__attribute__((noreturn)) void rt_fatal(const char *fmt, ...) { (void)fmt; abort(); }
+void mem_commit_range(uint64_t a, uint64_t n) {
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (n && ps5_guest_access(s, a) != -2) assert(plat_mem_commit(a, n));
+}
+void mem_thaw(uint64_t a, uint64_t n) {
+    thaw_bytes += n; if (n > largest_thaw) largest_thaw = n;
+    mem_commit_range(a, n);
+}
+int main(void) {
+    size_t size = 0x860f80;
+    unsigned char *plain = malloc(size), *frame = malloc(ZSTD_compressBound(size));
+    assert(plain && frame);
+    for (size_t i = 0; i < size; i++) plain[i] = (unsigned char)((i / 511 + i % 83) & 255);
+    size_t compressed = ZSTD_compress(frame, ZSTD_compressBound(size), plain, size, 3);
+    assert(!ZSTD_isError(compressed));
+    uint64_t src = 0x7000000000ull, base = 0x1040000000ull, dst = base + 0x180;
+    Ps5GuestSpace *s = ps5_memory_space();
+    assert(ps5_guest_reserve(s, src, 16u << 20, 1));
+    assert(ps5_guest_reserve(s, base, 16u << 20, 1));
+    ps5_memory_native_hle(1);
+    mem_commit_range(src, compressed);
+    assert(ps5_guest_write(s, src, frame, compressed));
+    mem_commit_range(base, 2u << 20);
+    int ok = 0;
+    size_t result = host_decode(dst, size, src, compressed, 0, 0, 0, &ok);
+    assert(ok && result == size);
+    unsigned char *readback = malloc(size); assert(readback);
+    assert(ps5_guest_read(s, dst, readback, size) && !memcmp(readback, plain, size));
+    uint64_t *pages = malloc(4096 * sizeof(*pages)); assert(pages);
+    assert(ps5_guest_written(s, dst, size, pages, 4096, 1) == ((dst & 4095) + size + 4095) / 4096);
+    unsigned char before[32], after[32];
+    assert(ps5_guest_read(s, dst, before, sizeof before));
+    result = host_decode(dst, size, src, 3, 0, 0, 0, &ok);
+    assert(ok && ZSTD_isError(result));
+    assert(ps5_guest_read(s, dst, after, sizeof after) && !memcmp(before, after, sizeof before));
+    assert(!ps5_guest_written(s, dst, size, pages, 4096, 1));
+    // Streaming must retain a stable output/history dictionary across blocks.
+    uint64_t stream_base = 0x1080000000ull, stream_dst = stream_base + 0x180;
+    uint64_t obj = 0x7100000000ull;
+    assert(ps5_guest_reserve(s, stream_base, 16u << 20, 1));
+    assert(ps5_guest_reserve(s, obj, 65536, 1));
+    mem_commit_range(stream_base, 2u << 20);
+    mem_commit_range(obj, 4096);
+    wr64(obj + 8, stream_dst);
+    wr32(obj + 0x10, (uint32_t)size);
+    wr32(obj + 0x14, (uint32_t)size);
+    ZSTD_DCtx *stream = ZSTD_createDCtx(); assert(stream);
+    assert(!ZSTD_isError(ZSTD_decompressBegin(stream)));
+    size_t pos = 0, blocks = 0;
+    uint64_t legacy_prepared = 0;
+    thaw_bytes = 0; largest_thaw = 0;
+    Cpu cpu = {0};
+    for (;;) {
+        size_t want = ZSTD_nextSrcSizeToDecompress(stream);
+        if (!want) break;
+        assert(pos + want <= compressed);
+        legacy_prepared += rd32(obj + 0x10);
+        int32_t err = 0;
+        assert(stream_block(&cpu, obj, stream, frame + pos, want, &err) && !err);
+        pos += want; blocks++;
+    }
+    assert(pos == compressed && blocks > 2);
+    assert(largest_thaw <= ZSTD_BLOCKSIZE_MAX);
+    assert(thaw_bytes <= blocks * ZSTD_BLOCKSIZE_MAX);
+    assert(thaw_bytes < size * 3); // linear work, including metadata calls
+    assert(legacy_prepared > thaw_bytes * 16);
+    assert(rd64(obj + 8) == stream_dst + size && !rd32(obj + 0x10) && !rd32(obj + 0x14));
+    assert(ps5_guest_read(s, stream_dst, readback, size) && !memcmp(readback, plain, size));
+    assert(ps5_guest_written(s, stream_dst, size, pages, 4096, 1) == ((stream_dst & 4095) + size + 4095) / 4096);
+    ZSTD_freeDCtx(stream);
+    free(pages); free(readback); free(frame); free(plain);
+}
+''')
+            includes = {ROOT / 'runtime'} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')}
+            sources = [ROOT / 'runtime/platform' / f'{n}.c' for n in
+                       ('ps5_mem', 'ps5_guest_memory', 'ps5_hle_copy', 'ps5_sync', 'common')]
+            exe = folder / 'test'
+            subprocess.run(['clang', '-O2', '-march=x86-64-v3', '-DMKW_PS5_HOST_CHECK',
+                            '-ffunction-sections', '-fdata-sections', '-Wno-bitwise-instead-of-logical',
+                            *['-I' + str(p) for p in sorted(includes)], demand_include(), str(source),
+                            *map(str, sources), str(ROOT / 'runtime/core/base/boot_progress.c'), *demand_sources(),
+                            str(ROOT.parent / 'PS5_PayloadSDK/platform/src/checked_region.c'),
+                            '-pthread', '-lzstd', '-Wl,--gc-sections', '-o', str(exe)], check=True, timeout=30)
+            subprocess.run([str(exe)], check=True, timeout=30)
+if __name__ == '__main__': unittest.main()
