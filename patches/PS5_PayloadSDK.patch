+/* Large sparse checked reservations, not native-console evidence. SPDX-License-Identifier: GPL-3.0-or-later */
+#include "ps5platform/checked_region.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+extern atomic_int demand_test_fail_commit, checked_test_fail_decommit;
+static struct ps5_checked_region *shared;
+static void *writer(void *arg) {
+   (void)arg; unsigned char data[32]; memset(data, 0x77, sizeof data);
+   for (unsigned i = 0; i < 3000; i++) ps5_checked_write(shared, 0, data, sizeof data);
+   return NULL;
+}
+static void *reader(void *arg) {
+   (void)arg; unsigned char data[32];
+   for (unsigned i = 0; i < 3000; i++) {
+      memset(data, 0xab, sizeof data);
+      if (ps5_checked_read(shared, 0, data, sizeof data)) {
+         for (unsigned j = 1; j < sizeof data; j++) assert(data[j] == data[0]);
+      } else for (unsigned j = 0; j < sizeof data; j++) assert(data[j] == 0xab);
+   }
+   return NULL;
+}
+int main(void) {
+   const uintptr_t base = 0x6000000000ull;
+   const size_t bytes = (size_t)16 << 30;
+   struct ps5_checked_region *r = NULL, *alias = NULL, *collision = NULL;
+   assert(ps5_checked_create_sparse(base, bytes, 1, &r));
+   assert(ps5_checked_create_sparse(0x3000000000ull, (size_t)64 << 30, 0, &alias));
+   assert(!ps5_checked_create_sparse(base, 0x10000, 0, &collision));
+   assert(ps5_checked_backed_bytes(r) == 0 && ps5_checked_backed_bytes(alias) == 0);
+   assert(ps5_checked_access(r, 0) == PS5_CHECKED_RESERVED);
+   const unsigned char *fast = ps5_checked_fast(r);   /* MKWBOOT-058: direct rights only where the page is granted AND backed */
+   assert(fast[0] == 0 && fast[1] == 0);
+   unsigned char page[4096], out[4096]; memset(page, 0xcc, sizeof page);
+   assert(!ps5_checked_protect(r, 0, 4096, PS5_CHECKED_RW));
+   assert(ps5_checked_commit(r, 0, 4096));
+   assert(ps5_checked_commit(r, bytes - 4096, 4096));
+   assert(ps5_checked_backed_bytes(r) == 0);
+   assert(fast[0] == 0);   /* committed but not backed: the inline path must still ask */
+   memset(out, 0xff, sizeof out);
+   assert(ps5_checked_read(r, 0, out, sizeof out));
+   for (unsigned i = 0; i < sizeof out; i++) assert(!out[i]);
+   assert(ps5_checked_backed_bytes(r) == 0);
+   assert(ps5_checked_write(r, bytes - 4096, page, 4096));
+   assert(ps5_checked_backed_bytes(r) == 65536);
+   assert(fast[(bytes - 4096) / 4096] == 3 && fast[(bytes - 8192) / 4096] == 0);   /* backed and RW / backed but reserved */
+   assert(ps5_checked_commit(r, 4096, 4096));
+   assert(ps5_checked_write(r, 4096, page, 4096));
+   assert(ps5_checked_backed_bytes(r) == 131072);
+   assert(fast[0] == 3 && fast[1] == 3);
+   assert(ps5_checked_protect(r, 0, 4096, PS5_CHECKED_READ) && fast[0] == 1 && fast[1] == 3);
+   assert(ps5_checked_protect(r, 0, 4096, PS5_CHECKED_NONE));
+   assert(fast[0] == 0 && fast[1] == 3);
+   uint64_t value = 123, result = 99;
+   assert(!ps5_checked_read(r, 0, &result, 8) && result == 99);
+   assert(ps5_checked_poke(r, 0, &value, 8));
+   assert(ps5_checked_peek(r, 0, &result, 8) && result == value);
+   assert(!ps5_checked_write(r, 0, &value, 8));
+   assert(!ps5_checked_poke(r, 8192, &value, 8));
+   assert(!ps5_checked_peek(r, 8192, &result, 8));
+   uint64_t dirty[4];
+   assert(ps5_checked_written(r, 0, bytes, dirty, 1, 1) == 1 && dirty[0] == base);
+   assert(ps5_checked_written(r, 0, bytes, dirty, 1, 1) == 1 && dirty[0] == base + 4096);
+   assert(ps5_checked_written(r, 0, bytes, dirty, 4, 1) == 1 && dirty[0] == base + bytes - 4096);
+   assert(ps5_checked_written(r, 0, bytes, dirty, 4, 0) == 0);
+   assert(ps5_checked_written(alias, 0, 4096, dirty, 4, 0) == UINT64_MAX);
+   assert(ps5_checked_decommit(r, 0, 4096));
+   assert(fast[0] == 0 && fast[1] == 3);
+   assert(ps5_checked_backed_bytes(r) == 131072);
+   assert(ps5_checked_commit(r, 0, 4096));
+   assert(ps5_checked_read(r, 0, out, 4096));
+   for (unsigned i = 0; i < sizeof out; i++) assert(!out[i]);
+   assert(ps5_checked_read(r, 4096, out, 4096) && !memcmp(out, page, 4096));
+   assert(ps5_checked_decommit(r, 0, 8192));
+   assert(ps5_checked_backed_bytes(r) == 65536);
+   assert(ps5_checked_decommit(r, bytes - 4096, 4096));
+   assert(ps5_checked_backed_bytes(r) == 0);
+   assert(ps5_checked_commit(r, 0, bytes));
+   assert(ps5_checked_backed_bytes(r) == 0);
+   assert(ps5_checked_decommit(r, 0, bytes));
+   assert(ps5_checked_commit(r, 0, 4096));
+   uint64_t compare = 1, desired = 7; int exchanged = -1;
+   assert(ps5_checked_atomic_cas(r, 0, &compare, &desired, 8, &exchanged) && !exchanged && !compare);
+   assert(ps5_checked_backed_bytes(r) == 0);
+   assert(ps5_checked_atomic_cas(r, 0, &compare, &desired, 8, &exchanged) && exchanged);
+   assert(ps5_checked_atomic_load(r, 0, &result, 8) && result == 7);
+   assert(ps5_checked_backed_bytes(r) == 65536);
+   assert(ps5_checked_decommit(r, 0, 4096) && ps5_checked_commit(r, 0, 4096));
+   shared = r; pthread_t threads[2];
+   assert(!pthread_create(&threads[0], NULL, writer, NULL));
+   assert(!pthread_create(&threads[1], NULL, reader, NULL));
+   for (unsigned i = 0; i < 300; i++) {
+      assert(ps5_checked_decommit(r, 0, 4096));
+      assert(ps5_checked_commit(r, 0, 4096));
+   }
+   for (unsigned i = 0; i < 2; i++) assert(!pthread_join(threads[i], NULL));
+   assert(ps5_checked_write(r, 0, page, sizeof page));
+   atomic_store(&checked_test_fail_decommit, 1);
+   assert(!ps5_checked_decommit(r, 0, 4096));
+   assert(ps5_checked_access(r, 0) == -1 && ps5_checked_backed_bytes(r) == UINT64_MAX);
+   atomic_store(&checked_test_fail_decommit, 0);
+   ps5_checked_destroy(r); ps5_checked_destroy(alias);
+   assert(ps5_checked_create_sparse(base, 0x10000, 1, &r));
+   assert(ps5_checked_commit(r, 0, 4096));
+   atomic_store(&demand_test_fail_commit, 1);
+   assert(!ps5_checked_write(r, 0, &value, 8));
+   assert(ps5_checked_access(r, 0) == -1);
+   atomic_store(&demand_test_fail_commit, 0);
+   ps5_checked_destroy(r);
+   puts("PASS: 16+64 GiB sparse reservations, logical 4 KiB commit/decommit, zero-fill, dirty pages, privileged copies, races and failure poison");
+}
