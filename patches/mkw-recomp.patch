+int ps5_memory_before_access(uint64_t address, size_t bytes, int write, uint64_t pc);
+// Direct title startup pre-backs logical commits used by native HLE pointers.
+// Combined with the core's chunked lazy commit, this does not back the whole heap.
+void ps5_memory_native_hle(int enable);
diff --git a/runtime/platform/ps5_nso_link.c b/runtime/platform/ps5_nso_link.c
new file mode 100644
index 0000000..3960866
--- /dev/null
+++ b/runtime/platform/ps5_nso_link.c
@@ -0,0 +1,194 @@
+// Guest-only reference linking, following core/boot/loader.c (MIT). SPDX-License-Identifier: MIT
+// All guest access goes through checked copies. Parse/plan all modules before writing;
+// a write/hash failure requires discarding the diagnostic images, never executing them.
+#include "ps5_nso_link.h"
+#include "sha256.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { uint64_t off, value; } Write;
+typedef struct {
+    const Ps5NsoProbeSpec *spec;
+    uint8_t *raw, *written;
+    uint64_t sym, str, strsz, hash, rela, relasz, jump, jumpsz, relr, relrsz, syment, relaent;
+    uint32_t nsyms;
+    Write *writes;
+    size_t used, capacity;
+} Module;
+typedef struct { const char *name; uint64_t value; } Definition;
+static uint32_t u32(const void *p) { uint32_t n; memcpy(&n, p, 4); return n; }
+static uint64_t u64(const void *p) { uint64_t n; memcpy(&n, p, 8); return n; }
+static int span(Module *m, uint64_t off, uint64_t len) {
+    return off <= m->spec->image_bytes && len <= m->spec->image_bytes - off;
+}
+static const uint8_t *symbol(Module *m, uint32_t i) { return m->raw + m->sym + (uint64_t)i * 24; }
+static const char *name_of(Module *m, uint32_t i) {
+    uint32_t off = u32(symbol(m, i));
+    if (off >= m->strsz) return NULL;
+    const char *s = (const char *)m->raw + m->str + off;
+    return memchr(s, 0, (size_t)(m->strsz - off)) ? s : NULL;
+}
+static uint32_t fnv(const char *s) {
+    uint32_t n = 2166136261u;
+    while (*s) n = (n ^ (uint8_t)*s++) * 16777619u;
+    return n;
+}
+static Definition *lookup(Definition *defs, size_t mask, const char *name) {
+    size_t p = fnv(name) & mask;
+    while (defs[p].name && strcmp(defs[p].name, name)) p = (p + 1) & mask;
+    return &defs[p];
+}
+static int parse(Module *m) {
+    if (!span(m, 4, 4)) return 0;
+    uint64_t mod = u32(m->raw + 4);
+    if (!span(m, mod, 8) || memcmp(m->raw + mod, "MOD0", 4)) return 0;
+    int32_t displacement; memcpy(&displacement, m->raw + mod + 4, 4);
+    int64_t dyn = (int64_t)mod + displacement;
+    if (dyn < 0) return 0;
+    uint64_t off = (uint64_t)dyn;
+    for (;;) {
+        if (!span(m, off, 16)) return 0;
+        uint64_t tag = u64(m->raw + off), val = u64(m->raw + off + 8); off += 16;
+        if (!tag) break;
+        uint64_t *slot = NULL;
+        switch (tag) {
+        case 2: slot = &m->jumpsz; break;
+        case 4: slot = &m->hash; break;
+        case 5: slot = &m->str; break;
+        case 6: slot = &m->sym; break;
+        case 7: slot = &m->rela; break;
+        case 8: slot = &m->relasz; break;
+        case 9: slot = &m->relaent; break;
+        case 10: slot = &m->strsz; break;
+        case 11: slot = &m->syment; break;
+        case 20: if (val != 7) return 0; break; // DT_PLTREL must be RELA.
+        case 23: slot = &m->jump; break;
+        case 0x23: slot = &m->relrsz; break;
+        case 0x24: slot = &m->relr; break;
+        case 0x25: if (val != 8) return 0; break;
+        }
+        if (slot) { if (*slot) return 0; *slot = val; }
+    }
+    // This diagnostic deliberately requires DT_HASH, present in all selected 1.0.0 modules.
+    if (!m->hash || !span(m, m->hash, 8) || m->syment != 24 || m->relaent != 24) return 0;
+    m->nsyms = u32(m->raw + m->hash + 4);
+    if (!m->nsyms || !span(m, m->sym, (uint64_t)m->nsyms * 24) ||
+        !m->strsz || !span(m, m->str, m->strsz) ||
+        m->relasz % 24 || m->jumpsz % 24 || m->relrsz % 8 ||
+        !span(m, m->rela, m->relasz) || !span(m, m->jump, m->jumpsz) ||
+        !span(m, m->relr, m->relrsz)) return 0;
+    for (uint32_t i = 0; i < m->nsyms; i++) if (!name_of(m, i)) return 0;
+    return 1;
+}
+static int plan(Module *m, uint64_t off, uint64_t value) {
+    if (off < m->spec->data_offset || off % 8 || !span(m, off, 8)) return 0;
+    size_t word = (size_t)(off / 8), byte = word / 8;
+    uint8_t bit = (uint8_t)(1u << (word % 8));
+    if (m->written[byte] & bit) return 0;
+    if (m->used == m->capacity) {
+        size_t capacity = m->capacity ? m->capacity * 2 : 1024;
+        Write *next = realloc(m->writes, capacity * sizeof *next);
+        if (!next) return 0;
+        m->writes = next; m->capacity = capacity;
+    }
+    m->written[byte] |= bit;
+    m->writes[m->used++] = (Write){off, value};
+    return 1;
+}
+static int plan_rela(Module *m, uint64_t table, uint64_t bytes, Definition *defs, size_t mask) {
+    for (uint64_t i = 0; i < bytes; i += 24) {
+        const uint8_t *r = m->raw + table + i;
+        uint64_t off = u64(r), info = u64(r + 8), add = u64(r + 16), value;
+        uint32_t kind = (uint32_t)info, si = (uint32_t)(info >> 32);
+        if (kind == 1027) value = m->spec->base + add;
+        else {
+            if ((kind != 257 && kind != 1025 && kind != 1026) || !si || si >= m->nsyms) return 0;
+            const uint8_t *s = symbol(m, si);
+            int own = s[6] || s[7], binding = s[4] >> 4, visibility = s[5] & 3;
+            Definition *d = lookup(defs, mask, name_of(m, si));
+            if (own && !(binding && !visibility && d->name)) value = m->spec->base + u64(s + 8);
+            else if (d->name) value = d->value;
+            else if (binding == 2) { if (!plan(m, off, 0)) return 0; continue; }
+            else return 0;
+            if (kind != 1026) value += add;
+        }
+        if (!plan(m, off, value)) return 0;
+    }
+    return 1;
+}
+static int plan_relr(Module *m) {
+    uint64_t where = 0;
+    for (uint64_t i = 0; i < m->relrsz; i += 8) {
+        uint64_t e = u64(m->raw + m->relr + i);
+        if (!(e & 1)) {
+            if (!span(m, e, 8) || !plan(m, e, m->spec->base + u64(m->raw + e))) return 0;
+            where = e + 8;
+        } else {
+            if (!where || where > m->spec->image_bytes || m->spec->image_bytes - where < 63 * 8) return 0;
+            for (unsigned k = 0; k < 63; k++) if ((e >> (k + 1)) & 1) {
+                uint64_t off = where + k * 8;
+                if (!plan(m, off, m->spec->base + u64(m->raw + off))) return 0;
+            }
+            where += 63 * 8;
+        }
+    }
+    return 1;
+}
+#define FAIL(message) do { snprintf(detail, cap, "%s", message); goto done; } while (0)
+int ps5_nso_link_probe(const Ps5NsoProbeSpec *specs, Ps5NsoProbeImage *images,
+                       const Ps5NsoLinkExpected *expected, size_t count, char *detail, size_t cap) {
+    Module *mods = NULL; Definition *defs = NULL;
+    size_t symbols = 0, capacity = 16; uint64_t total = 0; int ok = 0;
+    if (!count || count > 16) FAIL("Numero de modulos no admitido");
+    mods = calloc(count, sizeof *mods);
+    if (!mods) FAIL("Sin memoria para los modulos de enlace");
+    for (size_t i = 0; i < count; i++) {
+        Module *m = &mods[i]; m->spec = &specs[i];
+        if (!images[i].region || !m->spec->image_bytes || m->spec->image_bytes > (256u << 20))
+            FAIL("Falta una imagen o su tamano no es valido");
+        m->raw = malloc((size_t)m->spec->image_bytes);
+        m->written = calloc((size_t)((m->spec->image_bytes + 63) / 64), 1);
+        if (!m->raw || !m->written || !ps5_checked_read(images[i].region, 0, m->raw, (size_t)m->spec->image_bytes))
+            FAIL("No se obtiene la imagen para planificar el enlace");
+        uint8_t digest[32]; sha256(m->raw, (size_t)m->spec->image_bytes, digest);
+        if (memcmp(digest, m->spec->image_sha256, 32)) FAIL("La imagen inicial cambio antes del enlace");
+        if (!parse(m)) FAIL("MOD0 o tablas dinamicas no validos para este diagnostico");
+        symbols += m->nsyms;
+    }
+    while (capacity < symbols * 2) capacity *= 2;
+    defs = calloc(capacity, sizeof *defs);
+    if (!defs) FAIL("Sin memoria para las definiciones de simbolos");
+    for (size_t i = 0; i < count; i++) for (uint32_t si = 1; si < mods[i].nsyms; si++) {
+        Module *m = &mods[i]; const uint8_t *s = symbol(m, si); const char *name = name_of(m, si);
+        if (!(s[6] || s[7]) || !*name) continue;
+        Definition *d = lookup(defs, capacity - 1, name);
+        if (!d->name) *d = (Definition){name, m->spec->base + u64(s + 8)};
+    }
+    for (size_t i = 0; i < count; i++) {
+        Module *m = &mods[i];
+        if (!plan_rela(m, m->rela, m->relasz, defs, capacity - 1) ||
+            !plan_rela(m, m->jump, m->jumpsz, defs, capacity - 1) || !plan_relr(m))
+            FAIL("Relocacion no valida, duplicada o import fuerte sin definir");
+        if (m->used != expected[i].relocations) FAIL("El numero de relocaciones no coincide con la referencia");
+        total += m->used;
+    }
+    for (size_t i = 0; i < count; i++) {
+        Module *m = &mods[i];
+        for (size_t j = 0; j < m->used; j++) {
+            Write *w = &m->writes[j];
+            if (!ps5_checked_write(images[i].region, (size_t)w->off, &w->value, 8))
+                FAIL("La API rechazo una escritura de relocacion");
+        }
+        if (!ps5_checked_read(images[i].region, 0, m->raw, (size_t)m->spec->image_bytes))
+            FAIL("No se recupera la imagen enlazada");
+        uint8_t digest[32]; sha256(m->raw, (size_t)m->spec->image_bytes, digest);
+        if (memcmp(digest, expected[i].sha256, 32)) FAIL("SHA-256 de imagen enlazada distinto de la referencia");
+    }
+    snprintf(detail, cap, "%llu relocaciones; SHA-256 de %zu modulos enlazados OK; sin ejecutar codigo",
+             (unsigned long long)total, count); ok = 1;
+done:
+    free(defs);
+    if (mods) for (size_t i = 0; i < count; i++) { free(mods[i].raw); free(mods[i].written); free(mods[i].writes); }
+    free(mods); return ok;
+}
