+// The monotonic clocks of the whole title (Mesa, libc++, the SDK) from the counter; the others from the system.
+// FreeBSD ids: CLOCK_MONOTONIC 4, CLOCK_UPTIME 5, CLOCK_UPTIME_PRECISE 7, CLOCK_UPTIME_FAST 8, CLOCK_MONOTONIC_PRECISE 11, _FAST 12.
+__attribute__((visibility("hidden"))) int __wrap_clock_gettime(clockid_t id, struct timespec *ts) {
+    if ((id == 4 || id == 11 || id == 12) && ts && __atomic_load_n(&tsc_state, __ATOMIC_ACQUIRE) == 1) {
+        uint64_t ns = plat_now_ns();
+        ts->tv_sec = (time_t)(ns / 1000000000u), ts->tv_nsec = (long)(ns % 1000000000u);
+        return 0;
+    }
