+"""Actual graphics memcpy override: GPU ordering, lazy backing, dirty pages and rejection."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_sources, demand_include
+ROOT = Path(__file__).resolve().parents[1]
+class Ps5NvnCopyTest(unittest.TestCase):
+    def test_checked_graphics_copy(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'copy.c'
+            c.write_text(r'''
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "ps5_mem.h"
+#include "nvn_api_core.c"
+static uint64_t source = 0x104aa50000ull, base = 0x4c1800000ull;
+static unsigned read_calls;
+__attribute__((noreturn)) void rt_fatal(const char *fmt, ...) { (void)fmt; _exit(77); }
+void rt_log(const char *fmt, ...) { (void)fmt; }
+static int lazy_back(uint64_t a) {
+    uint64_t chunk = a & ~((2ull << 20) - 1);
+    return plat_mem_commit(chunk, 2u << 20);
+}
+static void gpu_read(uint64_t a, uint64_t n) {
+    assert(a == source + 0x1400 && n == 0x2b400);
+    read_calls++;
+    unsigned char marker = 0x7b;
+    assert(ps5_guest_write(ps5_memory_space(), a, &marker, 1));
+}
+const GfxBackend *gfx_backend(void) { static const GfxBackend backend = {.guest_read = gpu_read}; return &backend; }
+int main(void) {
+    Ps5GuestSpace *s = ps5_memory_space();
+    assert(ps5_guest_reserve(s, source, 1u << 20, 1));
+    assert(ps5_guest_reserve(s, base, 8u << 20, 1));
+    ps5_memory_native_hle(1);
+    assert(plat_mem_commit(source, 1u << 20) && plat_mem_commit(base, 2u << 20));
+    plat_mem_lazy_hook(lazy_back);
+    uint64_t src = source + 0x1400, dst = base + 0x1eb000;
+    size_t n = 0x2b400;
+    unsigned char *data = malloc(n), *out = malloc(n); assert(data && out);
+    for (size_t i = 0; i < n; i++) data[i] = (unsigned char)(i * 17);
+    assert(ps5_guest_write(s, src, data, n));
+    Cpu cpu = {0}; cpu.x[0] = dst; cpu.x[1] = src; cpu.x[2] = n;
+    ov_memcpy(&cpu);
+    data[0] = 0x7b;
+    assert(cpu.x[0] == dst && read_calls == 1);
+    assert(ps5_guest_read(s, dst, out, n) && !memcmp(out, data, n));
+    uint64_t pages[128];
+    assert(ps5_guest_written(s, dst, n, pages, 128, 1) == ((dst & 4095) + n + 4095) / 4096);
+    // Read-only tail must reject the entire copy before any destination bytes change.
+    uint64_t tail = (dst + n - 1) & ~4095ull;
+    assert(plat_mem_protect(tail, 4096, PLAT_PROT_READ));
+    unsigned char first = 0xee;
+    assert(ps5_guest_write(s, dst, &first, 1));
+    pid_t child = fork(); assert(child >= 0);
+    if (!child) { cpu.x[0] = dst; ov_memcpy(&cpu); _exit(99); }
+    int status; assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 77);
+    assert(ps5_guest_read(s, dst, &first, 1) && first == 0xee);
+    free(data); free(out);
+}
+''')
+            includes = {ROOT / 'runtime'} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')}
+            sources = [ROOT / 'runtime/platform' / f'{n}.c' for n in
+                       ('ps5_mem', 'ps5_guest_memory', 'ps5_hle_copy', 'ps5_sync', 'common')]
+            exe = d / 'copy'
+            subprocess.run(['clang', '-O2', '-march=x86-64-v3', '-DMKW_PS5_HOST_CHECK',
+                            '-ffunction-sections', '-fdata-sections', '-Wno-bitwise-instead-of-logical',
+                            *['-I' + str(p) for p in sorted(includes)], demand_include(), str(c),
+                            *map(str, sources), *demand_sources(),
+                            str(ROOT.parent / 'PS5_PayloadSDK/platform/src/checked_region.c'),
+                            '-pthread', '-Wl,--gc-sections', '-o', str(exe)], check=True, timeout=30)
+            subprocess.run([str(exe)], check=True, timeout=30)
+if __name__ == '__main__': unittest.main()
