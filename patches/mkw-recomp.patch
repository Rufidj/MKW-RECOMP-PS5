diff --git a/runtime/sdk/fs/romfs_index.c b/runtime/sdk/fs/romfs_index.c
new file mode 100644
index 0000000..774061f
--- /dev/null
+++ b/runtime/sdk/fs/romfs_index.c
@@ -0,0 +1,29 @@
+// MKW_RFS1 metadata plus SHA-256 trailer, generated by tools/romfs/index.py.
+// The digest detects corruption; it is not authentication of the game dump.
+#include "romfs_index.h"
+#include "romfs_path.h"
+#include "sha256.h"
+#include <string.h>
+int romfs_index_validate(const uint8_t *b, size_t n, uint64_t *count, uint64_t *strings) {
+    if (n < 56 || memcmp(b, "MKW_RFS1", 8)) return 0;
+    uint64_t c, s;
+    memcpy(&c, b + 8, 8); memcpy(&s, b + 16, 8);
+    if (!c || c > (n - 56) / 24 || s != 24 + c * 24 || s >= n - 32) return 0;
+    uint8_t digest[32]; sha256(b, n - 32, digest);
+    if (memcmp(digest, b + n - 32, 32)) return 0;
+    uint64_t next = 0;
+    const char *prev = NULL;
+    for (uint64_t i = 0; i < c; i++) {
+        uint64_t off; uint32_t at, len;
+        memcpy(&off, b + 24 + i * 24, 8);
+        memcpy(&at, b + 40 + i * 24, 4); memcpy(&len, b + 44 + i * 24, 4);
+        if (off || at != next || len < 2 || next > n - 32 - s || len > n - 32 - s - next) return 0;
+        const char *name = (const char *)b + s + at;
+        if (name[len - 1] || memchr(name, 0, len - 1) || !romfs_path_valid_relative(name) ||
+            name[strlen(name) - 1] == '/' || (prev && strcmp(prev, name) >= 0)) return 0;
+        prev = name; next += len;
+    }
+    if (next != n - 32 - s) return 0;
+    *count = c; *strings = s;
+    return 1;
+}
