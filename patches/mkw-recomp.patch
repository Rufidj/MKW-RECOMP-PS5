+    uint64_t file_done, file_total, unpack_done, unpack_total;
+    int nlines;
+} BootConsole;
+void boot_progress_file(const char *name, uint64_t done, uint64_t total);   // a RomFS read reached done of total bytes
+void boot_progress_unpack_begin(uint64_t total);                            // a compressed frame of total bytes starts
+void boot_progress_unpack_add(uint64_t bytes);                              // bytes of it decoded
+int boot_progress_console(BootConsole *out);                                // 0 when startup is over
+#ifdef __cplusplus
+}
