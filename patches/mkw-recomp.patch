new file mode 100644
index 0000000..70d82fa
--- /dev/null
+++ b/tests/c/t_ps5_intr.c
@@ -0,0 +1,103 @@
+// Host checks of scheduler suspension, cancellation and PC redirection.
+// SPDX-License-Identifier: MIT
+#define _GNU_SOURCE
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "platform.h"
+#include "ps5_int.h"
+
+uint64_t redirect_back;
+unsigned redirect_count;
+void redirect_stub(void);
+// Preserve flags and all GPRs, including the interrupted function's red zone.
+__asm__(".text\n.globl redirect_stub\n.type redirect_stub,@function\n"
+        "redirect_stub:\n"
+        "leaq -128(%rsp), %rsp\n"
+        "pushfq\n"
+        "lock incl redirect_count(%rip)\n"
+        "popfq\n"
+        "leaq 128(%rsp), %rsp\n"
+        "jmp *redirect_back(%rip)\n"
+        ".size redirect_stub,.-redirect_stub\n");
+
+typedef struct { PlatIntr *intr; int ready, unblock, running, quit; uint64_t counter; } Job;
+static void spin_worker(void *arg) {
+    Job *job = arg;
+    sigset_t blocked;
+    sigemptyset(&blocked); sigaddset(&blocked, SIGUSR2);
+    assert(!pthread_sigmask(SIG_BLOCK, &blocked, NULL));
+    job->intr = plat_intr_self();
+    assert(job->intr && plat_intr_self() == job->intr);
+    __atomic_store_n(&job->ready, 1, __ATOMIC_RELEASE);
+    while (!__atomic_load_n(&job->unblock, __ATOMIC_ACQUIRE)) plat_pause();
+    assert(!pthread_sigmask(SIG_UNBLOCK, &blocked, NULL));
+    __atomic_store_n(&job->running, 1, __ATOMIC_RELEASE);
+    while (!__atomic_load_n(&job->quit, __ATOMIC_ACQUIRE))
+        __atomic_add_fetch(&job->counter, 1, __ATOMIC_RELAXED);
+    plat_intr_free(job->intr);
+}
+static void wait_flag(int *flag) {
+    uint64_t deadline = plat_now_ns() + 2000000000ull;
+    while (!__atomic_load_n(flag, __ATOMIC_ACQUIRE)) {
+        assert(plat_now_ns() < deadline);
+        plat_yield();
+    }
+}
+static void stop_worker(PlatIntr *intr, uint64_t *rip, uint64_t *rsp) {
+    uint64_t deadline = plat_now_ns() + 2000000000ull;
+    while (!plat_intr_stop(intr, rip, rsp)) {
+        assert(plat_now_ns() < deadline);
+        plat_yield();
+    }
+}
+
+int main(int argc, char **argv) {
+    if (argc == 2 && !strcmp(argv[1], "--conflict")) {
+        struct sigaction action = {.sa_handler = SIG_IGN};
+        sigemptyset(&action.sa_mask);
+        assert(!sigaction(SIGUSR2, &action, NULL));
+        assert(!plat_intr_self());
+        assert(!sigaction(SIGUSR2, NULL, &action));
+        assert(action.sa_handler == SIG_IGN);
+        puts("PASS: existing signal handler retained");
+        return 0;
+    }
+    Job job = {0};
+    PlatThread *thread = plat_thread_new_ex(spin_worker, &job, "intr-probe", 1u << 20);
+    assert(thread);
+    wait_flag(&job.ready);
+    uint64_t rip = 1, rsp = 2;
+    assert(!plat_intr_stop(job.intr, &rip, &rsp)); // Signal is blocked: request must cancel.
+    assert(rip == 1 && rsp == 2);
+    assert(!plat_intr_resume(job.intr, 0));
+    __atomic_store_n(&job.unblock, 1, __ATOMIC_RELEASE);
+    wait_flag(&job.running);
+    for (int i = 0; i < 100; i++) {
+        stop_worker(job.intr, &rip, &rsp);
+        assert(rip && rsp);
+        uint64_t frozen = __atomic_load_n(&job.counter, __ATOMIC_RELAXED);
+        // No locks or allocations while another thread is stopped.
+        uint64_t start = plat_now_ns();
+        while (plat_now_ns() - start < 10000u) plat_pause();
+        assert(__atomic_load_n(&job.counter, __ATOMIC_RELAXED) == frozen);
+        assert(!plat_intr_stop(job.intr, &rip, &rsp));
+        assert(plat_intr_resume(job.intr, 0));
+    }
+    stop_worker(job.intr, &rip, &rsp);
+    redirect_back = rip;
+    assert(plat_intr_resume(job.intr, (uintptr_t)redirect_stub));
+    uint64_t deadline = plat_now_ns() + 2000000000ull;
+    while (!__atomic_load_n(&redirect_count, __ATOMIC_ACQUIRE)) {
+        assert(plat_now_ns() < deadline);
+        plat_yield();
+    }
+    __atomic_store_n(&job.quit, 1, __ATOMIC_RELEASE);
+    plat_thread_join(thread);
+    assert(redirect_count == 1 && !ps5_stack_reserved_bytes());
+    puts("PASS: blocked-signal timeout, cancellation, 100 suspensions, register snapshot, PC redirect, cleanup");
+    return 0;
+}
diff --git a/tests/c/t_ps5_sync.c b/tests/c/t_ps5_sync.c
new file mode 100644
index 0000000..d34f90d
--- /dev/null
+++ b/tests/c/t_ps5_sync.c
@@ -0,0 +1,152 @@
+// Host regression for the PS5 lock protocol, not a console test.
+// SPDX-License-Identifier: MIT
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "platform.h"
+
+static _Thread_local uint32_t self_id;
+static uint32_t next_id;
+uint32_t plat_thread_id(void) {
+    if (!self_id) self_id = __atomic_add_fetch(&next_id, 1, __ATOMIC_RELAXED);
+    return self_id;
+}
+
+static PlatMutex data_lock = PLAT_MUTEX_INIT;
+static uint64_t value, inverse = UINT64_MAX;
+static void *writer(void *arg) {
+    (void)arg;
+    for (int i = 0; i < 15000; i++) {
+        plat_mutex_lock(&data_lock);
+        value++;
+        inverse = ~value;
+        plat_mutex_unlock(&data_lock);
+    }
+    return NULL;
+}
+static void *reader(void *arg) {
+    (void)arg;
+    for (int i = 0; i < 15000; i++) {
+        plat_mutex_lock_shared(&data_lock);
+        assert(inverse == ~value);
+        assert(!plat_mutex_trylock(&data_lock));
+        plat_mutex_unlock_shared(&data_lock);
+    }
+    return NULL;
+}
+
+static PlatMutex ping_lock = PLAT_MUTEX_INIT;
+static PlatCond ping_cond = PLAT_COND_INIT;
+static int turn;
+static void *ping(void *arg) {
+    int me = (int)(intptr_t)arg;
+    for (int i = 0; i < 4000; i++) {
+        plat_mutex_lock(&ping_lock);
+        while (turn != me) plat_cond_wait(&ping_cond, &ping_lock);
+        turn = 1 - me;
+        plat_cond_signal(&ping_cond);
+        plat_mutex_unlock(&ping_lock);
+    }
+    return NULL;
+}
+
+static PlatOnce once = PLAT_ONCE_INIT;
+static PlatEvent start_event;
+static int init_count;
+static void init(void *arg) { (void)arg; init_count++; }
+static void *once_waiter(void *arg) {
+    (void)arg;
+    plat_event_wait(&start_event);
+    plat_once(&once, init, NULL);
+    return NULL;
+}
+
+typedef struct { PlatCond c; PlatMutex m; int ready, done; } Collision;
+static Collision collision[129];
+static unsigned bucket(Collision *c) {
+    uintptr_t key = (uintptr_t)&c->c.p >> 3;
+    return (unsigned)((key ^ (key >> 7)) & 63);
+}
+static void *collision_waiter(void *arg) {
+    Collision *c = arg;
+    plat_mutex_lock(&c->m);
+    c->ready = 1;
+    while (!c->done) plat_cond_wait(&c->c, &c->m);
+    plat_mutex_unlock(&c->m);
+    return NULL;
+}
+static void wait_ready(Collision *c) {
+    for (;;) {
+        plat_mutex_lock(&c->m);
+        int ready = c->ready;
+        plat_mutex_unlock(&c->m);
+        if (ready) return;
+        plat_wait_ns(100000u);
+    }
+}
+static void signal_done(Collision *c) {
+    plat_mutex_lock(&c->m);
+    c->done = 1;
+    plat_cond_signal(&c->c);
+    plat_mutex_unlock(&c->m);
+}
+
+int main(void) {
+    pthread_t threads[8];
+    assert(plat_counter_hz() == 1000000000u);
+    for (int i = 0; i < 8; i++)
+        assert(!pthread_create(&threads[i], NULL, i < 4 ? writer : reader, NULL));
+    for (int i = 0; i < 8; i++) assert(!pthread_join(threads[i], NULL));
+    assert(value == 60000 && inverse == ~value);
+    assert(plat_mutex_trylock_shared(&data_lock));
+    assert(plat_mutex_trylock_shared(&data_lock));
+    plat_mutex_unlock_shared(&data_lock);
+    plat_mutex_unlock_shared(&data_lock);
+    assert(plat_mutex_trylock(&data_lock));
+    assert(!plat_mutex_trylock_shared(&data_lock));
+    plat_mutex_unlock(&data_lock);
+
+    for (int i = 0; i < 2; i++) assert(!pthread_create(&threads[i], NULL, ping, (void *)(intptr_t)i));
+    for (int i = 0; i < 2; i++) assert(!pthread_join(threads[i], NULL));
+    plat_mutex_lock(&ping_lock);
+    uint64_t before = plat_now_ns();
+    assert(!plat_cond_wait_ns(&ping_cond, &ping_lock, 2000000u));
+    assert(plat_now_ns() - before >= 2000000u);
+    assert(!plat_mutex_trylock(&ping_lock));
+    plat_mutex_unlock(&ping_lock);
+
+    plat_event_init(&start_event, 1, 0);
+    for (int i = 0; i < 8; i++) assert(!pthread_create(&threads[i], NULL, once_waiter, NULL));
+    plat_event_set(&start_event);
+    for (int i = 0; i < 8; i++) assert(!pthread_join(threads[i], NULL));
+    assert(init_count == 1);
+    PlatRMutex recursive = PLAT_RMUTEX_INIT;
+    plat_rmutex_lock(&recursive);
+    assert(plat_rmutex_trylock(&recursive));
+    plat_rmutex_unlock(&recursive);
+    plat_rmutex_unlock(&recursive);
+    PlatEvent automatic;
+    plat_event_init(&automatic, 0, 1);
+    assert(plat_event_wait_ns(&automatic, 1));
+    assert(!plat_event_wait_ns(&automatic, 1000000u));
+
+    Collision *a = NULL, *b = NULL;
+    for (int i = 0; i < 129 && !a; i++)
+        for (int j = i + 1; j < 129; j++)
+            if (bucket(&collision[i]) == bucket(&collision[j])) {
+                a = &collision[i]; b = &collision[j]; break;
+            }
+    assert(a && b);
+    assert(!pthread_create(&threads[0], NULL, collision_waiter, a));
+    assert(!pthread_create(&threads[1], NULL, collision_waiter, b));
+    wait_ready(a); wait_ready(b);
+    signal_done(a);
+    assert(!pthread_join(threads[0], NULL));
+    signal_done(b);
+    assert(!pthread_join(threads[1], NULL));
+    puts("PASS: rw locks, conditions, monotonic timeout, events, once, recursion, colliding waiters");
+    return 0;
+}
diff --git a/tests/c/t_ps5_threads.c b/tests/c/t_ps5_threads.c
new file mode 100644
index 0000000..c5ded29
--- /dev/null
+++ b/tests/c/t_ps5_threads.c
@@ -0,0 +1,189 @@
+// Host checks of thread lifetime, guarded stacks and migrating fibers.
+// SPDX-License-Identifier: MIT
+#define _GNU_SOURCE
+#include <assert.h>
+#include <fenv.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdatomic.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "platform.h"
+#include "ps5_int.h"
+#include <ps5platform/demand.h>
+
+extern atomic_int demand_test_fail_commit;
+#include <errno.h>
+static int fail_pthread;
+int __real_pthread_create(pthread_t *, const pthread_attr_t *, void *(*)(void *), void *);
+int __wrap_pthread_create(pthread_t *t, const pthread_attr_t *a, void *(*fn)(void *), void *arg) {
+    if (fail_pthread) { fail_pthread = 0; return EAGAIN; }
+    return __real_pthread_create(t, a, fn, arg);
+}
+
+
+static PlatEvent release_long;
+static unsigned finished;
+static void short_worker(void *arg) {
+    (void)arg;
+    assert(plat_thread_id());
+    __atomic_add_fetch(&finished, 1, __ATOMIC_RELEASE);
+}
+static void blocked_worker(void *arg) {
+    (void)arg;
+    plat_event_wait(&release_long);
+}
+static void fp_worker(void *arg) {
+    uint32_t *id = arg;
+    *id = plat_thread_id();
+    assert(fegetround() == FE_UPWARD);
+    assert(!fesetround(FE_TOWARDZERO));
+}
+static void wait_reserved(uint64_t expected) {
+    uint64_t deadline = plat_now_ns() + 3000000000ull;
+    while (ps5_stack_reserved_bytes() != expected) {
+        assert(plat_now_ns() < deadline);
+        plat_wait_ns(1000000u);
+    }
+}
+
+typedef struct { PlatFiber *fiber, *root; uint32_t expected_thread; int visits; } FiberJob;
+static pthread_key_t destructor_key;
+static unsigned destructor_count;
+static __attribute__((noinline)) unsigned grow_stack(unsigned depth) {
+    volatile unsigned char local[200000];
+    for (unsigned i = 0; i < sizeof local; i += 4096) local[i] = (unsigned char)(depth + 1);
+    unsigned sum = depth ? grow_stack(depth - 1) : 0;
+    for (unsigned i = 0; i < sizeof local; i += 4096) {
+        assert(local[i] == depth + 1);
+        sum += local[i];
+    }
+    return sum;
+}
+static void stack_destructor(void *arg) {
+    (void)arg;
+    assert(grow_stack(3) > 0); // Runs after the callback, on previously untouched stack units.
+    __atomic_add_fetch(&destructor_count, 1, __ATOMIC_RELEASE);
+}
+static void destructor_worker(void *arg) {
+    (void)arg;
+    assert(!pthread_setspecific(destructor_key, (void *)1));
+}
+static __attribute__((noinline)) uint32_t current_thread(void) { return plat_thread_id(); }
+static void fiber_body(void *arg) {
+    FiberJob *job = arg;
+    volatile uint64_t local[32];
+    for (int i = 0; i < 32; i++) local[i] = 0xcafe0000ull + (unsigned)i;
+    assert(fegetround() == FE_TONEAREST);
+    assert(grow_stack(12) > 0); // Fault through several MiB of an initially sparse stack.
+    assert(!fesetround(FE_DOWNWARD));
+    for (int i = 0; i < 3; i++) {
+        assert(current_thread() == job->expected_thread);
+        assert(fegetround() == FE_DOWNWARD);
+        for (int j = 0; j < 32; j++) assert(local[j] == 0xcafe0000ull + (unsigned)j);
+        job->visits++;
+        plat_fiber_switch(job->root);
+    }
+    __builtin_trap(); // A completed test fiber is freed while suspended, never resumed.
+}
+static void migration_worker(void *arg) {
+    FiberJob *job = arg;
+    assert(fegetround() == FE_UPWARD);
+
+    job->root = plat_fiber_self();
+    job->expected_thread = current_thread();
+    plat_fiber_switch(job->fiber);
+    assert(fegetround() == FE_UPWARD);
+    plat_fiber_unself();
+}
+
+int main(void) {
+    assert(!ps5_stack_reserved_bytes());
+    Ps5Stack stack;
+    assert(!ps5_stack_create(&stack, 0));
+    assert(!ps5_stack_create(&stack, SIZE_MAX));
+    assert(ps5_stack_create(&stack, 70001));
+    assert(stack.bytes >= 70001 && !(stack.bytes & 0xffffu));
+    ((volatile char *)stack.data)[stack.bytes - 1] = 42;
+    pid_t child = fork();
+    assert(child >= 0);
+    if (!child) { (void)*(volatile char *)stack.base; _exit(7); }
+    int status;
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+    ps5_stack_destroy(&stack);
+    assert(!ps5_stack_reserved_bytes());
+
+    fail_pthread = 1;
+    errno = 0;
+    assert(!plat_thread_new_ex(short_worker, NULL, "native-create-failure", 256u << 20));
+    assert(errno == EAGAIN);
+    assert(!ps5_stack_reserved_bytes() && !ps5_demand_backed_bytes());
+    plat_event_init(&release_long, 1, 0);
+    PlatThread *worker = plat_thread_new_ex(blocked_worker, NULL, "join-timeout", 1u << 20);
+    assert(worker);
+    assert(!plat_thread_join_ns(worker, 2000000u));
+    plat_event_set(&release_long);
+    assert(plat_thread_join_ns(worker, 1000000000u));
+    assert(!ps5_stack_reserved_bytes());
+    assert(!plat_thread_new_ex(NULL, NULL, NULL, 1u << 20));
+    assert(!plat_thread_new_ex(short_worker, NULL, NULL, SIZE_MAX));
+    atomic_store(&demand_test_fail_commit, 1);
+    assert(!plat_thread_new_ex(short_worker, NULL, "attach-failure", 1u << 20));
+    atomic_store(&demand_test_fail_commit, 0);
+    assert(!finished && !ps5_stack_reserved_bytes() && !ps5_demand_backed_bytes());
+
+    assert(!fesetround(FE_UPWARD));
+    uint32_t worker_id = 0;
+    worker = plat_thread_new_ex(fp_worker, &worker_id, "fp-state", 1u << 20);
+    assert(worker);
+    plat_thread_join(worker);
+    assert(worker_id && worker_id != plat_thread_id());
+    assert(fegetround() == FE_UPWARD);
+    assert(!pthread_key_create(&destructor_key, stack_destructor));
+    worker = plat_thread_new_ex(destructor_worker, NULL, "stack-destructor", 1u << 20);
+    assert(worker);
+    plat_thread_join(worker);
+    assert(destructor_count == 1 && !ps5_demand_backed_bytes());
+    assert(!pthread_key_delete(destructor_key));
+
+    plat_event_init(&release_long, 1, 0);
+    assert(plat_thread_spawn(blocked_worker, NULL, "detached-long", 1u << 20));
+    uint64_t long_bytes = ps5_stack_reserved_bytes();
+    for (int i = 0; i < 64; i++)
+        assert(plat_thread_spawn(short_worker, NULL, "detached-short", 1u << 20));
+    wait_reserved(long_bytes); // Short workers must be reaped while the long one still waits.
+    assert(__atomic_load_n(&finished, __ATOMIC_ACQUIRE) == 64);
+    plat_event_set(&release_long);
+    wait_reserved(0);
+
+    FiberJob job = {0};
+    PlatFiber *main_root = plat_fiber_self();
+    assert(main_root == plat_fiber_self());
+    assert(!plat_fiber_new(SIZE_MAX, fiber_body, &job));
+    job.fiber = plat_fiber_new(256u << 20, fiber_body, &job);
+    assert(job.fiber);
+    assert(ps5_demand_backed_bytes() == 0x10000); // Only its startup unit is backed.
+    job.root = main_root;
+    job.expected_thread = current_thread();
+    plat_fiber_switch(job.fiber);
+    assert(job.visits == 1 && fegetround() == FE_UPWARD);
+    assert(ps5_demand_backed_bytes() > 2u << 20);
+    assert(ps5_demand_backed_bytes() < 4u << 20);
+    worker = plat_thread_new_ex(migration_worker, &job, "fiber-migrate", 1u << 20);
+    assert(worker);
+    plat_thread_join(worker);
+    assert(job.visits == 2);
+    job.root = main_root;
+    job.expected_thread = current_thread();
+    plat_fiber_switch(job.fiber);
+    assert(job.visits == 3 && fegetround() == FE_UPWARD);
+    plat_fiber_free(job.fiber);
+    plat_fiber_unself();
+    assert(!ps5_stack_reserved_bytes());
+    assert(!ps5_demand_backed_bytes());
+    puts("PASS: guarded demand stacks, joins, attach failure, detach reaping, FP state, 256 MiB fiber growth and migration");
+    return 0;
+}
