+    const Ps5FastMap *m = hot_map(a, &off, n);
+    if (__builtin_expect(m && (__atomic_load_n(&m->rights[off >> 12], __ATOMIC_RELAXED) & 1) &&
+                         (!m->backed || __atomic_load_n(&m->backed[off >> 16], __ATOMIC_ACQUIRE)), 1)) {
+        const void *p = (const void *)(uintptr_t)a;
+        if (n == 4) { uint32_t v; __builtin_memcpy(&v, p, 4); return v; }
+        if (n == 8) { uint64_t v; __builtin_memcpy(&v, p, 8); return v; }
+        if (n == 1) return __atomic_load_n((const uint8_t *)p, __ATOMIC_RELAXED);
+        if (n == 2) { uint16_t v; __builtin_memcpy(&v, p, 2); return v; }
+    }
+    return load_slow(a, n, (uintptr_t)__builtin_return_address(0));
+}
+void rt_checked_scalar_store(uint64_t a, uint64_t value, unsigned n) {
+    uint64_t off;
+    const Ps5FastMap *m = hot_map(a, &off, n);
+    if (__builtin_expect(m && (__atomic_load_n(&m->rights[off >> 12], __ATOMIC_RELAXED) & 3) == 3 &&
+                         (!m->backed || __atomic_load_n(&m->backed[off >> 16], __ATOMIC_ACQUIRE)), 1)) {
+        void *p = (void *)(uintptr_t)a;
+        if (n == 4) { uint32_t v = (uint32_t)value; __builtin_memcpy(p, &v, 4); }
+        else if (n == 8) __builtin_memcpy(p, &value, 8);
+        else if (n == 1) __atomic_store_n((uint8_t *)p, (uint8_t)value, __ATOMIC_RELAXED);
+        else if (n == 2) { uint16_t v = (uint16_t)value; __builtin_memcpy(p, &v, 2); }
+        else goto slow;
+        if (m->dirty && !__atomic_load_n(&m->dirty[off >> 12], __ATOMIC_RELAXED)) __atomic_store_n(&m->dirty[off >> 12], 1, __ATOMIC_RELAXED);
