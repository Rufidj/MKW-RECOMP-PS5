+static FILE *log_file;
+static uint64_t calls;
+static void slice_enter(uint64_t address) { (void)address; calls++; }
+#undef FN_ENTER
+#define FN_ENTER(a) slice_enter(a)
+#include "mkw_game_slice.h"
+#define BASE 0x7100000000ull
+static void record(const char *text) {
+    fprintf(stderr, "[MKWEXEC-001] %s\n", text); fflush(stderr);
+    if (log_file) { fprintf(log_file, "%s\n", text); fflush(log_file); }
+}
+static int execute(GuestFn fn, const float matrix[16], const float vector[4], float output[4]) {
+    if (!space || !ps5_guest_write(space, BASE, matrix, 64) || !ps5_guest_write(space, BASE + 0x100, vector, 16)) return 0;
+    Cpu c = {0}; c.x[0] = BASE + 0x200; c.x[1] = BASE; c.x[2] = BASE + 0x100;
+    return ps5_cpu_run_checked(space, fn, &c) && ps5_guest_read(space, BASE + 0x200, output, 16);
+}
+int mkw_slice_transform(const float matrix[16], const float vector[4], float output[4]) {
+    if (!execute(f_700004e6c8, matrix, vector, output)) { record("ERROR: checked access rejected during real main function"); return 0; }
+    if (calls && !(calls % 6000)) {
+        char line[128]; snprintf(line, sizeof line, "RUNNING: %llu actual game-function entries", (unsigned long long)calls); record(line);
+    }
+    return 1;
+}
+uint64_t mkw_slice_calls(void) { return calls; }
+void mkw_slice_close(void) {
+    if (space) { ps5_guest_space_destroy(space); space = NULL; }
+    if (log_file) {
+        char line[128]; snprintf(line, sizeof line, "CLOSED: %llu actual game-function entries", (unsigned long long)calls); record(line);
+        fclose(log_file); log_file = NULL;
+    }
+}
+int mkw_slice_init(char *detail, size_t cap) {
+    FILE *main = NULL; int ok = 0;
+    if (space || log_file) { snprintf(detail, cap, "La ejecucion ya esta iniciada"); return 0; }
+    calls = 0;
+    log_file = fopen(MKW_EXEC_ROOT "/game-exec-001.txt", "w");
+    if (log_file) chmod(MKW_EXEC_ROOT "/game-exec-001.txt", 0666);
+    record("MKWEXEC-001 - actual recompiled main functions; not full game boot");
+    main = fopen(MKW_EXEC_ROOT "/exefs/main", "rb");
+    if (!main) { snprintf(detail, cap, "Falta exefs/main"); goto done; }
+    Sha256 hash; sha256_init(&hash); unsigned char buffer[65536], digest[32]; size_t n;
+    while ((n = fread(buffer, 1, sizeof buffer, main))) sha256_update(&hash, buffer, n);
+    if (ferror(main)) { snprintf(detail, cap, "No se lee exefs/main"); goto done; }
+    sha256_final(&hash, digest);
+    if (memcmp(digest, slice_main_sha256, 32)) { snprintf(detail, cap, "El SHA-256 de main no coincide con el dump recompilado"); goto done; }
+    record("MAIN_SHA256: MATCH");
+    space = ps5_guest_space_create();
+    if (!space || !ps5_guest_map(space, BASE, 0x10000)) { snprintf(detail, cap, "No se prepara la memoria de ejecucion"); goto done; }
+    // Independent finite integer-valued inputs give exact binary32 expectations.
+    float matrix[16] = {2,3,5,0, 7,11,13,0, 17,19,23,0, 29,31,37,1};
+    float input[4] = {3,-2,4,0}, result[4];
+    for (unsigned translated = 0; translated < 2; translated++) {
+        GuestFn fn = translated ? f_700004e6c8 : f_7000080bc4;
+        if (!execute(fn, matrix, input, result)) { snprintf(detail, cap, "Acceso rechazado ejecutando main"); goto done; }
+        for (unsigned j = 0; j < 4; j++) {
+            float expected = matrix[j]*input[0] + matrix[4+j]*input[1] + matrix[8+j]*input[2];
+            if (translated) expected += matrix[12+j];
+            if (!isfinite(result[j]) || result[j] != expected) { snprintf(detail, cap, "Resultado incorrecto de funcion real"); goto done; }
+        }
+    }
+    record("EXECUTED: main+0x80bc4 and main+0x4e6c8; outputs match independent reference");
+    snprintf(detail, cap, "Ejecutando main+0x4e6c8 de tu dump; main+0x80bc4 tambien ejecutada");
+    record("READY: visualization uses actual main+0x4e6c8 outputs every frame"); ok = 1;
+done:
+    if (main) fclose(main);
+    if (!ok) { record(detail); mkw_slice_close(); }
+    return ok;
+}
