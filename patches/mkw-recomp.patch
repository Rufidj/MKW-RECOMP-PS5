+    store_slow(a, value, n, (uintptr_t)__builtin_return_address(0));
+}
+u128 rt_checked_vector_load(uint64_t a) {
+    uint64_t pc = (uintptr_t)__builtin_return_address(0); u128 value;
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (fast_load(s, a, &value, 16)) return value;
+    if (!ps5_guest_read(s, a, &value, 16)) {
+        s = prepare(a, 16, 0, pc);
+        if (!ps5_guest_read(s, a, &value, 16)) invalid(a, 16, 0, pc);
+    }
+    return value;
+}
+void rt_checked_vector_store(uint64_t a, u128 value) {
+    uint64_t pc = (uintptr_t)__builtin_return_address(0);
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (fast_store(s, a, &value, 16)) return;
+    if (!ps5_guest_write(s, a, &value, 16)) {
+        s = prepare(a, 16, 1, pc);
+        if (!ps5_guest_write(s, a, &value, 16)) invalid(a, 16, 1, pc);
+    }
+}
+static void atomic_width(uint64_t a, unsigned n, int write, uint64_t pc) {
+    if ((n != 1 && n != 2 && n != 4 && n != 8 && n != 16) || a % n) invalid(a, n, write, pc);
