@@ -0,0 +1,52 @@
+"""Concurrent real activity counters and terminal first-image handoff."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+ROOT = Path(__file__).resolve().parents[1]
+class BootProgressTest(unittest.TestCase):
+    def test_counters_and_handoff(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'progress.c'
+            c.write_text(r'''
+#include "boot_progress.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdatomic.h>
+static atomic_uint_fast64_t clock_ns = 100;
+uint64_t plat_now_ns(void) { return atomic_fetch_add(&clock_ns, 10); }
+static void *work(void *p) {
+    (void)p;
+    for (unsigned i = 0; i < 1000; i++) {
+        int token = boot_progress_decode_begin(); assert(token);
+        boot_progress_read(31); boot_progress_decode_end(token, 47);
+    }
+    return 0;
+}
+int main(void) {
+    BootProgress p;
+    assert(!boot_progress_snapshot(&p));
+    boot_progress_read(1); assert(!boot_progress_decode_begin());
+    boot_progress_begin(90);
+    pthread_t t[4];
+    for (int i = 0; i < 4; i++) assert(!pthread_create(t+i, 0, work, 0));
+    for (int i = 0; i < 4; i++) assert(!pthread_join(t[i], 0));
+    assert(boot_progress_snapshot(&p));
+    assert(p.started_ns == 90 && p.last_activity_ns >= 100);
+    assert(p.read_bytes == 4000 * 31 && p.decoded_bytes == 4000 * 47);
+    assert(p.decode_calls == 4000 && !p.active_decoders);
+    int pending = boot_progress_decode_begin(); assert(pending);
+    boot_progress_finish();
+    boot_progress_decode_end(pending, 13);
+    assert(!boot_progress_snapshot(&p) && !p.active_decoders);
+    assert(!boot_progress_decode_begin());
+    uint64_t before = p.read_bytes; boot_progress_read(999);
+    assert(!boot_progress_snapshot(&p) && p.read_bytes == before);
+}
+''')
+            exe = d / 'progress'
+            subprocess.run(['clang', '-O2', '-pthread', '-I' + str(ROOT / 'runtime/core/base'),
+                            '-I' + str(ROOT / 'runtime'), str(c), str(ROOT / 'runtime/core/base/boot_progress.c'),
+                            '-o', str(exe)], check=True)
+            subprocess.run([str(exe)], check=True)
+if __name__ == '__main__': unittest.main()
diff --git a/tests/test_ps5_cpu_fast.py b/tests/test_ps5_cpu_fast.py
new file mode 100644
index 0000000..69346af
--- /dev/null
+++ b/tests/test_ps5_cpu_fast.py
@@ -0,0 +1,72 @@
+"""Ready CPU accesses keep a two-gate budget and preserve lazy/watch fallbacks."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_include, demand_sources, FORK
+ROOT=Path(__file__).resolve().parents[1]
+class Ps5CpuFastTest(unittest.TestCase):
+    def test_ready_accesses_and_fallbacks(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=Path(tmp);c=d/'fast.c'
+            c.write_text(r'''
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "platform/platform.h"
+#include "platform/ps5_mem.h"
+#include "cpu/cpu.h"
+static int recording, gates, lazy_calls, watch_calls;
+static const uint64_t base=0x1040000000ull;
+int __real_pthread_rwlock_rdlock(pthread_rwlock_t *);
+int __real_pthread_rwlock_wrlock(pthread_rwlock_t *);
+int __wrap_pthread_rwlock_rdlock(pthread_rwlock_t *p) {if(recording)gates++;return __real_pthread_rwlock_rdlock(p);}
+int __wrap_pthread_rwlock_wrlock(pthread_rwlock_t *p) {if(recording)gates++;return __real_pthread_rwlock_wrlock(p);}
+__attribute__((noreturn)) void rt_fatal(const char *fmt,...) {(void)fmt;_exit(77);}
+static int lazy(uint64_t a) {lazy_calls++;return plat_mem_commit(a&~4095ull,4096);}
+static int watch(uint64_t a,uint64_t pc) {assert(pc);watch_calls++;return plat_mem_protect(a&~4095ull,4096,PLAT_PROT_RW);}
+static void begin(void) {gates=0;recording=1;}
+static void end(void) {recording=0;assert(gates<=2);}
+int main(void) {
+    Ps5GuestSpace *s=ps5_memory_space();assert(s);
+    assert(plat_mem_reserve(base,131072,1)&&plat_mem_commit(base,65536));
+    plat_mem_lazy_hook(lazy);plat_mem_watch_hook(watch);
+    begin();uint64_t v=rt_checked_scalar_load(base+24,8);end();assert(!v);
+    begin();rt_checked_scalar_store(base+24,0x8877665544332211ull,8);end();
+    begin();v=rt_checked_scalar_load(base+24,8);end();assert(v==0x8877665544332211ull);
+    u128 wide=((u128)0xabcdef0123456789ull<<64)|0x123456789abcdef0ull;
+    begin();rt_checked_vector_store(base+4088,wide);end();
+    begin();u128 out=rt_checked_vector_load(base+4088);end();assert(out==wide);
+    assert(!lazy_calls&&!watch_calls);
+    // An untouched reserved page still invokes lazy handling; ready repeats do not.
+    assert(!rt_checked_scalar_load(base+65536,8)&&lazy_calls==1);
+    begin();assert(!rt_checked_scalar_load(base+65536,8));end();assert(lazy_calls==1);
+    // A write-watch RO page falls back, then retries the same whole transaction.
+    assert(plat_mem_protect(base,4096,PLAT_PROT_READ));
+    rt_checked_vector_store(base+4088,wide+1);assert(watch_calls==1);
+    assert(rt_checked_vector_load(base+4088)==wide+1);
+    uint64_t pages[8];assert(plat_mem_written(base+4088,16,pages,8,1)==2);
+    // Invalid tail still rejects before changing the writable prefix.
+    plat_mem_watch_hook(0);assert(plat_mem_protect(base+4096,4096,PLAT_PROT_READ));
+    uint64_t before=rt_checked_scalar_load(base+4088,8);
+    pid_t pid=fork();assert(pid>=0);
+    if(!pid){rt_checked_vector_store(base+4088,0);_exit(99);}
+    int status;assert(waitpid(pid,&status,0)==pid);
+    assert(WIFEXITED(status)&&WEXITSTATUS(status)==77);
+    assert(rt_checked_scalar_load(base+4088,8)==before);
+}
+''')
+            sources=[ROOT/'runtime/platform'/f'{n}.c' for n in ('ps5_mem','ps5_guest_memory','ps5_cpu_memory','ps5_sync','common')]
+            includes=sorted({ROOT/'runtime'}|{p.parent for p in (ROOT/'runtime').rglob('*.h')})
+            exe=d/'fast'
+            subprocess.run(['clang','-O2','-DMKW_PS5_HOST_CHECK','-DMKW_CHECKED_MEMORY','-march=x86-64-v3',
+                '-ffunction-sections','-fdata-sections','-Wno-bitwise-instead-of-logical',
+                *['-I'+str(p) for p in includes],demand_include(),str(c),*map(str,sources),
+                str(FORK/'platform/src/checked_region.c'),*demand_sources(),'-pthread',
+                '-Wl,--gc-sections','-Wl,--wrap=pthread_rwlock_rdlock','-Wl,--wrap=pthread_rwlock_wrlock',
+                '-o',str(exe)],check=True)
+            subprocess.run([str(exe)],check=True,timeout=20)
+if __name__=='__main__':unittest.main()
