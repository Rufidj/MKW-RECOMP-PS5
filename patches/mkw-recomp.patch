+// MKWBOOT-079: the game's atomics without a lock, as its loads and stores (rt_ld*): when the page may be read (load) or read
+// and written (store, exchange, read-modify-write) directly, per its byte in fast[] through rt_fast_tab, the host atomic is made
+// on the guest address itself (16 bytes: an aligned AVX load, LOCK CMPXCHG16B). Every atomic took prepare (a registry lookup
+// per page) and then the registry and the region locks (4 percent of the CPU and the stripes' cache lines bounced between the
+// cores, 078). Anything else (a page not direct, an unaligned or odd width) takes the general path below, unchanged.
+static inline void page_dirty_a(const RtFastDesc *d, uint64_t a) {
+    if (d->dirty) { unsigned char *p = (unsigned char *)(d->dirty + (a >> 12)); if (!__atomic_load_n(p, __ATOMIC_RELAXED)) __atomic_store_n(p, 1, __ATOMIC_RELAXED); }
+}
+static inline const RtFastDesc *atomic_desc(uint64_t a, unsigned n, unsigned bits) {
+    if (__builtin_expect((n != 1 && n != 2 && n != 4 && n != 8 && n != 16) || (a & (n - 1)) || (a >> 39), 0)) return NULL;
+    const RtFastDesc *d = __atomic_load_n(&rt_fast_tab[a >> 24], __ATOMIC_ACQUIRE);
+    if (__builtin_expect(!d, 0)) return NULL;
+    if ((__atomic_load_n((const unsigned char *)(d->ok + (a >> 12)), __ATOMIC_ACQUIRE) & bits) != bits) return NULL;
+    return d;
+}
+static inline int cas16_host(volatile void *at, u128 *expected, u128 desired) {
+    uint64_t elo = (uint64_t)*expected, ehi = (uint64_t)(*expected >> 64), dlo = (uint64_t)desired, dhi = (uint64_t)(desired >> 64);
+    unsigned char ok;
+    __asm__ volatile("lock cmpxchg16b %1\n\tsete %0" : "=q"(ok), "+m"(*(volatile u128 *)at), "+a"(elo), "+d"(ehi) : "b"(dlo), "c"(dhi) : "memory", "cc");
+    *expected = ((u128)ehi << 64) | elo;
+    return ok;
+}
+static inline u128 load16_host(const volatile void *at) {
+    typedef long long v2 __attribute__((vector_size(16)));
+    v2 v; __asm__ volatile("vmovdqa %1, %0" : "=x"(v) : "m"(*(const volatile v2 *)at) : "memory");
+    u128 r; __builtin_memcpy(&r, &v, 16); return r;
+}
+static inline u128 host_load(uint64_t a, unsigned n) {
+    void *p = (void *)(uintptr_t)a;
+    switch (n) {
+    case 1: return __atomic_load_n((uint8_t *)p, __ATOMIC_SEQ_CST);
+    case 2: return __atomic_load_n((uint16_t *)p, __ATOMIC_SEQ_CST);
+    case 4: return __atomic_load_n((uint32_t *)p, __ATOMIC_SEQ_CST);
+    case 8: return __atomic_load_n((uint64_t *)p, __ATOMIC_SEQ_CST);
+    default: { __atomic_thread_fence(__ATOMIC_SEQ_CST); u128 v = load16_host(p); __atomic_thread_fence(__ATOMIC_SEQ_CST); return v; }
+    }
+}
+static inline int host_cas(uint64_t a, u128 *expected, u128 desired, unsigned n) {
+    void *p = (void *)(uintptr_t)a;
+    switch (n) {
+    case 1: { uint8_t e = (uint8_t)*expected; int ok = __atomic_compare_exchange_n((uint8_t *)p, &e, (uint8_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    case 2: { uint16_t e = (uint16_t)*expected; int ok = __atomic_compare_exchange_n((uint16_t *)p, &e, (uint16_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    case 4: { uint32_t e = (uint32_t)*expected; int ok = __atomic_compare_exchange_n((uint32_t *)p, &e, (uint32_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    case 8: { uint64_t e = (uint64_t)*expected; int ok = __atomic_compare_exchange_n((uint64_t *)p, &e, (uint64_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    default: return cas16_host(p, expected, desired);
+    }
+}
+u128 rt_checked_atomic_load(uint64_t a, unsigned n) {
+    if (__builtin_expect(atomic_desc(a, n, 1) != NULL, 1)) return host_load(a, n);
+    uint64_t pc = (uintptr_t)__builtin_return_address(0); u128 value = 0;
+    atomic_width(a, n, 0, pc);
+    Ps5GuestSpace *s = prepare(a, n, 0, pc);
+    if (!ps5_guest_atomic_load(s, a, &value, n)) invalid(a, n, 0, pc);
+    return value;
+}
+void rt_checked_atomic_store(uint64_t a, u128 value, unsigned n) {
+    const RtFastDesc *d = atomic_desc(a, n, 3);
+    if (__builtin_expect(d != NULL, 1)) {
+        void *p = (void *)(uintptr_t)a;
+        switch (n) {
+        case 1: __atomic_store_n((uint8_t *)p, (uint8_t)value, __ATOMIC_SEQ_CST); break;
+        case 2: __atomic_store_n((uint16_t *)p, (uint16_t)value, __ATOMIC_SEQ_CST); break;
+        case 4: __atomic_store_n((uint32_t *)p, (uint32_t)value, __ATOMIC_SEQ_CST); break;
+        case 8: __atomic_store_n((uint64_t *)p, (uint64_t)value, __ATOMIC_SEQ_CST); break;
