diff --git a/runtime/platform/ps5_guest_memory.c b/runtime/platform/ps5_guest_memory.c
new file mode 100644
index 0000000..c89ae93
--- /dev/null
+++ b/runtime/platform/ps5_guest_memory.c
@@ -0,0 +1,414 @@
+// Registry/lifetime gate for checked CPU and HLE access. SPDX-License-Identifier: MIT
+#include "ps5_guest_memory.h"
+#include <ps5platform/biglock.h>
+#include <ps5platform/checked_region.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+// Registry gate: ps5_biglock (readers overlap on per-stripe counters; map changes, cross-map copies and 16-byte
+// atomics are exclusive). Plain accesses and atomics up to 8 bytes hold it shared.
+#define MAP_LIMIT 64
+#define ADDRESS_LIMIT (1ull << 39)
+typedef struct { uint64_t base; size_t bytes; struct ps5_checked_region *region; int watch; } Mapping;
+// An immutable copy of the mappings, sorted by base, published with a release store each time they change (MKWBOOT-042):
+// the scalar and vector accesses of the game read it with no lock and no atomic read-modify-write. A replaced snapshot and a
+// retired region are kept 30 s before they are freed, so a reader that was preempted holding one still finds valid memory.
+typedef struct { Ps5FastSnap pub; Mapping maps[MAP_LIMIT]; RtFastDesc desc[MAP_LIMIT]; } Snap;   // pub.fm[i], maps[i] and desc[i] describe the same mapping
+// MKWBOOT-058: the table the generated game code reads inline (cpu.h rt_fast_desc), for the process space only (ps5_mem.c): per
+// 16 MiB, the descriptor of the mapping that wholly holds it in the current snapshot, NULL when none does. Each entry is one
+// pointer, replaced with a release store; the descriptors live in the snapshot, kept 30 s after it stops being current.
+const RtFastDesc *rt_fast_tab[1u << 15];
+typedef struct { void *ptr; int region; uint64_t at_ns; } Retired;
+#define RETIRED_MAX 512
+struct Ps5GuestSpace { Snap *snap; /* first: ps5_guest_fast() reads it */ int global; ps5_biglock lock; Mapping maps[MAP_LIMIT]; size_t count; Mapping *hint; Retired retired[RETIRED_MAX]; size_t nretired; };
+static uint64_t mono_ns(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return (uint64_t)t.tv_sec * 1000000000ull + (uint64_t)t.tv_nsec; }
+static int address_span(uint64_t a, size_t n) { return a < ADDRESS_LIMIT && n <= ADDRESS_LIMIT - a; }
+static Mapping *find(Ps5GuestSpace *s, uint64_t a) {
+    // The last mapping found first: nearly every access lands where the previous one did. The hint is only written and
+    // trusted while the registry gate is held, and unmap clears it under the exclusive gate.
+    Mapping *h = __atomic_load_n(&s->hint, __ATOMIC_RELAXED);
+    if (h && a >= h->base && a - h->base < h->bytes) return h;
+    for (size_t i = 0; i < s->count; i++)
+        if (a >= s->maps[i].base && a - s->maps[i].base < s->maps[i].bytes) {
+            __atomic_store_n(&s->hint, &s->maps[i], __ATOMIC_RELAXED);
+            return &s->maps[i];
+        }
+    return NULL;
+}
+// Called with the registry gate held exclusively, after s->maps changed. Frees what has waited long enough.
+static void retire(Ps5GuestSpace *s, void *ptr, int region) {
+    uint64_t now = mono_ns();
+    size_t keep = 0;
+    for (size_t i = 0; i < s->nretired; i++) {
+        if (now - s->retired[i].at_ns > 30000000000ull) {
+            if (s->retired[i].region) ps5_checked_free(s->retired[i].ptr); else free(s->retired[i].ptr);
+        } else s->retired[keep++] = s->retired[i];
+    }
+    s->nretired = keep;
+    if (!ptr) return;
+    if (s->nretired == RETIRED_MAX) return;   // never reached with 64 mappings and 30 s; leaking beats freeing early
+    s->retired[s->nretired++] = (Retired){ptr, region, now};
+}
+static void publish(Ps5GuestSpace *s) {
+    Snap *n = calloc(1, sizeof *n);
+    if (!n) abort();
+    n->pub.count = s->count;
+    memcpy(n->maps, s->maps, s->count * sizeof *n->maps);
+    for (size_t i = 1; i < s->count; i++)   // insertion sort by base
+        for (size_t j = i; j > 0 && n->maps[j].base < n->maps[j - 1].base; j--) { Mapping t = n->maps[j]; n->maps[j] = n->maps[j - 1]; n->maps[j - 1] = t; }
+    for (size_t i = 0; i < s->count; i++) {
+        n->pub.fm[i].base = n->maps[i].base, n->pub.fm[i].bytes = n->maps[i].bytes;
+        ps5_checked_arrays(n->maps[i].region, &n->pub.fm[i].rights, &n->pub.fm[i].backed, &n->pub.fm[i].dirty);
+        uint64_t first = (n->maps[i].base + 0xffffff) >> 24, end = (n->maps[i].base + n->maps[i].bytes) >> 24;   // granules wholly inside
+        for (uint64_t g = first; g < end && g < (1u << 15); g++) n->pub.granule[g] = (unsigned char)(i + 1);
+        unsigned char *fast = ps5_checked_fast(n->maps[i].region);
+        n->desc[i].ok = (uintptr_t)fast - (uintptr_t)(n->maps[i].base >> 12);
+        n->desc[i].dirty = n->pub.fm[i].dirty ? (uintptr_t)n->pub.fm[i].dirty - (uintptr_t)(n->maps[i].base >> 12) : 0;
+    }
+    if (s->global)
+        for (unsigned g = 0; g < (1u << 15); g++) {
+            const RtFastDesc *want = n->pub.granule[g] ? &n->desc[n->pub.granule[g] - 1] : NULL;
+            if (__atomic_load_n(&rt_fast_tab[g], __ATOMIC_RELAXED) != want) __atomic_store_n(&rt_fast_tab[g], want, __ATOMIC_RELEASE);
+        }
+    Snap *old = s->snap;
+    __atomic_store_n(&s->snap, n, __ATOMIC_RELEASE);
+    retire(s, old, 0);
+}
+static int host_buffer(Ps5GuestSpace *s, const void *host, size_t n) {
+    if (!n) return 1;
+    uintptr_t a = (uintptr_t)host;
+    if (!host || n > UINTPTR_MAX - a) return 0;
+    for (size_t i = 0; i < s->count; i++) {
+        Mapping *m = &s->maps[i]; size_t reserved = (m->bytes + 0xffff) & ~(size_t)0xffff;
+        if (a < m->base + reserved && m->base < a + n) return 0;
+    }
+    return 1;
+}
+// The registry read gate excludes unmap and protection changes for the complete
+// transaction. Single-map payload operations use the region lock; multi-map
+// copies and metadata mutations use the exclusive registry gate. Reads within
+// one region overlap; cross-map snapshots exclude every writer.
+// Owned SDK regions are never exposed, so validation stays valid.
+static int allowed(Ps5GuestSpace *s, uint64_t a, size_t n, int bit) {
+    if (!address_span(a, n)) return 0;
+    while (n) {
+        Mapping *m = find(s, a); if (!m) return 0;
+        size_t off = (size_t)(a - m->base), part = m->bytes - off;
+        if (part > n) part = n;
+        size_t last = (off + part - 1) / 0x1000;
+        for (size_t page = off / 0x1000; page <= last; page++) {
+            int rights = ps5_checked_access(m->region, page * 0x1000);
+            if (rights < 0 || !(rights & bit)) return 0;
+        }
+        a += part; n -= part;
+    }
+    return 1;
+}
+static int transfer(Ps5GuestSpace *s, uint64_t a, void *host, size_t n, int write) {
+    unsigned char *p = host;
+    while (n) {
+        Mapping *m = find(s, a); if (!m) return 0;
+        size_t off = (size_t)(a - m->base), part = m->bytes - off;
+        if (part > n) part = n;
+        int ok = write ? ps5_checked_write(m->region, off, p, part) : ps5_checked_read(m->region, off, p, part);
+        // Validation and exclusive ownership make rejection here an invariant
+        // violation. Returning a recoverable failure could hide a partial write.
+        if (!ok) __builtin_trap();
+        a += part; p += part; n -= part;
+    }
+    return 1;
+}
+static int prepare_write(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    while (n) {
+        Mapping *m = find(s, a); if (!m) return 0;
+        size_t off = (size_t)(a - m->base), part = m->bytes - off; if (part > n) part = n;
+        if (!ps5_checked_prepare_write(m->region, off, part)) return 0;
+        a += part; n -= part;
+    }
+    return 1;
+}
+Ps5GuestSpace *ps5_guest_space_create(void) {
+    Ps5GuestSpace *s = calloc(1, sizeof *s);
+    if (s && ps5_biglock_init(&s->lock)) { free(s); return NULL; }
+    return s;
+}
+void ps5_guest_space_destroy(Ps5GuestSpace *s) {
+    if (!s) return;
+    // Caller must stop all users, just as for region destruction.
+    for (size_t i = 0; i < s->count; i++) ps5_checked_destroy(s->maps[i].region);
+    for (size_t i = 0; i < s->nretired; i++) { if (s->retired[i].region) ps5_checked_free(s->retired[i].ptr); else free(s->retired[i].ptr); }
+    free(s->snap);
+    ps5_biglock_destroy(&s->lock); free(s);
+}
+int ps5_guest_map(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    if (!n || !address_span(a, n)) return 0;
+    unsigned lt = ps5_biglock_wrlock(&s->lock);
+    struct ps5_checked_region *r = NULL;
+    int ok = s->count < MAP_LIMIT && ps5_checked_create((uintptr_t)a, n, &r);
+    if (ok) { s->maps[s->count++] = (Mapping){a, n, r, -1}; publish(s); }
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_reserve(Ps5GuestSpace *s, uint64_t a, size_t n, int watch) {
+    if (!n || !address_span(a, n)) return 0;
+    unsigned lt = ps5_biglock_wrlock(&s->lock); struct ps5_checked_region *r = NULL;
+    int ok = s->count < MAP_LIMIT && ps5_checked_create_sparse((uintptr_t)a, n, watch, &r);
+    if (ok) { s->maps[s->count++] = (Mapping){a, n, r, !!watch}; publish(s); }
+#ifdef __PROSPERO__
+    if (!ok) {   // MKWBOOT-060: why a reservation failed, before the log exists
+        void ps5_early_mark(const char *);
+        char m[400]; snprintf(m, sizeof m, "reserve %#llx+%#llx watch %d failed (maps %zu): %s", (unsigned long long)a, (unsigned long long)n, watch, s->count, ps5_checked_last_failure());
+        ps5_early_mark(m);
+    }
+#endif
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+static int change_commit(Ps5GuestSpace *s, uint64_t a, size_t n, int commit) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); Mapping *m = find(s, a);
+    int ok = m && n <= m->bytes - (a - m->base);
+    if (ok) ok = commit ? ps5_checked_commit(m->region, (size_t)(a - m->base), n) :
+                         ps5_checked_decommit(m->region, (size_t)(a - m->base), n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_commit(Ps5GuestSpace *s, uint64_t a, size_t n) { return change_commit(s, a, n, 1); }
+int ps5_guest_decommit(Ps5GuestSpace *s, uint64_t a, size_t n) { return change_commit(s, a, n, 0); }
+int ps5_guest_replace(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); Mapping *m = find(s, a);
+    int ok = m && n <= m->bytes - (a - m->base) &&
+             ps5_checked_decommit(m->region, (size_t)(a - m->base), n) &&
+             ps5_checked_commit(m->region, (size_t)(a - m->base), n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_prepare_write(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); int ok = allowed(s, a, n, 2) && prepare_write(s, a, n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_watch_mode(Ps5GuestSpace *s, uint64_t a) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); Mapping *m = find(s, a); int result = m ? m->watch : -2;
+    ps5_biglock_unlock(&s->lock, lt); return result;
+}
+int ps5_guest_query(Ps5GuestSpace *s, uint64_t a, uint64_t limit, uint64_t *end) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); Mapping *m = find(s, a); int result = -2;
+    uint64_t next = limit;
+    if (m && a < limit) {
+        uint64_t hi = m->base + m->bytes; if (hi > limit) hi = limit;
+        size_t relative = (size_t)(a - m->base), stop = relative;
+        result = ps5_checked_run(m->region, relative, (size_t)(hi - m->base), &stop);
+        next = m->base + stop;
+    } else for (size_t i = 0; i < s->count; i++) if (s->maps[i].base > a && s->maps[i].base < next) next = s->maps[i].base;
+    if (end) *end = next;
+    ps5_biglock_unlock(&s->lock, lt); return result;
+}
+int ps5_guest_unmap(Ps5GuestSpace *s, uint64_t a) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); int ok = 0;
+    for (size_t i = 0; i < s->count; i++) if (s->maps[i].base == a) {
+        __atomic_store_n(&s->hint, NULL, __ATOMIC_RELAXED);
+        struct ps5_checked_region *gone = s->maps[i].region;
+        ps5_checked_retire(gone);   // the host range goes now, every later access fails; the metadata waits (retire)
+        s->maps[i] = s->maps[--s->count]; s->maps[s->count] = (Mapping){0}; ok = 1;
+        publish(s);
+        retire(s, gone, 1);
+        break;
+    }
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_protect(Ps5GuestSpace *s, uint64_t a, size_t n, int rights) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); Mapping *m = find(s, a);
+    int ok = m && n <= m->bytes - (a - m->base) &&
+             ps5_checked_protect(m->region, (size_t)(a - m->base), n, rights);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_access(Ps5GuestSpace *s, uint64_t a) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); Mapping *m = find(s, a);
+    int result = m ? ps5_checked_access(m->region, (size_t)(a - m->base)) : -1;
+    ps5_biglock_unlock(&s->lock, lt); return result;
+}
+static int copy_host(Ps5GuestSpace *s, uint64_t a, void *host, size_t n, int write) {
+    // The common scalar/vector case needs one registry lifetime gate and
+    // one checked region operation. The SDK validates the complete range,
+    // prepares backing and records dirty pages under its own region lock.
+    unsigned lt = ps5_biglock_rdlock(&s->lock);
+    Mapping *m = find(s, a);
+    if (m && n <= m->bytes - (a - m->base) && address_span(a, n) && host_buffer(s, host, n)) {
+        size_t offset = (size_t)(a - m->base);
+        int ok = write ? ps5_checked_write(m->region, offset, host, n) :
+                         ps5_checked_read(m->region, offset, host, n);
+        ps5_biglock_unlock(&s->lock, lt);
+        return ok;
+    }
+    ps5_biglock_unlock(&s->lock, lt);
+    // Rare multi-map copies retain exclusive whole-transaction ownership,
+    // including reads: a single-map writer must not split their snapshot.
+    lt = ps5_biglock_wrlock(&s->lock);
+    int ok = host_buffer(s, host, n) && allowed(s, a, n, write ? 2 : 1);
+    unsigned char local[256];
+    void *stage = ok && n ? (n <= sizeof local ? local : malloc(n)) : NULL;
+    if (ok && n && !stage) ok = 0;
+    if (ok && write) ok = prepare_write(s, a, n);
+    if (ok && n) {
+        if (write) memcpy(stage, host, n);
+        transfer(s, a, stage, n, write);
+        if (!write) memcpy(host, stage, n);
+    }
+    if (stage != local) free(stage);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+// Scalar and vector accesses (up to 16 bytes, host buffer on the caller's stack) with no lock and no atomic read-modify-write:
+// the snapshot of the mappings, the page rights and the backing are read as plain loads, as the hardware's page tables would be.
+// 1 done, 0 rejected, -1: take the general path (spans mappings, unbacked store...). A racing unmap, decommit or protection
+// change on the very page being accessed can fault, as it would on the console: that is a bug of the game, not a case to lock.
+static inline Mapping *snap_find(Snap *sn, uint64_t a) {
+    uint64_t g = a >> 24;
+    if (g < (1u << 15) && sn->pub.granule[g]) return &sn->maps[sn->pub.granule[g] - 1];
+    size_t lo = 0, hi = sn->pub.count;
+    while (lo < hi) {
+        size_t mid = (lo + hi) >> 1;
+        if (a < sn->pub.fm[mid].base) hi = mid;
+        else if (a - sn->pub.fm[mid].base >= sn->pub.fm[mid].bytes) lo = mid + 1;
+        else return &sn->maps[mid];
+    }
+    return NULL;
+}
+int ps5_guest_read_fast(Ps5GuestSpace *s, uint64_t a, void *out, size_t n) {
+    Snap *sn = __atomic_load_n(&s->snap, __ATOMIC_ACQUIRE);
+    if (!sn) return -1;
+    Mapping *m = snap_find(sn, a);
+    if (!m || n > m->bytes - (a - m->base) || !address_span(a, n)) return -1;
+    return ps5_checked_read_gated(m->region, (size_t)(a - m->base), out, n);
+}
+int ps5_guest_write_fast(Ps5GuestSpace *s, uint64_t a, const void *in, size_t n) {
+    Snap *sn = __atomic_load_n(&s->snap, __ATOMIC_ACQUIRE);
+    if (!sn) return -1;
+    Mapping *m = snap_find(sn, a);
+    if (!m || n > m->bytes - (a - m->base) || !address_span(a, n)) return -1;
+    return ps5_checked_write_gated(m->region, (size_t)(a - m->base), in, n);
+}
+int ps5_guest_read(Ps5GuestSpace *s, uint64_t a, void *out, size_t n) { return copy_host(s, a, out, n, 0); }
+int ps5_guest_write(Ps5GuestSpace *s, uint64_t a, const void *in, size_t n) { return copy_host(s, a, (void *)in, n, 1); }
+// MKWBOOT-058: copies and fills of the game (hle_memmove, ps5_hle_memset: 73000 + 18000 a second in a race) took the registry
+// gate exclusively, which stopped every other checked access of every thread (1.3 s of waiting in 5 s, MKWBOOT-057). When the
+// whole range lies in one mapping and every page of it may be read (source) or written (destination) directly, the copy goes
+// straight to memory, as the scalar accesses do: the same per-page answer from the region's fast[] (granted and backed), the
+// dirty pages marked after. Anything else takes the general path below. A racing unmap/protect of these pages can fault, as on the console.
+// MKW_FASTCOPY=0 (mkw.ini FASTCOPY=0) keeps every copy and fill on the general path; read once at the first copy: bisection of MKWBOOT-058, which did not reach its log on the console.
+const char *cfg_get(const char *name) __attribute__((weak));   // absent in the host tests: everything on
+static int knob(const char *name, int *cache) {
+    int v = __atomic_load_n(cache, __ATOMIC_RELAXED);
+    if (v < 0) { const char *e = cfg_get ? cfg_get(name) : NULL; v = !(e && !strcmp(e, "0")); __atomic_store_n(cache, v, __ATOMIC_RELAXED); }
+    return v;
+}
+static int fastcopy_on = -1;
+static const RtFastDesc *fast_range(Snap *sn, uint64_t a, size_t n, unsigned bit) {
+    if (!knob("MKW_FASTCOPY", &fastcopy_on)) return NULL;
+    if (!n || !address_span(a, n)) return NULL;
+    Mapping *m = snap_find(sn, a);
+    if (!m || n > m->bytes - (a - m->base)) return NULL;
+    const RtFastDesc *d = &sn->desc[m - sn->maps];
+    for (uint64_t p = a >> 12, last = (a + n - 1) >> 12; p <= last; p++)
+        if (!(__atomic_load_n((const unsigned char *)(d->ok + p), __ATOMIC_ACQUIRE) & bit)) return NULL;
+    return d;
+}
+static void fast_dirty(const RtFastDesc *d, uint64_t a, size_t n) {
+    if (!d->dirty) return;
+    for (uint64_t p = a >> 12, last = (a + n - 1) >> 12; p <= last; p++) {
+        unsigned char *b = (unsigned char *)(d->dirty + p);
+        if (!__atomic_load_n(b, __ATOMIC_RELAXED)) __atomic_store_n(b, 1, __ATOMIC_RELAXED);
+    }
+}
+int ps5_guest_copy(Ps5GuestSpace *s, uint64_t dst, uint64_t src, size_t n) {
+    Snap *sn = __atomic_load_n(&s->snap, __ATOMIC_ACQUIRE);
+    if (sn && n) {
+        const RtFastDesc *ds = fast_range(sn, src, n, 1), *dd = ds ? fast_range(sn, dst, n, 2) : NULL;
+        if (dd) { memmove((void *)(uintptr_t)dst, (const void *)(uintptr_t)src, n); fast_dirty(dd, dst, n); return 1; }
+    }
+    unsigned lt = ps5_biglock_wrlock(&s->lock);
+    int ok = allowed(s, src, n, 1) && allowed(s, dst, n, 2);
+    void *stage = ok && n ? malloc(n) : NULL;
+    if (ok && n && !stage) ok = 0;
+    if (ok) ok = prepare_write(s, dst, n);
+    if (ok && n) { transfer(s, src, stage, n, 0); transfer(s, dst, stage, n, 1); }
+    free(stage); ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_fill(Ps5GuestSpace *s, uint64_t a, unsigned char value, size_t n) {
+    Snap *sn = __atomic_load_n(&s->snap, __ATOMIC_ACQUIRE);
+    if (sn && n) {
+        const RtFastDesc *d = fast_range(sn, a, n, 2);
+        if (d) { memset((void *)(uintptr_t)a, value, n); fast_dirty(d, a, n); return 1; }
+    }
+    unsigned lt = ps5_biglock_wrlock(&s->lock); int ok = allowed(s, a, n, 2);
+    void *stage = ok && n ? malloc(n) : NULL;
+    if (ok && n && !stage) ok = 0;
+    if (ok) ok = prepare_write(s, a, n);
+    if (ok && n) { memset(stage, value, n); transfer(s, a, stage, n, 1); }
+    free(stage); ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+static Mapping *atomic_map(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    Mapping *m = find(s, a);
+    return m && n <= m->bytes - (a - m->base) ? m : NULL;
+}
+int ps5_guest_atomic_load(Ps5GuestSpace *s, uint64_t a, void *out, size_t n) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); /* MKWBOOT-071: 16 bytes too (CMPXCHG16B in the SDK region) */ Mapping *m = atomic_map(s, a, n);
+    int ok = m && host_buffer(s, out, n) && ps5_checked_atomic_load(m->region, (size_t)(a - m->base), out, n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_atomic_store(Ps5GuestSpace *s, uint64_t a, const void *in, size_t n) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); /* MKWBOOT-071: 16 bytes too (CMPXCHG16B in the SDK region) */ Mapping *m = atomic_map(s, a, n);
+    int ok = m && host_buffer(s, in, n) && ps5_checked_atomic_store(m->region, (size_t)(a - m->base), in, n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_atomic_cas(Ps5GuestSpace *s, uint64_t a, void *expected, const void *desired, size_t n, int *exchanged) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); /* MKWBOOT-071: 16 bytes too (CMPXCHG16B in the SDK region) */ Mapping *m = atomic_map(s, a, n);
+    int ok = m && host_buffer(s, expected, n) && host_buffer(s, desired, n) && host_buffer(s, exchanged, sizeof *exchanged) &&
+             ps5_checked_atomic_cas(m->region, (size_t)(a - m->base), expected, desired, n, exchanged);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+static int privileged(Ps5GuestSpace *s, uint64_t a, void *host, size_t n, int write) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); Mapping *m = find(s, a);
+    // Privileged copies are currently scoped to a single reservation. The
+    // loader and memory services know their reservation boundaries.
+    int ok = m && n <= m->bytes - (a - m->base) && host_buffer(s, host, n);
+    if (ok) ok = write ? ps5_checked_poke(m->region, (size_t)(a - m->base), host, n) :
+                        ps5_checked_peek(m->region, (size_t)(a - m->base), host, n);
+    ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+int ps5_guest_peek(Ps5GuestSpace *s, uint64_t a, void *out, size_t n) { return privileged(s, a, out, n, 0); }
+int ps5_guest_poke(Ps5GuestSpace *s, uint64_t a, const void *in, size_t n) { return privileged(s, a, (void *)in, n, 1); }
+int ps5_guest_readable(Ps5GuestSpace *s, uint64_t a, size_t n) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); int ok = allowed(s, a, n, 1); ps5_biglock_unlock(&s->lock, lt); return ok;
+}
+uint64_t ps5_guest_backed_bytes(Ps5GuestSpace *s) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock); uint64_t total = 0;
+    for (size_t i = 0; i < s->count; i++) {
+        uint64_t n = ps5_checked_backed_bytes(s->maps[i].region);
+        if (n == UINT64_MAX || n > UINT64_MAX - total) { total = UINT64_MAX; break; }
+        total += n;
+    }
+    ps5_biglock_unlock(&s->lock, lt); return total;
+}
+uint64_t ps5_guest_written(Ps5GuestSpace *s, uint64_t a, size_t n, uint64_t *pages, size_t max, int reset) {
+    unsigned lt = ps5_biglock_rdlock(&s->lock); Mapping *m = find(s, a);   // MKWBOOT-092: shared, a single-map query
+    uint64_t count = UINT64_MAX;
+    if (m && n <= m->bytes - (a - m->base) && max <= SIZE_MAX / sizeof(*pages) &&
+        host_buffer(s, pages, max * sizeof(*pages)))
+        count = ps5_checked_written(m->region, (size_t)(a - m->base), n, pages, max, reset);
+    ps5_biglock_unlock(&s->lock, lt); return count;
+}
+
+// The process space (ps5_mem.c): its mappings also go to rt_fast_tab for the inline checks of the game code.
+void ps5_guest_space_global(Ps5GuestSpace *s) {
+    unsigned lt = ps5_biglock_wrlock(&s->lock);
+    s->global = 1;
+    publish(s);
+    ps5_biglock_unlock(&s->lock, lt);
+}
+
+// MKWBOOT-066: the mappings, as text (ps5_mem.c logs them once next to the access misses)
+int ps5_guest_describe(Ps5GuestSpace *s, char *buf, size_t size) {
+    int n = 0; buf[0] = 0;
+    Snap *sn = s ? __atomic_load_n(&s->snap, __ATOMIC_ACQUIRE) : NULL;
+    for (size_t i = 0; sn && i < sn->pub.count && n < (int)size - 60; i++)
+        n += snprintf(buf + n, size - (size_t)n, " [%#llx +%#llx%s]", (unsigned long long)sn->maps[i].base,
+                      (unsigned long long)sn->maps[i].bytes, sn->maps[i].watch > 0 ? " watched" : "");
+    return n;
+}
diff --git a/runtime/platform/ps5_guest_memory.h b/runtime/platform/ps5_guest_memory.h
new file mode 100644
index 0000000..d7b3dda
--- /dev/null
+++ b/runtime/platform/ps5_guest_memory.h
@@ -0,0 +1,56 @@
+// Checked mapped-region registry shared by CPU hooks and HLE copies. SPDX-License-Identifier: MIT
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+typedef struct Ps5GuestSpace Ps5GuestSpace;
+// The mappings as the registry publishes them (MKWBOOT-043): an immutable copy sorted by base, replaced with a release store
+// whenever a mapping is added or removed. The CPU hooks (ps5_cpu_memory.c) read it with plain loads and check an access
+// inline against the page rights, the backing flags and the dirty bytes of the region: no lock, no function chain. A region that
+// is poisoned or unmapped has every page RESERVED (no read or write bit), so a stale copy refuses it. Host address == guest
+// address. A copy and the arrays it points to stay valid 30 s after they stop being current.
+typedef struct { uint64_t base, bytes; unsigned char *rights, *backed, *dirty; } Ps5FastMap;   // rights: 1 read, 2 write per 4 KiB; backed: per 64 KiB (NULL: eager); dirty: per 4 KiB (NULL: not watched)
+// granule[a >> 24]: 1 + the index of the mapping that wholly contains that 16 MiB of address space, 0 when none does (a smaller
+// mapping, a gap, or a boundary): read-only, so no cache line is ever written by the threads that use it.
+typedef struct { size_t count; Ps5FastMap fm[64]; unsigned char granule[1u << 15]; } Ps5FastSnap;
+typedef struct { uintptr_t ok, dirty; } RtFastDesc;   // MKWBOOT-058/064: per mapping, biased so that ok + (a >> 12) is the page byte
+extern const RtFastDesc *rt_fast_tab[1u << 15];        // per 16 MiB of the process space (ps5_guest_space_global), NULL: none
+static inline const Ps5FastSnap *ps5_guest_fast(Ps5GuestSpace *s) { return __atomic_load_n((Ps5FastSnap *const *)s, __ATOMIC_ACQUIRE); }   // the first member of the space
+// Owns its mappings exclusively. Clients must use this API for every access and
+// permission change; never access the backing SDK regions directly. Not yet a
+// transparent raw-pointer backend: eager mappings and sparse reservations share
+// logical 4 KiB commit/protection and checked copies. No aliases or GPU views.
+Ps5GuestSpace *ps5_guest_space_create(void);
+void ps5_guest_space_global(Ps5GuestSpace *);
+int ps5_guest_describe(Ps5GuestSpace *, char *buf, size_t size);   // MKWBOOT-066: the mappings as text   // MKWBOOT-058: publish this space to rt_fast_tab too (the process space only)
+void ps5_guest_space_destroy(Ps5GuestSpace *);
+int ps5_guest_map(Ps5GuestSpace *, uint64_t base, size_t bytes);
+int ps5_guest_reserve(Ps5GuestSpace *, uint64_t base, size_t bytes, int watch);
+int ps5_guest_commit(Ps5GuestSpace *, uint64_t address, size_t bytes);
+int ps5_guest_decommit(Ps5GuestSpace *, uint64_t address, size_t bytes);
+int ps5_guest_replace(Ps5GuestSpace *, uint64_t address, size_t bytes);
+int ps5_guest_prepare_write(Ps5GuestSpace *, uint64_t address, size_t bytes);
+// Watch mode of an owning map: 0/1 for reservations, -1 for eager maps,
+// -2 when unmapped. Query returns SDK rights, -1 poisoned, -2 unmapped.
+int ps5_guest_watch_mode(Ps5GuestSpace *, uint64_t address);
+int ps5_guest_query(Ps5GuestSpace *, uint64_t address, uint64_t limit, uint64_t *end);
+int ps5_guest_unmap(Ps5GuestSpace *, uint64_t base);
+int ps5_guest_protect(Ps5GuestSpace *, uint64_t address, size_t bytes, int rights);
+// Whole-range checks before changing bytes, including spans across adjacent maps.
+// Trusted host buffers must not alias any mapping. Copies may allocate staging.
+int ps5_guest_read(Ps5GuestSpace *, uint64_t, void *, size_t);
+int ps5_guest_write(Ps5GuestSpace *, uint64_t, const void *, size_t);
+int ps5_guest_copy(Ps5GuestSpace *, uint64_t destination, uint64_t source, size_t);
+int ps5_guest_fill(Ps5GuestSpace *, uint64_t, unsigned char value, size_t);
+int ps5_guest_peek(Ps5GuestSpace *, uint64_t, void *, size_t);
+int ps5_guest_poke(Ps5GuestSpace *, uint64_t, const void *, size_t);
+uint64_t ps5_guest_backed_bytes(Ps5GuestSpace *);
+uint64_t ps5_guest_written(Ps5GuestSpace *, uint64_t, size_t, uint64_t *, size_t, int reset);
+int ps5_guest_readable(Ps5GuestSpace *, uint64_t, size_t);
+// Logical rights at an address, -1 for an unmapped/invalid address.
+int ps5_guest_access(Ps5GuestSpace *, uint64_t);
+int ps5_guest_atomic_load(Ps5GuestSpace *, uint64_t, void *, size_t);
+int ps5_guest_atomic_store(Ps5GuestSpace *, uint64_t, const void *, size_t);
+int ps5_guest_atomic_cas(Ps5GuestSpace *, uint64_t, void *, const void *, size_t, int *);
+/* Up to 16 bytes with the host buffer on the caller's stack: 1 done, 0 rejected, -1 use the general ps5_guest_read/write. */
+int ps5_guest_read_fast(Ps5GuestSpace *, uint64_t address, void *out, size_t bytes);
+int ps5_guest_write_fast(Ps5GuestSpace *, uint64_t address, const void *in, size_t bytes);
diff --git a/runtime/platform/ps5_hle_copy.c b/runtime/platform/ps5_hle_copy.c
new file mode 100644
index 0000000..ec81f62
--- /dev/null
+++ b/runtime/platform/ps5_hle_copy.c
@@ -0,0 +1,76 @@
+// Checked bulk memory for native SDK overrides. SPDX-License-Identifier: MIT
+#include "ps5_mem.h"
+#include "ps5_hle_copy.h"
+#include "core/base/host.h"
+#include <stdint.h>
+#include <string.h>
+#include <time.h>
+#include "platform/platform.h"
+static int owned(Ps5GuestSpace *s,const void *p){return ps5_guest_watch_mode(s,(uintptr_t)p)>=-1;}
+// MKWBOOT-045: a rejected range is retried for ~20 ms (another thread's commit, decommit or write-watch may be settling it)
+// and, if it stays rejected, the fatal names the first page that is not usable, its rights and the region's watch mode.
+static void prepare(const void *p,size_t n,int write){
+    uintptr_t a=(uintptr_t)p,pc=(uintptr_t)__builtin_return_address(0);
+    int attempt=0;
+    for(;;attempt++){
+        if(ps5_memory_before_access(a,n,write,pc))return;
+        if(attempt>=20)break;
+        struct timespec ts={0,1000000};nanosleep(&ts,NULL);
+    }
+    Ps5GuestSpace *s=ps5_memory_space();
+    uint64_t bad=0;int rights=0;
+    for(uint64_t at=a&~0xfffull;at<a+n;at+=0x1000){
+        int r=ps5_guest_access(s,at);
+        if(r<0||!(r&(write?2:1))){bad=at;rights=r;break;}
+    }
+    rt_fatal("PS5 HLE %s rejected: %p + %llu: first unusable page %#llx has rights %d (1 read, 3 read+write, 4 reserved, -1 unmapped or poisoned), watch mode %d, %d retries",
+             write?"write":"read",p,(unsigned long long)n,(unsigned long long)bad,rights,ps5_guest_watch_mode(s,bad?bad:a),attempt);
+}
+// MKWBOOT-022 measurement, no behaviour change: the startup worker spends most samples in this call. Totals every
+// 256 MiB and every single copy of 50 ms or more are logged (first 24), to tell checked-copy cost from game work.
+static uint64_t st_calls, st_bytes, st_ns, st_next = 256u << 20, st_slow;
+static void *hle_memmove(void *dst,const void *src,size_t n){if(!n)return dst;Ps5GuestSpace *s=ps5_memory_space();int d=owned(s,dst),r=owned(s,src);if(!d&&!r)return memmove(dst,src,n);if(r)prepare(src,n,0);if(d)prepare(dst,n,1);int ok=d&&r?ps5_guest_copy(s,(uintptr_t)dst,(uintptr_t)src,n):d?ps5_guest_write(s,(uintptr_t)dst,src,n):ps5_guest_read(s,(uintptr_t)src,dst,n);if(!ok)rt_fatal("PS5 HLE copy failed: %p <- %p + %llu",dst,src,(unsigned long long)n);return dst;}
+void *ps5_hle_memmove(void *dst,const void *src,size_t n){
+    if(n<4096)return hle_memmove(dst,src,n);   // small copies: counted nowhere, two clock reads would cost more
+    uint64_t t0=plat_now_ns();
+    void *r=hle_memmove(dst,src,n);
+    uint64_t dt=plat_now_ns()-t0;
+    uint64_t bytes=__atomic_add_fetch(&st_bytes,n,__ATOMIC_RELAXED);
+    __atomic_add_fetch(&st_calls,1,__ATOMIC_RELAXED);
+    uint64_t ns=__atomic_add_fetch(&st_ns,dt,__ATOMIC_RELAXED);
+    if(dt>=50000000ull&&__atomic_fetch_add(&st_slow,1,__ATOMIC_RELAXED)<24)
+        rt_log("hle copy: %llu bytes took %.1f ms (%.0f MiB/s)",(unsigned long long)n,dt/1e6,n/1048576.0/(dt/1e9));
+    uint64_t next=__atomic_load_n(&st_next,__ATOMIC_RELAXED);
+    if(bytes>=next&&__atomic_compare_exchange_n(&st_next,&next,next+(256u<<20),0,__ATOMIC_RELAXED,__ATOMIC_RELAXED))
+        rt_log("hle copy: %llu copies of 4 KiB or more, %.0f MiB, %.0f ms summed over threads (%.0f MiB/s)",
+               (unsigned long long)__atomic_load_n(&st_calls,__ATOMIC_RELAXED),bytes/1048576.0,ns/1e6,bytes/1048576.0/(ns/1e9));
+    return r;
+}
+void *ps5_hle_memcpy(void *dst,const void *src,size_t n){return ps5_hle_memmove(dst,src,n);}
+void *ps5_hle_memset(void *dst,int value,size_t n){if(!n)return dst;Ps5GuestSpace *s=ps5_memory_space();if(!owned(s,dst))return memset(dst,value,n);prepare(dst,n,1);if(!ps5_guest_fill(s,(uintptr_t)dst,(unsigned char)value,n))rt_fatal("PS5 HLE fill failed: %p + %llu",dst,(unsigned long long)n);return dst;}
+
+// Keep source snapshots private and bounded; never expose sparse guest memory
+// to a libc vector load, which could bypass logical rights or backing checks.
+int ps5_hle_memcmp(const void *left, const void *right, size_t n) {
+    if (!n) return 0;
+    Ps5GuestSpace *s = ps5_memory_space();
+    int l = owned(s, left), r = owned(s, right);
+    if (!l && !r) return memcmp(left, right, n);
+    if (l) prepare(left, n, 0);
+    if (r) prepare(right, n, 0);
+    unsigned char a[4096], b[4096];
+    while (n) {
+        size_t part = n < sizeof a ? n : sizeof a;
+        const unsigned char *x = left, *y = right;
+        if (l) { if (!ps5_guest_read(s, (uintptr_t)left, a, part)) rt_fatal("PS5 HLE compare left rejected"); x = a; }
+        if (r) { if (!ps5_guest_read(s, (uintptr_t)right, b, part)) rt_fatal("PS5 HLE compare right rejected"); y = b; }
+        if (memcmp(x, y, part)) {
+            // Match the SDK's exact unsigned-byte difference, including high bits.
+            for (size_t i = 0; i < part; i++) if (x[i] != y[i]) return (int)x[i] - (int)y[i];
+        }
+        left = (const unsigned char *)left + part;
+        right = (const unsigned char *)right + part;
+        n -= part;
+    }
+    return 0;
+}
