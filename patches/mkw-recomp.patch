+    if (__builtin_expect(!(__atomic_load_n(&m->rights[off >> 12], __ATOMIC_RELAXED) & 1), 0)) return 0;
+    if (m->backed && !__atomic_load_n(&m->backed[off >> 16], __ATOMIC_ACQUIRE)) { memset(out, 0, n); return 1; }
