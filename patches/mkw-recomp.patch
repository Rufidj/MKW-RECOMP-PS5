+    assert(plat_mem_state(heap, heap + 8192, &end) == PLAT_PROT_READ && end == heap + 4096);
+    plat_mem_lazy_hook(lazy); plat_mem_watch_hook(watch);
+    assert(ps5_memory_before_access(heap + 8192, 8, 0, 0x1234) && faults == 1);
+    assert(ps5_memory_before_access(heap, 8, 1, 0x1234) && watches == 1);
+    assert(plat_fault_write && plat_fault_pc == 0x1234);
+    // Production hooks have no probe scope or per-pthread address-space binding.
+    plat_mem_watch_hook(NULL);
+    rt_checked_scalar_store(heap, 0xfedcba9876543210ull, 8);
+    assert(rt_checked_scalar_load(heap, 8) == 0xfedcba9876543210ull);
+    u128 vector = ((u128)17 << 64) | 29;
+    rt_checked_vector_store(heap + 16, vector);
