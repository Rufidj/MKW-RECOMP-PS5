+extern atomic_int demand_test_fixed_reject, demand_test_relocate_fail, demand_test_relocated;
+extern atomic_int demand_test_live_allocs, demand_test_fail_alloc, demand_test_map_calls, demand_test_fail_map;
+static pthread_barrier_t barrier;
+struct worker { volatile unsigned char *data; int index; };
+static void *touch_worker(void *arg)
+{
+   struct worker *work = arg;
+   assert(!ps5_demand_thread_attach());
+   pthread_barrier_wait(&barrier);
+   // All workers fault on the same unit but write different bytes.
+   assert(work->data[work->index] == 0);
+   work->data[work->index] = (unsigned char)(work->index + 1);
+   ps5_demand_thread_detach();
+   return NULL;
+}
+static void *churn_worker(void *arg)
+{
+   struct worker *work = arg;
+   assert(!ps5_demand_thread_attach());
+   pthread_barrier_wait(&barrier);
+   for (size_t i = 0; i < 64; i++) {
+      size_t at = (i * 2 + (unsigned)work->index) * UNIT;
+      assert(work->data[at] == 0);
+      work->data[at] = 17;
+   }
+   ps5_demand_thread_detach();
+   return NULL;
+}
+static void expect_fault(void *address, int execute)
+{
+   pid_t child = fork(); assert(child >= 0);
+   if (!child) {
+      if (execute) ((void (*)(void))address)();
+      else (void)*(volatile char *)address;
+      _exit(7);
+   }
+   int status;
+   assert(waitpid(child, &status, 0) == child);
+   assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+}
+
+static void shared_dispatch(int sig, siginfo_t *info, void *context)
+{
+   ucontext_t *u = context;
+   unsigned error = (unsigned)u->uc_mcontext.gregs[REG_ERR];
+   unsigned access = error & 16 ? PS5_DEMAND_EXECUTE : error & 2 ? PS5_DEMAND_WRITE : PS5_DEMAND_READ;
+   int saved_errno = errno;
+   if (sig == SIGSEGV && info->si_code > 0 && ps5_demand_access((uintptr_t)info->si_addr, access)) {
+      errno = saved_errno; return;
+   }
+   _exit(88); // The consumer's crash-report path, distinct from success/looping.
+}
+static void unrelated_dispatch(int sig, siginfo_t *info, void *context)
+{ (void)sig; (void)info; (void)context; _exit(89); }
+static void expect_shared_fault(void *address, unsigned access)
+{
+   pid_t child = fork(); assert(child >= 0);
+   if (!child) {
+      if (access == PS5_DEMAND_EXECUTE) ((void (*)(void))address)();
+      else if (access == PS5_DEMAND_WRITE) *(volatile char *)address = 1;
+      else (void)*(volatile char *)address;
+      _exit(7);
+   }
+   int status; assert(waitpid(child, &status, 0) == child);
+   assert(WIFEXITED(status) && WEXITSTATUS(status) == 88);
+}
+static void test_shared_dispatch(void)
+{
+   struct sigaction old, action = {.sa_sigaction = shared_dispatch, .sa_flags = SA_SIGINFO | SA_ONSTACK};
+   sigemptyset(&action.sa_mask); assert(!sigaction(SIGSEGV, &action, &old));
+   struct ps5_demand_region *region = NULL;
+   const size_t bytes = 74973184; // Actual MKWBOOT-001 dispatch-table allocation.
+   assert(ps5_demand_create(bytes, 0, &region)); // Reproduces the unbound runtime crash-handler conflict.
+   assert(!region && !atomic_load(&demand_test_live_allocs));
+   assert(ps5_demand_bind_dispatcher(unrelated_dispatch));
+   assert(!ps5_demand_bind_dispatcher(shared_dispatch));
+   assert(!ps5_demand_create(bytes, 0, &region));
+   assert(!sigaction(SIGSEGV, NULL, &action) && action.sa_sigaction == shared_dispatch);
+   volatile unsigned char *table = ps5_demand_data(region);
+   assert(ps5_demand_size(region) >= bytes && !ps5_demand_backed_bytes());
+   table[0] = 23; table[bytes - 1] = 41;
+   assert(ps5_demand_backed_bytes() == 2 * UNIT);
+   assert(!ps5_demand_seal_readonly(region));
+   assert(table[0] == 23 && table[bytes - 1] == 41 && table[UNIT] == 0);
+   expect_shared_fault((void *)table, PS5_DEMAND_WRITE);
+   expect_shared_fault((void *)(table + 2 * UNIT), PS5_DEMAND_WRITE);
+   expect_shared_fault((void *)table, PS5_DEMAND_EXECUTE);
+   expect_shared_fault(NULL, PS5_DEMAND_READ);
+   ps5_demand_destroy(region);
+   assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+   assert(!ps5_demand_bind_dispatcher(NULL));
+   assert(ps5_demand_create(UNIT, 0, &region)); // Unbinding never silently accepts a custom handler.
+   assert(!sigaction(SIGSEGV, &old, NULL));
+   puts("PASS: real 74973184-byte table with explicitly bound crash dispatcher; zero fill, seal, NX and write rejection");
+}
+
+int main(int argc, char **argv)
+{
+   struct ps5_demand_region *region = NULL;
+   if (argc == 2 && !strcmp(argv[1], "--conflict")) {
+      struct sigaction action = {.sa_handler = SIG_IGN};
+      sigemptyset(&action.sa_mask);
+      assert(!sigaction(SIGSEGV, &action, NULL));
+      assert(ps5_demand_create(UNIT, UNIT, &region));
+      assert(!region && !atomic_load(&demand_test_live_allocs));
+      assert(!sigaction(SIGSEGV, NULL, &action) && action.sa_handler == SIG_IGN);
+      puts("PASS: demand handler conflict refused");
+      return 0;
+   }
+   assert(ps5_demand_create(0, UNIT, &region));
+   assert(ps5_demand_create(SIZE_MAX, UNIT, &region));
+   assert(ps5_demand_create(UNIT, SIZE_MAX, &region));
+   atomic_store(&demand_test_force_low_return, 1);
+   assert(ps5_demand_create(UNIT, UNIT, &region));
+   assert(!region && !atomic_load(&demand_test_live_allocs));
+   atomic_store(&demand_test_force_low_return, 0);
+   assert(!ps5_demand_create(256u << 20, UNIT, &region));
+   assert(ps5_demand_size(region) == 256u << 20);
+   assert(!atomic_load(&demand_test_low_hint));
+   struct ps5_demand_failure prepare_error;
+   assert(ps5_demand_prepare(region, SIZE_MAX, UNIT, &prepare_error));
+
+   assert(ps5_demand_reserved(region) == (512u << 20) + UNIT);
+   assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+   assert(!ps5_demand_thread_attach());
+   assert(!ps5_demand_thread_attach());
+   ps5_demand_thread_detach(); // Nested attach keeps the signal stack alive.
+   volatile unsigned char *data = ps5_demand_data(region);
+   errno = EDOM;
+   assert(data[0] == 0 && errno == EDOM);
+   data[0] = 73;
+   assert(data[UNIT + 123] == 0);
+   data[(256u << 20) - 1] = 91;
+   assert(data[0] == 73 && data[(256u << 20) - 1] == 91);
+   assert(ps5_demand_backed_bytes() == 3 * UNIT);
+   assert(atomic_load(&demand_test_live_allocs) == 3);
+   assert(!ps5_demand_fault((uintptr_t)data - 1));
+   expect_fault((void *)(data - 1), 0);
+   expect_fault((void *)data, 1); // A backed demand page must remain non-executable.
+   pid_t conflict = fork(); assert(conflict >= 0);
+   if (!conflict) {
+      struct sigaction action = {.sa_handler = SIG_IGN};
+      sigemptyset(&action.sa_mask);
+      assert(!sigaction(SIGSEGV, &action, NULL));
+      struct ps5_demand_region *other = NULL;
+      assert(ps5_demand_create(UNIT, UNIT, &other));
+      assert(!other);
+      _exit(0);
+   }
+   int conflict_status;
+   assert(waitpid(conflict, &conflict_status, 0) == conflict);
+   assert(WIFEXITED(conflict_status) && WEXITSTATUS(conflict_status) == 0);
+
+   struct ps5_demand_region *shared = NULL;
+   assert(!ps5_demand_create(UNIT, UNIT, &shared));
+   pthread_t threads[8]; struct worker work[8];
+   assert(!pthread_barrier_init(&barrier, NULL, 8));
+   for (int i = 0; i < 8; i++) {
+      work[i] = (struct worker){ps5_demand_data(shared), i};
+      assert(!pthread_create(&threads[i], NULL, touch_worker, &work[i]));
+   }
+   for (int i = 0; i < 8; i++) assert(!pthread_join(threads[i], NULL));
+   for (int i = 0; i < 8; i++) assert(work[i].data[i] == i + 1);
+   assert(ps5_demand_backed_bytes() == 4 * UNIT);
+   assert(!pthread_barrier_destroy(&barrier));
+   ps5_demand_destroy(shared);
+   ps5_demand_destroy(region);
+   assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+
+   // Add and remove registry nodes while other regions are being faulted in.
+   assert(!ps5_demand_create(128 * UNIT, UNIT, &shared));
+   assert(!pthread_barrier_init(&barrier, NULL, 3));
+   for (int i = 0; i < 2; i++) {
+      work[i] = (struct worker){ps5_demand_data(shared), i};
+      assert(!pthread_create(&threads[i], NULL, churn_worker, &work[i]));
+   }
+   pthread_barrier_wait(&barrier);
+   for (int i = 0; i < 64; i++) {
+      struct ps5_demand_region *temporary = NULL;
+      assert(!ps5_demand_create(UNIT, UNIT, &temporary));
+      ps5_demand_destroy(temporary);
+   }
+   for (int i = 0; i < 2; i++) assert(!pthread_join(threads[i], NULL));
+   assert(ps5_demand_backed_bytes() == 128 * UNIT);
+   for (size_t i = 0; i < 128; i++) assert(((unsigned char *)ps5_demand_data(shared))[i * UNIT] == 17);
+   ps5_demand_destroy(shared);
+   assert(!pthread_barrier_destroy(&barrier));
+   assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+
+   for (int fail = 0; fail < 2; fail++) {
+      atomic_store(&demand_test_fixed_reject, 1);
+      atomic_store(&demand_test_relocate_fail, fail);
+      atomic_store(&demand_test_map_calls, 0);
+      assert(!ps5_demand_create(UNIT, UNIT, &region));
+      struct ps5_demand_failure error;
+      int result = ps5_demand_prepare(region, 0, UNIT, &error);
+      if (fail) assert(result && error.stage == PS5_DEMAND_MAP_STAGING);
+      else {
+         assert(!result && atomic_load(&demand_test_relocated));
+         unsigned char *p = ps5_demand_data(region);
+         for (size_t i = 0; i < UNIT; i++) assert(!p[i]);
+         p[UNIT - 1] = 91;
+         assert(!ps5_demand_seal_readonly(region) && p[UNIT - 1] == 91);
+         pid_t child = fork(); assert(child >= 0);
+         if (!child) { *(volatile unsigned char *)p = 1; _exit(7); }
+         int status; assert(waitpid(child, &status, 0) == child);
+         assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+      }
+      ps5_demand_destroy(region);
+      assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+   }
+   assert(!atomic_load(&demand_test_relocated));
+   atomic_store(&demand_test_fixed_reject, 0);
+   atomic_store(&demand_test_relocate_fail, 0);
+   for (int fail = 0; fail < 3; fail++) {
+      assert(!ps5_demand_create(UNIT, UNIT, &region));
+      atomic_store(&demand_test_map_calls, 0);
+      atomic_store(&demand_test_fail_alloc, fail == 0);
+      atomic_store(&demand_test_fail_map, fail);
+      struct ps5_demand_failure error;
+      assert(ps5_demand_prepare(region, 0, UNIT, &error));
+      assert(error.stage == fail + 1 && error.result == -1);
+      assert(error.data == (uintptr_t)ps5_demand_data(region));
+      assert(error.staging && error.staging != error.data);
+      assert(!ps5_demand_fault((uintptr_t)ps5_demand_data(region)));
+      struct ps5_demand_failure again;
+      assert(ps5_demand_prepare(region, 0, UNIT, &again));
+      assert(again.stage == error.stage && again.result == error.result);
+      ps5_demand_destroy(region);
+      assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+   }
+   atomic_store(&demand_test_fail_alloc, 0);
+   atomic_store(&demand_test_fail_map, 0);
+   assert(!ps5_demand_create(4 * UNIT, 0, &region));
+   volatile unsigned char *sealed = ps5_demand_data(region); sealed[0] = 29;
+   assert(!ps5_demand_seal_readonly(region));
+   assert(sealed[0] == 29 && sealed[UNIT] == 0);
+   for (unsigned i = 0; i < 2; i++) {
+      pid_t child = fork(); assert(child >= 0);
+      if (!child) { sealed[i ? 2 * UNIT : 0] = 1; _exit(7); }
+      int status; assert(waitpid(child, &status, 0) == child);
+      assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+   }
+   ps5_demand_destroy(region);
+   assert(!ps5_demand_backed_bytes() && !atomic_load(&demand_test_live_allocs));
+   ps5_demand_thread_detach();
+   test_shared_dispatch();
+   puts("PASS: 256 MiB sparse region, zero-fill, concurrent faults and registry churn, guards, NX, allocation/map failure cleanup");
+   return 0;
+}
