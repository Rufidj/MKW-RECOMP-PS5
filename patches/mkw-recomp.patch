@@ -0,0 +1,57 @@
+"""Translate original synthetic AArch64 routines for the PS5 scalar-access probe.
+
+Uses the project's lifter at build time; no interpreter, JIT or game bytes.
+Usage: python3 tools/build/ps5_aot_fixture.py --out build/ps5/ps5_aot_fixture.h
+"""
+import argparse
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'recomp'))
+from lifter import Lifter  # noqa: E402
+
+
+def generate():
+    lift = Lifter(0, simd='c')
+    lines = ['// Original synthetic diagnostic instructions, translated offline.', '#pragma once']
+    for size in range(4):
+        # LDR{B,H,W,X} r2,[x0]; LDR r3,[x0,#element]; ADD x2,x2,x3;
+        # STR r2,[x1]; MOV x0,x2. Return is emitted by the C function boundary.
+        words = [(size << 30) | 0x39400002, (size << 30) | 0x39400403,
+                 0x8b030042, (size << 30) | 0x39000022, 0xaa0203e0]
+        lines.append(f'static void ps5_aot_{1 << size}(Cpu *c) {{')
+        for i, word in enumerate(words):
+            ins = lift.lift(word, 0x1000 + i * 4)
+            if ins.kind != 'op':
+                raise ValueError(f'fixture instruction {word:#x} is not a scalar operation')
+            lines.append(f'    /* {word:08x} */ {ins.code}')
+        lines.append('}')
+    routines = {'zero': [0xd50b7420], 'vector': [0x3dc00000, 0x4e208400, 0x3d800020],
+                'casp': [0x48227c04], 'ldxp': [0xc87f8c02], 'stxp': [0xc8269404],
+                'ldx': [0xc85ffc02], 'stx': [0xc803fc04]}
+    for size in range(4):
+        routines[f'cas_{1 << size}'] = [(size << 30) | 0x08a27c03]
+        for op, name in enumerate(('add', 'and', 'xor', 'or', 'smax', 'smin', 'umax', 'umin')):
+            routines[f'{name}_{1 << size}'] = [(size << 30) | 0x38220003 | (op << 12)]
+        routines[f'swap_{1 << size}'] = [(size << 30) | 0x38228003]
+        routines[f'lda_{1 << size}'] = [(size << 30) | 0x08dffc02]
+        routines[f'stl_{1 << size}'] = [(size << 30) | 0x089ffc04]
+    for name, words in routines.items():
+        lines.append(f'static void ps5_aot_{name}(Cpu *c) {{')
+        for i, word in enumerate(words):
+            ins = lift.lift(word, 0x2000 + i * 4)
+            if ins.kind != 'op':
+                raise ValueError(f'fixture instruction {word:#x} is not an operation')
+            lines.append(f'    /* {word:08x} */ {ins.code}')
+        lines.append('}')
+    return '\n'.join(lines) + '\n'
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--out', required=True, type=Path)
+    args = parser.parse_args()
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(generate())
+    print(f'Synthetic AOT scalar fixture: {args.out}')
