+static volatile uint32_t *lock_word(PlatMutex *m) { return (volatile uint32_t *)&m->p; }
+static volatile uint32_t *cond_word(PlatCond *c) { return (volatile uint32_t *)&c->p; }
+void plat_mutex_init(PlatMutex *m) { m->p = NULL; }
+void plat_cond_init(PlatCond *c) { c->p = NULL; }
+
+static void lock_sleep(volatile uint32_t *word, uint32_t state) {
+    // The last owner may have released between the failed trylock and this
+    // load. Never publish a sleeper bit on an otherwise unlocked word.
+    if (!(state & (LOCK_WRITER | LOCK_READERS))) return;
+    if (!(state & LOCK_SLEEPER) &&
+        !__atomic_compare_exchange_n(word, &state, state | LOCK_SLEEPER, 0,
+                                     __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return;
+    park_wait(word, state | LOCK_SLEEPER, NULL);
+}
+static void lock_wake(volatile uint32_t *word) {
+    __atomic_fetch_and(word, ~LOCK_SLEEPER, __ATOMIC_RELAXED);
+    park_wake(word);
+}
+
+int plat_mutex_trylock(PlatMutex *m) {
+    volatile uint32_t *word = lock_word(m);
+    uint32_t state = __atomic_load_n(word, __ATOMIC_RELAXED);
+    while (!(state & (LOCK_WRITER | LOCK_READERS)))
+        if (__atomic_compare_exchange_n(word, &state, state | LOCK_WRITER, 1,
+                                         __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return 1;
+    return 0;
+}
+void plat_mutex_lock(PlatMutex *m) {
+    for (unsigned spin = 0;; spin++) {
+        if (plat_mutex_trylock(m)) return;
+        if (spin < LOCK_SPINS) plat_pause();
+        else lock_sleep(lock_word(m), __atomic_load_n(lock_word(m), __ATOMIC_RELAXED));
+    }
+}
+void plat_mutex_lock_from(PlatMutex *m, uintptr_t ra) { (void)ra; plat_mutex_lock(m); }
+void plat_mutex_unlock(PlatMutex *m) {
+    volatile uint32_t *word = lock_word(m);
+    uint32_t state = __atomic_fetch_and(word, ~LOCK_WRITER, __ATOMIC_RELEASE);
+    if (state & LOCK_SLEEPER) lock_wake(word);
+}
+int plat_mutex_trylock_shared(PlatMutex *m) {
+    volatile uint32_t *word = lock_word(m);
+    uint32_t state = __atomic_load_n(word, __ATOMIC_RELAXED);
+    while (!(state & (LOCK_WRITER | LOCK_SLEEPER)) && (state & LOCK_READERS) != LOCK_READERS)
+        if (__atomic_compare_exchange_n(word, &state, state + 1, 1,
+                                         __ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) return 1;
+    return 0;
+}
+void plat_mutex_lock_shared(PlatMutex *m) {
+    for (unsigned spin = 0;; spin++) {
+        if (plat_mutex_trylock_shared(m)) return;
+        if (spin < LOCK_SPINS) plat_pause();
+        else lock_sleep(lock_word(m), __atomic_load_n(lock_word(m), __ATOMIC_RELAXED));
+    }
+}
+void plat_mutex_unlock_shared(PlatMutex *m) {
+    volatile uint32_t *word = lock_word(m);
+    uint32_t state = __atomic_sub_fetch(word, 1, __ATOMIC_RELEASE);
+    if (!(state & LOCK_READERS) && (state & LOCK_SLEEPER)) lock_wake(word);
+}
+
+void plat_cond_wait(PlatCond *c, PlatMutex *m) {
+    uint32_t seq = __atomic_load_n(cond_word(c), __ATOMIC_ACQUIRE);
+    plat_mutex_unlock(m);
+    park_wait(cond_word(c), seq, NULL);
+    plat_mutex_lock(m);
+}
+int plat_cond_wait_ns(PlatCond *c, PlatMutex *m, uint64_t ns) {
+    uint64_t now = plat_now_ns();
+    uint64_t end = ns > UINT64_MAX - now ? UINT64_MAX : now + ns;
+    struct timespec deadline = {(time_t)(end / 1000000000u), (long)(end % 1000000000u)};
+    uint32_t seq = __atomic_load_n(cond_word(c), __ATOMIC_ACQUIRE);
+    plat_mutex_unlock(m);
+    int result = park_wait(cond_word(c), seq, &deadline);
+    plat_mutex_lock(m);
+    return result != ETIMEDOUT;
+}
+void plat_cond_signal(PlatCond *c) {
+    __atomic_add_fetch(cond_word(c), 1, __ATOMIC_RELEASE);
+    park_wake(cond_word(c));
+}
+void plat_cond_broadcast(PlatCond *c) { plat_cond_signal(c); }
+int plat_lock_report(int holds, char *buf, int size) {
+    (void)holds;
+    if (size > 0) buf[0] = 0;
+    return 0;
+}
