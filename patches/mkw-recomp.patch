diff --git a/runtime/core/base/README.md b/runtime/core/base/README.md
index 2d53d10..d954be1 100644
--- a/runtime/core/base/README.md
+++ b/runtime/core/base/README.md
@@ -3,6 +3,10 @@
 The runtime's common pieces: the `host.h` interface, settings (`cfg`), commands to a running game, system info, hashing
 and UTF-16.
 
+SHA-256 selects SHA-NI/SSE4.1 from the architectural CPUID bits, including on
+Clang versions whose CPU-feature builtin rejects `sha`. The SCE target explicitly
+includes the SHA declarations used by its function-specific target attribute.
+
 Game folder selections are resolved relative to the launcher and limited to `CFG_GAME_DIR_MAX` (768 UTF-8 bytes),
 leaving 256 bytes in the smallest runtime buffers for derived paths. Unsupported paths are rejected before saving;
 an invalid saved selection falls back to the launcher folder so the chooser remains available. The selector is quoted
@@ -18,3 +22,11 @@ long-path opt-in. ASCII and BMP characters use one unit; supplementary character
 | `ctl.c` | `MKW_CTL=<fifo>`: commands to the running game (screenshot, dump, flight recorder, button presses, textures at an address, game memory to a file); `tools/run/ctl.sh` |
 | `players.c`, `players.h` | The players of one install (the launcher's Profiles page): each its own console account, nickname and save under the profile folder; `MKW_PLAYER` in `mkw.ini` names the one the next start plays |
 | `sysinfo.c`, `sysinfo.h`, `sysinfo_log.c`, `sha256.c`, `sha256.h`, `utf16.h` | System info and log-folder discovery, hashing, UTF-16; log-folder discovery prefers the active game log, then redirected stderr, then the selected installation's `logs/` (including setup failures). It is separate from the Vulkan report so it can be tested without graphics dependencies |
+
+For PS5, `ctl.c` reads an optional command file named by MKW_CTL instead of a
+Unix FIFO. It tails complete lines, resets on truncation/replacement and polls
+without holding a guest virtual core. No unsupported mkfifo import is emitted.
+
+`boot_progress.c`/`boot_progress.h` collect observed startup reads and native decompression activity with atomic counters. No estimated global percentage; successful first game presentation ends the display.
+
+The command reader accepts `startup` for a read-only scheduler snapshot. The PS5 diagnostic title uses its own startup-014.commands file; no app launch/close command is sent by enabling this reader.
diff --git a/runtime/core/base/boot_progress.c b/runtime/core/base/boot_progress.c
new file mode 100644
index 0000000..f409f4d
--- /dev/null
+++ b/runtime/core/base/boot_progress.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: MIT
+#include "boot_progress.h"
+#include "platform/platform.h"
+static uint64_t started, activity, reads, decoded, calls, images, images_ns;
+static int first_image;
+static uint64_t first_image_ns;
+static uint32_t decoders;
+static int active;
+void boot_progress_begin(uint64_t now) {
+    __atomic_store_n(&started, now, __ATOMIC_RELAXED);
+    __atomic_store_n(&activity, now, __ATOMIC_RELAXED);
+    __atomic_store_n(&reads, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&decoded, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&calls, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&decoders, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&images, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&images_ns, now, __ATOMIC_RELAXED);
+    __atomic_store_n(&first_image, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&first_image_ns, 0, __ATOMIC_RELAXED);
+    __atomic_store_n(&active, 1, __ATOMIC_RELEASE);
+}
+void boot_progress_finish(void) { __atomic_store_n(&active, 0, __ATOMIC_RELEASE); }
+int boot_progress_snapshot(BootProgress *out) {
+    int is_active = __atomic_load_n(&active, __ATOMIC_ACQUIRE);
+    *out = (BootProgress){
+        .started_ns = __atomic_load_n(&started, __ATOMIC_RELAXED),
+        .last_activity_ns = __atomic_load_n(&activity, __ATOMIC_RELAXED),
+        .read_bytes = __atomic_load_n(&reads, __ATOMIC_RELAXED),
+        .decoded_bytes = __atomic_load_n(&decoded, __ATOMIC_RELAXED),
+        .decode_calls = __atomic_load_n(&calls, __ATOMIC_RELAXED),
+        .images = __atomic_load_n(&images, __ATOMIC_RELAXED),
+        .images_ns = __atomic_load_n(&images_ns, __ATOMIC_RELAXED),
+        .first_image_ns = __atomic_load_n(&first_image_ns, __ATOMIC_RELAXED),
+        .active_decoders = __atomic_load_n(&decoders, __ATOMIC_RELAXED),
+        .active = is_active,
+        .first_image = __atomic_load_n(&first_image, __ATOMIC_RELAXED)};
+    return out->active;
+}
+void boot_progress_first_image(void) {
+    __atomic_store_n(&first_image_ns, plat_now_ns(), __ATOMIC_RELAXED);
+    __atomic_store_n(&first_image, 1, __ATOMIC_RELEASE);
+}
+void boot_progress_images(uint64_t created) {
+    if (!__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return;
+    uint64_t old = __atomic_load_n(&images, __ATOMIC_RELAXED);
+    while (created > old && !__atomic_compare_exchange_n(&images, &old, created, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+    if (created > old) __atomic_store_n(&images_ns, plat_now_ns(), __ATOMIC_RELAXED);
+}
+static void touch(void) {
+    uint64_t now = plat_now_ns(), old = __atomic_load_n(&activity, __ATOMIC_RELAXED);
+    while (now > old && !__atomic_compare_exchange_n(&activity, &old, now, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+}
+void boot_progress_read(uint64_t bytes) {
+    if (!bytes || !__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return;
+    __atomic_fetch_add(&reads, bytes, __ATOMIC_RELAXED); touch();
+}
+int boot_progress_decode_begin(void) {
+    if (!__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return 0;
+    __atomic_fetch_add(&decoders, 1, __ATOMIC_RELAXED); touch(); return 1;
+}
+void boot_progress_decode_end(int token, uint64_t bytes) {
+    if (!token) return;
+    __atomic_fetch_add(&decoded, bytes, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&calls, 1, __ATOMIC_RELAXED);
+    __atomic_fetch_sub(&decoders, 1, __ATOMIC_RELAXED); touch();
+}
+
+// ---- console text. One mutex, tiny critical sections; callers are the reading and decoding threads.
+#include <stdio.h>
+#include <string.h>
+#define NLINES 22
+// A spin lock, not PlatMutex: critical sections copy a few hundred bytes, and this file stays free of platform deps.
+static char con_flag;
+#define plat_mutex_lock(x) do { (void)(x); while (__atomic_test_and_set(&con_flag, __ATOMIC_ACQUIRE)) {} } while (0)
+#define plat_mutex_unlock(x) do { (void)(x); __atomic_clear(&con_flag, __ATOMIC_RELEASE); } while (0)
+static int con_lock;
+static BootConsole con;
+static unsigned long long line_seq;
+static char lines[NLINES][160];
+static void put_line(const char *s) {   // caller holds con_lock
+    memmove(lines[0], lines[1], sizeof lines[0] * (NLINES - 1));
+    snprintf(lines[NLINES - 1], sizeof lines[0], "%s", s);
+    line_seq++;
+}
+static void shorten(char *dst, size_t cap, const char *name) {   // keeps the end of a long path
+    size_t n = strlen(name);
+    if (n < cap) memcpy(dst, name, n + 1);
+    else snprintf(dst, cap, "...%s", name + n - (cap - 4));
+}
+void boot_progress_file(const char *name, uint64_t done, uint64_t total) {
+    if (!name || !__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return;
+    char shown[112], l[160];
+    shorten(shown, sizeof shown, name);
+    plat_mutex_lock(&con_lock);
+    if (strcmp(con.file, shown)) {
+        snprintf(l, sizeof l, "[ leyendo ] %s  (%.2f MiB)", shown, total / 1048576.0);
+        put_line(l);
+        memcpy(con.file, shown, strlen(shown) + 1);
+    }
+    con.file_done = done, con.file_total = total;
+    plat_mutex_unlock(&con_lock);
+}
+void boot_progress_unpack_begin(uint64_t total) {
+    if (!__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return;
+    char l[160];
+    plat_mutex_lock(&con_lock);
+    memcpy(con.unpack_file, con.file, sizeof con.unpack_file);   // the file read last
+    con.unpack_done = 0, con.unpack_total = total;
+    snprintf(l, sizeof l, "[ descomp. ] %s  -> %.1f MiB", con.unpack_file, total / 1048576.0);
+    put_line(l);
+    plat_mutex_unlock(&con_lock);
+}
+void boot_progress_unpack_add(uint64_t bytes) {
+    if (!__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return;
+    plat_mutex_lock(&con_lock);
+    if (con.unpack_total && (con.unpack_done += bytes) >= con.unpack_total) {
+        char l[160];
+        snprintf(l, sizeof l, "[   OK   ] %s  %.1f MiB descomprimidos", con.unpack_file, con.unpack_total / 1048576.0);
+        put_line(l);
+        con.unpack_total = con.unpack_done = 0;
+    }
+    plat_mutex_unlock(&con_lock);
+}
+int boot_progress_console(BootConsole *out) {
+    if (!__atomic_load_n(&active, __ATOMIC_ACQUIRE)) return 0;
+    plat_mutex_lock(&con_lock);
+    *out = con;
+    out->nlines = 0;
+    for (int i = 0; i < NLINES; i++)
+        if (lines[i][0]) memcpy(out->lines[out->nlines++], lines[i], sizeof lines[i]);
+    plat_mutex_unlock(&con_lock);
+    return 1;
+}
