     uint32_t mb = g_gpu_n > 0 ? g_gpu_vram_mb[gi] : 0;
     bool weak = g_gpu_n <= 0 || !g_gpu_discrete[gi] || mb < 6 * 1024, strong = !weak && mb >= 16 * 1024;
