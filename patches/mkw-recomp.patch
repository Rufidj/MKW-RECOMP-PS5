+"""Native PS5 memory overrides preserve ordering, comparison and checked fill semantics."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_sources, demand_include
+ROOT = Path(__file__).resolve().parents[1]
+class Ps5MemOpsTest(unittest.TestCase):
+    def test_checked_memory_operations(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'copy.c'
+            c.write_text(r'''
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include "ps5_mem.h"
+#include <ps5platform/checked_region.h>
+#include "nvn_api_core.c"
+static uint64_t left=0x1040000000ull, right=0x1080000000ull;
+static unsigned calls;
+__attribute__((noreturn)) void rt_fatal(const char *fmt, ...) { (void)fmt; _exit(77); }
+void rt_log(const char *fmt, ...) { (void)fmt; }
+static void gpu_read(uint64_t a,uint64_t n) {
+    assert(n==0x210123 && (a==left+7 || a==right+11));
+    unsigned char fresh=0xa5;
+    assert(ps5_guest_write(ps5_memory_space(),a,&fresh,1)); calls++;
+}
+const GfxBackend *gfx_backend(void) { static const GfxBackend b={.guest_read=gpu_read};return &b; }
+static void rejected(int compare) {
+    pid_t pid=fork();assert(pid>=0);
+    if(!pid) {
+        Cpu c={0}; c.x[0]=left+4096-8; c.x[1]=compare?right+4096-8:0x55;c.x[2]=16;
+        if(compare)ov_memcmp(&c);else ov_memset(&c);
+        _exit(99);
+    }
+    int status;assert(waitpid(pid,&status,0)==pid);
+    assert(WIFEXITED(status)&&WEXITSTATUS(status)==77);
+}
+int main(void) {
+    Ps5GuestSpace *s=ps5_memory_space();
+    assert(ps5_guest_reserve(s,left,4u<<20,1)&&ps5_guest_reserve(s,right,4u<<20,1));
+    ps5_memory_native_hle(1);
+    assert(plat_mem_commit(left,4u<<20)&&plat_mem_commit(right,4u<<20));
+    size_t n=0x210123;
+    unsigned char *plain=malloc(n),*out=malloc(n);assert(plain&&out);
+    for(size_t i=0;i<n;i++)plain[i]=(unsigned char)(i*19);
+    assert(ps5_guest_write(s,left+7,plain,n)&&ps5_guest_write(s,right+11,plain,n));
+    Cpu c={0};c.x[0]=left+7;c.x[1]=right+11;c.x[2]=n;ov_memcmp(&c);
+    assert(!c.x[0]&&calls==2);plain[0]=0xa5;
+    // Different bytes past 4 KiB, including unsigned bytes >127; exact SDK result.
+    unsigned char lo=1,hi=255;
+    assert(ps5_guest_write(s,left+7+8191,&lo,1)&&ps5_guest_write(s,right+11+8191,&hi,1));
+    assert(ps5_hle_memcmp((void *)(left+7),(void *)(right+11),n)==-254);
+    assert(ps5_hle_memcmp((void *)(right+11),(void *)(left+7),n)==254);
+    assert(ps5_hle_memcmp(NULL,NULL,0)==0);
+    assert(ps5_hle_memcmp((void *)(left+7),plain,8191)==0);
+    assert(ps5_hle_memcmp(plain,(void *)(left+7),8191)==0);
+    // Zero-backed sparse reads and RO comparisons are valid, reads stay clean.
+    uint64_t sparse=0x10c0000000ull;unsigned char zeros[64]={0};
+    assert(ps5_guest_reserve(s,sparse,65536,1));
+    assert(ps5_guest_commit(s,sparse,65536));
+    assert(ps5_guest_protect(s,sparse,65536,PS5_CHECKED_READ));
+    uint64_t backed_before = ps5_guest_backed_bytes(s);
+    assert(ps5_hle_memcmp((void *)sparse,zeros,sizeof zeros)==0);
+    assert(ps5_guest_backed_bytes(s)==backed_before);
+    uint64_t pages[1024];
+    assert(!ps5_guest_written(s,sparse,65536,pages,1024,1));
+    ps5_guest_written(s,left,4u<<20,pages,1024,1);
+    // Native fill crosses 2 MiB, records exactly touched logical pages, returns dst.
+    c.x[0]=left+7;c.x[1]=0x1ab;c.x[2]=n;ov_memset(&c);assert(c.x[0]==left+7);
+    assert(ps5_guest_read(s,left+7,out,n));
+    for(size_t i=0;i<n;i++)assert(out[i]==0xab);
+    assert(ps5_guest_written(s,left+7,n,pages,1024,1)==(7+n+4095)/4096);
+    unsigned char before[8],after[8];assert(ps5_guest_read(s,left+4096-8,before,8));
+    assert(plat_mem_protect(left+4096,4096,PLAT_PROT_READ));
+    rejected(0);
+    assert(ps5_guest_read(s,left+4096-8,after,8)&&!memcmp(before,after,8));
+    assert(plat_mem_protect(right+4096,4096,PLAT_PROT_NONE));
+    rejected(1); // Reject unreadable tail, even with an earlier mismatch.
+    free(plain);free(out);
+}
+''')
+            includes = {ROOT / 'runtime'} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')}
+            sources = [ROOT / 'runtime/platform' / f'{n}.c' for n in
+                       ('ps5_mem', 'ps5_guest_memory', 'ps5_hle_copy', 'ps5_sync', 'common')]
+            exe = d / 'copy'
+            subprocess.run(['clang', '-O2', '-march=x86-64-v3', '-DMKW_PS5_HOST_CHECK',
+                            '-ffunction-sections', '-fdata-sections', '-Wno-bitwise-instead-of-logical',
+                            *['-I' + str(p) for p in sorted(includes)], demand_include(), str(c),
+                            *map(str, sources), *demand_sources(),
+                            str(ROOT.parent / 'PS5_PayloadSDK/platform/src/checked_region.c'),
+                            '-pthread', '-Wl,--gc-sections', '-o', str(exe)], check=True, timeout=30)
+            subprocess.run([str(exe)], check=True, timeout=30)
+if __name__ == '__main__': unittest.main()
