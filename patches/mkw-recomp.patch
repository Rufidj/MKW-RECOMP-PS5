diff --git a/runtime/platform/ps5_threads.c b/runtime/platform/ps5_threads.c
new file mode 100644
index 0000000..a4c741d
--- /dev/null
+++ b/runtime/platform/ps5_threads.c
@@ -0,0 +1,270 @@
+// PS5 threads with explicit guarded stacks and detached-stack reclamation.
+// SPDX-License-Identifier: MIT
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 platform source selected for another target"
+#endif
+#ifdef MKW_PS5_HOST_CHECK
+#define _GNU_SOURCE
+#include <sys/syscall.h>
+#include <unistd.h>
+#else
+#include <pthread_np.h>
+#endif
+#include <errno.h>
+#include <pthread.h>
+#include <time.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "platform.h"
+#include "ps5_int.h"
+#ifdef MKW_PS5_HOST_CHECK
+#define THREAD_ERROR(...) fprintf(stderr, __VA_ARGS__)
+#else
+#include "host.h"
+#define THREAD_ERROR(...) rt_log(__VA_ARGS__)
+#endif
+
+struct PlatThread {
+    pthread_t thread;
+    PlatThreadFn fn;
+    void *arg;
+    Ps5Stack stack;
+    void *retired_signal_stack;
+    PlatMutex lock;
+    PlatCond finished;
+    int done;
+    int startup_done, startup_ok, startup_error;
+    char name[32];
+    uint32_t mxcsr;
+    uint16_t x87;
+    struct PlatThread *next;
+};
+static PlatMutex reap_lock = PLAT_MUTEX_INIT;
+static PlatCond reap_changed = PLAT_COND_INIT;
+static PlatThread *reap_list;
+static PlatOnce reap_once = PLAT_ONCE_INIT;
+
+static void release_thread(PlatThread *t) {
+    // Only after pthread_join: the worker cannot still execute on this stack.
+    ps5_stack_thread_release(t->retired_signal_stack);
+    ps5_stack_destroy(&t->stack);
+    free(t);
+}
+static int thread_done(PlatThread *t) {
+    plat_mutex_lock(&t->lock);
+    int done = t->done;
+    plat_mutex_unlock(&t->lock);
+    return done;
+}
+static void *reaper_main(void *unused) {
+    (void)unused;
+    for (;;) {
+        plat_mutex_lock(&reap_lock);
+        PlatThread *ready = NULL;
+        while (!ready) {
+            // A long-lived detached worker must not retain other finished stacks.
+            for (PlatThread **link = &reap_list; *link; link = &(*link)->next)
+                if (thread_done(*link)) {
+                    ready = *link;
+                    *link = ready->next;
+                    break;
+                }
+            if (!ready) plat_cond_wait(&reap_changed, &reap_lock);
+        }
+        plat_mutex_unlock(&reap_lock);
+        if (pthread_join(ready->thread, NULL)) __builtin_trap();
+        release_thread(ready);
+    }
+    return NULL;
+}
+static void start_reaper(void *unused) {
+    (void)unused;
+    pthread_t reaper;
+    // The SDK link wraps this default-stack pthread into direct memory.
+    if (pthread_create(&reaper, NULL, reaper_main, NULL) || pthread_detach(reaper)) __builtin_trap();
+}
+static void *thread_main(void *arg) {
+    PlatThread *t = arg;
+    errno = 0;
+    int attached = ps5_stack_thread_attach() == 0;
+    int attach_error = errno;
+    plat_mutex_lock(&t->lock);
+    t->startup_ok = attached;
+    t->startup_error = attach_error;
+    t->startup_done = 1;
+    plat_cond_broadcast(&t->finished);
+    plat_mutex_unlock(&t->lock);
+    _mm_setcsr(t->mxcsr);
+    __asm__ volatile("fldcw %0" : : "m"(t->x87));
+    if (t->name[0]) {
+#ifdef MKW_PS5_HOST_CHECK
+        char name[16];
+        memcpy(name, t->name, 15); name[15] = 0;
+        pthread_setname_np(pthread_self(), name);
+#else
+        pthread_set_name_np(pthread_self(), t->name);
+#endif
+    }
+    if (attached) {
+        t->fn(t->arg);
+        t->retired_signal_stack = ps5_stack_thread_retire();
+    }
+    plat_mutex_lock(&t->lock);
+    t->done = 1;
+    plat_cond_broadcast(&t->finished);
+    plat_mutex_unlock(&t->lock);
+    // Do not dereference t after publishing completion. A join still waits for
+    // this routine to return before either the caller or reaper frees it.
+    plat_mutex_lock(&reap_lock);
+    plat_cond_broadcast(&reap_changed);
+    plat_mutex_unlock(&reap_lock);
+    return NULL;
+}
+
+// MKWBOOT-040: every named host thread, so the "cpu:" log line can say which of them burns the cores (the guest threads
+// were nearly idle while the process used 4.8 cores). Entries stay after the thread ends; its clock then fails and it is skipped.
+typedef struct { char name[24]; pthread_t thread; uint64_t last; } HostRec;
+#define HOST_RECS 96
+static HostRec host_recs[HOST_RECS];
+static int host_n;
+static void host_register(const char *name, pthread_t thread) {
+    int i = __atomic_fetch_add(&host_n, 1, __ATOMIC_RELAXED);
+    if (i >= HOST_RECS) return;
+    snprintf(host_recs[i].name, sizeof host_recs[i].name, "%s", name ? name : "?");
+    host_recs[i].thread = thread;
+    __atomic_store_n(&host_recs[i].last, 1, __ATOMIC_RELEASE);   // 1: registered, no sample yet
+}
+// MKWBOOT-069: the name a profiler sample's thread was registered with (pthread_getcpuclockid gives every thread the same
+// figure on the console, so the per-thread CPU now comes from the SIGPROF samples). 0 when unknown (a driver thread).
+int plat_thread_name_of(uintptr_t self, char *out, size_t size) {
+    int n = __atomic_load_n(&host_n, __ATOMIC_ACQUIRE);
+    if (n > HOST_RECS) n = HOST_RECS;
+    for (int i = 0; i < n; i++)
+        if (__atomic_load_n(&host_recs[i].last, __ATOMIC_ACQUIRE) && (uintptr_t)host_recs[i].thread == self) {
+            snprintf(out, size, "%s", host_recs[i].name); return 1;
+        }
+    return 0;
+}
+int plat_host_threads_cpu(char names[][24], uint64_t *delta, int max) {
+    int n = __atomic_load_n(&host_n, __ATOMIC_ACQUIRE), out = 0;
+    if (n > HOST_RECS) n = HOST_RECS;
+    for (int i = 0; i < n && out < max; i++) {
+        if (!__atomic_load_n(&host_recs[i].last, __ATOMIC_ACQUIRE)) continue;
+        clockid_t id;
+        struct timespec ts;
+        if (pthread_getcpuclockid(host_recs[i].thread, &id) || clock_gettime(id, &ts)) continue;
+        uint64_t c = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec, last = host_recs[i].last;
+        delta[out] = last > 1 && c > last ? c - last : 0;
+        host_recs[i].last = c ? c : 1;
+        memcpy(names[out], host_recs[i].name, sizeof host_recs[i].name);
+        out++;
+    }
+    return out;
+}
+PlatThread *plat_thread_new_ex(PlatThreadFn fn, void *arg, const char *name, size_t stack) {
+    if (!fn) return NULL;
+    PlatThread *t = calloc(1, sizeof *t);
+    if (!t) {
+        THREAD_ERROR("thread: allocation failed for %s (errno %d)\n", name ? name : "unnamed", errno);
+        return NULL;
+    }
+    t->fn = fn; t->arg = arg;
+    t->mxcsr = _mm_getcsr();
+    __asm__ volatile("fnstcw %0" : "=m"(t->x87));
+    if (name) snprintf(t->name, sizeof t->name, "%s", name);
+    size_t bytes = stack ? stack : PLAT_STACK_DEFAULT;
+    if (!ps5_stack_create(&t->stack, bytes)) {
+        int saved = errno;
+        THREAD_ERROR("thread: %s stack reservation/backing failed: %zu bytes, errno %d, other stacks %llu MiB\n",
+                t->name, bytes, saved, (unsigned long long)(ps5_stack_reserved_bytes() >> 20));
+        free(t);
+        errno = saved;
+        return NULL;
+    }
+    pthread_attr_t attr;
+    const char *stage = "pthread_attr_init";
+    int error = pthread_attr_init(&attr);
+    if (!error) {
+        stage = "pthread_attr_setstack";
+        error = pthread_attr_setstack(&attr, t->stack.data, t->stack.bytes);
+        if (!error) { stage = "pthread_create"; error = pthread_create(&t->thread, &attr, thread_main, t); if (!error) host_register(name, t->thread); }
+        pthread_attr_destroy(&attr);
+    }
+    if (error) {
+        THREAD_ERROR("thread: %s failed at %s: code %d (%#x), errno %d, stack %p + %zu, reserved %llu MiB, parent %u\n",
+                t->name, stage, error, (unsigned)error, errno, t->stack.data, t->stack.bytes,
+                (unsigned long long)(ps5_stack_reserved_bytes() >> 20), plat_thread_id());
+        release_thread(t); errno = error; return NULL;
+    }
+    plat_mutex_lock(&t->lock);
+    while (!t->startup_done) plat_cond_wait(&t->finished, &t->lock);
+    int started = t->startup_ok;
+    int startup_error = t->startup_error;
+    plat_mutex_unlock(&t->lock);
+    if (!started) {
+        THREAD_ERROR("thread: %s alternate signal stack setup failed (errno %d)\n", t->name, startup_error);
+        plat_thread_join(t); errno = startup_error; return NULL;
+    }
+    return t;
+}
+PlatThread *plat_thread_new(PlatThreadFn fn, void *arg, const char *name) {
+    return plat_thread_new_ex(fn, arg, name, 0);
+}
+void plat_thread_join(PlatThread *t) {
+    if (pthread_join(t->thread, NULL)) __builtin_trap();
+    release_thread(t);
+}
+int plat_thread_join_ns(PlatThread *t, uint64_t ns) {
+    uint64_t now = plat_now_ns();
+    uint64_t end = ns > UINT64_MAX - now ? UINT64_MAX : now + ns;
+    plat_mutex_lock(&t->lock);
+    while (!t->done) {
+        now = plat_now_ns();
+        if (now >= end) { plat_mutex_unlock(&t->lock); return 0; }
+        plat_cond_wait_ns(&t->finished, &t->lock, end - now);
+    }
+    plat_mutex_unlock(&t->lock);
+    // The completion flag means the callback returned, not that the pthread
+    // itself ended; join before releasing the custom stack.
+    plat_thread_join(t);
+    return 1;
+}
+void plat_thread_detach(PlatThread *t) {
+    plat_once(&reap_once, start_reaper, NULL);
+    plat_mutex_lock(&reap_lock);
+    t->next = reap_list;
+    reap_list = t;
+    plat_cond_signal(&reap_changed);
+    plat_mutex_unlock(&reap_lock);
+}
+int plat_thread_spawn(PlatThreadFn fn, void *arg, const char *name, size_t stack) {
+    PlatThread *t = plat_thread_new_ex(fn, arg, name, stack);
+    if (!t) return 0;
+    plat_thread_detach(t);
+    return 1;
+}
+uint32_t plat_thread_id(void) {
+#ifdef MKW_PS5_HOST_CHECK
+    return (uint32_t)syscall(SYS_gettid);
+#else
+    return (uint32_t)pthread_getthreadid_np();
+#endif
+}
+void plat_yield(void) { sched_yield(); }
+
+uint64_t plat_thread_affinity(PlatThread *t,uint64_t mask) { (void)t;(void)mask;return 0; }
+static _Thread_local int requested_priority;
+void plat_thread_set_priority(PlatThread *t,int priority) {
+    int policy;struct sched_param param;
+    pthread_t thread=t?t->thread:pthread_self();
+    if(pthread_getschedparam(thread,&policy,&param))return;
+    int low=sched_get_priority_min(policy),high=sched_get_priority_max(policy);
+    if(low<0 || high<=low)return;
+    int base=(low+high)/2;int value=base-priority;if(value<low)value=low;if(value>high)value=high;
+    param.sched_priority=value;
+    if(!pthread_setschedparam(thread,policy,&param) && !t)requested_priority=priority;
+}
+void plat_thread_priority(int priority) { plat_thread_set_priority(NULL,priority); }
+int plat_thread_priority_get(void) { return requested_priority; }
