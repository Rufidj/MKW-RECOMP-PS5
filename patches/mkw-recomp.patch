@@ -0,0 +1,65 @@
+"""Guest link reference: visibility, interposition, addends and rejection paths."""
+import hashlib
+import importlib.util
+from pathlib import Path
+import struct
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+SPEC = importlib.util.spec_from_file_location(
+    "link_audit", Path(__file__).resolve().parents[1] / "tools/build/nso_link_audit.py")
+AUDIT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(AUDIT)
+
+
+def module(symbols, relocs, visibility=None):
+    image = bytearray(512)
+    syms = [("", 0, 0, 0, 0)] + symbols
+    for index, other in (visibility or {}).items():
+        image[index * 24 + 5] = other
+    return SimpleNamespace(image=image, size=512, data=(256, 256), dyn={6: 0},
+                           syms=syms, relocs=relocs,
+                           imports=lambda: [s for s in syms if s[0] and not s[2]])
+
+
+class LinkAuditTest(unittest.TestCase):
+    def run_audit(self, modules):
+        with patch.object(AUDIT, "module_layout", return_value=[
+                (name, base, obj.size) for name, base, obj in modules]), patch.object(
+                    AUDIT, "Nso", side_effect=[obj for _, _, obj in modules]):
+            return AUDIT.audit(Path("unused"))
+
+    def test_binding_and_expected_bytes(self):
+        first = module([("shared", 0x10, 1, 64, 8)], [])
+        second = module([
+            ("shared", 0x10, 1, 80, 8),
+            ("shared", 0x10, 1, 96, 8),
+            ("absent", 0x20, 0, 0, 0),
+            ("shared", 0, 1, 112, 8),
+        ], [(256, 257, 1, 7), (264, 1025, 2, -3),
+            (272, 1026, 1, 123), (280, 257, 3, 999),
+            (288, 1027, 0, 16), (296, 257, 4, 0)], {2: 2})
+        result = self.run_audit([("main", 4096, first), ("sdk", 8192, second)])
+        expected = bytearray(second.image)
+        for off, value in zip(range(256, 304, 8), [4167, 8285, 4160, 0, 8208, 8304]):
+            struct.pack_into("<Q", expected, off, value)
+        self.assertEqual(result["modules"][1]["guest_linked_image_sha256"],
+                         hashlib.sha256(expected).hexdigest())
+        self.assertEqual(result["total_relocations"], 6)
+
+    def test_reject_invalid_inputs(self):
+        for relocs, symbols, message in [
+            ([(248, 1027, 0, 0)], [], "destination"),
+            ([(257, 1027, 0, 0)], [], "destination"),
+            ([(256, 1027, 0, 0)] * 2, [], "duplicate"),
+            ([(256, 0, 0, 0)], [], "unsupported"),
+            ([(256, 257, 9, 0)], [], "symbol"),
+            ([(256, 257, 1, 0)], [("missing", 0x10, 0, 0, 0)], "unresolved strong"),
+        ]:
+            with self.subTest(message=message), self.assertRaisesRegex(ValueError, message):
+                self.run_audit([("main", 4096, module(symbols, relocs))])
+
+
+if __name__ == "__main__":
+    unittest.main()
