index 0000000..8f381c1
--- /dev/null
+++ b/tools/build/ps5_host_tables.py
@@ -0,0 +1,122 @@
+"""Validate retained HLE tables and their relocations before signing a PS5 title.
+
+MKWBOOT-002 linked its weak table bounds to zero after --gc-sections removed
+all registrations. Check every name/function pointer in the LLVM image and,
+when supplied, the converted image and its GNU_RELRO coverage.
+Usage: python3 tools/build/ps5_host_tables.py ELF [--converted ELF] [--out JSON]
+"""
+from pathlib import Path
+import argparse
+import json
+import struct
+
+
+class Elf:
+    def __init__(self, path):
+        self.data = Path(path).read_bytes()
+        d = self.data
+        if d[:6] != b'\x7fELF\x02\x01' or struct.unpack_from('<H', d, 18)[0] != 62:
+            raise ValueError('expected little-endian x86-64 ELF')
+        phoff, shoff = struct.unpack_from('<QQ', d, 32)
+        phsize, phnum, shsize, shnum, shnames = struct.unpack_from('<HHHHH', d, 54)
+        self.ph = [struct.unpack_from('<IIQQQQQQ', d, phoff + i * phsize) for i in range(phnum)]
+        self.sh = [struct.unpack_from('<IIQQQQIIQQ', d, shoff + i * shsize) for i in range(shnum)]
+        self.symbols = {}
+        self.relative = {}
+        for s in self.sh:
+            if s[1] == 2:  # SHT_SYMTAB, including hidden linker-defined bounds.
+                strings = self.sh[s[6]]
+                names = d[strings[4]:strings[4] + strings[5]]
+                for at in range(s[4], s[4] + s[5], s[9]):
+                    n, info, other, defined, value, size = struct.unpack_from('<IBBHQQ', d, at)
+                    if defined:
+                        end = names.find(b'\0', n)
+                        self.symbols[names[n:end].decode()] = value
+            if s[1] == 4:
+                self.add_rela(d[s[4]:s[4] + s[5]])
+        # Converted PS5 images have no section table. Their dynamic tags use
+        # virtual addresses, just as the converter's source implementation does.
+        if not self.sh:
+            for p in self.ph:
+                if p[0] != 2:
+                    continue
+                tags = dict(struct.iter_unpack('<qQ', d[p[2]:p[2] + p[5]]))
+                if 7 in tags and 8 in tags:
+                    self.add_rela(self.read(tags[7], tags[8]))
+
+    def add_rela(self, data):
+        for address, info, addend in struct.iter_unpack('<QQq', data):
+            if info & 0xffffffff == 8:  # R_X86_64_RELATIVE
+                self.relative[address] = addend
+
+    def read(self, address, size):
+        for p in self.ph:
+            if p[0] == 1 and p[3] <= address and size <= p[5] - (address - p[3]):
+                at = p[2] + address - p[3]
+                return self.data[at:at + size]
+        raise ValueError(f'unmapped file address {address:#x}+{size:#x}')
+
+    def pointer(self, address):
+        return self.relative.get(address, struct.unpack('<Q', self.read(address, 8))[0])
+
+    def string(self, address):
+        for p in self.ph:
+            if p[0] == 1 and p[3] <= address < p[3] + p[5]:
+                n = min(4096, p[3] + p[5] - address)
+                data = self.read(address, n)
+                end = data.find(b'\0')
+                if end > 0:
+                    return data[:end].decode()
+        raise ValueError(f'invalid registration name at {address:#x}')
+
+    def executable(self, address):
+        return any(p[0] == 1 and p[1] & 1 and p[3] <= address < p[3] + p[6] for p in self.ph)
+
+
+def validate_tables(path, converted=None):
+    elf = Elf(path)
+    native = Elf(converted) if converted else None
+    report = {}
+    for kind in ('ovr', 'obs', 'fns'):
+        lo = elf.symbols.get('__start_mkw_' + kind, 0)
+        hi = elf.symbols.get('__stop_mkw_' + kind, 0)
+        if not lo or hi <= lo or lo % 8 or (hi - lo) % 16:
+            raise ValueError(f'missing or empty host table {kind}')
+        names = []
+        for address in range(lo, hi, 16):
+            name = elf.string(elf.pointer(address))
+            function = elf.pointer(address + 8)
+            if not elf.executable(function):
+                raise ValueError(f'non-executable HLE function: {name}')
+            if native and (native.string(native.pointer(address)) != name or
+                           native.pointer(address + 8) != function or not native.executable(function)):
+                raise ValueError(f'converted HLE relocation mismatch: {name}')
+            names.append(name)
+        required = {'ovr': 'nndiagStartup', 'obs': 'nnMain'}.get(kind)
+        if required and required not in names:
+            raise ValueError(f'host table lacks {required}')
+        if native and not any(p[0] == 0x6474e552 and p[3] <= lo and hi <= p[3] + p[6] for p in native.ph):
+            raise ValueError(f'converted host table {kind} is outside RELRO')
+        report[kind] = dict(entries=len(names), start=lo, end=hi)
+    report['converted_pointers_verified'] = bool(native)
+    return report
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('elf', type=Path)
+    ap.add_argument('--converted', type=Path)
+    ap.add_argument('--out', type=Path)
+    args = ap.parse_args()
+    try:
+        report = validate_tables(args.elf, args.converted)
+    except (ValueError, struct.error) as error:
+        raise SystemExit(f'host table verification failed: {error}')
+    text = json.dumps(report, indent=2) + '\n'
+    if args.out:
+        args.out.write_text(text)
+    print(text, end='')
+
+
+if __name__ == '__main__':
+    main()
