+// MKWBOOT-064: the entries of the game code (cpu.h LD8..ST64, simd.h LD128/ST128). rt_fast_tab[a >> 24] describes the mapping that
+// wholly holds that 16 MiB (ps5_guest_memory.c); ok + (a >> 12) is the page's direct-rights byte from the SDK region (bit 0 read,
+// bit 1 write: granted, backed, not poisoned), dirty + (a >> 12) its dirty byte. One table, one byte, then the access: anything else
+// (no descriptor, page cross, clear bit) tail-calls the general entry, which gives the answer it always gave.
+static inline __attribute__((always_inline)) const RtFastDesc *page_desc(uint64_t a, unsigned n, unsigned bit) {
+    if (__builtin_expect((a >> 39) != 0 || (a & 0xfff) > 0x1000u - n, 0)) return NULL;
+    const RtFastDesc *d = __atomic_load_n(&rt_fast_tab[a >> 24], __ATOMIC_ACQUIRE);
+    if (__builtin_expect(!d, 0)) return NULL;
+    if (__builtin_expect(!(__atomic_load_n((const unsigned char *)(d->ok + (a >> 12)), __ATOMIC_ACQUIRE) & bit), 0)) return NULL;
+    return d;
+}
+static inline __attribute__((always_inline)) void page_dirty(const RtFastDesc *d, uint64_t a) {
+    if (d->dirty) { unsigned char *p = (unsigned char *)(d->dirty + (a >> 12)); if (!__atomic_load_n(p, __ATOMIC_RELAXED)) __atomic_store_n(p, 1, __ATOMIC_RELAXED); }
+}
+#define ENTRY(N, T)                                                                                       \
+    T rt_ld##N(uint64_t a) {                                                                              \
+        if (__builtin_expect(page_desc(a, N / 8, 1) != NULL, 1)) { T v; __builtin_memcpy(&v, (const void *)(uintptr_t)a, N / 8); return v; } \
+        return (T)rt_checked_scalar_load(a, N / 8);                                                       \
+    }                                                                                                     \
+    void rt_st##N(uint64_t a, T v) {                                                                      \
+        const RtFastDesc *d = page_desc(a, N / 8, 2);                                                     \
+        if (__builtin_expect(d != NULL, 1)) { __builtin_memcpy((void *)(uintptr_t)a, &v, N / 8); page_dirty(d, a); return; } \
+        rt_checked_scalar_store(a, v, N / 8);                                                             \
+    }
+ENTRY(8, uint8_t)
+ENTRY(16, uint16_t)
+ENTRY(32, uint32_t)
+ENTRY(64, uint64_t)
+u128 rt_ld128(uint64_t a) {
+    if (__builtin_expect(page_desc(a, 16, 1) != NULL, 1)) { u128 v; __builtin_memcpy(&v, (const void *)(uintptr_t)a, 16); return v; }
+    return rt_checked_vector_load(a);
+}
+void rt_st128(uint64_t a, u128 v) {
+    const RtFastDesc *d = page_desc(a, 16, 2);
+    if (__builtin_expect(d != NULL, 1)) { __builtin_memcpy((void *)(uintptr_t)a, &v, 16); page_dirty(d, a); return; }
+    rt_checked_vector_store(a, v);
+}
