+"""Exercise the PS5 synchronisation algorithm on the host without a game/GPU.
+
+The SDK object build is a separate check; this does not claim PS5 runtime support.
+Usage: python3 tests/test_ps5_sync.py (also discovered by pytest)
+"""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class Ps5SyncChecks(unittest.TestCase):
+    def test_ps5_sync(self):
+        cc = shutil.which("clang")
+        if not cc:
+            self.skipTest("clang is needed for the standalone C harness")
+        with tempfile.TemporaryDirectory() as folder:
+            self.check_harness(Path(folder))
+
+    def check_harness(self, tmp_path):
+        cc = shutil.which("clang")
+        exe = tmp_path / "ps5-sync"
+        subprocess.run([
+            cc, "-O2", "-g", "-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing",
+            "-DMKW_PS5_HOST_CHECK", "-ffunction-sections", "-fdata-sections",
+            f"-I{ROOT / 'runtime/platform'}", str(ROOT / "tests/c/t_ps5_sync.c"),
+            str(ROOT / "runtime/platform/ps5_sync.c"), str(ROOT / "runtime/platform/common.c"),
+            "-pthread", "-Wl,--gc-sections", "-o", str(exe),
+        ], check=True, timeout=30)
+        subprocess.run([str(exe)], check=True, timeout=30)
+
+    def test_desktop_source_lists_exclude_ps5(self):
+        # Importing build.py also needs numpy/lz4 for the version detector.
+        import importlib.util
+        import sys
+
+        spec = importlib.util.spec_from_file_location("mkw_build_ps5_check", ROOT / "tools/build/build.py")
+        module = importlib.util.module_from_spec(spec)
