+++ b/tools/build/ps5_deps.py
@@ -0,0 +1,155 @@
+"""Prepare pinned VMA/xxHash headers and native PS5 zstd, without host libraries.
+
+Downloads MIT-compatible upstream dependencies into build/, verifies pinned
+SHA-256, retains their licenses, and cross-compiles zstd with the PS5 wrapper.
+Usage: python3 tools/build/ps5_deps.py --stack DIR [--jobs 2]
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tarfile
+import urllib.request
+
+ROOT = Path(__file__).resolve().parents[2]
+VMA_URL = 'https://raw.githubusercontent.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/v3.4.0/include/vk_mem_alloc.h'
+VMA_SHA = '8487b7995ad3b263eb73bc5b9a77d71aa69b6bef5d58a715c02d2663afd81f1a'
+ZSTD_URL = 'https://codeload.github.com/facebook/zstd/tar.gz/refs/tags/v1.5.7'
+ZSTD_SHA = '37d7284556b20954e56e1ca85b80226768902e2edabd3b649e9e72c0c9012ee3'
+XXHASH_URL = 'https://raw.githubusercontent.com/Cyan4973/xxHash/v0.8.3/xxhash.h'
+XXHASH_SHA = '17973c0dc49d9854ca26caa191f0e12f7a424b68858d9a78de3860d959d85e4b'
+OPUS_URL = 'https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz'
+OPUS_SHA = '6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1'
+VPX_URL = 'https://codeload.github.com/webmproject/libvpx/tar.gz/refs/tags/v1.17.0'
+VPX_SHA = '1020f184046187baa2985dbde38e0691f49c44088bca7a1842b0236c6081dc0a'
+
+
+def fetch(path, url, digest):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    data = path.read_bytes() if path.exists() else urllib.request.urlopen(url, timeout=30).read()
+    if hashlib.sha256(data).hexdigest() != digest:
+        raise ValueError(f'upstream dependency checksum mismatch: {path}')
+    if not path.exists():
+        path.write_bytes(data)
+
+
+def codecs(out, stack, jobs):
+    """Real codec implementations, kept even when the physical audio output is silent."""
+    sdk = stack / 'PS5_VulkanTemplate/.deps/native/ps5-payload-sdk'
+    wrapper = stack / 'PS5_Vulkan/tooling/prospero-clang18'
+    env = dict(os.environ, PS5_PAYLOAD_SDK=str(sdk))
+    cc = out / 'ps5-codec-cc'
+    cxx = out / 'ps5-codec-cxx'
+    for driver, linker in [(cc, 'prospero-clang'), (cxx, 'prospero-clang++')]:
+        # Static objects use the same compiler/flags as the title. Configure's
+        # executable link checks need the SDK's CRT/stubs and native linker too;
+        # never let those checks accidentally link against the desktop libc.
+        driver.write_text('#!/bin/sh\nfor arg do\n'
+                          ' case "$arg" in -c|-E|-S|--version|-dumpmachine)\n'
+                          '  exec sh ' + shlex.quote(str(wrapper)) + ' "$@";;\n'
+                          ' esac\ndone\nexec ' + shlex.quote(str(sdk / 'bin' / linker)) + ' "$@"\n')
+        driver.chmod(0o755)
+    info = {}
+    for name, version, url, digest in [('opus', '1.6.1', OPUS_URL, OPUS_SHA),
+                                        ('libvpx', '1.17.0', VPX_URL, VPX_SHA)]:
+        archive = out / f'{name}-{version}.tar.gz'
+        fetch(archive, url, digest)
+        source = out / f'{name}-{version}'
+        if not source.exists():
+            with tarfile.open(archive) as contents:
+                contents.extractall(out, filter='data')
+        build = out / f'{name}-ps5'
+        stamp = build / 'ps5-build-config.json'
+        config = {'source_sha256': digest, 'vp9_highbitdepth': True,
+                  'cc_driver_sha256': hashlib.sha256(cc.read_bytes()).hexdigest(),
+                  'cxx_driver_sha256': hashlib.sha256(cxx.read_bytes()).hexdigest()}
+        # libvpx's generated RTCD headers do not reliably follow a configuration
+        # change in an existing out-of-tree build. Never mix old 8-bit-only
+        # dispatch headers or desktop C++ objects with the new native build.
+        if build.exists() and (not stamp.exists() or json.loads(stamp.read_text()) != config):
+            shutil.rmtree(build)
+        build.mkdir(exist_ok=True)
+        stamp.write_text(json.dumps(config, indent=2))
+        with (out / f'{name}-build.log').open('w') as log:
+            def run(command):
+                subprocess.run(command, cwd=build, env=env, stdout=log,
+                               stderr=subprocess.STDOUT, check=True)
+            if name == 'opus':
+                run(['cmake', '-S', str(source), '-B', str(build), '-G', 'Ninja',
+                     '-DCMAKE_SYSTEM_NAME=FreeBSD', '-DCMAKE_SYSTEM_PROCESSOR=x86_64',
+                     '-DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY',
+                     '-DCMAKE_C_COMPILER=' + str(cc), '-DCMAKE_AR=' + shutil.which('llvm-ar'),
+                     '-DCMAKE_RANLIB=' + shutil.which('llvm-ranlib'), '-DCMAKE_BUILD_TYPE=Release',
+                     '-DCMAKE_C_FLAGS=-O2 -fPIC -march=x86-64-v3',
+                     '-DOPUS_BUILD_SHARED_LIBRARY=OFF', '-DOPUS_BUILD_TESTING=OFF',
+                     '-DOPUS_BUILD_PROGRAMS=OFF'])
+                run(['cmake', '--build', str(build), '--target', 'opus', '--parallel', str(jobs)])
+                library = build / 'libopus.a'
+                headers = out / 'opus-1.6.1-headers/opus'; headers.mkdir(parents=True, exist_ok=True)
+                # Runtime includes <opus/opus.h>, while upstream's source headers
+                # are flat. Preserve the actual headers, not substitute declarations.
+                for header in (source / 'include').glob('*.h'):
+                    (headers / header.name).write_bytes(header.read_bytes())
+                include = headers.parent
+            else:
+                # Generic C is a supported upstream backend, with both VP8/VP9
+                # encoders/decoders and pthreads. No Linux ABI assumptions or
+                # assembly generated for a desktop calling convention.
+                env.update(CC=str(cc), CXX=str(cxx), LD=str(sdk / 'bin/prospero-clang'), AR='llvm-ar',
+                           STRIP='llvm-strip', CFLAGS='-O2 -fPIC -march=x86-64-v3')
+                run([str(source / 'configure'), '--target=generic-gnu', '--enable-pic',
+                     '--enable-static', '--enable-vp9-highbitdepth', '--disable-shared', '--disable-examples',
+                     '--disable-tools', '--disable-docs', '--disable-unit-tests'])
+                run(['make', '-j' + str(jobs)])
+                library = build / 'libvpx.a'; include = source
+            if not library.is_file():
+                raise RuntimeError(f'{name} did not produce its target archive')
+            info[name] = {'version': version, 'url': url, 'sha256': digest, 'target': 'PS5',
+                          'archive': str(library), 'archive_bytes': library.stat().st_size,
+                          'include': str(include), 'license': str(source / ('COPYING' if name == 'opus' else 'LICENSE'))}
+    return info
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--stack', type=Path, required=True)
+    ap.add_argument('--out', type=Path, default=ROOT / 'build/ps5-deps')
+    ap.add_argument('--jobs', type=int, default=2)
+    ap.add_argument('--codecs', action='store_true', help='also cross-compile real Opus and VP8/VP9 libraries')
+    args = ap.parse_args()
+    if args.jobs < 1:
+        ap.error('--jobs must be positive')
+    out = args.out.resolve(); stack = args.stack.resolve()
+    vma = out / 'VulkanMemoryAllocator-3.4.0/include/vk_mem_alloc.h'
+    archive = out / 'zstd-v1.5.7.tar.gz'
+    fetch(vma, VMA_URL, VMA_SHA); fetch(archive, ZSTD_URL, ZSTD_SHA)
+    xxhash = out / 'xxHash-0.8.3/include/xxhash.h'
+    fetch(xxhash, XXHASH_URL, XXHASH_SHA)
+    zstd = out / 'zstd-1.5.7'
+    if not zstd.exists():
+        with tarfile.open(archive) as source:
+            source.extractall(out, filter='data')
+    wrapper = stack / 'PS5_Vulkan/tooling/prospero-clang18'
+    sdk = stack / 'PS5_VulkanTemplate/.deps/native/ps5-payload-sdk'
+    command = ['make', '-C', str(zstd / 'lib'), 'libzstd.a', '-j' + str(args.jobs),
+               'CC=' + shlex.join(['sh', str(wrapper)]), 'AR=llvm-ar', 'CFLAGS=-O2 -fPIC -march=x86-64-v3']
+    with (out / 'zstd-build.log').open('w') as log:
+        subprocess.run(command, env=dict(os.environ, PS5_PAYLOAD_SDK=str(sdk)),
+                       stdout=log, stderr=subprocess.STDOUT, check=True)
+    info = {'vma': {'version': '3.4.0', 'url': VMA_URL, 'sha256': VMA_SHA, 'include': str(vma.parent)},
+            'xxhash': {'version': '0.8.3', 'url': XXHASH_URL, 'sha256': XXHASH_SHA, 'include': str(xxhash.parent)},
+            'zstd': {'version': '1.5.7', 'url': ZSTD_URL, 'sha256': ZSTD_SHA,
+                     'include': str(zstd / 'lib'), 'archive': str(zstd / 'lib/libzstd.a'),
+                     'license': str(zstd / 'LICENSE'), 'target': 'PS5'}}
+    if args.codecs:
+        info.update(codecs(out, stack, args.jobs))
+    (out / 'dependencies.json').write_text(json.dumps(info, indent=2) + '\n')
+    print(json.dumps(info, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tools/build/ps5_game.py b/tools/build/ps5_game.py
new file mode 100644
index 0000000..7dc548d
--- /dev/null
+++ b/tools/build/ps5_game.py
@@ -0,0 +1,121 @@
+"""Cross-compile ALL generated game modules for the PS5 boot integration.
+
+Builds private module archives and the ordinary RtGame tables, not a runnable
+title. No dummy HLE symbols, skipped functions or replacement startup path.
+Usage: python3 tools/build/ps5_game.py --stack DIR --exefs DIR --regenerate --jobs 2
+"""
+import argparse
+import json
+import os
+import re
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'recomp'))
+from versions import detect  # noqa: E402
+from build import module_glue, game_id  # noqa: E402
+
+
+def path(value):
+    return str(value).replace('$', '$$').replace(' ', '$ ').replace(':', '$:')
+
+
+def command(tokens):
+    return shlex.join(map(str, tokens)).replace('$', '$$')
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--stack', type=Path, required=True)
+    ap.add_argument('--exefs', type=Path, required=True)
+    ap.add_argument('--gen', type=Path, default=ROOT / 'build/generated-ps5')
+    ap.add_argument('--out', type=Path, default=ROOT / 'build/ps5-full')
+    ap.add_argument('--jobs', type=int, default=2)
+    ap.add_argument('--regenerate', action='store_true')
+    args = ap.parse_args()
+    if args.jobs < 1:
+        ap.error('--jobs must be positive')
+    args.gen = args.gen.resolve(); args.out = args.out.resolve(); args.exefs = args.exefs.resolve()
+    version = detect(args.exefs)
+    if version.number != 100:
+        ap.error('this boot integration currently targets the local 1.0.0 copy')
+    if args.regenerate:
+        subprocess.run([sys.executable, str(ROOT / 'recomp/gen.py'), '--exefs', str(args.exefs),
+                        '--out', str(args.gen), '--jobs', str(args.jobs),
+                        '--patches', str(ROOT / 'recomp/patches-mkw.txt')], check=True)
+    if not (args.gen / 'layout.json').exists():
+        ap.error('run with --regenerate to create the private PS5 generated tree')
+    stack = args.stack.resolve()
+    wrapper = stack / 'PS5_Vulkan/tooling/prospero-clang18'
+    sdk = stack / 'PS5_VulkanTemplate/.deps/native/ps5-payload-sdk'
+    ar = shutil.which('llvm-ar') or str(sdk / 'bin/llvm-ar')
+    if not wrapper.is_file() or not shutil.which('ninja'):
+        ap.error('PS5 compiler wrapper and ninja are required')
+    env = dict(os.environ, PS5_PAYLOAD_SDK=str(sdk))
+    args.out.mkdir(parents=True, exist_ok=True)
+    includes = sorted({ROOT / 'runtime', args.gen} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')})
+    # Same O1 policy as the upstream generated-game build. Checked hooks are
+    # compile-time references: linking a real guest backend is still required.
+    # MKWBOOT-080: MKW_GAME_OPT (default O1, the upstream policy) picks the optimisation of the generated code.
+    flags = ['-' + os.environ.get('MKW_GAME_OPT', 'O1'), '-g0', '-fPIC', '-march=x86-64-v3', '-fno-strict-aliasing',
+             '-fvisibility=hidden', '-ffunction-sections', '-fdata-sections',
+             '-Wno-return-type', '-Wno-unused-label', '-DMKW_CHECKED_MEMORY',
+             '-DRT_GAME_ID="' + game_id() + '"', *['-I' + str(p) for p in includes]]
+    lines = ['rule cc', '  command = ' + command(['sh', wrapper, *flags]) + ' -MD -MF $out.d -c $in -o $out',
+             '  depfile = $out.d', '  deps = gcc', '  description = PS5 $in',
+             'rule ar', '  command = ' + command([ar, 'rcs']) + ' $out $in', '  description = ARCHIVE $out']
+    modules = json.loads((args.gen / 'layout.json').read_text())
+    summaries = []
+    for mod in modules:
+        name = mod['name']; objects = []
+        manifest = json.loads((args.gen / name / 'manifest.json').read_text())
+        sources = sorted((args.gen / name).glob('*.c'))
+        # Reject stale generated trees whose old atomic instructions bypass hooks.
+        for source in sources:
+            if '__atomic_compare_exchange_n(' in source.read_text() or '__atomic_fetch_' in source.read_text():
+                ap.error('generated code predates the atomic selection hooks; use --regenerate')
+            obj = args.out / 'obj' / name / (source.stem + '.o'); obj.parent.mkdir(parents=True, exist_ok=True)
+            objects.append(obj); lines.append(f'build {path(obj)}: cc {path(source)}')
+        archive = args.out / ('lib' + name + '-ps5.a')
+        archive.unlink(missing_ok=True)  # recreate without stale archive members
+        lines.append(f'build {path(archive)}: ar ' + ' '.join(path(p) for p in objects))
+        summaries.append({'name': name, 'functions': manifest['function_count'], 'units': len(sources),
+                          'archive': str(archive)})
+    glue = args.out / 'modules.c'; glue.write_text(module_glue(args.gen, args.exefs, library=False))
+    lines.append(f'build {path(args.out / "modules.o")}: cc {path(glue)}')
+    (args.out / 'build.ninja').write_text('\n'.join(lines) + '\n')
+    summary = {'version': version.number, 'modules': summaries,
+               'functions': sum(m['functions'] for m in summaries), 'checked_memory': True,
+               'all_guest_accesses_instrumented': False,
+               'pending_raw_access_example': 'HLE native pointer paths require integration',
+               'complete': False, 'linked_runtime': False, 'game_boot': False}
+    result_path = args.out / 'game-build.json'
+    result_path.write_text(json.dumps(summary, indent=2) + '\n')
+    result = subprocess.run(['ninja', '-f', str(args.out / 'build.ninja'), '-j', str(args.jobs)], cwd=ROOT, env=env)
+    summary['exit_code'] = result.returncode
+    summary['complete'] = result.returncode == 0
+    if summary['complete']:
+        for m in summaries:
+            m['archive_bytes'] = Path(m['archive']).stat().st_size
+            symbols = subprocess.check_output(['llvm-nm', '--defined-only', '--just-symbol-name', m['archive']], text=True).splitlines()
+            functions = {s for s in symbols if re.fullmatch('f_[0-9a-f]+', s)}
+            if len(functions) != m['functions']:
+                raise RuntimeError(f'compiled function count differs from manifest for {m["name"]}')
+            m['defined_function_symbols_verified'] = len(functions)
+            if m['name'] == 'main':
+                if 'f_7000cf2370' not in functions:
+                    raise RuntimeError('the expected 1.0.0 nnMain function is missing')
+                summary['nnMain_compiled'] = True
+    result_path.write_text(json.dumps(summary, indent=2) + '\n')
+    if result.returncode:
+        return result.returncode
+    print(f'ALL game functions compiled for PS5: {summary["functions"]}; runtime link/boot still pending', flush=True)
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
