+/* MKWBOOT-057: who takes the registry/region locks exclusively, how often, how long it waited to get them and how long it held them. */
+struct ps5_biglock_stat ps5_biglock_tab[16];
+int ps5_biglock_report(char *buf, size_t size, double ticks_per_ns)
+{
+   int n = snprintf(buf, size, "biglock writers:");
+   for (unsigned i = 0; i < 16 && n < (int)size - 120; i++) {
+      struct ps5_biglock_stat s = ps5_biglock_tab[i];
+      if (!s.who || !s.n) continue;
+      n += snprintf(buf + n, size - (size_t)n, " [%#llx n %llu wait %.0f us hold %.0f us max %.0f us]", (unsigned long long)s.who, (unsigned long long)s.n,
+                    s.wait / ticks_per_ns / 1000.0, s.hold / ticks_per_ns / 1000.0, s.max / ticks_per_ns / 1000.0);
+      __atomic_store_n(&ps5_biglock_tab[i].n, 0, __ATOMIC_RELAXED); __atomic_store_n(&ps5_biglock_tab[i].wait, 0, __ATOMIC_RELAXED);
+      __atomic_store_n(&ps5_biglock_tab[i].hold, 0, __ATOMIC_RELAXED); __atomic_store_n(&ps5_biglock_tab[i].max, 0, __ATOMIC_RELAXED);
+   }
+   return n;
+}
diff --git a/platform/src/demand.c b/platform/src/demand.c
new file mode 100644
index 0000000..8b85e73
--- /dev/null
+++ b/platform/src/demand.c
@@ -0,0 +1,367 @@
+/* Experimental demand-backed CPU regions. SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE 1
+#include "ps5platform/demand.h"
+#include "ps5platform/kernel.h"
+#include "ps5platform/shm.h"
+#include "placement.h"
+#include <errno.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <time.h>
+#include <ucontext.h>
+#ifdef __PROSPERO__
+#include "ps5platform/context.h"
+#endif
+
+#define UNIT ((size_t)0x10000)
+/* Keep owned demand windows in the documented high reservation area. MKW's
+ * fw9 failures were at 0x810e40000/0x820e50000, after the low view area filled.
+ * ReserveVirtualRange success there did not imply MAP_FIXED was accepted. */
+#define DEMAND_AREA ((uintptr_t)0x1000000000ull)
+static int reserve_window(size_t bytes, void **base)
+{
+   int result = ps5_vrange_reserve(bytes, (void *)DEMAND_AREA, UNIT, base);
+   if (!result && (uintptr_t)*base < DEMAND_AREA) {
+      ps5_vrange_release(*base, bytes);
+      *base = NULL;
+      return EINVAL;
+   }
+   return result;
+}
+
+enum { EMPTY, MAPPING, READY, FAILED };
+struct demand_unit { atomic_int state; int64_t physical; int stage, result; void *relocated; };
+struct ps5_demand_region {
+   _Atomic(struct ps5_demand_region *) next;
+   void *base, *data, *staging;
+   size_t size, reservation;
+   struct demand_unit *units;
+   atomic_int readonly;
+};
+static _Atomic(struct ps5_demand_region *) regions;
+static atomic_uint readers;
+static atomic_uint_fast64_t backed;
+static pthread_mutex_t registry_lock = PTHREAD_MUTEX_INITIALIZER;
+static ps5_demand_dispatcher external_dispatcher;
+_Static_assert(ATOMIC_POINTER_LOCK_FREE == 2 && ATOMIC_INT_LOCK_FREE == 2 &&
+               ATOMIC_LONG_LOCK_FREE == 2 && ATOMIC_LLONG_LOCK_FREE == 2,
+               "fault-side atomics must be lock-free");
+
+static void pause_cpu(void) { __asm__ volatile("pause"); }
+
+static int back_unit(struct ps5_demand_region *region, size_t index)
+{
+   struct demand_unit *unit = &region->units[index];
+   int expected = EMPTY;
+   if (!atomic_compare_exchange_strong_explicit(&unit->state, &expected, MAPPING,
+                                                memory_order_acq_rel, memory_order_acquire)) {
+      unsigned spins = 0;
+      while (expected == MAPPING) {
+         if (spins++ < 64) pause_cpu();
+         else {
+            // A higher-priority waiter must not spin out the thread mapping
+            // this unit on the same CPU. No pthread/allocator lock is taken.
+            const struct timespec delay = {0, 50000};
+            nanosleep(&delay, NULL);
+         }
+         expected = atomic_load_explicit(&unit->state, memory_order_acquire);
+      }
+      return expected == READY;
+   }
+   int64_t physical = -1;
+   unit->stage = PS5_DEMAND_ALLOCATE;
+   int result = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), UNIT, UNIT,
+                                               PS5_KERNEL_DIRECT_TYPE_CPU, &physical);
+   if (result != 0) {
+      unit->result = result;
+      atomic_store_explicit(&unit->state, FAILED, memory_order_release);
+      return 0;
+   }
+   unit->physical = physical;
+   atomic_fetch_add_explicit(&backed, UNIT, memory_order_relaxed);
+   void *stage = (char *)region->staging + index * UNIT;
+   void *mapped = stage;
+   unit->stage = PS5_DEMAND_MAP_STAGING;
+   result = sceKernelMapDirectMemory(&mapped, UNIT,
+                                     PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE,
+                                     PS5_KERNEL_MAP_FIXED, physical, 0x4000);
+   if (result == 0 && mapped != stage) {
+      sceKernelMunmap(mapped, UNIT);
+      result = -1;
+   }
+   // Some title mappings refuse MAP_FIXED into this reserved alias (MKW on
+   // firmware 9: 0x80020016). The private alias has no address contract: use the
+   // platform's normal placement, outside the GPU window. Never release the
+   // reservation or retry a public data mapping at another address.
+   if ((uint32_t)result == 0x80020016u) {
+      void *alternate = NULL;
+      result = ps5p_map_placed(physical, UNIT, 0,
+          PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE, -1, &alternate);
+      if (!result) { unit->relocated = alternate; stage = alternate; }
+   }
+   if (result == 0) {
+      // Reused direct memory is dirty. Zero via a private alias before making
+      // the public view accessible, including to threads that would not fault.
+      // Volatile stores keep this independent of an out-of-line libc memset.
+      volatile uint64_t *words = stage;
+      for (size_t i = 0; i < UNIT / sizeof(*words); i++) words[i] = 0;
+      void *target = (char *)region->data + index * UNIT;
+      mapped = target;
+      unit->stage = PS5_DEMAND_MAP_DATA;
+      result = sceKernelMapDirectMemory(&mapped, UNIT,
+                                        atomic_load_explicit(&region->readonly, memory_order_acquire) ?
+                                           PS5_KERNEL_PROT_CPU_READ : PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE,
+                                        PS5_KERNEL_MAP_FIXED, physical, 0x4000);
+      if (result == 0 && mapped != target) {
+         sceKernelMunmap(mapped, UNIT);
+         result = -1;
+      }
+   }
+   // Keep the private alias mapped until destroy, avoiding a temporary hole
+   // that another allocator could take. It costs virtual space, not more RAM.
+   unit->result = result;
+   atomic_store_explicit(&unit->state, result == 0 ? READY : FAILED, memory_order_release);
+   return result == 0;
+}
+
+static int demand_fault_access(uintptr_t address, int write)
+{
+   // Sequential consistency makes unlink + waiting for readers a reclamation
+   // barrier. No region metadata is freed while a handler could still use it.
+   atomic_fetch_add_explicit(&readers, 1, memory_order_seq_cst);
+   int handled = 0;
+   for (struct ps5_demand_region *region = atomic_load_explicit(&regions, memory_order_seq_cst);
+        region; region = atomic_load_explicit(&region->next, memory_order_seq_cst)) {
+      uintptr_t low = (uintptr_t)region->data;
+      if (address >= low && address - low < region->size) {
+         if (!write || !atomic_load_explicit(&region->readonly, memory_order_acquire))
+            handled = back_unit(region, (address - low) / UNIT);
+         break;
+      }
+   }
+   atomic_fetch_sub_explicit(&readers, 1, memory_order_seq_cst);
+   return handled;
+}
+int ps5_demand_fault(uintptr_t address) { return demand_fault_access(address, 0); }
+int ps5_demand_prepare(struct ps5_demand_region *region, size_t offset, size_t bytes,
+                       struct ps5_demand_failure *failure)
+{
+   if (failure) *failure = (struct ps5_demand_failure){0};
+   if (!region || offset > region->size || bytes > region->size - offset) {
+      if (failure) failure->result = EINVAL;
+      return -1;
+   }
+   if (!bytes) return 0;
+   size_t last = (offset + bytes - 1) / UNIT;
+   for (size_t i = offset / UNIT; i <= last; i++) {
+      if (back_unit(region, i)) continue;
+      // back_unit acquires FAILED from another mapper or publishes its own
+      // failure: the phase/result are stable until the owner destroys region.
+      struct demand_unit *u = &region->units[i];
+      if (failure) *failure = (struct ps5_demand_failure){u->stage, u->result,
+          (uintptr_t)region->data + i * UNIT, u->relocated ? (uintptr_t)u->relocated : (uintptr_t)region->staging + i * UNIT, u->physical};
+      return -1;
+   }
+   return 0;
+}
+
+
+static void demand_signal(int sig, siginfo_t *info, void *context)
+{
+   int saved_errno = errno;
+   ucontext_t *uc = context;
+#ifdef __PROSPERO__
+   uint64_t error = uc->uc_mcontext.mc_err;
+#else
+   uint64_t error = (uint64_t)uc->uc_mcontext.gregs[REG_ERR];
+#endif
+   // Demand stacks are CPU read/write, never executable. An NX violation must
+   // remain fatal even if a racing reader has already backed this unit.
+   if (info->si_code > 0 && !(error & 16u) && demand_fault_access((uintptr_t)info->si_addr, (error & 2u) != 0)) {
+      errno = saved_errno;
+      return;
+   }
+   // This handler is installed only over SIG_DFL. Unowned faults, guards and
+   // allocation failures retain that fatal disposition, rather than retrying.
+   struct sigaction action = {.sa_handler = SIG_DFL};
+   sigemptyset(&action.sa_mask);
+   if (sigaction(sig, &action, NULL) || raise(sig)) __builtin_trap();
+   errno = saved_errno;
+}
+
+static int install_locked(void)
+{
+   struct sigaction old;
+   if (sigaction(SIGSEGV, NULL, &old)) return -1;
+   if ((old.sa_flags & SA_SIGINFO) && old.sa_sigaction == demand_signal) return 0;
+   if ((old.sa_flags & SA_SIGINFO) && external_dispatcher && old.sa_sigaction == external_dispatcher) return 0;
+   if (old.sa_handler != SIG_DFL) { errno = EBUSY; return -1; }
+   struct sigaction action = {.sa_sigaction = demand_signal, .sa_flags = SA_SIGINFO | SA_ONSTACK};
+   sigemptyset(&action.sa_mask);
+   if (sigaction(SIGSEGV, &action, NULL)) return -1;
+   return 0;
+}
+
+int ps5_demand_bind_dispatcher(ps5_demand_dispatcher dispatcher)
+{
+   pthread_mutex_lock(&registry_lock);
+   struct sigaction current;
+   int result = 0;
+   if (dispatcher && (sigaction(SIGSEGV, NULL, &current) ||
+       !(current.sa_flags & SA_SIGINFO) || current.sa_sigaction != dispatcher)) {
+      errno = EINVAL; result = -1;
+   } else external_dispatcher = dispatcher;
+   pthread_mutex_unlock(&registry_lock);
+   return result;
+}
+
+int ps5_demand_access(uintptr_t address, unsigned access)
+{
+   if (access != PS5_DEMAND_READ && access != PS5_DEMAND_WRITE) return 0;
+   return demand_fault_access(address, access == PS5_DEMAND_WRITE);
+}
+
+int ps5_demand_create(size_t bytes, size_t guard, struct ps5_demand_region **out)
+{
+   if (!out) return -1;
+   *out = NULL;
+   if (!bytes || bytes > SIZE_MAX - UNIT || guard > SIZE_MAX - UNIT) return -1;
+   bytes = (bytes + UNIT - 1) & ~(UNIT - 1);
+   guard = (guard + UNIT - 1) & ~(UNIT - 1);
+   if (guard > SIZE_MAX - bytes || bytes + guard > SIZE_MAX - bytes) return -1;
+   struct ps5_demand_region *region = calloc(1, sizeof(*region));
+   if (!region) return -1;
+   atomic_init(&region->next, NULL);
+   atomic_init(&region->readonly, 0);
+   region->size = bytes;
+   region->reservation = bytes + guard;
+   region->units = calloc(bytes / UNIT, sizeof(*region->units));
+   if (!region->units) { free(region); return -1; }
+   for (size_t i = 0; i < bytes / UNIT; i++) {
+      atomic_init(&region->units[i].state, EMPTY);
+      region->units[i].physical = -1;
+   }
+   const char *stage = "reserve data";
+   int result = reserve_window(region->reservation, &region->base);
+   if (result) goto fail;
+   region->data = (char *)region->base + guard;
+   stage = "reserve staging";
+   result = reserve_window(bytes, &region->staging);
+   if (result) goto fail;
+   stage = "signal dispatcher";
+   pthread_mutex_lock(&registry_lock);
+   result = install_locked();
+   if (result == 0) {
+      atomic_store_explicit(&region->next, atomic_load_explicit(&regions, memory_order_seq_cst), memory_order_seq_cst);
+      atomic_store_explicit(&regions, region, memory_order_seq_cst);
+   }
+   pthread_mutex_unlock(&registry_lock);
+   if (result != 0) goto fail;
+   *out = region;
+   return 0;
+fail:
+   { int saved = errno;
+     fprintf(stderr, "[ps5-demand] create %zu bytes failed at %s: result %d (%#x), errno %d\n",
+             bytes, stage, result, (unsigned)result, saved);
+   if (region->staging) ps5_vrange_release(region->staging, bytes);
+   if (region->base) ps5_vrange_release(region->base, region->reservation);
+   free(region->units); free(region);
+   errno = saved; }
+   return -1;
+}
+
+void *ps5_demand_data(const struct ps5_demand_region *region) { return region->data; }
+size_t ps5_demand_size(const struct ps5_demand_region *region) { return region->size; }
+size_t ps5_demand_reserved(const struct ps5_demand_region *region) { return region->reservation + region->size; }
+uint64_t ps5_demand_backed_bytes(void) { return atomic_load_explicit(&backed, memory_order_relaxed); }
+int ps5_demand_seal_readonly(struct ps5_demand_region *region)
+{
+   atomic_store_explicit(&region->readonly, 1, memory_order_release);
+   for (size_t i = 0; i < region->size / UNIT; i++) {
+      int state;
+      while ((state = atomic_load_explicit(&region->units[i].state, memory_order_acquire)) == MAPPING) {
+         const struct timespec delay = {0, 50000}; nanosleep(&delay, NULL);
+      }
+      if (state == FAILED) return -1;
+      if (state == READY && sceKernelMprotect((char *)region->data + i * UNIT, UNIT, PS5_KERNEL_PROT_CPU_READ)) return -1;
+   }
+   return 0;
+}
+
+void ps5_demand_destroy(struct ps5_demand_region *region)
+{
+   if (!region) return;
+   pthread_mutex_lock(&registry_lock);
+   _Atomic(struct ps5_demand_region *) *link = &regions;
+   while (atomic_load_explicit(link, memory_order_seq_cst) != region) {
+      struct ps5_demand_region *entry = atomic_load_explicit(link, memory_order_seq_cst);
+      if (!entry) __builtin_trap();
+      link = &entry->next;
+   }
+   atomic_store_explicit(link, atomic_load_explicit(&region->next, memory_order_seq_cst), memory_order_seq_cst);
+   while (atomic_load_explicit(&readers, memory_order_seq_cst)) {
+      const struct timespec delay = {0, 50000};
+      nanosleep(&delay, NULL);
+   }
+   if (ps5_vrange_release(region->base, region->reservation) ||
+       ps5_vrange_release(region->staging, region->size)) __builtin_trap();
+   for (size_t i = 0; i < region->size / UNIT; i++) {
+      if (region->units[i].relocated && sceKernelMunmap(region->units[i].relocated, UNIT)) __builtin_trap();
+      if (region->units[i].physical < 0) continue;
+      if (sceKernelReleaseDirectMemory(region->units[i].physical, UNIT)) __builtin_trap();
+      atomic_fetch_sub_explicit(&backed, UNIT, memory_order_relaxed);
+   }
+   free(region->units); free(region);
+   pthread_mutex_unlock(&registry_lock);
+}
+
+static _Thread_local struct {
+   unsigned refs;
+   stack_t old;
+   void *base;
+} thread_stack;
+
+int ps5_demand_thread_attach(void)
+{
+   if (thread_stack.refs) { thread_stack.refs++; return 0; }
+   if (sigaltstack(NULL, &thread_stack.old)) return -1;
+   if (thread_stack.old.ss_flags & SS_DISABLE) {
+      void *base = NULL;
+      if (reserve_window(2 * UNIT, &base)) return -1;
+      if (ps5_vrange_commit((char *)base + UNIT, UNIT, PS5_SHM_READ | PS5_SHM_WRITE)) {
+         ps5_vrange_release(base, 2 * UNIT); return -1;
+      }
+      stack_t stack = {.ss_sp = (char *)base + UNIT, .ss_size = UNIT};
+      if (sigaltstack(&stack, NULL)) { ps5_vrange_release(base, 2 * UNIT); return -1; }
+      thread_stack.base = base;
+   }
+   thread_stack.refs = 1;
+   return 0;
+}
+void ps5_demand_thread_detach(void)
+{
+   if (!thread_stack.refs) __builtin_trap();
+   if (--thread_stack.refs) return;
+   if (thread_stack.base) {
+      if (sigaltstack(&thread_stack.old, NULL) || ps5_vrange_release(thread_stack.base, 2 * UNIT)) __builtin_trap();
+      thread_stack.base = NULL;
+   }
+}
+
+int ps5_demand_thread_retire(void **token)
+{
+   if (!token || thread_stack.refs != 1) return -1;
+   *token = thread_stack.base;
+   thread_stack.refs = 0;
+   thread_stack.base = NULL;
+   // Leave sigaltstack installed: pthread's TLS destructors still use the
+   // demand-backed worker stack after its callback returned.
+   return 0;
+}
+void ps5_demand_thread_release(void *token)
+{
+   if (token && ps5_vrange_release(token, 2 * UNIT)) __builtin_trap();
+}
diff --git a/platform/tests/demand_host_kernel.c b/platform/tests/demand_host_kernel.c
new file mode 100644
index 0000000..7436c4a
--- /dev/null
+++ b/platform/tests/demand_host_kernel.c
@@ -0,0 +1,128 @@
+/* Linux model for demand.c; not PS5 kernel evidence. SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE
+#include "ps5platform/kernel.h"
+#include "ps5platform/shm.h"
+#include <stdatomic.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+atomic_int demand_test_live_allocs, demand_test_fail_alloc, demand_test_map_calls, demand_test_fail_map;
+atomic_int demand_test_fail_commit;
+atomic_int demand_test_low_hint, demand_test_force_low_return;
+atomic_int demand_test_fixed_reject, demand_test_relocate_fail, demand_test_relocated;
+static atomic_uintptr_t relocated_address;
+atomic_int checked_test_commit_calls, checked_test_fail_commit_at;
+atomic_int checked_test_protect_calls, checked_test_fail_protect, checked_test_fail_protect_always;
+atomic_int checked_test_fail_decommit;
+
+int ps5_vrange_reserve(size_t bytes, void *hint, size_t alignment, void **base)
+{
+   if ((uintptr_t)hint != (uintptr_t)0x1000000000ull) atomic_store(&demand_test_low_hint, 1);
+   if (!alignment) alignment = 0x10000;
+   int flags = MAP_ANONYMOUS | MAP_PRIVATE;
+   if (atomic_load(&demand_test_force_low_return)) flags |= MAP_32BIT;
+   void *raw = mmap(NULL, bytes + alignment, PROT_NONE, flags, -1, 0);
+   if (raw == MAP_FAILED) return -1;
+   uintptr_t aligned = ((uintptr_t)raw + alignment - 1) & ~(alignment - 1);
+   size_t prefix = aligned - (uintptr_t)raw;
+   if (prefix) munmap(raw, prefix);
+   size_t suffix = alignment - prefix;
+   if (suffix) munmap((void *)(aligned + bytes), suffix);
+   *base = (void *)aligned;
+   return 0;
+}
+int ps5_vrange_commit(void *address, size_t bytes, int protection)
+{
+   (void)protection;
+   int call = atomic_fetch_add(&checked_test_commit_calls, 1) + 1;
+   if (atomic_load(&demand_test_fail_commit) || call == atomic_load(&checked_test_fail_commit_at)) return -1;
+   uintptr_t low = (uintptr_t)address & ~(uintptr_t)0x3fff;
+   uintptr_t high = ((uintptr_t)address + bytes + 0x3fff) & ~(uintptr_t)0x3fff;
+   return mprotect((void *)low, high - low, PROT_READ | PROT_WRITE);
+}
+int ps5_vrange_decommit(void *address, size_t bytes)
+{
+   if (atomic_load(&checked_test_fail_decommit)) return -1;
+   uintptr_t low = (uintptr_t)address & ~(uintptr_t)0x3fff;
+   uintptr_t high = ((uintptr_t)address + bytes + 0x3fff) & ~(uintptr_t)0x3fff;
+   if (mprotect((void *)low, high - low, PROT_READ | PROT_WRITE)) return -1;
+   if (!((uintptr_t)address % 0x10000) && !(bytes % 0x10000)) {
+      if (madvise(address, bytes, MADV_DONTNEED)) return -1;
+      return mprotect(address, bytes, PROT_NONE);
+   }
+   memset(address, 0, bytes);
+   return 0;
+}
+int ps5_vrange_reserve_at(void *address, size_t bytes)
+{
+   void *mapped = mmap(address, bytes, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+   if (mapped != address && mapped != MAP_FAILED) munmap(mapped, bytes);
+   return mapped == address ? 0 : -1;
+}
+int32_t sceKernelMprotect(const void *address, size_t bytes, int protection)
+{
+   int call = atomic_fetch_add(&checked_test_protect_calls, 1) + 1;
+   if (atomic_load(&checked_test_fail_protect_always) || call == atomic_load(&checked_test_fail_protect)) return -1;
+   return mprotect((void *)address, bytes, protection);
+}
+int ps5_vrange_release(void *base, size_t bytes) { return munmap(base, bytes); }
+int64_t sceKernelGetDirectMemorySize(void) { return INT64_MAX; }
+int32_t sceKernelAllocateDirectMemory(int64_t start, int64_t end, size_t length,
+                                     size_t alignment, int type, int64_t *physical)
+{
+   (void)start; (void)end; (void)alignment; (void)type;
+   if (atomic_load(&demand_test_fail_alloc)) return -1;
+   int fd = (int)syscall(SYS_memfd_create, "demand-test", 1);
+   if (fd < 0) return -1;
+   if (ftruncate(fd, (off_t)length)) { close(fd); return -1; }
+   void *dirty = mmap(NULL, length, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (dirty == MAP_FAILED) { close(fd); return -1; }
+   memset(dirty, 0xa5, length); // New backing is deliberately dirty, as on the console.
+   munmap(dirty, length);
+   *physical = fd;
+   atomic_fetch_add(&demand_test_live_allocs, 1);
+   return 0;
+}
+int32_t sceKernelMapDirectMemory(void **address, size_t length, int protection, int flags,
+                                int64_t physical, size_t alignment)
+{
+   (void)flags; (void)alignment;
+   int call = atomic_fetch_add(&demand_test_map_calls, 1) + 1;
+   if (call == atomic_load(&demand_test_fail_map)) return -1;
+   if (atomic_load(&demand_test_fixed_reject) && call == 1) return (int32_t)0x80020016u;
+   void *mapped = mmap(*address, length, protection, MAP_SHARED | MAP_FIXED, (int)physical, 0);
+   if (mapped == MAP_FAILED) return -1;
+   *address = mapped;
+   return 0;
+}
+int32_t sceKernelMunmap(void *address, size_t bytes) {
+   int result = munmap(address, bytes);
+   uintptr_t expected = (uintptr_t)address;
+   if (!result && atomic_compare_exchange_strong(&relocated_address, &expected, 0))
+      atomic_fetch_sub(&demand_test_relocated, 1);
+   return result;
+}
+int32_t sceKernelReleaseDirectMemory(int64_t physical, size_t bytes)
+{
+   (void)bytes;
+   int result = close((int)physical);
+   if (!result) atomic_fetch_sub(&demand_test_live_allocs, 1);
+   return result;
+}
+
+/* Model the placement helper's result, not a guessed PS5 VA policy. */
+int ps5p_map_placed(int64_t physical, size_t bytes, uintptr_t hint, int protection,
+                    int no_place, void **address)
+{
+   (void)hint; (void)no_place;
+   if (atomic_load(&demand_test_relocate_fail)) return -1;
+   void *p = mmap(NULL, bytes, protection, MAP_SHARED, (int)physical, 0);
+   if (p == MAP_FAILED) return -1;
+   *address = p;
+   atomic_store(&relocated_address, (uintptr_t)p);
+   atomic_fetch_add(&demand_test_relocated, 1);
+   return 0;
+}
diff --git a/platform/tests/test_checked_atomics.c b/platform/tests/test_checked_atomics.c
new file mode 100644
index 0000000..c332486
--- /dev/null
+++ b/platform/tests/test_checked_atomics.c
@@ -0,0 +1,95 @@
+/* Shared-lock data stores and atomics: no lost updates, no tearing, protection changes still exclusive.
+ * SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE
+#include "ps5platform/checked_region.h"
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define THREADS 6
+#define ROUNDS 40000
+static struct ps5_checked_region *r;
+/* 4-byte and 8-byte CAS increments of shared counters from every thread: the sum must be exact. */
+static void *cas_worker(void *arg)
+{
+   (void)arg;
+   for (int i = 0; i < ROUNDS; i++) {
+      uint32_t e = 0, d; int ex = 0;
+      assert(ps5_checked_atomic_load(r, 0x100, &e, 4));
+      do { d = e + 1; assert(ps5_checked_atomic_cas(r, 0x100, &e, &d, 4, &ex)); } while (!ex);
+      uint64_t e8 = 0, d8;
+      assert(ps5_checked_atomic_load(r, 0x108, &e8, 8));
+      do { d8 = e8 + 3; assert(ps5_checked_atomic_cas(r, 0x108, &e8, &d8, 8, &ex)); } while (!ex);
+   }
+   return NULL;
+}
+/* Aligned 8-byte plain stores race with 8-byte atomic loads: every value read was one a store wrote. */
+static void *store_worker(void *arg)
+{
+   uint64_t tag = (uint64_t)(uintptr_t)arg * 0x0101010101010101ull;
+   for (int i = 0; i < ROUNDS; i++) assert(ps5_checked_write(r, 0x200, &tag, 8));
+   return NULL;
+}
+static void *load_worker(void *arg)
+{
+   (void)arg;
+   for (int i = 0; i < ROUNDS; i++) {
+      uint64_t v = 0;
+      assert(ps5_checked_atomic_load(r, 0x200, &v, 8));
+      uint8_t b = (uint8_t)v;
+      assert(v == b * 0x0101010101010101ull);   /* never a mix of two stores */
+      assert(ps5_checked_read(r, 0x200, &v, 8));
+      b = (uint8_t)v;
+      assert(v == b * 0x0101010101010101ull);
+   }
+   return NULL;
+}
+/* Protection flips while others access: accesses either succeed or are refused, never crash or hang. */
+static void *flip_worker(void *arg)
+{
+   (void)arg;
+   for (int i = 0; i < 2000; i++) {
+      assert(ps5_checked_protect(r, 0x4000, 0x1000, i & 1 ? PS5_CHECKED_RW : PS5_CHECKED_READ));
+   }
+   assert(ps5_checked_protect(r, 0x4000, 0x1000, PS5_CHECKED_RW));
+   return NULL;
+}
+static void *probe_worker(void *arg)
+{
+   (void)arg; uint32_t v = 1;
+   for (int i = 0; i < 20000; i++) { (void)ps5_checked_write(r, 0x4000, &v, 4); assert(ps5_checked_read(r, 0x4000, &v, 4)); }
+   return NULL;
+}
+int main(void)
+{
+   const uintptr_t base = 0x7000000000ull;
+   /* Sparse: the first store into each 64 KiB unit takes the exclusive backing path, later ones the shared path. */
+   assert(ps5_checked_create_sparse(base, 0x40000, 1, &r));
+   assert(ps5_checked_commit(r, 0, 0x40000));
+   uint32_t zero = 0; assert(ps5_checked_atomic_load(r, 0x100, &zero, 4) && zero == 0);   /* unbacked reads zero */
+   pthread_t t[THREADS * 2];
+   for (int i = 0; i < THREADS; i++) assert(!pthread_create(&t[i], NULL, cas_worker, NULL));
+   for (int i = 0; i < THREADS; i++) assert(!pthread_join(t[i], NULL));
+   uint32_t c4 = 0; uint64_t c8 = 0;
+   assert(ps5_checked_atomic_load(r, 0x100, &c4, 4) && ps5_checked_atomic_load(r, 0x108, &c8, 8));
+   assert(c4 == (uint32_t)THREADS * ROUNDS && c8 == (uint64_t)THREADS * ROUNDS * 3);
+   int n = 0;
+   for (int i = 0; i < 3; i++) assert(!pthread_create(&t[n++], NULL, store_worker, (void *)(intptr_t)(i + 1)));
+   for (int i = 0; i < 3; i++) assert(!pthread_create(&t[n++], NULL, load_worker, NULL));
+   assert(!pthread_create(&t[n++], NULL, flip_worker, NULL));
+   assert(!pthread_create(&t[n++], NULL, probe_worker, NULL));
+   for (int i = 0; i < n; i++) assert(!pthread_join(t[i], NULL));
+   /* Dirty tracking survives the shared path. */
+   uint64_t pages[16];
+   assert(ps5_checked_written(r, 0, 0x40000, pages, 16, 1) != UINT64_MAX);
+   uint32_t v = 7; assert(ps5_checked_write(r, 0x30000, &v, 4));
+   assert(ps5_checked_written(r, 0, 0x40000, pages, 16, 1) == 1 && pages[0] == base + 0x30000);
+   /* 16-byte atomics still work (exclusive path) beside 8-byte ones. */
+   unsigned char a[16] = {1, 2, 3}, b[16] = {0}; int ex = 0;
+   assert(ps5_checked_atomic_store(r, 0x300, a, 16) && ps5_checked_atomic_load(r, 0x300, b, 16) && !memcmp(a, b, 16));
+   unsigned char want[16] = {9}; assert(ps5_checked_atomic_cas(r, 0x300, a, want, 16, &ex) && ex);
+   ps5_checked_destroy(r);
+   puts("PASS: exact CAS counters, untorn 8-byte stores, concurrent protection, dirty pages, 16-byte atomics");
+   return 0;
+}
diff --git a/platform/tests/test_checked_region.c b/platform/tests/test_checked_region.c
