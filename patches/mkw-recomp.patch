index 0000000..ed3ac05
--- /dev/null
+++ b/tools/build/ps5_game_slice.py
@@ -0,0 +1,49 @@
+"""Translate two leaf functions from the user's MKW 1.0.0 main for PS5 execution.
+
+Uses the ordinary generator, with no replacement instructions. Derived C stays
+in build/ and must never enter git or a source distribution.
+Usage: python3 tools/build/ps5_game_slice.py --exefs DIR --out build/ps5/mkw_game_slice.h
+"""
+import argparse
+import hashlib
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'recomp'))
+from gen import Emitter, GENERATED_MARKER  # noqa: E402
+from module import Module  # noqa: E402
+from versions import detect  # noqa: E402
+from layout import layout  # noqa: E402
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('--exefs', required=True, type=Path)
+    ap.add_argument('--out', required=True, type=Path)
+    args = ap.parse_args()
+    if detect(args.exefs).number != 100:
+        raise SystemExit('this execution slice requires the verified 1.0.0 dump')
+    base = next(base for name, base, _ in layout(args.exefs) if name == 'main')
+    mod = Module('main', args.exefs / 'main', base, simd='c')
+    starts = set(mod.seeds())
+    emitter = Emitter(mod, starts)
+    text = [f'// {GENERATED_MARKER}: private PS5 execution slice. Never commit.', '#pragma once']
+    digest = hashlib.sha256((args.exefs / 'main').read_bytes()).digest()
+    text.append('static const unsigned char slice_main_sha256[32] = {' + ','.join(str(b) for b in digest) + '};')
+    for offset, size in [(0x4e6c8, 0x2c), (0x80bc4, 0x28)]:
+        entry = base + offset
+        if entry not in starts:
+            raise SystemExit(f'function boundary not found: main+{offset:#x}')
+        body, refs = emitter.function(entry, entry + size)
+        if refs or emitter.unsupported:
+            raise SystemExit('selected slice contains external calls or unsupported instructions')
+        text.append("__attribute__((noinline))")
+        text.extend(body)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text('\n'.join(text) + '\n')
+    print(f'Actual MKW main functions translated: +0x4e6c8 and +0x80bc4 -> {args.out}')
+
+
+if __name__ == '__main__':
+    main()
