+void plat_wait_ns(uint64_t ns) {
+    struct timespec ts = {(time_t)(ns / 1000000000u), (long)(ns % 1000000000u)};
+    while (nanosleep(&ts, &ts)) { if (errno != EINTR) __builtin_trap(); }
