+            main.write_text(r'''
+#include "platform/platform.h"
+#include "platform/ps5_mem.h"
+#include "platform/ps5_hle_copy.h"
+#include "cpu/cpu.h"
+#include <ps5platform/checked_region.h>
+#include <assert.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <signal.h>
+#include <pthread.h>
+_Noreturn void rt_fatal(const char *format, ...) { (void)format; _exit(77); }
+void rt_log(const char *format, ...) { (void)format; }
+extern atomic_int checked_test_commit_calls, checked_test_fail_commit_at;
+static uint64_t heap = 0x4000000000ull;
+static int faults, watches;
+static int lazy(uint64_t a) {
+    faults++;
+    return plat_mem_commit(a & ~0xfffull, 4096);
+}
+static int watch(uint64_t a, uint64_t pc) {
+    assert(pc == 0x1234); watches++;
+    return plat_mem_protect(a & ~0xfffull, 4096, PLAT_PROT_RW);
+}
+static void *increment(void *unused) {
+    (void)unused;
+    for (int i = 0; i < 1000; i++) (void)rt_checked_atomic_rmw(heap + 4096, 1, 8, 1);
+    return NULL;
+}
+int main(void) {
+    Ps5GuestSpace *s = ps5_memory_space(); assert(s);
+    uint64_t end = 0;
+    assert(plat_mem_reserve(heap, 14ull << 30, 1));
+    assert(plat_mem_state(heap, heap + (14ull << 30), &end) == PLAT_MEM_RESERVED);
+    assert(end == heap + (14ull << 30));
+    // Actual odd-sized lazy heap request observed on PS5.
+    uint64_t odd = heap + 0x22c00000, odd_end = 0;
+    assert(plat_mem_commit(odd, 0xcbcef));
+    assert(plat_mem_state(odd, odd + 0x100000, &odd_end) == PLAT_PROT_RW);
+    assert(odd_end == odd + 0xcc000);
+    assert(plat_mem_state(odd_end, odd_end + 4096, &end) == PLAT_MEM_RESERVED);
+    assert(plat_mem_decommit(odd, 0xcc000));
+    // Partial first/last pages: neighboring RO pages in the same native page
+    // keep their logical rights; a byte count must not become a 16 KiB commit.
+    uint64_t partial = heap + 0x1000000;
+    assert(plat_mem_commit(partial, 4096));
+    assert(plat_mem_commit(partial + 12288, 4096));
+    assert(plat_mem_protect(partial, 4096, PLAT_PROT_READ));
+    assert(plat_mem_protect(partial + 12288, 4096, PLAT_PROT_READ));
+    assert(plat_mem_commit(partial + 4096 + 17, 4096));
+    assert(plat_mem_state(partial, partial + 16384, &end) == PLAT_PROT_READ && end == partial + 4096);
+    assert(plat_mem_state(partial + 4096, partial + 16384, &end) == PLAT_PROT_RW && end == partial + 12288);
+    assert(plat_mem_state(partial + 12288, partial + 16384, &end) == PLAT_PROT_READ);
+    assert(!plat_mem_commit(UINT64_MAX - 8, 16));
