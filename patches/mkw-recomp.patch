+"""Loose-RomFS metadata validation; directory failures must propagate."""
+import ctypes
+import hashlib
+import importlib.util
+from pathlib import Path
+import struct
+import subprocess
+import tempfile
+import unittest
+ROOT = Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location('romfs_index_tool', ROOT / 'tools/romfs/index.py')
+tool = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(tool)
+
+class RomfsIndexTest(unittest.TestCase):
+    def test_metadata_and_corruption(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); root = d / 'romfs'
+            (root / 'System').mkdir(parents=True)
+            (root / 'System/test.bin').write_bytes(b'actual asset bytes')
+            (root / 'empty').write_bytes(b'')
+            (root / '.listing').write_text('ignored')
+            (root / 'link').symlink_to('System', target_is_directory=True)
+            out = d / 'romfs.index'
+            self.assertEqual(tool.build(root, out)['files'], 2)
+            self.assertNotIn(b'actual asset bytes', out.read_bytes())
+            library = d / 'index.so'
+            subprocess.run(['clang', '-shared', '-fPIC', '-O2', '-I' + str(ROOT / 'runtime/sdk/fs'),
+                            '-I' + str(ROOT / 'runtime/core/base'), str(ROOT / 'runtime/sdk/fs/romfs_index.c'),
+                            str(ROOT / 'runtime/core/base/sha256.c'), '-o', str(library)], check=True)
+            fn = ctypes.CDLL(str(library)).romfs_index_validate
+            fn.argtypes = [ctypes.c_char_p, ctypes.c_size_t, ctypes.POINTER(ctypes.c_uint64), ctypes.POINTER(ctypes.c_uint64)]
+            def valid(data):
+                count, strings = ctypes.c_uint64(), ctypes.c_uint64()
+                return fn(data, len(data), ctypes.byref(count), ctypes.byref(strings))
+            good = out.read_bytes()
+            self.assertTrue(valid(good))
+            for n in (0, 23, 55, len(good) - 1): self.assertFalse(valid(good[:n]))
+            bad = bytearray(good); bad[-1] ^= 1
+            self.assertFalse(valid(bytes(bad)))
+            def resigned(data): return bytes(data[:-32]) + hashlib.sha256(data[:-32]).digest()
+            for offset, value in ((8, 2**64 - 1), (16, 1), (24, 10)):
+                bad = bytearray(good); struct.pack_into('<Q', bad, offset, value)
+                self.assertFalse(valid(resigned(bad)))
+            strings = struct.unpack_from('<Q', good, 16)[0]
+            for name in (b'../bad/', b'/badbad', b'bad\\bad'):
+                bad = bytearray(good); bad[strings:strings + len(name)] = name
+                self.assertFalse(valid(resigned(bad)))
+            bad = bytearray(good); struct.pack_into('<I', bad, 44, 0xffffffff)
+            self.assertFalse(valid(resigned(bad)))
+            empty = d / 'none'; empty.mkdir()
+            with self.assertRaises(ValueError): tool.build(empty, d / 'bad.index')
+
+    def test_original_dump_listings(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); root = d / 'romfs'; root.mkdir()
+            (root / '.listing').write_text('-r--r--r-- 1 ftp ftp 4 Jan 01 1970 game.bin\n')
+            (root / 'game.bin').write_bytes(b'game')
+            (root / 'host-cache.bin').write_bytes(b'not a game asset')
+            out = d / 'romfs.index'
+            self.assertEqual(tool.build(root, out, True)['files'], 1)
+            self.assertNotIn(b'host-cache', out.read_bytes())
+            (root / 'game.bin').write_bytes(b'wrong size')
+            self.assertEqual(tool.build(root, out, True)['listing_size_mismatch_count'], 1)
+            (root / 'game.bin').unlink()
+            with self.assertRaises(FileNotFoundError): tool.build(root, out, True)
+
+    def test_directory_errors(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d = Path(tmp); c = d / 'list.c'
+            c.write_text(r'''
+#include "platform.h"
+#include <dirent.h>
+#include <errno.h>
+#include <sys/stat.h>
+#include <assert.h>
+#include <string.h>
+static int mode, count;
+struct dirent *__wrap_readdir(DIR *d) {
+    static struct dirent e;
+    if (mode == 1) { errno = EIO; return 0; }
+    if (count++) return 0;
+    memset(&e, 0, sizeof e); strcpy(e.d_name, "missing"); return &e;
+}
+int __wrap_lstat(const char *p, struct stat *s) { errno = EACCES; return -1; }
+static int visit(const char *n, int k, uint64_t size, void *ctx) { assert(0); return 1; }
+int main(int argc, char **argv) {
+    mode = 1; assert(plat_fs_list(argv[1], visit, 0) != PLAT_FS_OK);
+    mode = 2; assert(plat_fs_list(argv[1], visit, 0) != PLAT_FS_OK);
+    assert(plat_fs_list("/does-not-exist", visit, 0) != PLAT_FS_OK);
+}
+''')
+            exe = d / 'list'
+            subprocess.run(['clang', '-O2', '-DMKW_PS5_HOST_CHECK', '-D_GNU_SOURCE', '-ffunction-sections', '-fdata-sections',
+                            '-I' + str(ROOT / 'runtime/platform'), str(c), str(ROOT / 'runtime/platform/ps5_fs.c'),
+                            '-Wl,--gc-sections,--wrap=readdir,--wrap=lstat', '-o', str(exe)], check=True)
+            subprocess.run([str(exe), str(d)], check=True)
+
+if __name__ == '__main__': unittest.main()
