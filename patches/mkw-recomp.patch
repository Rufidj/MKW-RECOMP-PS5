diff --git a/runtime/platform/ps5_stack.c b/runtime/platform/ps5_stack.c
new file mode 100644
index 0000000..dcbf8f9
--- /dev/null
+++ b/runtime/platform/ps5_stack.c
@@ -0,0 +1,63 @@
+// Guarded demand-backed stacks for the PS5 bring-up. SPDX-License-Identifier: MIT
+// The generic pager belongs to the SDK platform layer, not this runtime.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 platform source selected for another target"
+#endif
+#include <stdint.h>
+#include <errno.h>
+#include <stdio.h>
+#ifndef MKW_PS5_HOST_CHECK
+#include "host.h"
+#endif
+#include <string.h>
+#include <ps5platform/demand.h>
+#include "ps5_int.h"
+
+#define STACK_UNIT ((size_t)0x10000)
+static uint64_t reserved_bytes;
+
+int ps5_stack_create(Ps5Stack *stack, size_t bytes) {
+    memset(stack, 0, sizeof *stack);
+    if (!bytes || bytes > SIZE_MAX - 2 * STACK_UNIT) return 0;
+    bytes = (bytes + STACK_UNIT - 1) & ~(STACK_UNIT - 1);
+    struct ps5_demand_region *region = NULL;
+    if (ps5_demand_create(bytes, STACK_UNIT, &region)) return 0;
+    void *data = ps5_demand_data(region);
+    // pthread startup needs a backed stack before its entry routine can
+    // install an alternate signal stack. Other units are backed on touch.
+    struct ps5_demand_failure failure;
+    if (ps5_demand_prepare(region, bytes - STACK_UNIT, STACK_UNIT, &failure)) {
+#ifdef MKW_PS5_HOST_CHECK
+        fprintf(stderr, "stack backing: stage %d code %d\n", failure.stage, failure.result);
+#else
+        rt_log("stack backing: stage %d code %d (%#x), data %#llx staging %#llx physical %#llx; backed %llu KiB",
+               failure.stage, failure.result, (unsigned)failure.result,
+               (unsigned long long)failure.data, (unsigned long long)failure.staging,
+               (unsigned long long)failure.physical, (unsigned long long)(ps5_demand_backed_bytes() >> 10));
+#endif
+        ps5_demand_destroy(region);
+        errno = failure.result;
+        return 0;
+    }
+    *stack = (Ps5Stack){(char *)data - STACK_UNIT, data, ps5_demand_reserved(region), bytes, region};
+    __atomic_fetch_add(&reserved_bytes, stack->reserved, __ATOMIC_RELAXED);
+    return 1;
+}
+
+void ps5_stack_destroy(Ps5Stack *stack) {
+    if (!stack->base) return;
+    ps5_demand_destroy(stack->region);
+    __atomic_fetch_sub(&reserved_bytes, stack->reserved, __ATOMIC_RELAXED);
+    memset(stack, 0, sizeof *stack);
+}
+uint64_t ps5_stack_reserved_bytes(void) {
+    return __atomic_load_n(&reserved_bytes, __ATOMIC_RELAXED);
+}
+int ps5_stack_thread_attach(void) { return ps5_demand_thread_attach(); }
+void ps5_stack_thread_detach(void) { ps5_demand_thread_detach(); }
+void *ps5_stack_thread_retire(void) {
+    void *token = NULL;
+    if (ps5_demand_thread_retire(&token)) __builtin_trap();
+    return token;
+}
+void ps5_stack_thread_release(void *token) { ps5_demand_thread_release(token); }
diff --git a/runtime/platform/ps5_sync.c b/runtime/platform/ps5_sync.c
new file mode 100644
index 0000000..e496b18
--- /dev/null
+++ b/runtime/platform/ps5_sync.c
@@ -0,0 +1,257 @@
+// PS5 time and synchronisation. SPDX-License-Identifier: MIT
+// The inline lock protocol follows linux_sync.c in this repository. A bounded
+// pthread parking table replaces futex; no allocation or destructor is needed
+// for a zero-initialised PlatMutex/PlatCond embedded in a transient object.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 platform source selected for another target"
+#endif
+#include <errno.h>
+#include <cpuid.h>
+#include <limits.h>
+#include <pthread.h>
+#include <sched.h>
+#include <stdlib.h>
+#include <time.h>
+
+#include "platform.h"
+
+enum { PARK_COUNT = 1024, LOCK_SPINS = 64 };
+#define LOCK_WRITER 0x80000000u
+#define LOCK_SLEEPER 0x40000000u
+#define LOCK_READERS 0x3fffffffu
+typedef struct { pthread_mutex_t mutex; pthread_cond_t cond; uint32_t waiters; } Park;   // waiters: threads between "about to look" and "left" (MKWBOOT-054)
+static Park parking[PARK_COUNT];
+static pthread_once_t parking_once = PTHREAD_ONCE_INIT;
+
+// Until fatal shutdown is integrated with the title's shell-exit path, a broken
+// primitive must stop with a diagnosable fault rather than continue unlocked.
+static void checked(int error) { if (error) __builtin_trap(); }
+
+static void park_init(void) {
+    pthread_condattr_t attr;
+    checked(pthread_condattr_init(&attr));
+    checked(pthread_condattr_setclock(&attr, CLOCK_MONOTONIC));
+    for (unsigned i = 0; i < PARK_COUNT; i++) {
+        checked(pthread_mutex_init(&parking[i].mutex, NULL));
+        checked(pthread_cond_init(&parking[i].cond, &attr));
+    }
+    checked(pthread_condattr_destroy(&attr));
+}
+
+static Park *park_for(const volatile uint32_t *word) {
+    checked(pthread_once(&parking_once, park_init));
+    uintptr_t key = (uintptr_t)word >> 3;
+    return &parking[(key ^ (key >> 7)) & (PARK_COUNT - 1)];
+}
+
+// MKWBOOT-053: the console has no vDSO clock, so every clock_gettime is a system call (13 percent of the CPU of 052).
+// The time stamp counter is read instead, scaled against CLOCK_MONOTONIC. MKWBOOT-082: the scale is re-anchored to the
+// system clock every 0.5 s (a seqlock publishes ns0, c0 and the multiplier measured over the whole run), so the counter
+// time cannot drift from the kernel's CLOCK_MONOTONIC, which timed waits use for their deadlines; and clock_gettime of the
+// monotonic clocks itself (Mesa's os_time_get_nano called it ~600 times a sample window in a race, on the submit path) is
+// answered from it (link-title.sh --wrap=clock_gettime). If the CPU does not say its counter is invariant, or the
+// calibration looks wrong, the system call stays.
+#ifdef __PROSPERO__
+int __real_clock_gettime(clockid_t, struct timespec *);
+#define SYS_CLOCK_GETTIME __real_clock_gettime
+#else
+#define SYS_CLOCK_GETTIME clock_gettime
+#endif
+static struct { uint32_t seq; uint64_t ns0, c0, mul, first_ns, first_c; } tsc;   // ns = ns0 + ((tsc - c0) * mul >> 32)
+static int tsc_state;                       // 0 not tried, 1 ready, -1 refused
+static uint64_t sys_now_ns(void) {
+    struct timespec ts;
+    checked(SYS_CLOCK_GETTIME(CLOCK_MONOTONIC, &ts));
+    return (uint64_t)ts.tv_sec * 1000000000u + (uint64_t)ts.tv_nsec;
+}
+static void tsc_calibrate(void) {
+    unsigned a, b, c, d;
+    if (!__get_cpuid(0x80000007u, &a, &b, &c, &d) || !(d & (1u << 8))) { __atomic_store_n(&tsc_state, -1, __ATOMIC_RELEASE); return; }
+    uint64_t n0 = sys_now_ns(), c0 = __builtin_ia32_rdtsc(), n1, c1;
+    do { n1 = sys_now_ns(); c1 = __builtin_ia32_rdtsc(); } while (n1 - n0 < 8000000u);
+    uint64_t dn = n1 - n0, dc = c1 - c0;
+    double hz = (double)dc * 1e9 / (double)dn;
+    if (dc == 0 || hz < 5e8 || hz > 6e9) { __atomic_store_n(&tsc_state, -1, __ATOMIC_RELEASE); return; }
+    tsc.ns0 = n1, tsc.c0 = c1, tsc.mul = (uint64_t)((double)dn / (double)dc * 4294967296.0);
+    tsc.first_ns = n0, tsc.first_c = c0;
+    __atomic_store_n(&tsc_state, 1, __ATOMIC_RELEASE);
+}
+static void tsc_reanchor(uint64_t now_c) {   // one thread at a time (the trylock); readers retry on an odd sequence
+    static int busy;
+    if (__atomic_exchange_n(&busy, 1, __ATOMIC_ACQUIRE)) return;
+    uint64_t n = sys_now_ns(), c = __builtin_ia32_rdtsc();
+    (void)now_c;
+    uint64_t mul = (uint64_t)((double)(n - tsc.first_ns) / (double)(c - tsc.first_c) * 4294967296.0);
+    uint64_t old = tsc.ns0 + (uint64_t)(((unsigned __int128)(c - tsc.c0) * tsc.mul) >> 32);
+    if (old > n) n = old;   // never backwards: the counter time only catches up with the system clock
+    __atomic_add_fetch(&tsc.seq, 1, __ATOMIC_ACQ_REL);
+    tsc.ns0 = n, tsc.c0 = c, tsc.mul = mul;
+    __atomic_add_fetch(&tsc.seq, 1, __ATOMIC_RELEASE);
+    __atomic_store_n(&busy, 0, __ATOMIC_RELEASE);
+}
+uint64_t plat_now_ns(void) {
+    int st = __atomic_load_n(&tsc_state, __ATOMIC_ACQUIRE);
+    if (__builtin_expect(st == 1, 1)) {
+        for (;;) {
+            uint32_t q = __atomic_load_n(&tsc.seq, __ATOMIC_ACQUIRE);
+            if (q & 1) continue;
+            uint64_t ns0 = tsc.ns0, c0 = tsc.c0, mul = tsc.mul, now = __builtin_ia32_rdtsc();
+            if (__atomic_load_n(&tsc.seq, __ATOMIC_ACQUIRE) != q) continue;
+            uint64_t dc = now - c0, ns = ns0 + (uint64_t)(((unsigned __int128)dc * mul) >> 32);
+            if (__builtin_expect(ns - ns0 > 500000000ull, 0)) tsc_reanchor(now);
