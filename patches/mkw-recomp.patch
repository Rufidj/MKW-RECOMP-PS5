+"""Run the PS5 suspension protocol against Linux signal delivery.
+
+Usage: python3 tests/test_ps5_intr.py (also discovered by pytest).
+This checks the handshake; PS5 ucontext fields are checked by cross-compilation.
+"""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_include, demand_sources
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class Ps5InterruptChecks(unittest.TestCase):
+    def test_interrupt_and_handler_conflict(self):
+        cc = shutil.which("clang")
+        if not cc:
+            self.skipTest("clang is needed for the standalone C harness")
+        with tempfile.TemporaryDirectory() as folder:
+            exe = Path(folder) / "ps5-intr"
+            sources = [ROOT / "runtime/platform" / f"{name}.c"
+                       for name in ("ps5_sync", "common", "ps5_stack", "ps5_threads", "ps5_intr")]
+            subprocess.run([
+                cc, "-O2", "-g", "-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing",
+                "-fno-omit-frame-pointer", "-DMKW_PS5_HOST_CHECK", "-ffunction-sections", "-fdata-sections",
+                f"-I{ROOT / 'runtime/platform'}", demand_include(), str(ROOT / "tests/c/t_ps5_intr.c"),
+                *demand_sources(),
+                *map(str, sources), "-pthread", "-Wl,--gc-sections", "-o", str(exe),
+            ], check=True, timeout=30)
+            subprocess.run([str(exe), "--conflict"], check=True, timeout=10)
+            subprocess.run([str(exe)], check=True, timeout=15)
+
+
+if __name__ == "__main__":
+    unittest.main()
