+"""Build the current PS5 runtime archive and audit remaining source dependencies.
+
+This is an intermediate object/archive build, not an executable or a title.
+The audit compiles each translation unit independently without invented headers
+or desktop library paths, retaining every diagnostic in build/ps5/audit.json.
+
+Usage: python3 tools/build/ps5.py --stack /path/to/ps5-vulkan [--audit-runtime]
+"""
+import argparse
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+RUNTIME = ROOT / "runtime"
+SOURCES = [RUNTIME / "cpu" / f"{name}.c" for name in ("dispatch", "sjlj", "hostfn")]
+SOURCES += [RUNTIME / "platform" / f"{name}.c"
+            for name in ("common", "ps5_sync", "ps5_stack", "ps5_threads", "ps5_fibers", "ps5_intr", "ps5_nso_probe", "ps5_nso_link", "ps5_cpu_probe", "ps5_guest_memory", "ps5_mem")]
+SOURCES.append(RUNTIME / "core/base/sha256.c")
+SOURCES.append(RUNTIME / "sdk/ov/display_version.c")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--stack", type=Path, required=True)
+    parser.add_argument("--sdk", type=Path)
+    parser.add_argument("--platform-fork", type=Path, default=ROOT.parent / "PS5_PayloadSDK",
+                        help="SDK fork containing the experimental demand pager")
+    parser.add_argument("--out", type=Path, default=ROOT / "build/ps5")
+    parser.add_argument("--audit-runtime", action="store_true")
+    parser.add_argument("--runtime-memory", action="store_true",
+                        help="select the process-wide CPU backend instead of scoped diagnostic hooks; not a bootable title")
+    parser.add_argument("--native-display", action="store_true",
+                        help="include the PS5 VK_KHR_display backend; requires VMA dependency headers")
+    parser.add_argument("--jobs", type=int, default=2)
+    parser.add_argument("--dependency-include", type=Path, action="append", default=[],
+                        help="target-compatible dependency headers; does not supply linked libraries")
+    args = parser.parse_args()
+    if args.jobs < 1:
+        parser.error("--jobs must be positive")
+    stack = args.stack.resolve()
+    sdk = (args.sdk or stack / "PS5_VulkanTemplate/.deps/native/ps5-payload-sdk").resolve()
+    wrapper = stack / "PS5_Vulkan/tooling/prospero-clang18"
+    ar = shutil.which("llvm-ar") or str(sdk / "bin/llvm-ar")
+    if not wrapper.is_file() or not (sdk / "target/include").is_dir():
+        parser.error("the stack wrapper or SDK headers are missing")
+    args.out.mkdir(parents=True, exist_ok=True)
+    # SCE Clang 18 predates #embed. Preserve the exact bundled font bytes in a
+    # generated include, rather than replacing the font or dropping glyphs.
+    font = ROOT / "runtime/ui/fonts/Roboto-Medium.ttf"
+    embedded = args.out / "ps5_roboto.inc"
+    font_text = ",".join(str(byte) for byte in font.read_bytes()) + ",\n"
+    if not embedded.exists() or embedded.read_text() != font_text:
+        embedded.write_text(font_text)
+    subprocess.run([sys.executable, str(ROOT / "tools/build/ps5_aot_fixture.py"),
+                    "--out", str(args.out / "ps5_aot_fixture.h")], check=True)
+    platform_fork = args.platform_fork.resolve()
+    pager = platform_fork / "platform/src/demand.c"
+    checked_region = platform_fork / "platform/src/checked_region.c"
+    if not pager.is_file():
+        parser.error("apply the demand-pager SDK patch and pass its checkout with --platform-fork")
+    env = dict(os.environ, PS5_PAYLOAD_SDK=str(sdk))
+    includes = sorted({RUNTIME} | {p.parent for p in RUNTIME.rglob("*.h")})
+    # Headers only: never use the host's libc, C++ headers or library directories.
+    includes += [ROOT / "build/generated", args.out / "rt", args.out]
+    includes.append(platform_fork / "platform/include")
+    for dependency in args.dependency_include:
+        if not dependency.is_dir():
+            parser.error(f"dependency include directory is missing: {dependency}")
+        # Third-party headers keep their own warning policy (not our -Werror).
+    vk_headers = stack / "PS5_VulkanTemplate/external/vulkan"
+    if (vk_headers / "vulkan/vulkan.h").is_file():
+        includes.append(vk_headers)
+    video_headers = stack / "PS5_VulkanTemplate/external"
+    if (video_headers / "vk_video").is_dir():
+        includes.append(video_headers)
+    # simd_fp.h deliberately uses bitwise OR for vector/scalar comparison masks.
+    flags = ["-O2", "-g1", "-Wall", "-Werror", "-Wno-bitwise-instead-of-logical", "-fno-strict-aliasing",
+             "-march=x86-64-v3", "-fno-omit-frame-pointer", "-ffunction-sections", "-fdata-sections",
+             *[f"-I{p}" for p in includes]]
+    for dependency in args.dependency_include:
+        flags += ["-isystem", str(dependency.resolve())]
+
+    def compile_source(source, audit=False):
+        local = source.relative_to(RUNTIME) if source.is_relative_to(RUNTIME) else Path("platform-extension") / source.name
+        output = args.out / "obj" / local.with_suffix(".o")
+        output.parent.mkdir(parents=True, exist_ok=True)
+        command = ["sh", str(wrapper), *flags]
+        if audit:
+            # The upstream full runtime builds with -Wall, not -Werror. In
+            # particular, SDK math macros and bundled unused helpers warn on SCE
+            # Clang. Keep those warnings in the report without treating them as
+            # missing functionality. Our small port archive remains strict.
+            command.remove("-Werror")
+        if args.runtime_memory or source.name == "display_version.c":
+            command.append("-DMKW_CHECKED_MEMORY")
+        if source.suffix == ".cpp":
+            command += ["-std=c++20"]
+            if source.name == "nx.cpp":
+                # NXFormat uses exceptions for allocation-failure recovery.
+                # The PS5 SDK supplies libc++abi/libunwind; its compiler wrapper
+                # defaults to no exceptions, so opt this reader into real C++ EH.
+                command += ["-fexceptions", "-fcxx-exceptions"]
+        command += ["-fsyntax-only", str(source)] if audit else ["-c", str(source), "-o", str(output)]
+        result = subprocess.run(command, env=env, text=True, capture_output=True, timeout=120)
+        label = str(source.relative_to(ROOT)) if source.is_relative_to(ROOT) else str(source)
+        return {"source": label, "exit_code": result.returncode,
+                "diagnostics": result.stderr, "command": command, "object": str(output)}
+
+    with ThreadPoolExecutor(max_workers=args.jobs) as pool:
+        diagnostics = {"ps5_cpu_probe", "ps5_game_slice", "ps5_nso_probe", "ps5_nso_link"}
+        sources = [p for p in SOURCES if not (args.runtime_memory and p.stem in diagnostics)]
+        if args.runtime_memory:
+            sources.append(RUNTIME / "platform/ps5_cpu_memory.c")
+        if args.native_display:
+            sources.append(RUNTIME / "gfx/nvn/host/gfx_window_ps5.c")
+        records = list(pool.map(compile_source, [*sources, pager, checked_region]))
+    (args.out / "runtime.json").write_text(json.dumps(records, indent=2))
+    for record in records:
+        print(f"{'OK' if not record['exit_code'] else 'FAIL'} {record['source']}", flush=True)
+        if record["exit_code"]:
+            print(record["diagnostics"], flush=True)
+    if any(record["exit_code"] for record in records):
+        return 1
+    archive = args.out / "libmkw-ps5-runtime.a"
+    # Remove the previous archive to prevent stale members surviving a source removal.
+    archive.unlink(missing_ok=True)
+    subprocess.run([ar, "rcs", str(archive), *[r["object"] for r in records]], check=True)
+    print(f"Archive: {archive} (not linked or executable)", flush=True)
+
+    if args.audit_runtime:
+        sources = sorted(p for p in RUNTIME.rglob("*") if p.suffix in (".c", ".cpp")
+                         and not p.stem.startswith(("linux", "win32")) and not p.stem.endswith("_win")
+                         and not (args.runtime_memory and p.stem in diagnostics))
+        with ThreadPoolExecutor(max_workers=args.jobs) as pool:
+            audit = list(pool.map(lambda source: compile_source(source, True), sources))
+        (args.out / "audit.json").write_text(json.dumps(audit, indent=2))
+        categories = Counter()
+        for record in audit:
+            if not record["exit_code"]:
+                continue
+            match = re.search(r"fatal error: '([^']+)' file not found", record["diagnostics"])
+            categories[match.group(1) if match else "other compiler diagnostics"] += 1
+        summary = {"units": len(audit), "passed": sum(not r["exit_code"] for r in audit),
+                   "failed": sum(bool(r["exit_code"]) for r in audit), "failure_groups": dict(categories)}
+        (args.out / "audit-summary.json").write_text(json.dumps(summary, indent=2))
+        print(json.dumps(summary, indent=2), flush=True)
+        # An incomplete audit is reported as failure even if the small archive built.
+        return int(summary["failed"] > 0)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
