+    assert(plat_mem_read(heap+65544,&out,8) && out==value);
+    assert(plat_mem_decommit(heap+65536,4096)); ps5_memory_native_hle(0);
+    assert(plat_mem_replace_anon(heap, 4096));
+    assert(plat_mem_read(heap, &out, 8) && !out);
+    assert(plat_mem_read(heap + 4096, &out, 8) && out == 4000);
+    assert(plat_mem_decommit(heap, 12288) && !ps5_guest_backed_bytes(s));
+    // watch=0 loader pages are backed at commit, before native initialization.
+    uint64_t loader = 0x7000000000ull;
+    assert(plat_mem_reserve(loader, 65536, 0) && plat_mem_commit(loader, 4096));
+    *(volatile uint64_t *)(uintptr_t)loader = 0x4567;
+    assert(plat_mem_read(loader, &out, 8) && out == 0x4567);
