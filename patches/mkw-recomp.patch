index 0000000..74c97c3
--- /dev/null
+++ b/tools/build/nso_link_audit.py
@@ -0,0 +1,98 @@
+"""Audit guest-only NSO linking and compute private post-relocation reference hashes.
+
+This does not execute code or install HLE overrides. It follows the guest symbol
+binding and relocation rules of runtime/core/boot/loader.c. Generated metadata
+belongs in build/, never in git.
+Usage: python3 tools/build/nso_link_audit.py --exefs DIR --out build/ps5/link-audit.json
+"""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+import struct
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "recomp"))
+from layout import layout as module_layout  # noqa: E402
+from nso import Nso  # noqa: E402
+
+MASK = (1 << 64) - 1
+
+
+def audit(exefs):
+    layout = module_layout(exefs)
+    modules = [(name, base, Nso(Path(exefs) / name)) for name, base, _ in layout]
+    # Match make_hash/find_symbol: first named definition, first module wins.
+    definitions = {}
+    for name, base, nso in modules:
+        for symbol, _, shndx, value, _ in nso.syms[1:]:
+            if symbol and shndx:
+                definitions.setdefault(symbol, (name, base + value))
+    rows = []
+    for name, base, nso in modules:
+        image = bytearray(nso.image)
+        kinds, bindings = Counter(), Counter()
+        writes = set()
+        for offset, kind, index, addend in nso.relocs:
+            if not nso.data[0] <= offset <= nso.size - 8 or offset % 8:
+                raise ValueError(f"{name}: invalid relocation destination {offset:#x}")
+            if offset in writes:
+                raise ValueError(f"{name}: duplicate relocation destination {offset:#x}")
+            writes.add(offset)
+            kinds[str(kind)] += 1
+            if kind == 1027:
+                value = base + addend
+            elif kind in (257, 1025, 1026):
+                if not 0 < index < len(nso.syms):
+                    raise ValueError(f"{name}: invalid relocation symbol {index}")
+                symbol, info, shndx, own_value, _ = nso.syms[index]
+                # Nso.syms omits st_other; read visibility from the original table.
+                other = nso.image[nso.dyn[6] + index * 24 + 5] & 3
+                target = definitions.get(symbol)
+                if shndx and not (info >> 4 and other == 0 and target):
+                    target = (name, base + own_value)
+                if target:
+                    bindings[target[0]] += 1
+                    value = target[1] + (0 if kind == 1026 else addend)
+                elif info >> 4 == 2:
+                    bindings["undefined_weak"] += 1
+                    value = 0
+                else:
+                    raise ValueError(f"{name}: unresolved strong relocation symbol {symbol}")
+            else:
+                raise ValueError(f"{name}: unsupported relocation type {kind}")
+            struct.pack_into("<Q", image, offset, value & MASK)
+        imports = Counter()
+        for symbol, info, _, _, _ in nso.imports():
+            target = definitions.get(symbol)
+            if target:
+                imports[target[0]] += 1
+            elif info >> 4 == 2:
+                imports["undefined_weak"] += 1
+            else:
+                raise ValueError(f"{name}: unresolved strong import {symbol}")
+        rows.append({"name": name, "base": hex(base), "bytes": nso.size,
+                     "relocations": dict(kinds), "relocation_bindings": dict(bindings),
+                     "import_bindings": dict(imports), "unique_write_destinations": len(writes),
+                     "raw_image_sha256": hashlib.sha256(nso.image).hexdigest(),
+                     "guest_linked_image_sha256": hashlib.sha256(image).hexdigest()})
+    return {"mode": "guest-only; no HLE overrides, observers or execution", "modules": rows,
+            "total_relocations": sum(sum(m["relocations"].values()) for m in rows)}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--exefs", required=True, type=Path)
+    parser.add_argument("--out", required=True, type=Path)
+    args = parser.parse_args()
+    result = audit(args.exefs)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + "\n")
+    print(f"Guest link audit: {len(result['modules'])} modules, "
+          f"{result['total_relocations']} relocations, no unresolved strong imports")
+
+
+if __name__ == "__main__":
+    main()
