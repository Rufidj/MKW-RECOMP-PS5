+    assert(ps5_guest_access(s, first + 65536) == -1); // failed map is poisoned
+    atomic_store(&checked_test_fail_commit_at, 0);
+    // Sparse host dispatch: untouched holes stay readable, including after seal.
+    volatile uint64_t *table = plat_mem_alloc(0x40000); assert(table);
+    table[0] = 17;
+    assert(plat_mem_protect((uintptr_t)table, 0x40000, PLAT_PROT_READ));
+    assert(table[0] == 17 && !table[0x10000 / 8]);
+    assert(plat_mem_read((uintptr_t)table + 0x20000, &out, 8) && !out);
+    pid_t child = fork(); assert(child >= 0);
+    if (!child) { table[0x30000 / 8] = 1; _exit(99); }
+    int status; assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+}
+''')
+            exe = Path(tmp) / 'memory'
+            sources = [ROOT / 'runtime/platform' / f'{name}.c' for name in
+                       ('ps5_mem', 'ps5_guest_memory', 'ps5_cpu_memory', 'ps5_hle_copy', 'common', 'ps5_sync')]
