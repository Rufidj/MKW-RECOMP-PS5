diff --git a/runtime/platform/ps5_intr.c b/runtime/platform/ps5_intr.c
new file mode 100644
index 0000000..564f10d
--- /dev/null
+++ b/runtime/platform/ps5_intr.c
@@ -0,0 +1,132 @@
+// Signal handshake for PS5 scheduler preemption. SPDX-License-Identifier: MIT
+// Protocol follows linux.c here; PS5 register access uses the SDK fork's
+// context layout, never FreeBSD register offsets guessed in this title.
+#ifdef MKW_PS5_HOST_CHECK
+#define _GNU_SOURCE
+#elif !defined(__PROSPERO__)
+#error "PS5 platform source selected for another target"
+#endif
+#include <pthread.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <time.h>
+#include <ucontext.h>
+#ifndef MKW_PS5_HOST_CHECK
+#include <ps5platform/context.h>
+#endif
+#include "platform.h"
+#include "ps5_int.h"
+
+enum { INTR_IDLE, INTR_REQUEST, INTR_STOPPED, INTR_GO };
+#define INTR_WAIT_NS 200000u
+struct PlatIntr {
+    pthread_t thread;
+    int32_t state;
+    uint64_t rip, rsp, redirect;
+    Ps5Stack signal_stack;
+    stack_t old_stack;
+};
+static _Thread_local PlatIntr *intr_self;
+static int signal_installed;
+static PlatMutex install_lock = PLAT_MUTEX_INIT;
+
+static void intr_handler(int sig, siginfo_t *info, void *context) {
+    (void)sig; (void)info;
+    PlatIntr *t = intr_self;
+    if (!t || __atomic_load_n(&t->state, __ATOMIC_ACQUIRE) != INTR_REQUEST) return;
+    ucontext_t *uc = context;
+#ifdef MKW_PS5_HOST_CHECK
+    t->rip = (uint64_t)uc->uc_mcontext.gregs[REG_RIP];
+    t->rsp = (uint64_t)uc->uc_mcontext.gregs[REG_RSP];
+#else
+    t->rip = uc->uc_mcontext.mc_rip;
+    t->rsp = uc->uc_mcontext.mc_rsp;
+#endif
+    int32_t request = INTR_REQUEST;
+    if (!__atomic_compare_exchange_n(&t->state, &request, INTR_STOPPED, 0,
+                                     __ATOMIC_RELEASE, __ATOMIC_RELAXED)) return;
+    while (__atomic_load_n(&t->state, __ATOMIC_ACQUIRE) != INTR_GO) plat_pause();
+    if (t->redirect) {
+#ifdef MKW_PS5_HOST_CHECK
+        uc->uc_mcontext.gregs[REG_RIP] = (greg_t)t->redirect;
+#else
+        uc->uc_mcontext.mc_rip = t->redirect;
+#endif
+    }
+    __atomic_store_n(&t->state, INTR_IDLE, __ATOMIC_RELEASE);
+}
+
+PlatIntr *plat_intr_self(void) {
+    if (intr_self) return intr_self;
+    plat_mutex_lock(&install_lock);
+    if (!signal_installed) {
+        struct sigaction previous;
+        if (!sigaction(SIGUSR2, NULL, &previous) && previous.sa_handler == SIG_DFL) {
+            struct sigaction action = {.sa_sigaction = intr_handler,
+                                       .sa_flags = SA_SIGINFO | SA_RESTART | SA_ONSTACK};
+            sigemptyset(&action.sa_mask);
+            if (!sigaction(SIGUSR2, &action, NULL)) signal_installed = 1;
+        }
+    }
+    int installed = signal_installed;
+    plat_mutex_unlock(&install_lock);
+    if (!installed) return NULL; // Do not replace another component's handler.
+    PlatIntr *t = calloc(1, sizeof *t);
+    if (!t) return NULL;
+    t->thread = pthread_self();
+    if (sigaltstack(NULL, &t->old_stack)) { free(t); return NULL; }
+    if (t->old_stack.ss_flags & SS_DISABLE) {
+        if (!ps5_stack_create(&t->signal_stack, 0x10000)) { free(t); return NULL; }
+        stack_t stack = {.ss_sp = t->signal_stack.data, .ss_size = t->signal_stack.bytes};
+        if (sigaltstack(&stack, NULL)) {
+            ps5_stack_destroy(&t->signal_stack);
+            free(t);
+            return NULL;
+        }
+    }
+    // Touch this TLS slot before delivering signals: the PS5 target uses
+    // emulated TLS, whose first access may allocate storage.
+    intr_self = t;
+    return t;
+}
+
+void plat_intr_free(PlatIntr *t) {
+    if (!t) return;
+    if (__atomic_load_n(&t->state, __ATOMIC_ACQUIRE) != INTR_IDLE) __builtin_trap();
+    if (intr_self == t) {
+        if (t->signal_stack.base && sigaltstack(&t->old_stack, NULL)) __builtin_trap();
+        intr_self = NULL;
+    }
+    ps5_stack_destroy(&t->signal_stack);
+    free(t);
+}
+uint64_t plat_intr_cpu_ns(PlatIntr *t) {
+    clockid_t id;
+    struct timespec ts;
+    if (!t || pthread_getcpuclockid(t->thread, &id) || clock_gettime(id, &ts)) return 0;
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+int plat_intr_stop(PlatIntr *t, uint64_t *rip, uint64_t *rsp) {
+    int32_t idle = INTR_IDLE;
+    if (!__atomic_compare_exchange_n(&t->state, &idle, INTR_REQUEST, 0,
+                                     __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return 0;
+    if (pthread_kill(t->thread, SIGUSR2)) {
+        __atomic_store_n(&t->state, INTR_IDLE, __ATOMIC_RELEASE);
+        return 0;
+    }
+    uint64_t start = plat_now_ns();
+    while (__atomic_load_n(&t->state, __ATOMIC_ACQUIRE) != INTR_STOPPED) {
+        if (plat_now_ns() - start < INTR_WAIT_NS) { plat_pause(); continue; }
+        int32_t request = INTR_REQUEST;
+        if (__atomic_compare_exchange_n(&t->state, &request, INTR_IDLE, 0,
+                                         __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return 0;
+    }
+    *rip = t->rip; *rsp = t->rsp;
+    return 1;
+}
+int plat_intr_resume(PlatIntr *t, uint64_t to) {
+    if (__atomic_load_n(&t->state, __ATOMIC_ACQUIRE) != INTR_STOPPED) return 0;
+    t->redirect = to;
+    __atomic_store_n(&t->state, INTR_GO, __ATOMIC_RELEASE);
+    return 1;
+}
diff --git a/runtime/platform/ps5_mem.c b/runtime/platform/ps5_mem.c
new file mode 100644
index 0000000..0dbfef9
--- /dev/null
+++ b/runtime/platform/ps5_mem.c
@@ -0,0 +1,205 @@
+// Logical 4 KiB guest memory over sparse PS5 backing. SPDX-License-Identifier: MIT
+// This does not make raw guest pointers safe: guest CPU/HLE must use checked
+// access. Host-only dispatch tables use the signal-safe demand service instead.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 memory source selected for another target"
+#endif
+#include "platform.h"
+#include "ps5_mem.h"
+#include <ps5platform/checked_region.h>
+#include <ps5platform/demand.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+static PlatOnce initialized = PLAT_ONCE_INIT;
+Ps5GuestSpace *ps5_mem_guest;
+#define guest ps5_mem_guest
+static int native_hle;
+void ps5_memory_native_hle(int enable) { __atomic_store_n(&native_hle, !!enable, __ATOMIC_RELEASE); }
+// MKWBOOT-059: 058 never reached its log on the console, and this runs before the log opens: raw open/write markers (no heap)
+// in /app0/logs/early.txt tell how far the start got.
+#include <fcntl.h>
+#include <unistd.h>
+void ps5_early_mark(const char *what) {
+    int fd = open("/app0/logs/early.txt", O_WRONLY | O_CREAT | O_APPEND, 0666);
+    if (fd < 0) return;
+    size_t n = 0; while (what[n]) n++;
+    (void)!write(fd, what, n); (void)!write(fd, "\n", 1); close(fd);
+}
+static void initialize(void *arg) {
+    (void)arg;
+    ps5_early_mark("mem: creating the guest space");
+    Ps5GuestSpace *g = ps5_guest_space_create();
+    ps5_early_mark(g ? "mem: space created" : "mem: space creation FAILED");
+    if (g) ps5_guest_space_global(g);
+    ps5_early_mark("mem: space published");
+    guest = g;
+}
+Ps5GuestSpace *ps5_memory_space(void) {
+    // Read on every guest access: after the first call a plain acquire load, not plat_once (1648 + 668 samples of 45000 in the profile).
+    Ps5GuestSpace *g = __atomic_load_n(&guest, __ATOMIC_ACQUIRE);
+    if (g) return g;
+    plat_once(&initialized, initialize, NULL);
+    return __atomic_load_n(&guest, __ATOMIC_ACQUIRE);
+}
+typedef struct HostAllocation {
+    struct HostAllocation *next;
+    struct ps5_demand_region *region;
+    uint64_t base;
+    size_t bytes;
+    int sealed;
+} HostAllocation;
+static HostAllocation *hosts;
+static pthread_mutex_t host_lock = PTHREAD_MUTEX_INITIALIZER;
+static HostAllocation *host_at(uint64_t a, size_t n) {
+    for (HostAllocation *h = hosts; h; h = h->next)
+        if (a >= h->base && a - h->base <= h->bytes && n <= h->bytes - (a - h->base)) return h;
+    return NULL;
+}
+int plat_mem_reserve(uint64_t a, uint64_t n, int watch) {
+    Ps5GuestSpace *s = ps5_memory_space();
+    return s && n <= SIZE_MAX && ps5_guest_reserve(s, a, (size_t)n, watch);
+}
+void *plat_mem_alloc(size_t n) {
+    if (!n) return NULL;
+    HostAllocation *h = calloc(1, sizeof *h); if (!h) return NULL;
+    if (ps5_demand_create(n, 0, &h->region)) { free(h); return NULL; }
+    h->base = (uintptr_t)ps5_demand_data(h->region); h->bytes = n;
+    pthread_mutex_lock(&host_lock); h->next = hosts; hosts = h; pthread_mutex_unlock(&host_lock);
+    return (void *)(uintptr_t)h->base;
+}
+int plat_mem_commit(uint64_t a, size_t n) {
+    if (!n) return 1;
+    // Lazy HLE reads request byte ranges (MKWBOOT-008: 0xcbcef bytes), as
+    // VirtualAlloc/mprotect commit every page touched. The registry API stays
+    // strict: normalize to guest 4 KiB pages, never PS5's native 16 KiB pages.
+    const uint64_t mask = 4095;
+    if (n > UINT64_MAX - a || a + n > UINT64_MAX - mask) return 0;
+    uint64_t end = (a + n + mask) & ~mask;
+    a &= ~mask;
+    if (end - a > SIZE_MAX) return 0;
+    n = (size_t)(end - a);
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (!s || !ps5_guest_commit(s, a, n)) return 0;
+    // Non-watched reservations hold loader/kernel objects currently accessed
+    // by native host code. Watched heaps/alias ranges remain physically sparse.
+    return (!__atomic_load_n(&native_hle, __ATOMIC_ACQUIRE) && ps5_guest_watch_mode(s, a) != 0) || ps5_guest_prepare_write(s, a, n);
+}
+int plat_mem_decommit(uint64_t a, uint64_t n) {
+    Ps5GuestSpace *s = ps5_memory_space(); return s && n <= SIZE_MAX && ps5_guest_decommit(s, a, (size_t)n);
+}
+int plat_mem_protect(uint64_t a, uint64_t n, int prot) {
+    if (n > SIZE_MAX || (prot != PLAT_PROT_NONE && prot != PLAT_PROT_READ && prot != PLAT_PROT_RW)) return 0;
+    pthread_mutex_lock(&host_lock); HostAllocation *h = host_at(a, (size_t)n);
+    if (h) {
+        int ok = 0;
+        // Current host caller seals the whole dispatch allocation once.
+        if (a == h->base && n == h->bytes) {
+            if (prot == PLAT_PROT_READ) { ok = !ps5_demand_seal_readonly(h->region); if (ok) h->sealed = 1; }
+            else if (prot == PLAT_PROT_RW && !h->sealed) ok = 1;
+        }
+        pthread_mutex_unlock(&host_lock); return ok;
+    }
+    pthread_mutex_unlock(&host_lock);
+    Ps5GuestSpace *s = ps5_memory_space();
+    int rights = prot == PLAT_PROT_RW ? PS5_CHECKED_RW : prot == PLAT_PROT_READ ? PS5_CHECKED_READ : PS5_CHECKED_NONE;
+    return s && ps5_guest_protect(s, a, (size_t)n, rights);
+}
+int plat_mem_replace_anon(uint64_t a, uint64_t n) {
+    Ps5GuestSpace *s = ps5_memory_space(); return s && n <= SIZE_MAX && ps5_guest_replace(s, a, (size_t)n);
+}
+int plat_mem_poke(uint64_t a, const void *in, size_t n) {
+    Ps5GuestSpace *s = ps5_memory_space(); return s && ps5_guest_poke(s, a, in, n);
+}
+int plat_mem_peek(void *out, uint64_t a, size_t n) {
+    Ps5GuestSpace *s = ps5_memory_space(); return s && ps5_guest_peek(s, a, out, n);
+}
+int plat_mem_readable(uint64_t a, uint64_t n) {
+    if (n > SIZE_MAX) return 0;
+    pthread_mutex_lock(&host_lock); int owned = host_at(a, (size_t)n) != NULL; pthread_mutex_unlock(&host_lock);
+    if (owned) return 1;
+    Ps5GuestSpace *s = ps5_memory_space(); return s && ps5_guest_readable(s, a, (size_t)n);
+}
+int plat_mem_read(uint64_t a, void *out, size_t n) {
+    pthread_mutex_lock(&host_lock); HostAllocation *h = host_at(a, n);
+    if (h && n) {
+        size_t offset = (size_t)(a - h->base), done = 0;
+        while (done < n) {
+            if (!ps5_demand_fault((uintptr_t)(a + done))) { pthread_mutex_unlock(&host_lock); return 0; }
+            size_t part = 0x10000 - ((offset + done) % 0x10000); if (part > n - done) part = n - done;
+            done += part;
+        }
+        memcpy(out, (void *)(uintptr_t)a, n);
+    }
+    pthread_mutex_unlock(&host_lock);
+    if (h) return 1;
+    Ps5GuestSpace *s = ps5_memory_space(); return s && ps5_guest_read(s, a, out, n);
+}
+int plat_mem_state(uint64_t a, uint64_t limit, uint64_t *end) {
+    pthread_mutex_lock(&host_lock); HostAllocation *h = host_at(a, 1);
+    if (h) {
+        uint64_t stop = h->base + h->bytes; if (stop > limit) stop = limit;
+        if (end) *end = stop; int state = h->sealed ? PLAT_PROT_READ : PLAT_PROT_RW;
+        pthread_mutex_unlock(&host_lock); return state;
+    }
+    pthread_mutex_unlock(&host_lock); Ps5GuestSpace *s = ps5_memory_space();
+    if (!s) { if (end) *end = limit; return PLAT_MEM_FREE; }
+    int rights = ps5_guest_query(s, a, limit, end);
+    if (rights == -2) return PLAT_MEM_FREE;
+    if (rights == PS5_CHECKED_RESERVED) return PLAT_MEM_RESERVED;
+    return rights == PS5_CHECKED_RW ? PLAT_PROT_RW : rights == PS5_CHECKED_READ ? PLAT_PROT_READ : PLAT_PROT_NONE;
+}
+uint64_t plat_mem_written(uint64_t a, uint64_t n, uint64_t *pages, uint64_t max, int reset) {
+    Ps5GuestSpace *s = ps5_memory_space();
+    return s && n <= SIZE_MAX && max <= SIZE_MAX ? ps5_guest_written(s, a, (size_t)n, pages, (size_t)max, reset) : UINT64_MAX;
+}
+uint64_t plat_mem_populated(uint64_t a, uint64_t n, uint64_t (*runs)[2], uint64_t max) {
+    (void)a; (void)n; (void)runs; (void)max;
+    return UINT64_MAX; // Optional resident-run query: explicitly unsupported, as on Windows.
+}
+static int (*fault_fn)(uint64_t), (*lazy_fn)(uint64_t);
+static int (*watch_fn)(uint64_t, uint64_t);
+_Thread_local int plat_fault_write;
+_Thread_local uint64_t plat_fault_pc, plat_fault_ret;
+void plat_mem_fault_hook(int (*fn)(uint64_t)) { __atomic_store_n(&fault_fn, fn, __ATOMIC_RELEASE); }
+// MKWBOOT-067: a host write (HLE/NVN memcpy into guest memory) that faults on a frozen page: the crash handler asks the
+// memory core to thaw it and retries, as linux_mem.c does in its SIGSEGV handler. 054 and 065 died in nvnTextureInitialize.
+int ps5_mem_host_fault(uint64_t a) {
+    int (*f)(uint64_t) = __atomic_load_n(&fault_fn, __ATOMIC_ACQUIRE);
+    return a < (1ull << 39) && f && f(a);
+}
+void plat_mem_lazy_hook(int (*fn)(uint64_t)) { __atomic_store_n(&lazy_fn, fn, __ATOMIC_RELEASE); }
+void plat_mem_watch_hook(int (*fn)(uint64_t, uint64_t)) { __atomic_store_n(&watch_fn, fn, __ATOMIC_RELEASE); }
+int ps5_memory_before_access(uint64_t a, size_t n, int write, uint64_t pc) {
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (!s || a >= (1ull << 39) || n > (1ull << 39) - a) return 0;
+    plat_fault_write = !!write; plat_fault_pc = pc; plat_fault_ret = 0;
+    size_t done = 0;
+    while (done < n) {
+        uint64_t at = a + done; int ready = 0;
+        for (unsigned retry = 0; retry < 3; retry++) {
+            int rights = ps5_guest_access(s, at);
+            if (rights >= 0 && (rights & (write ? 2 : 1))) { ready = 1; break; }
+            int (*lazy)(uint64_t) = __atomic_load_n(&lazy_fn, __ATOMIC_ACQUIRE);
+            int (*fault)(uint64_t) = __atomic_load_n(&fault_fn, __ATOMIC_ACQUIRE);
+            int (*watch)(uint64_t, uint64_t) = __atomic_load_n(&watch_fn, __ATOMIC_ACQUIRE);
+            if (rights == PS5_CHECKED_RESERVED) { if (!lazy || !lazy(at)) return 0; }
+            else if (rights < 0) return 0;
+            else if (write && watch && watch(at, pc)) continue;
+            else if (!fault || !fault(at)) return 0;
+        }
+        if (!ready) return 0;
+        size_t part = 0x1000 - (size_t)(at % 0x1000); if (part > n - done) part = n - done;
+        done += part;
+    }
+    return 1;
+}
+
+void rt_log(const char *fmt, ...);
+void ps5_guest_map_report(void) {   // MKWBOOT-066: once
+    static int done;
+    if (done++ || !guest) return;
+    char b[2048];
+    ps5_guest_describe(guest, b, sizeof b);
+    rt_log("guest maps:%s", b);
+}
diff --git a/runtime/platform/ps5_mem.h b/runtime/platform/ps5_mem.h
