+// Independent of presents: a stalled startup may never call the frame diagnostics.
+// Never block the display on G, or log/allocate while a guest owner is paused.
+void kern_startup_snapshot(void) {
+    struct Row {
+        uint32_t handle, tid;
+        int priority, core, wait, started, exited, depth, sampled;
+        uint64_t address, object, pc, lr, rip, rsp, fp;
+    } rows[128];
+    unsigned n = 0, total = 0;
+    if (!plat_mutex_trylock(&G)) {
+        rt_log("startup-diag: kernel lock busy; snapshot skipped");
+        return;
+    }
+    for (RtThread *t = g_all; t; t = t->all) {
+        total++;
+        if (n == 128) continue;
+        struct Row *r = &rows[n++];
+        *r = (struct Row){.handle = t->handle, .tid = t->tid, .priority = t->prio,
+            .core = t->cur_core, .wait = t->wkind, .started = t->started, .exited = t->exited,
+            .depth = __atomic_load_n(&t->host_depth, __ATOMIC_RELAXED), .address = t->waddr, .object = t->wobj};
+        if (t->hthr && t->cur_core >= 0 && !t->exited) {
+            r->sampled = plat_intr_stop(t->hthr, &r->rip, &r->rsp);
+            if (t->cur) { r->pc = __atomic_load_n(&t->cur->pc, __ATOMIC_RELAXED); r->lr = __atomic_load_n(&t->cur->x[30], __ATOMIC_RELAXED); r->fp = __atomic_load_n(&t->cur->x[29], __ATOMIC_RELAXED); }
+            if (r->sampled && !plat_intr_resume(t->hthr, 0)) __builtin_trap();
+        } else if (t->cur) {
+            r->pc = __atomic_load_n(&t->cur->pc, __ATOMIC_RELAXED);
+            r->lr = __atomic_load_n(&t->cur->x[30], __ATOMIC_RELAXED);
+            r->fp = __atomic_load_n(&t->cur->x[29], __ATOMIC_RELAXED);
+        }
+    }
+    plat_mutex_unlock(&G);
+    rt_log("startup-diag: %u guest threads (%u shown); wait 0 none, 1 lock, 2 condition, 3 address, 4 sync", total, n);
+    for (unsigned i = 0; i < n; i++) {
+        struct Row *r = &rows[i];
+        char pc[128], lr[128], module[256] = "?";
+        uintptr_t base = 0;
+        if (r->sampled) plat_module_of((uintptr_t)r->rip, module, sizeof module, &base);
+        const char *host = hostfn_name(r->pc);
+        rt_log("startup-diag: thread %#x tid %u p%d core %d start %d exit %d wait %d addr %#llx obj %#llx depth %d; "
+               "pc %s lr %s host %s; sampled %d native %s+%#llx rsp %#llx",
+               r->handle, r->tid, r->priority, r->core, r->started, r->exited, r->wait,
+               (unsigned long long)r->address, (unsigned long long)r->object, r->depth,
+               ldr_describe(r->pc, pc, sizeof pc), ldr_describe(r->lr, lr, sizeof lr), host ? host : "-",
+               r->sampled, module, (unsigned long long)(r->rip - base), (unsigned long long)r->rsp);
+        // MKWBOOT-021: who called the wait. The main thread and any thread not parked on an address wait get their guest
+        // frame-pointer chain (the saved x29 of a thread in a host call is current); idle workers would only repeat
+        // the same few frames. Read-only, bounded, nothing is allocated or locked.
+        if ((r->handle == 0x1001 || r->wait != 3) && r->started && !r->exited && r->fp) {
+            char d[160];
+            uint64_t fp = r->fp;
+            for (int k = 0; k < 14 && fp && !(fp & 7) && plat_mem_readable(fp, 16); k++) {
+                uint64_t next = LD64(fp), flr = LD64(fp + 8);
+                rt_log("startup-diag:   thread %#x frame %d: %s", r->handle, k, ldr_describe(flr, d, sizeof d));
+                if (next <= fp || next - fp > (64u << 20)) break;
+                fp = next;
+            }
+        }
+    }
