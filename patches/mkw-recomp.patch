+    uint64_t first = 0x7200000000ull;
+    assert(ps5_guest_reserve(s, first, 65536, 1));
+    assert(ps5_guest_reserve(s, first + 65536, 65536, 1));
+    assert(ps5_guest_commit(s, first, 65536) && ps5_guest_commit(s, first + 65536, 65536));
+    atomic_store(&checked_test_fail_commit_at, atomic_load(&checked_test_commit_calls) + 2);
