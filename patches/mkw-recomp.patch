+static _Noreturn void invalid(uint64_t a, size_t n, int write, uint64_t pc) {
+    rt_fatal("PS5 checked %s rejected: address %#llx, bytes %llu, host pc %#llx",
+             write ? "write" : "read", (unsigned long long)a, (unsigned long long)n,
+             (unsigned long long)pc);
+}
+// Ready ranges are attempted once through the checked transaction first.
+// Only rejected accesses enter lazy/watch/fault handling, then retry.
+static Ps5GuestSpace *prepare(uint64_t a, size_t n, int write, uint64_t pc) {
+    if (!ps5_memory_before_access(a, n, write, pc)) invalid(a, n, write, pc);
+    return ps5_memory_space();
+}
