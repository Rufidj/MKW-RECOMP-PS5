diff --git a/runtime/platform/ps5_emutls.c b/runtime/platform/ps5_emutls.c
new file mode 100644
index 0000000..d8156d2
--- /dev/null
+++ b/runtime/platform/ps5_emutls.c
@@ -0,0 +1,142 @@
+// Emulated thread-local storage for the PS5 title, faster than compiler-rt's. SPDX-License-Identifier: MIT
+//
+// MKWBOOT-092: the console build uses emulated TLS, so every _Thread_local access calls __emutls_get_address, whose
+// compiler-rt version asks pthread_getspecific (a libkernel call) each time. The replay thread reads dozens of thread
+// locals per draw (vk_exec, vk_usnap, the draw caches), the kernel and the CPU entries a few per guest call: together
+// ~7 percent of the replay thread in a race (090). Here the thread is found by its TCB self pointer at %fs:0 (FreeBSD
+// amd64 TCB, also glibc's on the host): one load, no call. Each thread's objects live in a slot of a fixed open-addressed
+// table keyed by that pointer; a pthread key's destructor frees them and retires the slot when the thread ends, so a
+// later thread with the same TCB address starts empty. When %fs:0 reads 0, or the table is full, the objects of that
+// thread are found through pthread_getspecific as before.
+//
+// Same contract as compiler-rt's emutls.c: control->object.index is given out once per variable (1-based), an object is
+// allocated on its thread's first access with the variable's size and alignment and initialised from its template
+// (control->value) or zeroed, and freed when the thread ends.
+#if defined(__PROSPERO__) || defined(MKW_PS5_EMUTLS_TEST)
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+    size_t size, align;
+    union { uintptr_t index; void *address; } object;
+    void *value;
+} __emutls_control;
+
+typedef struct {
+    uintptr_t self;   // 0 free, 1 retired, else the owner's TCB self pointer
+    void **data;      // data[index - 1]: the object, or NULL before its first access
+    size_t n;
+} Slot;
+
+#define SLOTS 4096u
+#define RETIRED ((uintptr_t)1)
+static Slot slots[SLOTS];
+static pthread_key_t key;          // destructor: the thread's slot (or its fallback array)
+static pthread_once_t key_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t index_lock = PTHREAD_MUTEX_INITIALIZER;
+static uintptr_t num_objects;
+
+static inline uintptr_t fs_self(void) {
+    uintptr_t v;
+    __asm__ volatile("movq %%fs:0, %0" : "=r"(v));
+    return v;
+}
+
+static void free_slot_objects(Slot *s) {
+    for (size_t i = 0; i < s->n; i++)
+        if (s->data[i]) free(((void **)s->data[i])[-1]);   // the allocation start is kept just before the object
+    free(s->data);
+    s->data = NULL, s->n = 0;
+}
+
+static void destructor(void *p) {
+    Slot *s = p;
+    free_slot_objects(s);
+    if (s >= slots && s < slots + SLOTS) __atomic_store_n(&s->self, RETIRED, __ATOMIC_RELEASE);
+    else free(s);   // a fallback record
+}
+static void make_key(void) { pthread_key_create(&key, destructor); }
+
+static uintptr_t index_of(__emutls_control *c) {
+    uintptr_t i = __atomic_load_n(&c->object.index, __ATOMIC_ACQUIRE);
+    if (__builtin_expect(i != 0, 1)) return i;
+    pthread_mutex_lock(&index_lock);
+    i = c->object.index;
+    if (!i) { i = ++num_objects; __atomic_store_n(&c->object.index, i, __ATOMIC_RELEASE); }
+    pthread_mutex_unlock(&index_lock);
+    return i;
+}
+
+static Slot *slot_new(uintptr_t self) {   // this thread's first access: claim a slot (or a fallback record)
+    pthread_once(&key_once, make_key);
+    Slot *s = NULL;
+    if (self > RETIRED) {
+        uint32_t h = (uint32_t)((self >> 6) ^ (self >> 18)) & (SLOTS - 1);
+        for (uint32_t k = 0; k < SLOTS && !s; k++, h = (h + 1) & (SLOTS - 1)) {
+            uintptr_t z = 0;
+            if (__atomic_compare_exchange_n(&slots[h].self, &z, self, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) s = &slots[h];
+        }
+    }
+    if (!s) s = calloc(1, sizeof *s);   // no usable %fs:0 or a full table: found through the key below
+    if (!s) abort();
+    pthread_setspecific(key, s);
+    return s;
+}
+
+static inline Slot *slot_find(uintptr_t self) {
+    uint32_t h = (uint32_t)((self >> 6) ^ (self >> 18)) & (SLOTS - 1);
+    for (uint32_t k = 0; k < 8; k++, h = (h + 1) & (SLOTS - 1)) {   // nearly always the first probe
+        uintptr_t v = __atomic_load_n(&slots[h].self, __ATOMIC_ACQUIRE);
+        if (v == self) return &slots[h];
+        if (!v) return NULL;
+    }
+    for (uint32_t k = 8; k < SLOTS; k++, h = (h + 1) & (SLOTS - 1)) {
+        uintptr_t v = __atomic_load_n(&slots[h].self, __ATOMIC_ACQUIRE);
+        if (v == self) return &slots[h];
+        if (!v) return NULL;
+    }
+    return NULL;
+}
+
+static __attribute__((noinline)) void *slow(__emutls_control *c, Slot *s, uintptr_t idx) {
+    if (idx > s->n) {
+        size_t n = (idx + 16) & ~(size_t)15;
+        void **d = realloc(s->data, n * sizeof *d);
+        if (!d) abort();
+        memset(d + s->n, 0, (n - s->n) * sizeof *d);
+        s->data = d, s->n = n;
+    }
+    void *obj = s->data[idx - 1];
+    if (!obj) {
+        size_t align = c->align < sizeof(void *) ? sizeof(void *) : c->align;
+        char *raw = malloc(c->size + align + sizeof(void *));
+        if (!raw) abort();
+        uintptr_t at = ((uintptr_t)raw + sizeof(void *) + align - 1) & ~(uintptr_t)(align - 1);
+        ((void **)at)[-1] = raw;
+        obj = (void *)at;
+        if (c->value) memcpy(obj, c->value, c->size);
+        else memset(obj, 0, c->size);
+        s->data[idx - 1] = obj;
+    }
+    return obj;
+}
+
+void *__emutls_get_address(__emutls_control *c) {
+    uintptr_t idx = index_of(c);
+    uintptr_t self = fs_self();
+    Slot *s = self > RETIRED ? slot_find(self) : NULL;
+    if (__builtin_expect(s != NULL, 1)) {
+        if (__builtin_expect(idx <= s->n, 1)) {
+            void *obj = s->data[idx - 1];
+            if (__builtin_expect(obj != NULL, 1)) return obj;
+        }
+        return slow(c, s, idx);
+    }
+    pthread_once(&key_once, make_key);
+    s = pthread_getspecific(key);
+    if (!s) s = slot_new(self);
+    return slow(c, s, idx);
+}
+#endif
diff --git a/runtime/platform/ps5_fibers.c b/runtime/platform/ps5_fibers.c
new file mode 100644
index 0000000..16a3fdb
--- /dev/null
+++ b/runtime/platform/ps5_fibers.c
@@ -0,0 +1,98 @@
+// PS5 x86-64 fibers. SPDX-License-Identifier: MIT
+// The register-switch assembly and initial frame follow linux.c in this
+// repository. Stack allocation is isolated so demand backing can follow.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 platform source selected for another target"
+#endif
+#if !defined(__x86_64__)
+#error "The PS5 fiber ABI requires x86-64"
+#endif
+#include <stdlib.h>
+#include <string.h>
+#include "platform.h"
+#include "ps5_int.h"
+
+struct PlatFiber { void *sp; Ps5Stack stack; };
+void plat_fiber_swap(void **save, void *load);
+void plat_fiber_entry(void);
+__asm__(".text\n"
+        ".globl plat_fiber_swap\n"
+        ".type plat_fiber_swap, @function\n"
+        ".p2align 4\n"
+        "plat_fiber_swap:\n"
+        "    .cfi_startproc\n"
+        "    pushq %rbp\n"
+        "    pushq %rbx\n"
+        "    pushq %r12\n"
+        "    pushq %r13\n"
+        "    pushq %r14\n"
+        "    pushq %r15\n"
+        "    subq $16, %rsp\n"
+        "    stmxcsr 8(%rsp)\n"
+        "    fnstcw (%rsp)\n"
+        "    movq %rsp, (%rdi)\n"
+        "    movq %rsi, %rsp\n"
+        "    fldcw (%rsp)\n"
+        "    ldmxcsr 8(%rsp)\n"
+        "    addq $16, %rsp\n"
+        "    popq %r15\n"
+        "    popq %r14\n"
+        "    popq %r13\n"
+        "    popq %r12\n"
+        "    popq %rbx\n"
+        "    popq %rbp\n"
+        "    ret\n"
+        "    .cfi_endproc\n"
+        ".size plat_fiber_swap, .-plat_fiber_swap\n"
+        ".globl plat_fiber_entry\n"
+        ".type plat_fiber_entry, @function\n"
+        ".p2align 4\n"
+        "plat_fiber_entry:\n"
+        "    movq %r13, %rdi\n"
+        "    andq $-16, %rsp\n"   // the ret here left it 8 off; SysV wants 16 before the call (NX2navi e9edd6a)
+        "    callq *%r12\n"
+        "    ud2\n"
+        ".size plat_fiber_entry, .-plat_fiber_entry\n");
+
+static _Thread_local PlatFiber own_fiber;
+static _Thread_local PlatFiber *current_fiber;
+
+PlatFiber *plat_fiber_self(void) {
+    if (current_fiber) return current_fiber;
+    if (ps5_stack_thread_attach()) return NULL;
+    own_fiber = (PlatFiber){0};
+    current_fiber = &own_fiber;
+    return current_fiber;
+}
+void plat_fiber_unself(void) {
+    if (current_fiber != &own_fiber) __builtin_trap();
+    current_fiber = NULL;
+    ps5_stack_thread_detach();
+}
+PlatFiber *plat_fiber_new(size_t bytes, void (*fn)(void *), void *arg) {
+    if (!fn) return NULL;
+    PlatFiber *f = calloc(1, sizeof *f);
+    if (!f) return NULL;
+    if (!ps5_stack_create(&f->stack, bytes)) { free(f); return NULL; }
+    uint64_t *top = (uint64_t *)((char *)f->stack.data + f->stack.bytes);
+    uint64_t *frame = top - 10;
+    memset(frame, 0, 10 * sizeof *frame);
+    frame[0] = 0x037f; frame[1] = 0x1f80;
+    frame[4] = (uintptr_t)arg;  // r13
+    frame[5] = (uintptr_t)fn;   // r12
+    frame[8] = (uintptr_t)plat_fiber_entry;
+    f->sp = frame;
+    return f;
+}
+void plat_fiber_switch(PlatFiber *to) {
+    PlatFiber *from = current_fiber;
+    if (!from || !to || !to->sp) __builtin_trap();
+    current_fiber = to;
+    // No TLS access after this call: this frame can return on another pthread.
+    plat_fiber_swap(&from->sp, to->sp);
+}
+void plat_fiber_free(PlatFiber *f) {
+    if (!f || !f->stack.base) return;
+    ps5_stack_destroy(&f->stack);
+    free(f);
+}
diff --git a/runtime/platform/ps5_fs.c b/runtime/platform/ps5_fs.c
new file mode 100644
index 0000000..8710a64
--- /dev/null
+++ b/runtime/platform/ps5_fs.c
@@ -0,0 +1,550 @@
+// PS5 POSIX files, adapted from linux_fs.c at e652497ab3284d53bed671c012d86c7e397f19f5.
+// Copyright (c) 2026 Adrià. SPDX-License-Identifier: MIT
+// Uses the SDK platform's complete directory/*at bindings via the RADV link recipe.
+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 source selected for another target"
+#endif
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "platform.h"
+// host.h (runtime/core/base), declared here so the host-check build of this file needs no core headers.
+void rt_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+
+int plat_file_exists(const char *path) {
+    struct stat st;
+    return !stat(path, &st) && !S_ISDIR(st.st_mode);
+}
+
+int plat_dir_exists(const char *path) {
+    struct stat st;
+    return !stat(path, &st) && S_ISDIR(st.st_mode);
+}
+
+int plat_full_path(const char *path, char *out, size_t cap) {
+    if (path[0] == '/') return snprintf(out, cap, "%s", path) < (int)cap;
+    return snprintf(out, cap, "/app0/%s", path) < (int)cap;
+}
+
+void plat_file_mkdir_p(const char *path) {
+    char tmp[PATH_MAX];
+    if (snprintf(tmp, sizeof tmp, "%s", path) >= (int)sizeof tmp) return;
+    for (char *p = tmp + 1; *p; p++) {
+        if (*p == '/' || *p == '\\') {
+            char c = *p;
+            *p = 0;
+            mkdir(tmp, 0777);
+            *p = c;
+        }
+    }
+    mkdir(tmp, 0777);
+}
+
+static int write_all(int fd, const void *data, size_t n) {
+    const uint8_t *p = data;
+    while (n) {
+        ssize_t k = write(fd, p, n);
+        if (k < 0 && errno == EINTR) continue;
+        if (k <= 0) return 0;
+        p += k, n -= (size_t)k;
+    }
+    return 1;
+}
+
+uint8_t *plat_file_read(const char *path, uint64_t *size) {
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return NULL;
+    struct stat st;
+    uint8_t *buf = NULL;
+    if (!fstat(fd, &st) && S_ISREG(st.st_mode) && st.st_size > 0 && st.st_size < (1ll << 30)) {
+        buf = malloc((size_t)st.st_size + 1);
+        size_t got = 0;
+        while (buf && got < (size_t)st.st_size) {
+            ssize_t k = read(fd, buf + got, (size_t)st.st_size - got);
+            if (k < 0 && errno == EINTR) continue;
+            if (k <= 0) break;
+            got += (size_t)k;
+        }
+        if (buf && got != (size_t)st.st_size) {
+            free(buf);
+            buf = NULL;
+        }
+        if (buf) {
+            buf[st.st_size] = 0;
+            *size = (uint64_t)st.st_size;
+        }
+    }
+    close(fd);
+    return buf;
+}
+
+int plat_file_write(const char *path, const void *data, size_t n) {
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0666);
+    if (fd < 0) return 0;
+    int ok = write_all(fd, data, n);
+    return close(fd) == 0 && ok;
+}
+
+// O_APPEND makes each write land whole at the end of the file, from any thread.
+PlatAppend *plat_append_open(const char *path) {
+    int fd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_APPEND | O_CLOEXEC, 0666);
+    return fd < 0 ? NULL : (PlatAppend *)(intptr_t)(fd + 1);
+}
+
+// MKWBOOT-078: the log is written by a thread of its own. A write() to the log file took up to 500 ms on the console
+// (077: the replay thread sat in plat_append_write's write while the game waited 500 ms for its submission, every race
+// stall), so callers now copy the line into a 4 MiB ring and return; the "log writer" thread empties it. A fatal or a
+// native crash report empties the ring itself, writes and flushes, so the end of a crash is on disk in order. A full ring
+// drops the line and counts it (said in the next line written).
+#include <pthread.h>
+#define LOG_RING (4u << 20)
+static char log_ring[LOG_RING];
+static size_t log_rd, log_wr;   // log_mx
+static uint64_t log_dropped;
+static int log_fd = -1, log_thread_on;
+static pthread_mutex_t log_mx = PTHREAD_MUTEX_INITIALIZER, log_io = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t log_cv = PTHREAD_COND_INITIALIZER;
+static void log_write_fd(int fd, const char *p, size_t n) {
+    while (n) { ssize_t k = write(fd, p, n); if (k < 0 && errno == EINTR) continue; if (k <= 0) return; p += k, n -= (size_t)k; }
+}
+static void log_drain_locked_io(int fd) {   // log_io held: writes what the ring holds, in order
+    for (;;) {
+        pthread_mutex_lock(&log_mx);
+        size_t rd = log_rd, wr = log_wr;
+        pthread_mutex_unlock(&log_mx);
+        if (rd == wr) return;
+        size_t a = rd % LOG_RING, len = wr - rd, first = LOG_RING - a < len ? LOG_RING - a : len;
+        log_write_fd(fd, log_ring + a, first);
+        if (len > first) log_write_fd(fd, log_ring, len - first);
+        pthread_mutex_lock(&log_mx);
+        log_rd = wr;
+        pthread_mutex_unlock(&log_mx);
+    }
+}
+static void *log_main(void *arg) {
+    (void)arg;
+    for (;;) {
+        pthread_mutex_lock(&log_mx);
+        while (log_rd == log_wr) pthread_cond_wait(&log_cv, &log_mx);
+        pthread_mutex_unlock(&log_mx);
+        pthread_mutex_lock(&log_io);
+        log_drain_locked_io(log_fd);
+        pthread_mutex_unlock(&log_io);
+    }
+    return NULL;
+}
+int plat_append_write(PlatAppend *f, const void *data, size_t n) {
+    int fd = (int)(intptr_t)f - 1;
+    int fatal = 0;
+    for (size_t i = 0; !fatal && n >= 5 && i + 5 <= n && i < 24; i++)
+        fatal = !memcmp((const char *)data + i, "FATAL", 5) || (i + 7 <= n && !memcmp((const char *)data + i, "native-", 7));
+    if (!log_thread_on && !fatal) {
+        pthread_mutex_lock(&log_mx);
+        if (!log_thread_on) {
+            pthread_t t;
+            log_fd = fd;
+            if (!pthread_create(&t, NULL, log_main, NULL)) { pthread_detach(t); log_thread_on = 1; }
+        }
+        pthread_mutex_unlock(&log_mx);
+    }
+    if (fatal || !log_thread_on || fd != log_fd) {   // a crash report, or no writer thread: write now, after what is queued
+        // (a crash report may come from a signal handler on a thread that holds the lock: then it is written as it is)
+        int held = log_thread_on && fd == log_fd && !pthread_mutex_trylock(&log_io);
+        if (held) log_drain_locked_io(fd);
+        log_write_fd(fd, data, n);
+        if (fatal) fsync(fd);
+        if (held) pthread_mutex_unlock(&log_io);
+        return 1;
+    }
+    pthread_mutex_lock(&log_mx);
+    int ok = log_wr - log_rd + n <= LOG_RING;
+    if (ok) {
+        for (size_t i = 0; i < n; i++) log_ring[(log_wr + i) % LOG_RING] = ((const char *)data)[i];
+        log_wr += n;
+        pthread_cond_signal(&log_cv);
+    } else log_dropped++;
+    pthread_mutex_unlock(&log_mx);
+    return ok;
+}
+
+// Flushes the directory holding path, so a rename into it survives a crash.
+static void sync_dir_of(const char *path) {
+    char dir[PATH_MAX];
+    if (snprintf(dir, sizeof dir, "%s", path) >= (int)sizeof dir) return;
+    char *slash = strrchr(dir, '/');
+    if (slash == dir) slash[1] = 0;
+    else if (slash) *slash = 0;
+    else strcpy(dir, ".");
+    int fd = open(dir, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd >= 0) {
+        fsync(fd);
+        close(fd);
+    }
+}
+
+int plat_file_replace(const char *from, const char *to) {
+    if (rename(from, to)) return 0;
+    sync_dir_of(to);
+    return 1;
+}
+
+int plat_file_write_atomic(const char *path, const void *data, size_t n) {
+    char tmp[PATH_MAX + 48];
+    int len = snprintf(tmp, sizeof tmp, "%s.%u.%u.tmp", path, plat_process_id(), plat_thread_id());
+    if (len < 0 || len >= (int)sizeof tmp) return 0;
+    // A read-only file stays as it is, as on Windows: rename() alone would replace it (a mkw.ini set read-only).
+    if (access(path, W_OK) && errno != ENOENT) return 0;
+    int fd = open(tmp, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0666);
+    if (fd < 0) return 0;
+    int ok = write_all(fd, data, n) && fsync(fd) == 0;
+    ok = close(fd) == 0 && ok;
+    if (ok && !rename(tmp, path)) {
+        sync_dir_of(path);
+        return 1;
+    }
+    unlink(tmp);
+    return 0;
+}
+
+int plat_file_sync(FILE *f) { return !fflush(f) && !fsync(fileno(f)); }
+
+void plat_file_delete(const char *path) { unlink(path); }
+
+int64_t plat_file_size(const char *path) {
+    struct stat st;
+    return stat(path, &st) ? -1 : (int64_t)st.st_size;
+}
+
+// The owner's write permission stands for Windows' read-only attribute.
+int plat_file_set_readonly(const char *path, int on) {
+    struct stat st;
+    if (stat(path, &st)) return 0;
+    mode_t m = on ? st.st_mode & ~(mode_t)0222 : st.st_mode | S_IWUSR;
+    return chmod(path, m & 07777) == 0;
+}
+
+int plat_file_lock(const char *path) {
+    int fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0666);
+    if (fd < 0) return -1;
+    if (!flock(fd, LOCK_EX | LOCK_NB)) return 1;   // fd stays open: the lock lives as long as the process
+    int e = errno;
+    close(fd);
+    return e == EWOULDBLOCK ? 0 : -1;
+}
+
+int plat_file_list(const char *dir, const char *ext, int (*cb)(const char *name, void *ctx), void *ctx) {
+    DIR *d = opendir(dir);
+    if (!d) return 0;
+    size_t el = strlen(ext);
+    for (struct dirent *e; (e = readdir(d));) {
+        size_t n = strlen(e->d_name);
+        if (n < el || strcmp(e->d_name + n - el, ext) || e->d_name[0] == '.') continue;
+        if (!cb(e->d_name, ctx)) break;
+    }
+    closedir(d);
+    return 1;
+}
+
+// A PlatFile is the descriptor + 1, so descriptor 0 is not NULL.
+PlatFile *plat_file_open(const char *path) {
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    return fd < 0 ? NULL : (PlatFile *)(intptr_t)(fd + 1);
+}
+
+PlatFile *plat_file_open_unbuffered(const char *path) {
+    int fd = open(path, O_RDONLY | O_CLOEXEC | O_DIRECT);
+    return fd < 0 ? NULL : (PlatFile *)(intptr_t)(fd + 1);
+}
+
+static int fd_of(PlatFile *f) { return (int)(intptr_t)f - 1; }
+
+void plat_file_close(PlatFile *f) {
+    if (f) close(fd_of(f));
+}
+
+// MKWBOOT-074: how long the game's file reads take (the race stalls of 072-073 had the process nearly idle: waiting, not
+// computing). Calls, bytes, summed and longest time, refusals; and the reads in flight with the oldest start, for the stall line.
+static uint64_t rd_calls, rd_bytes, rd_ns, rd_max, rd_fail, rd_slow;
+static uint64_t rd_start[16];   // start time of a read in flight, 0 = free slot
+int64_t plat_file_pread(PlatFile *f, void *buf, uint32_t n, uint64_t off) {
+    ssize_t k;
+    uint64_t t0 = plat_now_ns();
+    int slot = -1;
+    for (int i = 0; i < 16; i++) { uint64_t z = 0; if (__atomic_compare_exchange_n(&rd_start[i], &z, t0, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) { slot = i; break; } }
+    do k = pread(fd_of(f), buf, n, (off_t)off);
+    while (k < 0 && errno == EINTR);
+    int e = errno;
+    uint64_t d = plat_now_ns() - t0;
+    if (slot >= 0) __atomic_store_n(&rd_start[slot], 0, __ATOMIC_RELAXED);
+    __atomic_fetch_add(&rd_calls, 1, __ATOMIC_RELAXED); __atomic_fetch_add(&rd_ns, d, __ATOMIC_RELAXED);
+    if (k > 0) __atomic_fetch_add(&rd_bytes, (uint64_t)k, __ATOMIC_RELAXED);
+    if (k < 0) __atomic_fetch_add(&rd_fail, 1, __ATOMIC_RELAXED);
+    if (d > 50000000ull) __atomic_fetch_add(&rd_slow, 1, __ATOMIC_RELAXED);
+    uint64_t m = __atomic_load_n(&rd_max, __ATOMIC_RELAXED);
+    while (d > m && !__atomic_compare_exchange_n(&rd_max, &m, d, 0, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {}
+    errno = e;
+    return k >= 0 ? k : errno == EFAULT ? -2 : -1;
+}
+int ps5_fs_read_stats(char *buf, size_t size, int reset) {
+    uint64_t now = plat_now_ns(), oldest = 0; int inflight = 0;
+    for (int i = 0; i < 16; i++) { uint64_t t = __atomic_load_n(&rd_start[i], __ATOMIC_RELAXED); if (t) { inflight++; if (now - t > oldest) oldest = now - t; } }
+    uint64_t c = reset ? __atomic_exchange_n(&rd_calls, 0, __ATOMIC_RELAXED) : rd_calls, b = reset ? __atomic_exchange_n(&rd_bytes, 0, __ATOMIC_RELAXED) : rd_bytes;
+    uint64_t t = reset ? __atomic_exchange_n(&rd_ns, 0, __ATOMIC_RELAXED) : rd_ns, mx = reset ? __atomic_exchange_n(&rd_max, 0, __ATOMIC_RELAXED) : rd_max;
+    uint64_t fl = reset ? __atomic_exchange_n(&rd_fail, 0, __ATOMIC_RELAXED) : rd_fail, sl = reset ? __atomic_exchange_n(&rd_slow, 0, __ATOMIC_RELAXED) : rd_slow;
+    return snprintf(buf, size, "file reads %llu, %.1f MiB, %.0f ms summed, longest %.1f ms, over 50 ms %llu, failed %llu; in flight %d (oldest %.1f ms)",
+                    (unsigned long long)c, b / 1048576.0, t / 1e6, mx / 1e6, (unsigned long long)sl, (unsigned long long)fl, inflight, oldest / 1e6);
+}
+
+int plat_file_id(PlatFile *f, PlatFileId *out) {
+    struct stat st;
+    if (fstat(fd_of(f), &st)) return 0;
+    *out = (PlatFileId){(uint64_t)st.st_dev, (uint64_t)st.st_ino, (uint64_t)st.st_size,
+                        (uint64_t)st.st_mtim.tv_sec * 1000000000u + (uint64_t)st.st_mtim.tv_nsec,
+                        (uint64_t)st.st_ctim.tv_sec * 1000000000u + (uint64_t)st.st_ctim.tv_nsec};
+    return 1;
+}
+
+const void *plat_file_map(PlatFile *f) {
+    struct stat st;
+    if (fstat(fd_of(f), &st) || !st.st_size) return NULL;
+    void *v = mmap(NULL, (size_t)st.st_size, PROT_READ, MAP_SHARED, fd_of(f), 0);
+    return v == MAP_FAILED ? NULL : v;
+}
+
+int plat_fs_os_error(void) { return errno; }
+
+static int fs_err(int e) {
+    switch (e) {
+    case ENOENT: case ENOTDIR: return PLAT_FS_NOT_FOUND;
+    case EEXIST: return PLAT_FS_EXISTS;
+    case ENOTEMPTY: return PLAT_FS_NOT_EMPTY;
+    case EBUSY: case ETXTBSY: return PLAT_FS_BUSY;
+    default: return PLAT_FS_ERROR;
+    }
+}
+
+// MKWBOOT-019 measured on the console: lstat fails with EPERM for every path (also existing ones), while stat, fstat,
+// mkdir and readdir d_type work. When lstat is refused, stat gives the type; it follows links, so a link is only
+// reported by plat_fs_list (readdir d_type DT_LNK) and plat_fs_kind of a link names its target. Any other lstat error
+// (ENOENT, EACCES...) is reported as before.
+static int fs_lstat(const char *path, struct stat *st) {
+    if (!lstat(path, st)) return 0;
+    if (errno != EPERM) return -1;
+    return stat(path, st);
+}
+
+int plat_fs_kind(const char *path) {
+    struct stat st;
+    if (fs_lstat(path, &st)) return PLAT_FS_MISSING;
+    return S_ISLNK(st.st_mode) ? PLAT_FS_LINK : S_ISDIR(st.st_mode) ? PLAT_FS_DIR : PLAT_FS_FILE;
+}
+
+int plat_fs_mkdir(const char *path) { return mkdir(path, 0777) ? fs_err(errno) : PLAT_FS_OK; }
+
+// MKWBOOT-019 diagnostic, observation only: records what this console's libkernel returns for the calls that
+// make_dir (mkdir + errno, lstat) and the account check (stat) rely on, so the /app0/profile fatal can be attributed
+// to errno or to lstat's type instead of guessed. The struct is prefilled with 0xa5 so a call that returns 0 without
+// writing a field shows it. Changes nothing: mkdir runs only on a path that stat already reports as a directory.
+static void diag_stat(const char *what, const char *path, int rc, int err, const struct stat *st) {
+    const uint8_t *b = (const uint8_t *)st;
+    if (rc) {
+        rt_log("fs-diag: %s %s -> %d errno %d", what, path, rc, err);
+        return;
+    }
+    char hex[80];
+    size_t n = 0;
+    for (int i = 0; i < 32; i++) n += (size_t)snprintf(hex + n, sizeof hex - n, "%s%02x", i % 4 ? "" : " ", b[i]);
+    rt_log("fs-diag: %s %s -> 0 mode %#o fmt %#o ino %llu nlink %u size %lld; bytes%s", what, path,
+           (unsigned)st->st_mode, (unsigned)(st->st_mode & S_IFMT), (unsigned long long)st->st_ino,
+           (unsigned)st->st_nlink, (long long)st->st_size, hex);
+}
+
+void ps5_fs_diag(const char *path, int list) {
+    struct stat st;
+    int rc, e, stat_dir;
+    rt_log("fs-diag: %s (sizeof stat %zu, S_IFDIR %#o, S_IFLNK %#o, EEXIST %d)", path, sizeof st,
+            (unsigned)S_IFDIR, (unsigned)S_IFLNK, EEXIST);
+    memset(&st, 0xa5, sizeof st), errno = 0, rc = stat(path, &st), e = errno;
+    diag_stat("stat", path, rc, e, &st);
+    stat_dir = !rc && S_ISDIR(st.st_mode);
+    memset(&st, 0xa5, sizeof st), errno = 0, rc = lstat(path, &st), e = errno;
+    diag_stat("lstat", path, rc, e, &st);
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0) rt_log("fs-diag: open %s -> errno %d", path, errno);
+    else {
+        memset(&st, 0xa5, sizeof st), errno = 0, rc = fstat(fd, &st), e = errno;
+        diag_stat("fstat", path, rc, e, &st);
+        close(fd);
+    }
+    if (stat_dir) {
+        errno = 0, rc = mkdir(path, 0777), e = errno;
+        rt_log("fs-diag: mkdir existing %s -> %d errno %d (platform %d)", path, rc, e,
+                rc ? fs_err(e) : PLAT_FS_OK);
+    }
+    if (!list) return;
+    DIR *d = opendir(path);
+    if (!d) {
+        rt_log("fs-diag: opendir %s -> errno %d", path, errno);
+        return;
+    }
+    int shown = 0, total = 0;
+    for (;;) {
+        errno = 0;
+        struct dirent *ent = readdir(d);
+        if (!ent) {
+            rt_log("fs-diag: readdir %s ended after %d entries, errno %d", path, total, errno);
+            break;
+        }
+        total++;
+        if (shown >= 6) continue;
+        shown++;
+        rt_log("fs-diag: entry '%s' d_type %u d_fileno %llu", ent->d_name, (unsigned)ent->d_type,
+                (unsigned long long)ent->d_fileno);
+        if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, "..")) continue;
+        char p[PATH_MAX];
+        snprintf(p, sizeof p, "%s/%s", path, ent->d_name);
+        memset(&st, 0xa5, sizeof st), errno = 0, rc = lstat(p, &st), e = errno;
+        diag_stat("lstat", p, rc, e, &st);
+        memset(&st, 0xa5, sizeof st), errno = 0, rc = stat(p, &st), e = errno;
+        diag_stat("stat", p, rc, e, &st);
+    }
+    closedir(d);
+}
+
+// Deleting needs write access to the directory, not to the entry. A read-only directory (a save folder copied from
+// elsewhere, a read-only directory as Windows' plat_fs_rmdir clears) gets its owner's write bit back once and the
+// removal is retried.
+static int remove_entry(const char *path, int dir) {
+    if (!(dir ? rmdir(path) : unlink(path))) return PLAT_FS_OK;
+    int e = errno;
+    char parent[PATH_MAX];
+    const char *slash = strrchr(path, '/');
+    struct stat st;
+    if ((e != EACCES && e != EPERM) || !slash || (size_t)(slash - path) >= sizeof parent) return fs_err(e);
+    snprintf(parent, sizeof parent, "%.*s", (int)(slash - path), path);
+    if (!*parent || stat(parent, &st) || (st.st_mode & S_IWUSR) || chmod(parent, (st.st_mode & 07777) | S_IWUSR))
+        return fs_err(e);
+    return (dir ? rmdir(path) : unlink(path)) ? fs_err(errno) : PLAT_FS_OK;
+}
+
+int plat_fs_rmdir(const char *path) {
+    struct stat st;
+    // rmdir does not follow a link (ENOTDIR on one), so a refused lstat leaves this safe.
+    if (!lstat(path, &st) && S_ISLNK(st.st_mode)) return remove_entry(path, 0);
+    return remove_entry(path, 1);
+}
+
+int plat_fs_unlink(const char *path) { return remove_entry(path, 0); }
+
+// RENAME_NOREPLACE keeps Windows' rule that a rename never replaces; a file system without it (EINVAL) gets a check
+// first, which another process could race but the save directories are ours.
+int plat_fs_rename(const char *from, const char *to, int durable) {
+    // Same fallback as upstream on kernels without renameat2. Save operations
+    // serialize their own directories; this is not a cross-process no-replace primitive.
+    if (plat_fs_kind(to) != PLAT_FS_MISSING) return PLAT_FS_EXISTS;
+    if (rename(from, to)) return fs_err(errno);
+    if (durable) {
+        sync_dir_of(from);
+        sync_dir_of(to);
+    }
+    return PLAT_FS_OK;
+}
+
+int plat_fs_link(const char *existing, const char *path) { return link(existing, path) ? fs_err(errno) : PLAT_FS_OK; }
+
+int plat_fs_links(const char *path) {
+    struct stat st;
+    return stat(path, &st) ? 0 : (int)st.st_nlink;
+}
+
+void plat_fs_sync_dir(const char *path) {
+    int fd = open(path, O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (fd >= 0) {
+        fsync(fd);
+        close(fd);
+    }
+}
+
+// Open files never stop a rename here.
+void plat_fs_busy_reason(const char *dir, char *out, size_t cap) {
+    (void)dir;
+    if (cap) *out = 0;
+}
+
+int plat_fs_list(const char *dir, int (*cb)(const char *name, int kind, uint64_t size, void *ctx), void *ctx) {
+    DIR *d = opendir(dir);
+    if (!d) {
+        int saved = errno;
+        fprintf(stderr, "[host] fs: cannot open directory %s (errno %d)\n", dir, saved);
+        return fs_err(saved);
+    }
+    int result = PLAT_FS_OK;
+    for (;;) {
+        errno = 0;
+        struct dirent *e = readdir(d);
+        if (!e) { if (errno) result = fs_err(errno); break; }
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        // Resolve by full path: recursive walkers keep many streams open, while
+        // the SDK's descriptor-to-path registry has a bounded number of slots.
+        char path[PATH_MAX];
+        if (snprintf(path, sizeof path, "%s/%s", dir, e->d_name) >= (int)sizeof path) {
+            result = fs_err(ENAMETOOLONG); break;
+        }
+        struct stat st;
+        int kind;
+        if (!lstat(path, &st)) kind = S_ISLNK(st.st_mode) ? PLAT_FS_LINK : S_ISDIR(st.st_mode) ? PLAT_FS_DIR : PLAT_FS_FILE;
+        else if (errno == EPERM && e->d_type == DT_LNK) { kind = PLAT_FS_LINK; memset(&st, 0, sizeof st); }
+        else if (errno == EPERM && !stat(path, &st)) kind = e->d_type == DT_DIR ? PLAT_FS_DIR : S_ISDIR(st.st_mode) ? PLAT_FS_DIR : PLAT_FS_FILE;
+        else { result = fs_err(errno); break; }
+        if (!cb(e->d_name, kind, kind == PLAT_FS_FILE ? (uint64_t)st.st_size : 0, ctx)) break;
+    }
+    if (result != PLAT_FS_OK) fprintf(stderr, "[host] fs: cannot enumerate %s (platform error %d, errno %d)\n", dir, result, errno);
+    closedir(d);
+    return result;
+}
+
+PlatFile *plat_fs_open(const char *path, int write, int *err) {
+    struct stat st;
+    int fd = open(path, (write ? O_RDWR : O_RDONLY) | O_CLOEXEC);
+    if (fd >= 0 && (fstat(fd, &st) || !S_ISREG(st.st_mode))) {
+        close(fd);
+        fd = -1, errno = ENOENT;
+    }
+    if (fd < 0 && err) *err = fs_err(errno);
+    return fd < 0 ? NULL : (PlatFile *)(intptr_t)(fd + 1);
+}
+
+PlatFile *plat_fs_create(const char *path, int *err) {
+    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0666);
+    if (fd < 0 && err) *err = fs_err(errno);
+    return fd < 0 ? NULL : (PlatFile *)(intptr_t)(fd + 1);
+}
+
+int64_t plat_file_pwrite(PlatFile *f, const void *buf, uint32_t n, uint64_t off) {
+    ssize_t k;
+    do k = pwrite(fd_of(f), buf, n, (off_t)off);
+    while (k < 0 && errno == EINTR);
+    return k;
+}
+
+int plat_file_set_size(PlatFile *f, uint64_t size) { return ftruncate(fd_of(f), (off_t)size) ? fs_err(errno) : 0; }
+
+int plat_file_fsync(PlatFile *f) { return fsync(fd_of(f)) == 0; }
+
+int plat_temp_dir(char *out, size_t cap) {
+    const char *t = getenv("TMPDIR");
+    if (!t || !*t) t = "/app0/tmp";
+    size_t n = strlen(t);
+    while (n > 1 && t[n - 1] == '/') n--;
+    return snprintf(out, cap, "%.*s", (int)n, t) < (int)cap;
+}
+
