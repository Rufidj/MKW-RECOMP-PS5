+#if !defined(__PROSPERO__) && !defined(MKW_PS5_HOST_CHECK)
+#error "PS5 CPU memory source selected for another target"
+#endif
+#ifndef MKW_CHECKED_MEMORY
+#define MKW_CHECKED_MEMORY
+#endif
+#include "cpu/cpu.h"
+#include "core/base/host.h"
+#include "ps5_mem.h"
