+"""Native display selection against a deterministic Vulkan API model, no GPU run."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class DisplayTest(unittest.TestCase):
+    def test_selection_and_presentation_failures(self):
+        vma = ROOT / 'build/ps5-deps/VulkanMemoryAllocator-3.4.0/include'
+        vulkan = Path('/usr/include')
+        if not (vma / 'vk_mem_alloc.h').is_file() or not (vulkan / 'vulkan/vulkan.h').is_file():
+            self.skipTest('local VMA/Vulkan headers are needed; use ps5_deps.py and the PS5 foundation')
+        with tempfile.TemporaryDirectory() as tmp:
+            main = Path(tmp) / 'main.c'
+            main.write_text(r'''
+#include "gfx_wsys.h"
+#include <assert.h>
+#include <string.h>
+#define HANDLE(T, n) ((T)(uintptr_t)(n))
+static int surface_fail, support_fail, can_present = 1, creates, destroys, incomplete, bad_caps;
+static uint32_t last_plane, last_stack;
+static VkDisplayModeKHR last_mode;
+static double refresh;
+static VkCtx context = {.instance = HANDLE(VkInstance, 1), .phys = HANDLE(VkPhysicalDevice, 2)};
+VkCtx *vk_ctx(void) { return &context; }
+void gfx_cfg_window_size(int *w, int *h) { *w = 1920; *h = 1080; }
+void gfx_window_set_refresh(double hz) { refresh = hz; }
+void gfx_window_mark_dirty(void) {}
+void gfx_window_closed(void) { assert(0); }
+int gfx_window_focused(void) { return 1; }
+void rt_log(const char *format, ...) { (void)format; }
+VkResult vkGetPhysicalDeviceDisplayPropertiesKHR(VkPhysicalDevice pd, uint32_t *n, VkDisplayPropertiesKHR *out) {
+    (void)pd; *n = 1;
+    if (out) *out = (VkDisplayPropertiesKHR){.display = HANDLE(VkDisplayKHR, 3),
+        .supportedTransforms = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR};
+    return out && incomplete ? VK_INCOMPLETE : VK_SUCCESS;
+}
+VkResult vkGetPhysicalDeviceDisplayPlanePropertiesKHR(VkPhysicalDevice pd, uint32_t *n, VkDisplayPlanePropertiesKHR *out) {
+    (void)pd; *n = 2;
+    if (out) {
+        out[0] = (VkDisplayPlanePropertiesKHR){.currentDisplay = HANDLE(VkDisplayKHR, 9)};
+        out[1] = (VkDisplayPlanePropertiesKHR){.currentStackIndex = 4};
+    }
+    return VK_SUCCESS;
+}
+VkResult vkGetDisplayModePropertiesKHR(VkPhysicalDevice pd, VkDisplayKHR display, uint32_t *n, VkDisplayModePropertiesKHR *out) {
+    (void)pd; (void)display; *n = 3;
+    if (out) {
+        out[0] = (VkDisplayModePropertiesKHR){.displayMode = HANDLE(VkDisplayModeKHR, 10), .parameters = {{1280,720},60000}};
+        out[1] = (VkDisplayModePropertiesKHR){.displayMode = HANDLE(VkDisplayModeKHR, 11), .parameters = {{1920,1080},50000}};
+        out[2] = (VkDisplayModePropertiesKHR){.displayMode = HANDLE(VkDisplayModeKHR, 12), .parameters = {{1920,1080},60000}};
+    }
+    return VK_SUCCESS;
+}
+VkResult vkGetDisplayPlaneSupportedDisplaysKHR(VkPhysicalDevice pd, uint32_t plane, uint32_t *n, VkDisplayKHR *out) {
+    (void)pd; assert(plane == 1); *n = 1; if (out) *out = HANDLE(VkDisplayKHR, 3); return VK_SUCCESS;
+}
+VkResult vkGetDisplayPlaneCapabilitiesKHR(VkPhysicalDevice pd, VkDisplayModeKHR mode, uint32_t plane, VkDisplayPlaneCapabilitiesKHR *out) {
+    (void)pd; (void)mode; assert(plane == 1);
+    *out = (VkDisplayPlaneCapabilitiesKHR){.supportedAlpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+        .maxSrcExtent = {3840,2160}, .maxDstExtent = {3840,2160}};
+    if (bad_caps) out->minDstPosition.x = 1;
+    return VK_SUCCESS;
+}
+VkResult vkCreateDisplayPlaneSurfaceKHR(VkInstance inst, const VkDisplaySurfaceCreateInfoKHR *info,
+        const VkAllocationCallbacks *alloc, VkSurfaceKHR *out) {
+    (void)alloc; assert(inst == context.instance); creates++;
+    last_plane = info->planeIndex; last_stack = info->planeStackIndex; last_mode = info->displayMode;
