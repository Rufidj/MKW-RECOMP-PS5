+// MKWBOOT-043: the game's loads and stores, checked inline. The profile of MKWBOOT-042 put 88 percent of the CPU in the
+// chain rt_checked_* -> ps5_guest_*_fast -> ps5_checked_*_gated; here the whole check is a few instructions against the
+// published copy of the mappings (ps5_guest_memory.h): the mapping by hint, the page rights, the backing flag, the access
+// itself and the dirty byte. Anything else (an access across pages or mappings, an unbacked store, a refusal) returns 0 and
+// takes the general path below, which gives the same answer it always did.
+typedef unsigned char fvec16 __attribute__((vector_size(16)));
+static __attribute__((noinline)) const Ps5FastMap *fast_map_search(const Ps5FastSnap *sn, uint64_t a) {
+    size_t lo = 0, hi = sn->count;
+    while (lo < hi) {
+        size_t mid = (lo + hi) >> 1;
+        if (a < sn->fm[mid].base) hi = mid;
+        else if (a - sn->fm[mid].base >= sn->fm[mid].bytes) lo = mid + 1;
+        else return &sn->fm[mid];
+    }
+    return NULL;
+}
+static inline const Ps5FastMap *fast_map(const Ps5FastSnap *sn, uint64_t a) {
+    uint64_t g = a >> 24;   // the mapping that wholly holds this 16 MiB, from a table nothing ever writes
+    if (__builtin_expect(g < (1u << 15) && sn->granule[g], 1)) return &sn->fm[sn->granule[g] - 1];
+    return fast_map_search(sn, a);
+}
+static inline int fast_load(Ps5GuestSpace *s, uint64_t a, void *out, unsigned n) {
+    const Ps5FastSnap *sn = ps5_guest_fast(s);
