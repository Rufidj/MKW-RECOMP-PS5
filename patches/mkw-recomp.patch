+// PS5 guest-memory integration, still awaiting full HLE pointer conversion. SPDX-License-Identifier: MIT
+#pragma once
+#include "ps5_guest_memory.h"
+Ps5GuestSpace *ps5_memory_space(void);
+extern Ps5GuestSpace *ps5_mem_guest;   // the space once created, read by the hot checked accesses
+// Called by checked CPU/HLE accesses, not from a POSIX signal handler.
