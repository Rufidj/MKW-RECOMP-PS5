+"""Real checked copies overlap as readers while writes and unmap stay exclusive."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import demand_sources, demand_include
+ROOT = Path(__file__).resolve().parents[1]
+class Ps5MemoryReadersTest(unittest.TestCase):
+    def test_parallel_readers_and_exclusive_updates(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            d=Path(tmp);c=d/'readers.c'
+            c.write_text(r'''
+#define _GNU_SOURCE
+#include <assert.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <string.h>
+#include <unistd.h>
+#include "ps5_guest_memory.h"
+#include <ps5platform/checked_region.h>
+static Ps5GuestSpace *space;
+static const uint64_t base=0x1040000000ull;
+static pthread_barrier_t pair;
+static atomic_int armed, entered, done;
+static atomic_uint reads;
+void *__real_memcpy(void *,const void *,size_t);
+void *__wrap_memcpy(void *out,const void *in,size_t n) {
+    if(atomic_load(&armed)&&((uintptr_t)in==base)&&n==64) {
+        atomic_fetch_add(&entered,1);
+        // Both copies must reach the native read while registry AND region
+        // reader gates are held. An exclusive gate makes this alarm fail.
+        int r=pthread_barrier_wait(&pair);assert(!r||r==PTHREAD_BARRIER_SERIAL_THREAD);
+    }
+    return __real_memcpy(out,in,n);
+}
+static void *once(void *unused) {
+    (void)unused;unsigned char out[64];
+    assert(ps5_guest_read(space,base,out,sizeof out));
+    for(unsigned i=0;i<sizeof out;i++)assert(out[i]==0x3a);
+    return 0;
+}
+static void *reader(void *unused) {
+    (void)unused;unsigned char out[64];
+    do {
+        if(ps5_guest_read(space,base,out,sizeof out)) {
+            for(unsigned i=1;i<sizeof out;i++)assert(out[i]==out[0]);
+            atomic_fetch_add(&reads,1);
+        }
+    } while(!atomic_load(&done));
+    return 0;
+}
+static atomic_int fastdone;
+static void *fast_reader(void *unused) {   // the lock-free scalar/vector path (MKWBOOT-042) beside a 64-byte writer and protection changes
+    (void)unused;unsigned char o8[8],o16[16];unsigned long ok=0;
+    do {
+        if(ps5_guest_read_fast(space,base,o8,sizeof o8)==1){for(unsigned i=1;i<sizeof o8;i++)assert(o8[i]==o8[0]);ok++;}
+        if(ps5_guest_read_fast(space,base+16,o16,sizeof o16)==1){for(unsigned i=1;i<sizeof o16;i++)assert(o16[i]==o16[0]);ok++;}
+    } while(!atomic_load(&fastdone));
+    assert(ok>0);return 0;
+}
+int main(void) {
+    alarm(10);space=ps5_guest_space_create();assert(space);
+    assert(ps5_guest_reserve(space,base,65536,1)&&ps5_guest_commit(space,base,65536));
+    unsigned char block[64];memset(block,0x3a,sizeof block);
+    assert(ps5_guest_write(space,base,block,sizeof block));
+    assert(!pthread_barrier_init(&pair,0,2));
+    atomic_store(&armed,1);pthread_t a,b;
+    assert(!pthread_create(&a,0,once,0)&&!pthread_create(&b,0,once,0));
+    assert(!pthread_join(a,0)&&!pthread_join(b,0));
+    assert(atomic_load(&entered)==2);atomic_store(&armed,0);
+    pthread_barrier_destroy(&pair);
+    pthread_t threads[4];for(unsigned i=0;i<4;i++)assert(!pthread_create(&threads[i],0,reader,0));
+    pthread_t fast[2];for(unsigned i=0;i<2;i++)assert(!pthread_create(&fast[i],0,fast_reader,0));
+    for(unsigned i=0;i<1000;i++) {
+        memset(block,(unsigned char)i,sizeof block);
+        assert(ps5_guest_write(space,base,block,sizeof block));
+        if(!(i&31)) {
+            assert(ps5_guest_protect(space,base,4096,PS5_CHECKED_READ));
+            assert(!ps5_guest_write(space,base,block,sizeof block));
+            assert(ps5_guest_protect(space,base,4096,PS5_CHECKED_RW));
+        }
+    }
+    atomic_store(&fastdone,1);for(unsigned i=0;i<2;i++)assert(!pthread_join(fast[i],0));   // lock-free readers end before the unmap
+    // Destruction waits for each active reader; later reads fail without
+    // dereferencing freed metadata or the released guest reservation.
+    assert(ps5_guest_unmap(space,base));atomic_store(&done,1);
+    for(unsigned i=0;i<4;i++)assert(!pthread_join(threads[i],0));
+    assert(atomic_load(&reads)>0);ps5_guest_space_destroy(space);alarm(0);
+}
+''')
+            exe=d/'readers'
+            subprocess.run(['clang','-O2','-fno-builtin-memcpy','-pthread',
+                '-I'+str(ROOT/'runtime/platform'),demand_include(),str(c),
+                str(ROOT/'runtime/platform/ps5_guest_memory.c'),
+                str(ROOT.parent/'PS5_PayloadSDK/platform/src/checked_region.c'),
+                *demand_sources(),'-Wl,--wrap=memcpy','-o',str(exe)],check=True)
+            subprocess.run([str(exe)],check=True,timeout=15)
+if __name__=='__main__':unittest.main()
