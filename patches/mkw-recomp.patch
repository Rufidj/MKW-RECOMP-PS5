+        if (!ps5_guest_read(s, a, &value, n)) invalid(a, n, 0, pc);
+    }
+    return value;
+}
+static __attribute__((noinline, cold)) void store_slow(uint64_t a, uint64_t value, unsigned n, uint64_t pc) {
+    __atomic_fetch_add(&ps5_miss_store_slow, 1, __ATOMIC_RELAXED);
+    if (n != 1 && n != 2 && n != 4 && n != 8) invalid(a, n, 1, pc);
+    Ps5GuestSpace *s = ps5_memory_space();
+    if (fast_store(s, a, &value, n)) return;
+    if (!ps5_guest_write(s, a, &value, n)) {
+        s = prepare(a, n, 1, pc);
+        if (!ps5_guest_write(s, a, &value, n)) invalid(a, n, 1, pc);
+    }
+}
+static inline const Ps5FastMap *hot_map(uint64_t a, uint64_t *off, unsigned n) {
+    Ps5GuestSpace *s = __atomic_load_n(&ps5_mem_guest, __ATOMIC_ACQUIRE);
+    if (__builtin_expect(!s, 0)) return NULL;
+    const Ps5FastSnap *sn = ps5_guest_fast(s);
+    if (__builtin_expect(!sn, 0)) return NULL;
+    uint64_t g = a >> 24;
+    if (__builtin_expect(g >= (1u << 15), 0)) return NULL;
+    unsigned gi = sn->granule[g];
+    if (__builtin_expect(!gi, 0)) return NULL;
+    const Ps5FastMap *m = &sn->fm[gi - 1];
+    uint64_t o = a - m->base;
+    if (__builtin_expect(n > m->bytes - o || (o & 0xfff) + n > 0x1000, 0)) return NULL;
+    *off = o;
+    return m;
+}
