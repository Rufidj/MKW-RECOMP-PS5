@@ -0,0 +1,87 @@
+"""Transactional registry copies under concurrent writes and permission changes."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from ps5_support import FORK, demand_include
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class GuestSpaceTest(unittest.TestCase):
+    def test_transactions_and_lifetime(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            main = folder / 'main.c'
+            main.write_text(r'''
+#include "platform/ps5_guest_memory.h"
+#include <ps5platform/checked_region.h>
+#include <assert.h>
+#include <pthread.h>
+#include <string.h>
+static Ps5GuestSpace *space;
+static const uint64_t base = 0x7100000000ull;
+static void *writer(void *arg) {
+    unsigned char data[32]; memset(data, (int)(uintptr_t)arg, sizeof data);
+    for (unsigned i = 0; i < 4000; i++) ps5_guest_write(space, base + 0xfff0, data, sizeof data);
+    return NULL;
+}
+static void *reader(void *unused) {
+    (void)unused; unsigned char data[32];
+    for (unsigned i = 0; i < 4000; i++) {
+        memset(data, 0xab, sizeof data);
+        if (ps5_guest_read(space, base + 0xfff0, data, sizeof data)) {
+            for (unsigned j = 1; j < sizeof data; j++) assert(data[j] == data[0]);
+        } else {
+            for (unsigned j = 0; j < sizeof data; j++) assert(data[j] == 0xab);
+        }
+    }
+    return NULL;
+}
+int main(void) {
+    space = ps5_guest_space_create(); assert(space);
+    assert(!ps5_guest_map(space, UINT64_MAX, 0x1000));
+    assert(ps5_guest_map(space, base, 0x10000));
+    assert(ps5_guest_map(space, base + 0x10000, 0x10000));
+    assert(!ps5_guest_map(space, base, 0x10000));
+    unsigned char data[64]; memset(data, 0x11, sizeof data);
+    assert(ps5_guest_write(space, base + 0xffe0, data, sizeof data));
+    assert(!ps5_guest_read(space, base + 0xfff0, (void *)(uintptr_t)(base + 0x8000), 32));
+    assert(!ps5_guest_read(space, UINT64_MAX - 1, data, 4));
+    assert(!ps5_guest_copy(space, base, UINT64_MAX, 4));
+    assert(!ps5_guest_protect(space, base + 0xf000, 0x2000, PS5_CHECKED_READ));
+    pthread_t threads[3];
+    assert(!pthread_create(&threads[0], NULL, writer, (void *)0x22));
+    assert(!pthread_create(&threads[1], NULL, writer, (void *)0x33));
+    assert(!pthread_create(&threads[2], NULL, reader, NULL));
+    for (unsigned i = 0; i < 1000; i++)
+        assert(ps5_guest_protect(space, base + 0x10000, 0x1000, i & 1 ? PS5_CHECKED_RW : PS5_CHECKED_NONE));
+    for (unsigned i = 0; i < 3; i++) assert(!pthread_join(threads[i], NULL));
+    assert(ps5_guest_protect(space, base + 0x10000, 0x1000, PS5_CHECKED_NONE));
+    memset(data, 0x99, sizeof data);
+    assert(!ps5_guest_read(space, base + 0xffe0, data, sizeof data));
+    for (unsigned i = 0; i < sizeof data; i++) assert(data[i] == 0x99);
+    assert(!ps5_guest_write(space, base + 0xffe0, data, sizeof data));
+    assert(!ps5_guest_fill(space, base + 0xffe0, 0, sizeof data));
+    assert(!ps5_guest_copy(space, base + 0xffe0, base + 0x8000, sizeof data));
+    assert(ps5_guest_unmap(space, base + 0x10000));
+    assert(!ps5_guest_unmap(space, base + 0x10000));
+    assert(ps5_guest_access(space, base + 0x10000) == -1);
+    assert(ps5_guest_map(space, base + 0x10000, 0x10000));
+    assert(ps5_guest_read(space, base + 0x10000, data, sizeof data));
+    for (unsigned i = 0; i < sizeof data; i++) assert(!data[i]);
+    ps5_guest_space_destroy(space);
+}
+''')
+            exe = folder / 'space'
+            subprocess.run(['clang', '-O2', '-Wall', '-Wextra', '-Werror',
+                            f'-I{ROOT / "runtime"}', demand_include(), str(main),
+                            str(ROOT / 'runtime/platform/ps5_guest_memory.c'),
+                            str(FORK / 'platform/src/checked_region.c'),
+                            str(FORK / 'platform/tests/demand_host_kernel.c'), '-pthread', '-o', str(exe)],
+                           check=True, timeout=30)
+            subprocess.run([str(exe)], check=True, timeout=15)
+
+
+if __name__ == '__main__':
+    unittest.main()
