diff --git a/tools/romfs/index.py b/tools/romfs/index.py
new file mode 100644
index 0000000..c320ae6
--- /dev/null
+++ b/tools/romfs/index.py
@@ -0,0 +1,87 @@
+"""Index a loose RomFS without packing/moving its data.
+
+Usage: python3 tools/romfs/index.py ROMFS build/romfs.index
+The title reads ROOT.index instead of enumerating ROOT. Names and sizes are
+metadata only; the SHA-256 trailer detects damaged metadata, not altered assets.
+"""
+import argparse
+import hashlib
+import os
+from pathlib import Path
+import struct
+import stat
+
+
+def build(root, output, from_listings=False):
+    rows = []
+    size_mismatches = []
+    def walk(directory, prefix=''):
+        with os.scandir(directory) as entries:
+            for e in entries:
+                if not prefix and e.name.startswith('.'):
+                    continue
+                rel = prefix + e.name
+                if '\\' in rel or '\x00' in rel:
+                    raise ValueError('Invalid RomFS path: ' + repr(rel))
+                if e.is_symlink():
+                    continue
+                if e.is_dir(follow_symlinks=False):
+                    walk(e.path, rel + '/')
+                else:
+                    st = e.stat(follow_symlinks=False)
+                    if stat.S_ISREG(st.st_mode):
+                        rows.append((rel.encode('utf-8'), st.st_size))
+    def listed(directory, prefix=''):
+        # Original dump listings exclude host preparation artifacts added later.
+        for line in (Path(directory) / '.listing').read_text().splitlines():
+            if not line.strip():
+                continue
+            fields = line.split(None, 8)
+            if len(fields) != 9:
+                raise ValueError('Malformed dump listing: ' + line)
+            mode, _, _, _, size, _, _, _, name = fields
+            if name in ('.', '..'):
+                continue
+            if '/' in name or '\\' in name or '\x00' in name:
+                raise ValueError('Invalid listing name: ' + repr(name))
+            child = Path(directory) / name
+            st = child.lstat()
+            if mode[0] == 'd' and stat.S_ISDIR(st.st_mode):
+                listed(child, prefix + name + '/')
+            elif mode[0] == '-' and stat.S_ISREG(st.st_mode):
+                if st.st_size != int(size):
+                    size_mismatches.append({'path': prefix + name, 'listed_bytes': int(size), 'actual_bytes': st.st_size})
+                rows.append(((prefix + name).encode('utf-8'), st.st_size))
+            else:
+                raise ValueError('Dump file missing/changed: ' + str(child))
+    if from_listings:
+        listed(root)
+    else:
+        walk(root)
+    rows.sort()
+    if not rows:
+        raise ValueError('RomFS is empty')
+    entries, names = bytearray(), bytearray()
+    for name, size in rows:
+        entries += struct.pack('<QQII', 0, size, len(names), len(name) + 1)
+        names += name + b'\0'
+    data = b'MKW_RFS1' + struct.pack('<QQ', len(rows), 24 + len(entries)) + entries + names
+    output.parent.mkdir(parents=True, exist_ok=True)
+    temporary = output.with_name(output.name + '.tmp')
+    temporary.write_bytes(data + hashlib.sha256(data).digest())
+    temporary.replace(output)
+    return {'files': len(rows), 'bytes': len(data) + 32,
+            'asset_bytes': sum(size for _, size in rows),
+            'sha256': hashlib.sha256(output.read_bytes()).hexdigest(),
+            'listing_size_mismatch_count': len(size_mismatches),
+            'listing_size_mismatch_samples': size_mismatches[:20]}
+
