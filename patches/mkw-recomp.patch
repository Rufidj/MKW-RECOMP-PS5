diff --git a/runtime/input/input_ps5.c b/runtime/input/input_ps5.c
new file mode 100644
index 0000000..9997b78
--- /dev/null
+++ b/runtime/input/input_ps5.c
@@ -0,0 +1,69 @@
+// Native PS5 gamepad adapter; no SDL dependency. SPDX-License-Identifier: MIT
+#include "input.h"
+#include "input_map.h"
+#include "input_script.h"
+#include "cfg.h"
+#include "ui/menu/menu.h"
+#include "platform/platform.h"
+#include "platform/ps5_title.h"
+#include <math.h>
+#include <string.h>
+static PlatMutex lock = PLAT_MUTEX_INIT;
+static int started, block, menu, combo, overlay;
+static void init(void) { if(!started){input_map_reset();input_map_configure();started=1;} }
+static void physical(const Ps5PadSample *s,uint8_t down[PAD_COUNT]) {
+ memset(down,0,PAD_COUNT);
+ const uint32_t mask[PAD_COUNT] = {[PAD_SOUTH]=0x4000,[PAD_EAST]=0x2000,[PAD_WEST]=0x8000,[PAD_NORTH]=0x1000,
+ [PAD_LSTICK]=2,[PAD_RSTICK]=4,[PAD_L]=0x400,[PAD_R]=0x800,[PAD_START]=8,[PAD_BACK]=0x100000,
+ [PAD_DPAD_LEFT]=0x80,[PAD_DPAD_UP]=0x10,[PAD_DPAD_RIGHT]=0x20,[PAD_DPAD_DOWN]=0x40};
+ for(int i=1;i<PAD_COUNT;i++)down[i]=!!(s->buttons&mask[i]);down[PAD_ZL]=s->l2>0.5f;down[PAD_ZR]=s->r2>0.5f;
+}
+static void directions(uint64_t *b,const int32_t s[4]) {for(int i=0;i<2;i++){unsigned bit=16+i*4;if(s[i*2]<-16384)*b|=1ull<<bit;if(s[i*2]>16384)*b|=1ull<<(bit+2);if(s[i*2+1]>16384)*b|=1ull<<(bit+1);if(s[i*2+1]<-16384)*b|=1ull<<(bit+3);}}
+static int read_pad(int player,uint64_t *b,int32_t s[4]) {
+ Ps5PadSample sample={0};*b=0;memset(s,0,4*sizeof *s);
+ int connected=ps5_title_pad(player,&sample);if(!connected || !sample.connected || !sample.focused)return 0;
+ uint8_t down[PAD_COUNT];physical(&sample,down);
+ int layout=input_pad_layout_pick(cfg_value("MKW_PAD_LAYOUT"),0);
+ *b=input_map_pad_buttons(down,layout);
+ for(int i=0;i<4;i++){float f=sample.sticks[i];if(f>1)f=1;if(f< -1)f=-1;s[i]=(int32_t)(f*32767);}
+ s[1]=-s[1];s[3]=-s[3];return 1;
+}
+static void poll(int player,int ui,uint64_t *b,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry) {
+ int32_t sticks[4];int toggle=0,perf=0;
+ plat_mutex_lock(&lock);init();input_map_configure();read_pad(player,b,sticks);
+ {const char *off=cfg_get("MKW_INPUT");   /* an environment switch, not a settings row: cfg_value would be fatal */
+  if(off && !strcmp(off,"none")){*b=0;memset(sticks,0,sizeof sticks);}}
+ if(!player){toggle=input_menu_gate(&combo,menu_is_open(),b,sticks);perf=input_overlay_gate(&overlay,b);}
+ plat_mutex_unlock(&lock);
+ if(toggle)menu_toggle();if(perf)menu_perf_cycle();
+ script_apply(b,sticks,sticks+2,player);directions(b,sticks);
+ plat_mutex_lock(&lock);
+ if(!ui){if(block==2 && !*b)block=0;if(menu==2 && !*b)menu=0;if(block||menu){*b=0;memset(sticks,0,sizeof sticks);}}
+ plat_mutex_unlock(&lock);
+ if(!player)rec_apply(*b,sticks,sticks+2);
+ *lx=sticks[0];*ly=sticks[1];*rx=sticks[2];*ry=sticks[3];
+}
+void input_poll(uint64_t *b,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry){poll(0,0,b,lx,ly,rx,ry);}
+void input_poll_ui(uint64_t *b,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry){poll(0,1,b,lx,ly,rx,ry);}
+void input_poll_player(int p,uint64_t *b,int32_t *lx,int32_t *ly,int32_t *rx,int32_t *ry){poll(p,0,b,lx,ly,rx,ry);}
+void input_block(int on){plat_mutex_lock(&lock);block=on?1:2;plat_mutex_unlock(&lock);}
+void input_menu(int on){plat_mutex_lock(&lock);menu=on?1:2;plat_mutex_unlock(&lock);}
+uint32_t input_player_mask(void){uint32_t bits=0;plat_mutex_lock(&lock);for(int p=0;p<4;p++){Ps5PadSample s;if(ps5_title_pad(p,&s)&&s.connected)bits|=1u<<p;}plat_mutex_unlock(&lock);return bits;}
+int input_pad_read(uint64_t *b,int32_t *lx,int32_t *ly){int32_t s[4];plat_mutex_lock(&lock);init();int ok=read_pad(0,b,s);plat_mutex_unlock(&lock);*lx=s[0];*ly=s[1];return ok;}
+int input_last_device(void){return INPUT_DEVICE_PAD;}
+int input_pad_layout(void){return input_pad_layout_pick(cfg_value("MKW_PAD_LAYOUT"),0);}
+int input_pad_label(int id){switch(id){case PAD_SOUTH:return PAD_LABEL_CROSS;case PAD_EAST:return PAD_LABEL_CIRCLE;case PAD_WEST:return PAD_LABEL_SQUARE;case PAD_NORTH:return PAD_LABEL_TRIANGLE;default:return PAD_LABEL_NONE;}}
+void input_map_snapshot(InputMap *m){plat_mutex_lock(&lock);init();input_map_configure();*m=input_map;plat_mutex_unlock(&lock);}
+int input_capture(int reset,int *id){static uint8_t previous[PAD_COUNT];Ps5PadSample sample={0};uint8_t now[PAD_COUNT];plat_mutex_lock(&lock);ps5_title_pad(0,&sample);physical(&sample,now);int found=0;if(!reset)for(int i=1;i<PAD_COUNT;i++)if(now[i]&&!previous[i]){*id=i;found=INPUT_CAPTURE_PAD;break;}memcpy(previous,now,sizeof now);plat_mutex_unlock(&lock);return found;}
+uint16_t rumble_motor(float a,float curve,float strength){if(!(a>0)||!(strength>0))return 0;float v=powf(a>1?1:a,curve)*strength*65535+0.5f;return v>=65535?65535:(uint16_t)v;}
+int input_rumble(int p,uint16_t low,uint16_t high,uint32_t ms){plat_mutex_lock(&lock);int ok=ps5_title_rumble(p,low/65535.f,high/65535.f,ms);plat_mutex_unlock(&lock);return ok;}
+int input_rumble_triggers_enabled(void){return 0;} // DualSense standard motors, no Xbox impulse-trigger interface.
+uint32_t input_key_char(int key){(void)key;return 0;}
+int input_flight_key(void){return 0;}
+int input_hack_key(int which){(void)which;return 0;}
+int input_cursor_allowed(void){return 0;} // no native pointer device in this title
+void input_cursor_suspend(int on){(void)on;}
+int input_cursor_released(void){return 1;}
+int input_motion_enabled(void){return 0;} // The title's pad API does not expose calibrated sensor readings yet.
+void input_motion_start(void){}
+void input_motion_axes(const float a[3],const float g[3],double acc[3],double gyro[3]){acc[0]=-a[0]/9.80665;acc[1]=a[2]/9.80665;acc[2]=-a[1]/9.80665;gyro[0]=-g[0];gyro[1]=g[2];gyro[2]=-g[1];}
