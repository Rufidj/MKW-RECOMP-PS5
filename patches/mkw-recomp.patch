+uint64_t ps5_miss_general, ps5_miss_slow, ps5_miss_cross, ps5_miss_nomap, ps5_miss_unbacked, ps5_miss_store_slow;
+static __attribute__((noinline, cold)) uint64_t load_slow(uint64_t a, unsigned n, uint64_t pc) {
