+void plat_sleep_ms(uint32_t ms) { plat_wait_ns((uint64_t)ms * 1000000u); }
+void plat_sleep_ns(uint64_t ns) {
+    uint64_t start = plat_now_ns();
+    if (ns > 100000u) plat_wait_ns(ns - 100000u);
+    while (plat_now_ns() - start < ns) sched_yield();
+}
+
+// Return ETIMEDOUT only when the word stayed unchanged to the deadline. The
+// same bucket mutex guards check-to-sleep and wake, closing the lost-wake race.
+static int park_wait(volatile uint32_t *word, uint32_t expected, const struct timespec *deadline) {
+    // (MKWBOOT-092 spun 256 pauses here before sleeping: with dozens of game threads waiting at once the spinners took
+    // the host cores the replay thread needed, and the race got slower: 093 took it out again.)
+    Park *p = park_for(word);
+    checked(pthread_mutex_lock(&p->mutex));
+    int error = 0;
+    __atomic_fetch_add(&p->waiters, 1, __ATOMIC_SEQ_CST);   // counted before the word is looked at (pairs with the fence in park_wake)
+    while (__atomic_load_n(word, __ATOMIC_SEQ_CST) == expected) {
+        error = deadline ? pthread_cond_timedwait(&p->cond, &p->mutex, deadline)
+                         : pthread_cond_wait(&p->cond, &p->mutex);
+        if (error == ETIMEDOUT) break;
+        checked(error);
+    }
+    __atomic_fetch_sub(&p->waiters, 1, __ATOMIC_RELEASE);
+    checked(pthread_mutex_unlock(&p->mutex));
+    return error;
+}
+
+static void park_wake(volatile uint32_t *word) {
+    Park *p = park_for(word);
+    // MKWBOOT-054: with nobody in the bucket there is nothing to wake, and the lock + broadcast were three system calls on every
+    // wake (the _umtx_op stub was 25 percent of the CPU in 052/053, called from the library mutex/condition code). The caller
+    // changed the word before this; the fence orders that change before the read of the count, the waiter counts itself before
+    // it reads the word, so either the waiter sees the new word or the waker sees the waiter.
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (!__atomic_load_n(&p->waiters, __ATOMIC_SEQ_CST)) return;
+    checked(pthread_mutex_lock(&p->mutex));
+    // Different words can share a bucket. Waking one arbitrary thread could
+    // leave the intended waiter asleep forever, so every bucket wake broadcasts.
+    checked(pthread_cond_broadcast(&p->cond));
+    checked(pthread_mutex_unlock(&p->mutex));
+}
