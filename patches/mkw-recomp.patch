diff --git a/runtime/platform/ps5_nso_probe.c b/runtime/platform/ps5_nso_probe.c
new file mode 100644
index 0000000..6990878
--- /dev/null
+++ b/runtime/platform/ps5_nso_probe.c
@@ -0,0 +1,126 @@
+// Raw fixed-address NSO images for the PS5 diagnostic. SPDX-License-Identifier: MIT
+// NSO/LZ4 structure follows core/boot/loader.c in this repository (LAS/MacNativeGames,
+// MIT, attribution there). This does not relocate imports or call game code.
+#include "ps5_nso_probe.h"
+#include "sha256.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint32_t rd32(const uint8_t *p) { uint32_t n; memcpy(&n, p, 4); return n; }
+static int lz4_block(const uint8_t *src, size_t n, uint8_t *dst, size_t capacity) {
+    const uint8_t *s = src, *end = src + n;
+    uint8_t *d = dst;
+    while (s < end) {
+        unsigned token = *s++;
+        size_t literal = token >> 4;
+        if (literal == 15) {
+            unsigned part;
+            do { if (s == end) return 0; part = *s++; literal += part; } while (part == 255);
+        }
+        size_t used = (size_t)(d - dst);
+        if (literal > capacity - used || literal > (size_t)(end - s)) return 0;
+        memcpy(d, s, literal); d += literal; s += literal;
+        if (s == end) break;
+        if (end - s < 2) return 0;
+        size_t distance = s[0] | ((size_t)s[1] << 8); s += 2;
+        if (!distance || distance > (size_t)(d - dst)) return 0;
+        size_t length = token & 15;
+        if (length == 15) {
+            unsigned part;
+            do { if (s == end) return 0; part = *s++; length += part; } while (part == 255);
+        }
+        length += 4;
+        if (length > capacity - (size_t)(d - dst)) return 0;
+        uint8_t *previous = d - distance;
+        while (length--) *d++ = *previous++;
+    }
+    return (size_t)(d - dst) == capacity;
+}
+void ps5_nso_probe_unload(Ps5NsoProbeImage *image) {
+    if (image->region) ps5_checked_destroy(image->region);
+    memset(image, 0, sizeof *image);
+}
+#define FAIL(message) do { snprintf(detail, cap, "%s", message); goto fail; } while (0)
+int ps5_nso_probe_load(const char *path, const Ps5NsoProbeSpec *spec, Ps5NsoProbeImage *image,
+                       char *detail, size_t cap) {
+    FILE *file = NULL;
+    uint8_t *raw = NULL, *segment = NULL, *buffer = NULL;
+    struct ps5_checked_region *region = NULL;
+    memset(image, 0, sizeof *image);
+    file = fopen(path, "rb");
+    if (!file) FAIL("Falta el archivo en exefs/ o no se puede abrir");
+    if (fseek(file, 0, SEEK_END)) FAIL("No se obtiene el tamano del archivo");
+    long length = ftell(file);
+    if (length < 0 || (uint64_t)length != spec->file_bytes || length < 0x100 || length > 256 * 1024 * 1024)
+        FAIL("El tamano del archivo no coincide con el dump preparado");
+    if (fseek(file, 0, SEEK_SET)) FAIL("No se vuelve al inicio del archivo");
+    raw = malloc((size_t)length);
+    if (!raw) FAIL("No hay memoria para leer el NSO");
+    if (fread(raw, 1, (size_t)length, file) != (size_t)length) FAIL("Lectura incompleta del NSO");
+    fclose(file); file = NULL;
+    uint8_t digest[32]; sha256(raw, (size_t)length, digest);
+    if (memcmp(digest, spec->file_sha256, 32)) FAIL("SHA-256 del archivo distinto: revisa la version del dump");
+    if (memcmp(raw, "NSO0", 4)) FAIL("Firma NSO0 incorrecta");
+    uint32_t data_offset = rd32(raw + 0x34), data_size = rd32(raw + 0x38), bss = rd32(raw + 0x3c);
+    uint64_t image_bytes = ((uint64_t)data_offset + data_size + bss + 0xfff) & ~0xfffull;
+    if (image_bytes != spec->image_bytes || data_offset != spec->data_offset ||
+        !data_offset || data_offset % 0x1000) FAIL("La imagen NSO no coincide con su disposicion esperada");
+    if (!ps5_checked_create((uintptr_t)spec->base, (size_t)image_bytes, &region))
+        FAIL("No se reserva o respalda la direccion fija del modulo");
+    uint32_t flags = rd32(raw + 0xc);
+    uint64_t previous_end = 0;
+    for (unsigned i = 0; i < 3; i++) {
+        uint32_t file_offset = rd32(raw + 0x10 + i * 16);
+        uint32_t memory_offset = rd32(raw + 0x14 + i * 16);
+        uint32_t decoded = rd32(raw + 0x18 + i * 16);
+        uint32_t stored = flags & (1u << i) ? rd32(raw + 0x60 + i * 4) : decoded;
+        if ((uint64_t)file_offset + stored > (uint64_t)length ||
+            (uint64_t)memory_offset + decoded > image_bytes) FAIL("Un segmento sale de los limites del NSO");
+        if (memory_offset < previous_end || (i < 2 && (uint64_t)memory_offset + decoded > data_offset))
+            FAIL("Los segmentos del NSO se solapan");
+        previous_end = (uint64_t)memory_offset + decoded;
+        const uint8_t *data = raw + file_offset;
+        if (flags & (1u << i)) {
+            segment = malloc(decoded ? decoded : 1);
+            if (!segment) FAIL("No hay memoria para descomprimir el segmento");
+            if (!lz4_block(data, stored, segment, decoded)) FAIL("Segmento LZ4 incorrecto");
+            data = segment;
+        }
+        if (!ps5_checked_write(region, memory_offset, data, decoded)) FAIL("No se copia el segmento a su destino");
+        free(segment); segment = NULL;
+    }
+    free(raw); raw = NULL;
+    if (!ps5_checked_protect(region, 0, data_offset, PS5_CHECKED_READ)) FAIL("No se establecen los permisos logicos del modulo");
+    uint8_t boundary[2], after[2], change[2] = {0xa5, 0x5a};
+    if (!ps5_checked_read(region, data_offset - 1, boundary, 2)) FAIL("No se lee la frontera RO/RW");
+    if (ps5_checked_write(region, data_offset - 1, change, 2)) FAIL("Se acepta una escritura que cruza memoria de solo lectura");
+    if (!ps5_checked_read(region, data_offset - 1, after, 2) || memcmp(boundary, after, 2))
+        FAIL("Una escritura rechazada ha modificado datos");
+    uint8_t old, altered;
+    if (!ps5_checked_read(region, data_offset, &old, 1)) FAIL("No se leen los datos modificables");
+    altered = old ^ 0x5a;
+    if (!ps5_checked_write(region, data_offset, &altered, 1) ||
+        !ps5_checked_read(region, data_offset, &after[0], 1) || after[0] != altered ||
+        !ps5_checked_write(region, data_offset, &old, 1)) FAIL("Los datos RW no se modifican/restauran correctamente");
+    buffer = malloc(0x10000);
+    if (!buffer) FAIL("No hay memoria para verificar la imagen cargada");
+    Sha256 hash; sha256_init(&hash);
+    for (uint64_t offset = 0; offset < image_bytes;) {
+        size_t n = image_bytes - offset < 0x10000 ? (size_t)(image_bytes - offset) : 0x10000;
+        if (!ps5_checked_read(region, (size_t)offset, buffer, n)) FAIL("No se puede verificar una pagina de la imagen");
+        sha256_update(&hash, buffer, n); offset += n;
+    }
+    sha256_final(&hash, digest);
+    if (memcmp(digest, spec->image_sha256, 32)) FAIL("La imagen cargada o su BSS no coincide con el SHA-256 esperado");
+    free(buffer);
+    image->region = region; image->mixed_pages = ps5_checked_mixed_pages(region);
+    snprintf(detail, cap, "%s: %llu KiB en %#llx; SHA-256 y API RO/RW OK; %zu paginas mixtas",
+             spec->name, (unsigned long long)(image_bytes >> 10), (unsigned long long)spec->base, image->mixed_pages);
+    return 1;
+fail:
+    if (file) fclose(file);
+    free(raw); free(segment); free(buffer);
+    if (region) ps5_checked_destroy(region);
+    return 0;
+}
