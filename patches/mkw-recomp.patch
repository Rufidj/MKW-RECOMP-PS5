+++ b/tests/test_ps5_host_sections.py
@@ -0,0 +1,79 @@
+"""Host-service tables survive the PS5 linker's section garbage collection.
+
+Uses the actual hostfn implementation, registration macros and title fragment.
+The unretained link reproduces MKWBOOT-002's empty service tables.
+"""
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools/build"))
+from ps5_host_tables import validate_tables
+
+ROOT = Path(__file__).resolve().parents[1]
+FRAGMENT = ROOT.parent / 'PS5_MKWProbe/ps5/src/mkw-host-sections.ld'
+
+
+class HostSectionsTest(unittest.TestCase):
+    def test_registrations_under_gc(self):
+        linker = shutil.which('ld.lld') or shutil.which('ld.lld-18')
+        if not linker or not FRAGMENT.is_file():
+            self.skipTest('lld and the PS5 title linker fragment are required')
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            source = folder / 'registrations.c'
+            source.write_text(r'''
+#include "host.h"
+#include <assert.h>
+#include <string.h>
+static void diag(Cpu *c) { c->x[0] = 17; }
+static void observe(Cpu *c) { c->x[0] = 29; }
+static void plain(Cpu *c) { c->x[0] = 41; }
+HOST_OVERRIDE("nndiagStartup", diag);
+HOST_OBSERVER("nnMain", observe);
+HOST_FUNCTION("plain", plain);
+// Ensure a RELRO insertion point in the host's default linker layout too.
+__attribute__((used, section(".data.rel.ro")))
+const volatile RtHostEntry relro_anchor = {"anchor", diag};
+extern const RtHostEntry __start_mkw_fns[] __attribute__((weak));
+extern const RtHostEntry __stop_mkw_fns[] __attribute__((weak));
+int main(int argc, char **argv) {
+    assert(relro_anchor.name != NULL);
+    if (argc > 1 && !strcmp(argv[1], "empty")) {
+        assert(hostfn_table_size(0) == 0 && hostfn_table_size(1) == 0);
+        assert(!hostfn_override("nndiagStartup") && !hostfn_observer("nnMain"));
+        return 0;
+    }
+    assert(hostfn_table_size(0) == 1 && hostfn_table_size(1) == 1);
+    Cpu c = {0};
+    GuestFn fn = hostfn_override("nndiagStartup"); assert(fn); fn(&c); assert(c.x[0] == 17);
+    fn = hostfn_observer("nnMain"); assert(fn); fn(&c); assert(c.x[0] == 29);
+    assert(__start_mkw_fns && __stop_mkw_fns - __start_mkw_fns == 1);
+    __start_mkw_fns[0].fn(&c); assert(c.x[0] == 41);
+    assert(!hostfn_override("missing"));
+}
+''')
+            includes = sorted({ROOT / 'runtime'} | {p.parent for p in (ROOT / 'runtime').rglob('*.h')})
+            command = ['clang', '-O2', '-fPIE', '-pie', '-march=x86-64-v3',
+                       '-ffunction-sections', '-fdata-sections', '-fuse-ld=' + linker,
+                       '-Wl,--gc-sections,-z,start-stop-gc', '-Wno-bitwise-instead-of-logical',
+                       *[f'-I{p}' for p in includes], str(source), str(ROOT / 'runtime/cpu/hostfn.c')]
+            empty = folder / 'empty'
+            subprocess.run([*command, '-o', str(empty)], check=True, timeout=30)
+            subprocess.run([str(empty), 'empty'], check=True, timeout=10)
+            with self.assertRaises(ValueError):
+                validate_tables(empty)
+            # This host fixture tests retention/relocations, not Linux RELRO
+            # grouping of inserted sections. The native converted ELF is checked
+            # separately for actual GNU_RELRO coverage by the same verifier.
+            retained = folder / 'retained'
+            subprocess.run([*command, '-Wl,-z,norelro', '-Wl,-T,' + str(FRAGMENT), '-o', str(retained)], check=True, timeout=30)
+            subprocess.run([str(retained)], check=True, timeout=10)
+            report = validate_tables(retained)
+            self.assertEqual([report[k]['entries'] for k in ('ovr', 'obs', 'fns')], [1, 1, 1])
+
+
+if __name__ == '__main__':
+    unittest.main()
