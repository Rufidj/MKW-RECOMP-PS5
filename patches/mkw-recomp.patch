+"""Compile the native game runtime for a direct PS5 title, without desktop SDL/launcher/probes.
+
+Uses real runtime services and the native pad/window adapters. Game archives must
+already exist from ps5_game.py. Output is private build/ data; this script does
+not substitute unresolved HLE or claim that startup reached the first frame.
+Usage: python3 tools/build/ps5_boot.py --stack DIR [--jobs 2]
+"""
+from pathlib import Path
+import argparse, hashlib, json, os, shlex, subprocess, sys
+ROOT=Path(__file__).resolve().parents[2]
+from build import game_id, catalog
+from ps5_game import path
+
+def main():
+ ap=argparse.ArgumentParser(description=__doc__);ap.add_argument('--stack',type=Path,required=True);ap.add_argument('--jobs',type=int,default=2);ap.add_argument('--link',action='store_true');args=ap.parse_args()
+ stack=args.stack.resolve();out=ROOT/'build/ps5-boot';out.mkdir(exist_ok=True)
+ sdk=stack/'PS5_VulkanTemplate/.deps/native/ps5-payload-sdk';wrapper=stack/'PS5_Vulkan/tooling/prospero-clang18';runtime=ROOT/'runtime';title=ROOT.parent/'PS5_MKWProbe'
+ (out/'ps5_roboto.inc').write_bytes((ROOT/'build/ps5/ps5_roboto.inc').read_bytes())
+ sources=[]
+ skip={'input','input_sdl','switch2','switch2_win','menu_sdl','gfx_window_sdl','imgui_impl_sdl3','imgui_impl_sdlrenderer3',
+       'ps5_cpu_probe','ps5_game_slice','ps5_nso_probe','ps5_nso_link'}
+ for p in sorted(runtime.rglob('*')):
+  if p.suffix not in ('.c','.cpp') or p.stem in skip or p.stem.startswith(('linux','win32')) or p.stem.endswith('_win'):continue
+  if p.is_relative_to(runtime/'ui/launcher') or p.is_relative_to(runtime/'probes'):continue
+  sources.append(p)
+ sources += [ROOT.parent/'PS5_PayloadSDK/platform/src'/f'{n}.c' for n in ('demand','checked_region')]
+ sources += [title/'ps5/src/platform.c',title/'ps5/third_party/volk/volk.c',title/'ps5/src/game_entry.c']
+ catalog.generate(out/'rt/i18n')
+ defaults=out/'defaults.c'
+ defaults.write_text('const char rt_default_exefs[]="/app0/exefs";\nconst char rt_default_romfs[]="/app0/romfs";\nconst char rt_default_profile[]="/app0/profile";\nconst char rt_port_version[]="PS5 MKWBOOT-093";\n')
+ sources += [defaults,*sorted((out/'rt/i18n').glob('ui_text_*.c'))]
+ includes=sorted({runtime}|{p.parent for p in runtime.rglob('*.h')})
+ includes += [stack/'PS5_VulkanTemplate/external',ROOT/'build/generated-ps5',out,ROOT.parent/'PS5_PayloadSDK/platform/include',title/'ps5/third_party/volk']
+ deps=json.loads((ROOT/'build/ps5-deps/dependencies.json').read_text());includes += [Path(d['include']) for d in deps.values()]
+ flags=['-O2','-g1','-fPIC','-march=x86-64-v3','-fno-strict-aliasing','-fno-omit-frame-pointer','-ffunction-sections','-fdata-sections',
+        '-Wno-bitwise-instead-of-logical','-Wno-nullability-completeness','-DMKW_CHECKED_MEMORY','-DVK_NO_PROTOTYPES','-DRT_GAME_ID="'+game_id()+'"',
+        '-include',str(title/'ps5/third_party/volk/volk.h'),*['-I'+str(p) for p in includes]]
+ rules=['rule cc','  command = '+shlex.join(['sh',str(wrapper),*flags])+' $flags -MD -MF $out.d -c $in -o $out','  depfile = $out.d','  deps = gcc','  description = PS5 $in']
+ objects=[]
+ for i,src in enumerate(sources):
+  obj=out/'obj'/f'{i:03d}-{src.stem}.o';obj.parent.mkdir(exist_ok=True)
+  special=['-std=c++20'] if src.suffix=='.cpp' else ['-std=gnu11']
+  if src.name=='nx.cpp':special+=['-fexceptions','-fcxx-exceptions']
+  if src.is_relative_to(runtime/'sdk'):
+   special+=['-Dmemcpy=ps5_hle_memcpy','-Dmemmove=ps5_hle_memmove','-Dmemset=ps5_hle_memset']
+  if src==runtime/'core/boot/main.c':special+=['-Dmain=mkw_runtime_main']
+  rules += [f'build {path(obj)}: cc {path(src)}','  flags = '+shlex.join(special)];objects.append(str(obj))
+ identity=hashlib.sha256()
+ identity_inputs = [*sources,Path(__file__),title/'ps5/tools/link-title.sh',ROOT/'build/ps5-full/game-build.json',
+                    *sorted(runtime.rglob('*.h')),ROOT/'tools/build/ps5_host_tables.py',
+                    *sorted((ROOT.parent/'PS5_PayloadSDK/platform/include').rglob('*.h')),
+                    title/'ps5/src/platform.h',title/'ps5/third_party/volk/volk.h',title/'ps5/src/mkw-host-sections.ld',
+                    ROOT.parent/'PS5_VulkanBuild/tools/radv-link.sh']
+ for src in identity_inputs:
+  identity.update(src.read_bytes())
+ text='#define MKW_BOOT_ID "'+identity.hexdigest()[:20]+'"\n'
+ header=out/'boot_identity.h'
+ if not header.exists() or header.read_text()!=text:header.write_text(text)
+ (out/'build.ninja').write_text('\n'.join(rules)+'\n')
+ (out/'objects.json').write_text(json.dumps(objects,indent=2));(out/'sources.json').write_text(json.dumps(list(map(str,sources)),indent=2))
+ result=subprocess.run(['ninja','-f',str(out/'build.ninja'),'-j',str(args.jobs)],cwd=ROOT,env=dict(os.environ,PS5_PAYLOAD_SDK=str(sdk)))
+ if result.returncode or not args.link:return result.returncode
+ (out/'samples.txt').write_text('game\n')
+ (out/'require-mkw-host-tables').write_text('1\n')
+ link_objects=objects+[str(ROOT/'build/ps5-full/modules.o')]
+ link_objects += [str(ROOT/'build/ps5-full'/('lib'+n+'-ps5.a')) for n in ('main','subsdk0','sdk')]
+ link_objects += [deps[n]['archive'] for n in ('zstd','opus','libvpx')]
+ vulkan=ROOT.parent/'PS5_VulkanBuild'
+ command=['bash',str(title/'ps5/tools/link-title.sh'),str(out),str(vulkan),str(sdk),*link_objects]
+ (out/'link-command.json').write_text(json.dumps(command,indent=2))
+ with (out/'link.log').open('w') as log:result=subprocess.run(command,stdout=log,stderr=subprocess.STDOUT)
+ return result.returncode
+if __name__=='__main__':raise SystemExit(main())
