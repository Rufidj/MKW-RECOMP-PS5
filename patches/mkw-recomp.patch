new file mode 100644
index 0000000..8f1a133
--- /dev/null
+++ b/tools/build/nso_probe_manifest.py
@@ -0,0 +1,61 @@
+"""Write private hashes/layout for raw and guest-linked NSO diagnostics.
+
+All generated output belongs in build/. No game bytes are embedded in the header.
+Usage: python3 tools/build/nso_probe_manifest.py --exefs DIR --out build/ps5/nso_probe_manifest.h
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import sys
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "recomp"))
+from nso import Nso  # noqa: E402
+from versions import detect  # noqa: E402
+from layout import layout as module_layout  # noqa: E402
+from nso_link_audit import audit  # noqa: E402
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--exefs", type=Path, required=True)
+    parser.add_argument("--layout", type=Path, help="optional existing generator layout to validate")
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    version = detect(args.exefs)
+    layout = [
+        {"name": name, "base": hex(base), "size": hex(size)} for name, base, size in module_layout(args.exefs)]
+    if args.layout and json.loads(args.layout.read_text()) != layout:
+        raise SystemExit("existing generated layout differs from the canonical dump layout")
+    rows = []
+    for item in layout:
+        path = args.exefs / item["name"]
+        nso = Nso(path)
+        if nso.size != int(item["size"], 0):
+            raise SystemExit(f"layout size mismatch for {item['name']}")
+        raw = path.read_bytes()
+        arrays = ["{" + ",".join(f"0x{byte:02x}" for byte in digest) + "}"
+                  for digest in (hashlib.sha256(raw).digest(), hashlib.sha256(nso.image).digest())]
+        rows.append(f'    {{{json.dumps(item["name"])}, {item["base"]}ull, {nso.size}ull, '
+                    f'{nso.data[0]}ull, {len(raw)}ull, {arrays[0]}, {arrays[1]}}}')
+    linked = audit(args.exefs)
+    link_rows = []
+    for module in linked["modules"]:
+        digest = ",".join(f"0x{byte:02x}" for byte in bytes.fromhex(module["guest_linked_image_sha256"]))
+        count = sum(module["relocations"].values())
+        link_rows.append(f"    {{{count}ull, {{{digest}}}}}")
+    text = ("// Private diagnostic metadata, generated from the local dump. Keep in build/.\n"
+            "#pragma once\n#include \"platform/ps5_nso_link.h\"\n"
+            f"#define PS5_NSO_PROBE_COUNT {len(rows)}\n"
+            f"#define PS5_NSO_PROBE_VERSION {version.number}\n"
+            "static const Ps5NsoProbeSpec ps5_nso_probe_specs[] = {\n" + ",\n".join(rows) + "\n};\n"
+            "static const Ps5NsoLinkExpected ps5_nso_link_expected[] = {\n"
+            + ",\n".join(link_rows) + "\n};\n")
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(text)
+    print(f"NSO diagnostic metadata: version {version.number}, {len(rows)} modules, {args.out}")
+
+
+if __name__ == "__main__":
+    main()
