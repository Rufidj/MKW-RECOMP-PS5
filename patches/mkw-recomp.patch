+"""Check raw fixed-address NSO loading independently of game data.
+
+Usage: python3 tests/test_ps5_nso.py. Synthetic fixtures cover compressed and
+uncompressed segments, file/image hashes, corrupt backreferences and cleanup.
+"""
+import hashlib
+from pathlib import Path
+import shutil
+import struct
+import subprocess
+import tempfile
+import unittest
+
+import lz4.block
+from ps5_support import FORK, demand_include
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def fixture(compressed, corrupt=False):
+    text = bytes(i % 13 for i in range(0x1000))
+    rodata = bytes((i * 3) % 251 for i in range(0x2000))
+    data = bytes((i * 7) % 253 for i in range(0x1000))
+    stored = lz4.block.compress(text, store_size=False) if compressed else text
+    if corrupt:
+        stored = b"\x00\x00\x00"  # A match with distance zero.
+    image = text + rodata + data + bytes(0x2000)
+    header = bytearray(0x100)
+    header[:4] = b"NSO0"
+    struct.pack_into("<I", header, 0xc, int(compressed))
+    cursor = 0x100
+    pieces = []
+    for i, (offset, decoded, encoded) in enumerate(((0, text, stored), (0x1000, rodata, rodata), (0x3000, data, data))):
+        struct.pack_into("<III", header, 0x10 + i * 16, cursor, offset, len(decoded))
+        struct.pack_into("<I", header, 0x60 + i * 4, len(encoded))
+        pieces.append(encoded)
+        cursor += len(encoded)
+    struct.pack_into("<I", header, 0x3c, 0x2000)
+    return bytes(header) + b"".join(pieces), image
+
+
+class Ps5NsoChecks(unittest.TestCase):
+    def test_raw_loader(self):
+        cc = shutil.which("clang")
+        if not cc:
+            self.skipTest("clang is needed")
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            for compressed, corrupt in ((False, False), (True, False), (True, True)):
+                raw, image = fixture(compressed, corrupt)
+                (folder / "fixture.nso").write_bytes(raw)
+                arrays = ["{" + ",".join(str(b) for b in digest) + "}"
+                          for digest in (hashlib.sha256(raw).digest(), hashlib.sha256(image).digest())]
+                (folder / "fixture.h").write_text(
+                    '#include "platform/ps5_nso_probe.h"\n'
+                    'static const Ps5NsoProbeSpec spec = {"fixture", 0x7000000000ull, '
+                    f'0x6000, 0x3000, {len(raw)}, {arrays[0]}, {arrays[1]}}};\n')
+                (folder / "main.c").write_text(r'''
+#include "fixture.h"
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+int main(int argc, char **argv) {
+    (void)argc; char detail[256]; Ps5NsoProbeImage image = {0};
+    int ok = ps5_nso_probe_load("fixture.nso", &spec, &image, detail, sizeof detail);
+    puts(detail);
+    if (strcmp(argv[1], "valid")) {
+        assert(!ok && !image.region);
+        assert(strstr(detail, !strcmp(argv[1], "corrupt") ? "LZ4" : "SHA-256"));
+        return 0;
+    }
+    assert(ok && image.region && image.mixed_pages == 2);
+    assert(ps5_checked_address(image.region) == spec.base);
+    Ps5NsoProbeImage collision = {0};
+    assert(!ps5_nso_probe_load("fixture.nso", &spec, &collision, detail, sizeof detail));
+    assert(!collision.region);
+    unsigned char bytes[16];
+    assert(ps5_checked_read(image.region, 0, bytes, sizeof bytes));
+    for (int i = 0; i < 16; i++) assert(bytes[i] == i % 13);
+    ps5_nso_probe_unload(&image);
+    assert(ps5_nso_probe_load("fixture.nso", &spec, &image, detail, sizeof detail));
+    ps5_nso_probe_unload(&image);
+    return 0;
+}
+''')
+                exe = folder / "nso-test"
+                subprocess.run([
+                    cc, "-O2", "-Wall", "-Wextra", "-Werror", "-fno-strict-aliasing",
+                    f"-I{ROOT / 'runtime'}", f"-I{ROOT / 'runtime/core/base'}", demand_include(),
+                    str(folder / "main.c"), str(ROOT / "runtime/platform/ps5_nso_probe.c"),
+                    str(ROOT / "runtime/core/base/sha256.c"), str(FORK / "platform/src/checked_region.c"),
+                    str(FORK / "platform/tests/demand_host_kernel.c"), "-pthread", "-o", str(exe),
+                ], check=True, timeout=30)
+                subprocess.run([str(exe), "corrupt" if corrupt else "valid"], cwd=folder, check=True, timeout=15)
+                if not corrupt:
+                    changed = bytearray(raw)
+                    changed[-1] ^= 1
+                    (folder / "fixture.nso").write_bytes(changed)
+                    subprocess.run([str(exe), "mismatch"], cwd=folder, check=True, timeout=15)
+
+
+if __name__ == "__main__":
+    unittest.main()
