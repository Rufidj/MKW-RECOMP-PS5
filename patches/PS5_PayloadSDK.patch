index 0000000..db8f6f0
--- /dev/null
+++ b/platform/tests/test_checked_region.c
@@ -0,0 +1,124 @@
+/* Checked 4 KiB policy over 16 KiB native protection. SPDX-License-Identifier: GPL-3.0-or-later */
+#define _GNU_SOURCE
+#include "ps5platform/checked_region.h"
+#include <assert.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+extern atomic_int checked_test_protect_calls, checked_test_fail_protect, checked_test_fail_protect_always;
+static struct ps5_checked_region *shared;
+static void *writer(void *arg)
+{
+   unsigned char bytes[16]; memset(bytes, (int)(intptr_t)arg, sizeof bytes);
+   for (int i = 0; i < 10000; i++) ps5_checked_write(shared, 0, bytes, sizeof bytes);
+   return NULL;
+}
+static void *reader(void *arg)
+{
+   (void)arg; unsigned char bytes[16];
+   for (int i = 0; i < 10000; i++) {
+      assert(ps5_checked_read(shared, 0, bytes, sizeof bytes));
+      for (int j = 1; j < 16; j++) assert(bytes[j] == bytes[0]);
+   }
+   return NULL;
+}
+int main(void)
+{
+   const uintptr_t base = 0x7000000000ull;
+   struct ps5_checked_region *r = NULL, *other = NULL;
+   assert(!ps5_checked_create(base + 0x1000, 0x10000, &r));
+   assert(!ps5_checked_create(base, 0, &r));
+   assert(!ps5_checked_create(base, 1, &r));
+   assert(ps5_checked_create(base, 0x20000, &r));
+   assert(ps5_checked_address(r) == base);
+   assert(!ps5_checked_create(base, 0x10000, &other) && !other);
+   unsigned char original[0x20000], readback[0x20000];
+   memset(original, 0x11, sizeof original);
+   assert(ps5_checked_write(r, 0, original, sizeof original));
+   for (size_t width = 1; width <= 16; width *= 2) {
+      unsigned char value[16], expected[16], desired[16], out[16];
+      memset(value, 0x55, 16); memset(desired, 0xaa, 16);
+      assert(ps5_checked_atomic_store(r, 0x8000, value, width));
+      assert(ps5_checked_atomic_load(r, 0x8000, out, width) && !memcmp(out, value, width));
+      memcpy(expected, value, 16); int exchanged = -1;
+      assert(ps5_checked_atomic_cas(r, 0x8000, expected, desired, width, &exchanged) && exchanged == 1);
+      assert(ps5_checked_atomic_cas(r, 0x8000, expected, value, width, &exchanged) && exchanged == 0);
+      assert(!memcmp(expected, desired, width));
+      assert(!ps5_checked_atomic_load(r, SIZE_MAX, out, width));
+      if (width > 1) assert(!ps5_checked_atomic_store(r, 0x8001, value, width));
+   }
+   assert(ps5_checked_write(r, 0, original, sizeof original));
+   assert(ps5_checked_protect(r, 0, 0x2000, PS5_CHECKED_READ));
+   uint64_t expected_atomic = 0, desired_atomic = 1;
+   int exchanged_atomic = 17;
+   assert(!ps5_checked_atomic_cas(r, 0, &expected_atomic, &desired_atomic, 8, &exchanged_atomic));
+   assert(expected_atomic == 0 && exchanged_atomic == 17);
+   assert(!ps5_checked_atomic_store(r, 0, &desired_atomic, 8));
+   assert(!ps5_checked_atomic_load(r, 0x2000, (void *)(base + 0x9000), 8));
+   assert(!ps5_checked_atomic_load(r, 0x2000, &expected_atomic, 3));
+   assert(ps5_checked_mixed_pages(r) == 1);
+   assert(ps5_checked_access(r, 0x1fff) == PS5_CHECKED_READ);
+   assert(ps5_checked_access(r, 0x2000) == PS5_CHECKED_RW);
+   unsigned char replacement[2] = {0x22, 0x33};
+   assert(!ps5_checked_write(r, 0x1fff, replacement, 2));
+   assert(ps5_checked_read(r, 0x1fff, readback, 2));
+   assert(readback[0] == 0x11 && readback[1] == 0x11);
+   assert(ps5_checked_write(r, 0x2000, replacement, 2));
+   assert(!ps5_checked_write(r, 0x1ffff, replacement, 2));
+   assert(!ps5_checked_read(r, SIZE_MAX, readback, 16));
+   assert(!ps5_checked_write(r, 0, NULL, 1));
+   assert(!ps5_checked_read(r, 0, (void *)(base + 0x3000), 1));
+   assert(ps5_checked_read(r, 0x20000, NULL, 0));
+   assert(!ps5_checked_read(r, 0x20001, NULL, 0));
+   assert(!ps5_checked_protect(r, 1, 0x1000, PS5_CHECKED_READ));
+   assert(!ps5_checked_protect(r, 0, 0x1000, 2));
+   assert(ps5_checked_protect(r, 0x3000, 0x1000, PS5_CHECKED_NONE));
+   assert(!ps5_checked_read(r, 0x2fff, readback, 2));
+   assert(!ps5_checked_write(r, 0x2fff, replacement, 2));
+   assert(ps5_checked_protect(r, 0x4000, 0x4000, PS5_CHECKED_READ));
+   pid_t child = fork(); assert(child >= 0);
+   if (!child) { *(volatile unsigned char *)(base + 0x4000) = 1; _exit(7); }
+   int status;
+   assert(waitpid(child, &status, 0) == child);
+   assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGSEGV);
+   assert(ps5_checked_protect(r, 0, 0x20000, PS5_CHECKED_RW));
+   atomic_store(&checked_test_protect_calls, 0);
+   /* MKWBOOT-063: apply() protects a uniform run with one call, so the range fails as a whole on its first call and the
+    * second call (the rollback) must restore it. */
+   atomic_store(&checked_test_fail_protect, 1);
+   assert(!ps5_checked_protect(r, 0, 0x8000, PS5_CHECKED_READ));
+   assert(ps5_checked_access(r, 0) == PS5_CHECKED_RW);
+   assert(ps5_checked_access(r, 0x4000) == PS5_CHECKED_RW);
+   assert(ps5_checked_write(r, 0, original, sizeof original));
+   atomic_store(&checked_test_fail_protect, 0);
+
+   shared = r;
+   pthread_t threads[3];
+   assert(!pthread_create(&threads[0], NULL, writer, (void *)0x22));
+   assert(!pthread_create(&threads[1], NULL, writer, (void *)0x33));
+   assert(!pthread_create(&threads[2], NULL, reader, NULL));
+   for (int i = 0; i < 1000; i++)
+      assert(ps5_checked_protect(r, 0, 0x1000, i & 1 ? PS5_CHECKED_RW : PS5_CHECKED_READ));
+   for (int i = 0; i < 3; i++) assert(!pthread_join(threads[i], NULL));
+   atomic_store(&checked_test_fail_protect_always, 1);
+   assert(!ps5_checked_protect(r, 0, 0x1000, PS5_CHECKED_READ));
+   assert(ps5_checked_access(r, 0) == -1);
+   assert(!ps5_checked_read(r, 0, readback, 1));
+   assert(!ps5_checked_write(r, 0x1000, replacement, 2));
+   assert(!ps5_checked_atomic_load(r, 0, &expected_atomic, 8));
+   assert(!ps5_checked_atomic_store(r, 0, &desired_atomic, 8));
+   assert(!ps5_checked_atomic_cas(r, 0, &expected_atomic, &desired_atomic, 8, &exchanged_atomic));
+   ps5_checked_destroy(r);
+   atomic_store(&checked_test_fail_protect_always, 0);
+   assert(ps5_checked_create(base, 0x10000, &r));
+   assert(ps5_checked_read(r, 0, readback, 16));
+   for (int i = 0; i < 16; i++) assert(readback[i] == 0);
+   ps5_checked_destroy(r);
+   puts("PASS: fixed mapping, checked 4 KiB rights, cross-page rejection, native RO, rollback, poison, concurrency, cleanup");
+   return 0;
+}
diff --git a/platform/tests/test_checked_sparse.c b/platform/tests/test_checked_sparse.c
